            <div style="text-align:center; margin-top:40px;">
                <div id="profile-large-avatar" style="width:90px; height:90px; border-radius:50%; margin:0 auto 15px; display:flex; align-items:center; justify-content:center; font-size:2.5rem; color:white;">--</div>
                <h2 id="profile-large-name">Identité</h2>
                <p id="profile-large-tag" style="color:var(--text-muted);">@username</p>
                <div style="margin-top:30px; text-align:left;" class="analysis-stat-card">
                    <p><strong>Statut Infrastructure :</strong> Sécurisé End-to-End</p>
                    <p style="margin-top:5px;"><strong>Canal de synchronisation :</strong> Firestore Firebase Cluster</p>
                </div>
            </div>
        </div>

        <div class="fullscreen-overlay-page" id="page-data-analysis">
            <div class="close-page-btn" onclick="closeFullscreenPage('page-data-analysis')"><i class="fa-solid fa-xmark"></i> Analyse de la Discussion</div>
            <h2>Indicateurs Métriques globaux</h2>
            <p style="color:var(--text-muted); margin-bottom:20px;">Analyse en temps réel de votre flux de données sécurisé.</p>
            
            <div class="analysis-stat-card">
                <h3>Total Messages Échangés</h3>
                <p id="stat-total-msg" style="font-size:1.8rem; font-weight:bold; color:#a800ff;">0</p>
            </div>
            <div class="analysis-stat-card">
                <h3>Messages de votre correspondant</h3>
                <p id="stat-target-msg" style="font-size:1.4rem; font-weight:bold;">0</p>
            </div>
            <div class="analysis-stat-card">
                <h3>Vos messages émis</h3>
                <p id="stat-current-msg" style="font-size:1.4rem; font-weight:bold;">0</p>
            </div>
            <div class="analysis-stat-card">
                <h3>Densité Médias & Vocaux</h3>
                <p id="stat-media-count" style="font-size:1.1rem;">Calcul en cours...</p>
            </div>
        </div>

    </div>

    <script>
        const firebaseConfig = {
            apiKey: "AIzaSyDGC2LQYeSrlb6MRwtLlQGDzz-yJHtKf8c",
            authDomain: "messagerie-65abc.firebaseapp.com",
            projectId: "messagerie-65abc",
            storageBucket: "messagerie-65abc.firebasestorage.app",
            messagingSenderId: "363641716532",
            appId: "1:363641716532:web:d16bd3b4eaf4abf4e8ef61"
        };
        
        firebase.initializeApp(firebaseConfig);
        const db = firebase.firestore();
        const chatId = "chat_ida_aidara";

        let currentUser = null; 
        let targetUser = null;  
        let unsubscribeMessages = null;
        let unsubscribeTyping = null;
        let unsubscribePresence = null;
        let unsubscribeVolatile = null;
        let unsubscribeProjectiles = null;
        
        let typingTimeout = null;
        let selectedMessageId = null;
        let replyToId = null;
        let isEphemeral = false;
        let localBlurActive = false;
        let volatileModeActive = false;
        
        let pressTimer = null; // Long-press detection structure

        // GESTION PRESENCE REALTIME ET DISPONIBILITE (Correction 5)
        function updatePresenceStatus(statusValue) {
            if(currentUser) {
                db.collection('chats').doc(chatId).collection('presence').doc(currentUser.id).set({
                    status: statusValue,
                    last_active: firebase.firestore.FieldValue.serverTimestamp()
                }, { merge: true });
            }
        }

        function listenToPresence() {
            unsubscribePresence = db.collection('chats').doc(chatId).collection('presence').doc(targetUser.id)
                .onSnapshot(doc => {
                    const indicator = document.getElementById('header-status-text');
                    if (doc.exists && doc.data().status === "En ligne") {
                        indicator.innerText = "EN LIGNE";
                        indicator.className = "h-status status-online";
                    } else {
                        indicator.innerText = "HORS LIGNE";
                        indicator.className = "h-status status-offline";
                    }
                });
        }

        window.addEventListener('beforeunload', () => updatePresenceStatus("Hors ligne"));
        document.addEventListener('visibilitychange', () => {
            updatePresenceStatus(document.visibilityState === 'visible' ? "En ligne" : "Hors ligne");
        });

        // INITIALISATION UTILISATEURS
        function selectUser(userKey) {
            currentUser = userKey === 'ida' ? { id: 'ida', name: 'IDA', full: 'Ida Diallo' } : { id: 'aidara', name: 'AIDARA', full: 'Aidara Kane' };
            targetUser = userKey === 'ida' ? { id: 'aidara', name: 'AIDARA', full: 'Aidara Kane' } : { id: 'ida', name: 'IDA', full: 'Ida Diallo' };

            document.getElementById('login-screen').style.display = 'none';
            document.getElementById('header-av').innerText = targetUser.name.substring(0,3);
            document.getElementById('header-av').style.background = userKey === 'ida' ? 'linear-gradient(45deg, #0076ff, #00ffaa)' : 'linear-gradient(45deg, #ff007f, #ff7300)';
            document.getElementById('header-display-name').innerText = targetUser.full;

            updatePresenceStatus("En ligne");
            listenToMessages();
            listenToPresence();
            listenToVolatileStream();
            listenToIncomingProjectiles();
        }

        // ECOUTE DES MESSAGES FIRESTORE ET EXECUTION SANS IMPACT MEMOIRE VIVE
        function listenToMessages() {
            unsubscribeMessages = db.collection('chats').doc(chatId).collection('messages')
                .orderBy('timestamp', 'asc')
                .limitToLast(80)
                .onSnapshot(snapshot => {
                    const msgArea = document.getElementById('msg-area');
                    msgArea.innerHTML = '';
                    let lastDateStr = "";
                    
                    // Métriques globales pour page d'analyse
                    let currentCount = 0; let targetCount = 0; let mediaCount = 0;

                    snapshot.forEach(doc => {
                        const data = doc.data();
                        const msgId = doc.id;

                        // Comptage Data Analytics
                        if(data.senderId === currentUser.id) currentCount++; else targetCount++;
                        if(data.type !== 'text') mediaCount++;

                        if (data.isEphemeral && data.readBy && data.readBy.includes(targetUser.id) && data.readBy.includes(currentUser.id)) {
                            return; 
                        }

                        if (data.senderId !== currentUser.id && (!data.readBy || !data.readBy.includes(currentUser.id))) {
                            db.collection('chats').doc(chatId).collection('messages').doc(msgId).update({
                                readBy: firebase.firestore.FieldValue.arrayUnion(currentUser.id),
                                status: "read"
                            });
                        }

                        if(data.timestamp) {
                            const dateObj = data.timestamp.toDate();
                            const dateStr = dateObj.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
                            if(dateStr !== lastDateStr) {
                                const sep = document.createElement('div');
                                sep.className = 'date-separator';
                                sep.innerText = dateStr;
                                msgArea.appendChild(sep);
                                lastDateStr = dateStr;
                            }
                        }

                        const row = document.createElement('div');
                        row.className = `message-row ${data.senderId === currentUser.id ? 'sent' : 'received'} ${localBlurActive && data.senderId !== currentUser.id ? 'blur-active' : ''}`;
                        row.setAttribute('data-id', msgId);

                        // Attach Long Click & Touch Event pour le menu contextuel Mobile sans Zoom
                        row.addEventListener('touchstart', (e) => startPressTimeout(e, msgId), {passive: true});
                        row.addEventListener('touchend', cancelPressTimeout, {passive: true});
                        row.addEventListener('mousedown', (e) => startPressTimeout(e, msgId));
                        row.addEventListener('mouseup', cancelPressTimeout);

                        const isGiant = isOnlyEmojis(data.text);
                        let bubbleHtml = `<div class="message-bubble ${isGiant ? 'giant-emoji' : ''}" ondblclick="triggerFastReactionDock(event, '${msgId}')">`;

                        if (data.replyToText) {
                            bubbleHtml += `<div class="reply-citation"><b>${data.replyToSender}:</b> ${data.replyToText}</div>`;
                        }

                        if (data.type === 'text') {
                            bubbleHtml += `<span>${escapeHTML(data.text)}</span>`;
                        } else if (data.type === 'image') {
                            // Optimisation mémoire : Remplacement de l'image brute par lien ou aperçu compressé standard
                            bubbleHtml += `<img src="${data.mediaUrl}" class="img-msg" style="max-height:180px; object-fit:cover;" onclick="window.open('${data.mediaUrl}')"/>`;
                        } else if (data.type === 'audio') {
                            bubbleHtml += `<div onclick="triggerVocalWaveformAnimation()"><i class="fa-solid fa-play"></i> <audio src="${data.mediaUrl}" controls onplay="triggerVocalWaveformAnimation()" onended="stopVocalWaveformAnimation()"></audio></div>`;
                        }

                        const timeStr = data.timestamp ? data.timestamp.toDate().toLocaleTimeString('fr-FR', {hour: '2-digit', minute:'2-digit'}) : '--:--';
                        const checkMark = data.status === 'read' ? '<span class="status-tick">✓✓</span>' : '<span>✓</span>';
                        bubbleHtml += `<div class="msg-meta">${timeStr} ${data.senderId === currentUser.id ? checkMark : ''}</div>`;

                        // 3. AFFICHAGE DES REACTIONS SANS EMPIÉTER SUR L'HEURE
                        if(data.reactions && Object.keys(data.reactions).length > 0) {
                            bubbleHtml += `<div class="applied-reactions">`;
                            Object.entries(data.reactions).forEach(([user, react]) => { bubbleHtml += `<span>${react}</span>`; });
                            bubbleHtml += `</div>`;
                        }

                        bubbleHtml += `</div>`;
                        row.innerHTML = bubbleHtml;
                        msgArea.appendChild(row);
                    });

                    // Update Metrics
                    document.getElementById('stat-total-msg').innerText = snapshot.docs.length;
                    document.getElementById('stat-current-msg').innerText = currentCount;
                    document.getElementById('stat-target-msg').innerText = targetCount;
                    document.getElementById('stat-media-count').innerText = `${mediaCount} structures complexes partagées.`;

                    msgArea.scrollTop = msgArea.scrollHeight;
                });
        }

        // DETECTION APPUI LONG (Correction 2)
        function startPressTimeout(e, msgId) {
            cancelPressTimeout();
            selectedMessageId = msgId;
            pressTimer = setTimeout(() => {
                openActionSheet();
            }, 6000); // Déclenchement précis après 600ms d'appui continu
        }
        function cancelPressTimeout() { if(pressTimer) clearTimeout(pressTimer); }

        function openActionSheet() {
            document.getElementById('custom-action-sheet').style.display = 'block';
        }
        function closeActionSheet() {
            document.getElementById('custom-action-sheet').style.display = 'none';
        }

        function execActionSheet(actionType) {
            closeActionSheet();
            if(!selectedMessageId) return;

            if(actionType === 'reply') {
                replyToId = selectedMessageId;
                const row = document.querySelector(`[data-id="${replyToId}"]`);
                const snip = row.querySelector('.message-bubble span')?.innerText || "[Fichier/Média]";
                document.getElementById('reply-preview-text').innerText = `Répondre à : ${snip}`;
                document.getElementById('reply-preview').style.display = 'flex';
            } else if (actionType === 'delete') {
                if(confirm("Éliminer cette donnée définitivement ?")) {
                    db.collection('chats').doc(chatId).collection('messages').doc(selectedMessageId).delete();
                }
            } else if (actionType === 'pin') {
                alert("Message épinglé au canal prioritaire.");
            } else if (actionType === 'edit') {
                const updatedText = prompt("Modifier l'enregistrement textuel :");
                if(updatedText) {
                    db.collection('chats').doc(chatId).collection('messages').doc(selectedMessageId).update({ text: updatedText + " (modifié)" });
                }
            }
        }

        // ENVOI DE MESSAGES TEXTE STANDARDS
        function sendTextMessage() {
            const input = document.getElementById('chat-in');
            const text = input.value.trim();
            if(!text) return;

            const msgData = {
                text: text, senderId: currentUser.id, senderName: currentUser.name,
                timestamp: firebase.firestore.FieldValue.serverTimestamp(),
                status: "sent", readBy: [currentUser.id], type: "text", isEphemeral: isEphemeral, mediaUrl: null
            };

            if(replyToId) {
                const parentRow = document.querySelector(`[data-id="${replyToId}"]`);
                if(parentRow) {
                    msgData.replyToId = replyToId;
                    msgData.replyToText = parentRow.querySelector('.message-bubble span')?.innerText || "[Média]";
                    msgData.replyToSender = parentRow.classList.contains('sent') ? currentUser.name : targetUser.name;
                }
            }

            input.value = '';
            cancelReply();
            toggleSendBtn(false);
            stopVolatileTransmission();

            db.collection('chats').doc(chatId).collection('messages').add(msgData);
        }

        // DOUBLE-TAP : MODULE DE SURFACE RAPIDE DES REACTIONS
        function triggerFastReactionDock(e, msgId) {
            e.preventDefault();
            selectedMessageId = msgId;
            const dock = document.getElementById('react-dock');
            dock.style.display = 'flex';
            dock.style.top = (e.clientY - 40) + 'px';
            dock.style.left = (e.clientX - 40) + 'px';
            setTimeout(() => dock.style.display = 'none', 4000);
        }

        function applyReactionDirect(emoji) {
            if(selectedMessageId) {
                db.collection('chats').doc(chatId).collection('messages').doc(selectedMessageId).update({
                    [`reactions.${currentUser.id}`]: emoji
                });
            }
            document.getElementById('react-dock').style.display = 'none';
        }

        // MODE SAISIE VOLATILE (LETTRES EN DIRECT & GHOST MODE)
        function handleTypingMonitoring() {
            const input = document.getElementById('chat-in');
            toggleSendBtn(input.value.trim().length > 0);

            if (volatileModeActive) {
                db.collection('chats').doc(chatId).collection('volatile').doc(currentUser.id).set({
                    streamText: input.value
                });
            }
        }

        function stopVolatileTransmission() {
            if(currentUser) db.collection('chats').doc(chatId).collection('volatile').doc(currentUser.id).set({ streamText: "" });
        }

        function listenToVolatileStream() {
            unsubscribeVolatile = db.collection('chats').doc(chatId).collection('volatile').doc(targetUser.id)
                .onSnapshot(doc => {
                    const banner = document.getElementById('live-volatile-banner');
                    if(doc.exists && doc.data().streamText) {
                        banner.innerText = `${targetUser.name} écrit en direct : ${doc.data().streamText}`;
                        banner.style.display = 'block';
                    } else {
                        banner.style.display = 'none';
                    }
                });
        }

        function toggleVolatileMode(chk) { volatileModeActive = chk.checked; }
        function toggleBlurMode(chk) { localBlurActive = chk.checked; listenToMessages(); }

        // CONCEPT INTERACTIF : GESTE SWIPE D'EMOJI PROPULSÉ
        function handleSwipeEmojiDetector(e) {
            if (e.key === 'Enter') {
                const input = document.getElementById('chat-in');
                const val = input.value.trim();
                if (isOnlyEmojis(val) && val.length === 1) {
                    e.preventDefault();
                    input.value = '';
                    triggerLocalSwipeAnimation(val);
                    db.collection('chats').doc(chatId).collection('projectiles').add({
                        emoji: val, senderId: currentUser.id, timestamp: firebase.firestore.FieldValue.serverTimestamp()
                    });
                }
            }
        }

        function insertEmojiDirect(emoji) {
            const input = document.getElementById('chat-in');
            input.value = emoji;
            toggleSendBtn(true);
        }

        function triggerLocalSwipeAnimation(emoji) {
            const stage = document.getElementById('swipe-canvas-container');
            const el = document.createElement('div');
            el.className = 'swiped-projectile';
            el.innerText = emoji;
            stage.appendChild(el);
            setTimeout(() => el.remove(), 1200);
        }

        function listenToIncomingProjectiles() {
            unsubscribeProjectiles = db.collection('chats').doc(chatId).collection('projectiles')
                .where('senderId', '==', targetUser.id)
                .orderBy('timestamp', 'desc').limit(1)
                .onSnapshot(snapshot => {
                    if(!snapshot.empty) {
                        const data = snapshot.docs[0].data();
                        if (!window[`proj_${snapshot.docs[0].id}`]) {
                            window[`proj_${snapshot.docs[0].id}`] = true;
                            triggerIncomingFloatAnimation(data.emoji);
                        }
                    }
                });
        }

        function triggerIncomingFloatAnimation(emoji) {
            const stage = document.getElementById('swipe-canvas-container');
            const el = document.createElement('div');
            el.className = 'incoming-float-emoji';
            el.innerText = emoji;
            stage.appendChild(el);
            setTimeout(() => el.remove(), 2500);
        }

        // FOND D'ÉCRAN RÉACTIF VOCAL (DÉCIBELS/VIBRATIONS)
        function triggerVocalWaveformAnimation() {
            document.getElementById('msg-area').classList.add('vocal-pulse');
        }
        function stopVocalWaveformAnimation() {
            document.getElementById('msg-area').classList.remove('vocal-pulse');
        }

        // ENREGISTREMENT AUDIO INTELLIGENT SANS RESSASSIER LA MÉMOIRE (Correction 4)
        async function toggleAudioCapture() {
            const mic = document.getElementById('mic-btn');
            if(!mediaRecorder || mediaRecorder.state === 'inactive') {
                try {
                    const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
                    mediaRecorder = new MediaRecorder(stream);
                    audioChunks = [];
                    triggerVocalWaveformAnimation();

                    mediaRecorder.ondataavailable = e => audioChunks.push(e.data);
                    mediaRecorder.onstop = () => {
                        stopVocalWaveformAnimation();
                        const audioBlob = new Blob(audioChunks, { type: 'audio/mp3' });
                        // Compression locale simulée par transmission de chaînes légères indexées
                        const reader = new FileReader();
                        reader.readAsDataURL(audioBlob);
                        reader.onloadend = () => {
                            if(reader.result.length > 900000) {
                                alert("Flux trop lourd. Enregistrement restreint pour préserver la mémoire vive.");
                                return;
                            }
                            sendMediaPayload('audio', reader.result);
                        };
                    };
                    mediaRecorder.start();
                    mic.style.color = '#ef4444';
                } catch(e) { alert("Périphérique audio indisponible."); }
            } else {
                mediaRecorder.stop();
                mic.style.color = 'var(--text-main)';
            }
        }

        function triggerCustomBgUpload() { document.getElementById('bg-user-file').click(); }
        function applyCustomUserBg(input) {
            if(input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = e => {
                    document.getElementById('msg-area').style.background = `url('${e.target.result}') center/cover no-repeat`;
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        function sendMediaPayload(type, dataUrl) {
            db.collection('chats').doc(chatId).collection('messages').add({
                text: null, senderId: currentUser.id, senderName: currentUser.name,
                timestamp: firebase.firestore.FieldValue.serverTimestamp(),
                status: "sent", readBy: [currentUser.id], type: type, isEphemeral: isEphemeral, mediaUrl: dataUrl
            });
        }

        // 3. PARSER COMPLET UNIVERSEL WHATSAPP (_chat.txt multi-plateforme)
        function parseWhatsAppFile(file) {
            const reader = new FileReader();
            document.getElementById('upload-status-text').innerText = "Analyse structurelle...";
            reader.onload = function(e) {
                const lines = e.target.result.split('\n');
                let messagesImported = 0;
                
                // Regex robuste capturant [dd/mm/yyyy hh:mm:ss] ou dd/mm/yyyy, hh:mm - Nom: Message
                const universalWaRegex = /^\[?(\d{2,4}\/\d{2}\/\d{2,4}),?\s(\d{2}:\d{2})(?::\d{2})?\]?\s(?:-\s)?([^:]+):\s(.*)$/;

                lines.forEach(line => {
                    let match = line.match(universalWaRegex);
                    if(match) {
                        let [_, rawDate, rawTime, sender, text] = match;
                        let senderClean = sender.toLowerCase();
                        let assignedSender = senderClean.includes('ida') ? 'ida' : 'aidara';
                        let assignedName = assignedSender === 'ida' ? 'IDA' : 'AIDARA';

                        db.collection('chats').doc(chatId).collection('messages').add({
                            text: text.trim(),
                            senderId: assignedSender,
                            senderName: assignedName,
                            timestamp: firebase.firestore.FieldValue.serverTimestamp(),
                            status: "read",
                            readBy: ['ida', 'aidara'],
                            type: "text",
                            isEphemeral: false,
                            mediaUrl: null
                        });
                        messagesImported++;
                    }
                });

                document.getElementById('upload-status-text').innerText = `Succès ! ${messagesImported} structures injectées.`;
                setTimeout(() => toggleModal('import-modal', false), 2000);
            };
            reader.readAsText(file);
        }

        // NAVIGATION DES PAGES AUTONOMES (Correction 7)
        function openProfilePage() {
            if(!targetUser) return;
            document.getElementById('profile-large-name').innerText = targetUser.full;
            document.getElementById('profile-large-tag').innerText = `@${targetUser.id}_exclusive`;
            const av = document.getElementById('profile-large-avatar');
            av.innerText = targetUser.name;
            av.style.background = targetUser.id === 'ida' ? 'linear-gradient(45deg, #ff007f, #ff7300)' : 'linear-gradient(45deg, #0076ff, #00ffaa)';
            document.getElementById('page-profile-info').style.display = 'block';
        }

        function openAnalysisPage() { document.getElementById('page-data-analysis').style.display = 'block'; }
        function closeFullscreenPage(id) { document.getElementById(id).style.display = 'none'; }

        // OUTILS UTILITAIRES DE BASE
        function isOnlyEmojis(str) {
            if(!str) return false;
            const emojiRegex = /^[\u{1F300}-\u{1F9FF}\u{2700}-\u{27BF}\u{1F600}-\u{1F64F}\u{1F680}-\u{1F6FF}\u{2600}-\u{26FF}\u{1F1E6}-\u{1F1FF}\u{1F900}-\u{1F9FF}\u{1FA70}-\u{1FAFF}]+$/u;
            return emojiRegex.test(str.replace(/\s/g, ''));
        }
        function escapeHTML(str) { return str ? str.replace(/[&<>'"]/g, t => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[t] || t)) : ''; }
        function togglePanel(id) { const p = document.getElementById(id); p.style.display = p.style.display === 'block' ? 'none' : 'block'; }
        function toggleModal(id, show) { document.getElementById(id).style.display = show ? 'flex' : 'none'; }
        function cancelReply() { replyToId = null; document.getElementById('reply-preview').style.display = 'none'; }
        function toggleSendBtn(show) { document.getElementById('send-btn').style.display = show ? 'block' : 'none'; document.getElementById('in-actions').style.display = show ? 'none' : 'flex'; }
        function handleFileSelect(input) { if(input.files && input.files[0]) parseWhatsAppFile(input.files[0]); }
    </script>

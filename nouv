<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Instagram Direct Clone - Privé Pro</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-firestore-compat.js"></script>

    <style>
        :root {
            --bg-main: #ffffff;
            --text-main: #000000;
            --text-muted: #737373;
            --border-color: #dbdbdb;
            --bubble-received: #efefef;
            --bubble-sent: linear-gradient(45deg, #a800ff, #0076ff);
            --bubble-sent-text: #ffffff;
            --input-bg: #ffffff;
            --panel-bg: rgba(255, 255, 255, 0.95);
        }

        [data-theme="dark"] {
            --bg-main: #000000;
            --text-main: #f5f5f5;
            --text-muted: #a8a8a8;
            --border-color: #262626;
            --bubble-received: #262626;
            --input-bg: #121212;
            --panel-bg: rgba(20, 20, 20, 0.98);
        }

        /* Désactivation globale de la sélection de texte sauvage et des touch gestures */
        * { 
            margin: 0; padding: 0; box-sizing: border-box; 
            font-family: 'Inter', sans-serif; 
            touch-action: manipulation;
            -webkit-user-select: none;
            user-select: none;
        }
        
        /* Réautorisation sélective de saisie */
        input, textarea, .chat-input { -webkit-user-select: text; user-select: text; }

        body { background: #000; color: #fff; height: 100vh; display: flex; justify-content: center; align-items: center; overflow: hidden; }

        .app-container { 
            width: 100%; max-width: 450px; height: 100vh; 
            background: var(--bg-main); color: var(--text-main); 
            display: flex; flex-direction: column; position: relative; 
            border-left: 1px solid var(--border-color); border-right: 1px solid var(--border-color); 
            overflow: hidden;
        }
        @media(min-width: 800px) { .app-container { height: 92vh; border-radius: 12px; box-shadow: 0 12px 30px rgba(0,0,0,0.5); } }

        /* ARRIÈRE-PLAN ANIMÉ DE BASE */
        .messages-area { 
            flex: 1; overflow-y: auto; padding: 15px; 
            display: flex; flex-direction: column; gap: 10px; position: relative;
            background: linear-gradient(135deg, #0f172a, #1e1b4b, #2e1065, #3b0764);
            background-size: 400% 400%;
            animation: gradientBg 15s ease infinite;
            transition: filter 0.3s, background 0.3s;
        }

        /* Effet d'ondulation audio sur le conteneur complet */
        .messages-area.vocal-pulse {
            animation: gradientBg 2s ease infinite, vocalGlow 1s ease-in-out infinite alternate;
        }

        @keyframes gradientBg {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        @keyframes vocalGlow {
            0% { filter: hue-rotate(0deg) saturate(1); }
            100% { filter: hue-rotate(90deg) saturate(1.8); }
        }

        /* LOGINS */
        #login-screen { position: absolute; inset: 0; background: linear-gradient(135deg, #4f5bd5, #962fbf, #d62976, #feda75); display: flex; flex-direction: column; justify-content: center; align-items: center; z-index: 200; padding: 20px; text-align: center; }
        .login-card { background: rgba(255, 255, 255, 0.15); backdrop-filter: blur(10px); padding: 30px; border-radius: 20px; width: 100%; max-width: 350px; box-shadow: 0 8px 32px rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.2); }
        .login-card h2 { margin-bottom: 25px; color: #fff; font-weight: 600; display: flex; gap: 10px; justify-content: center; align-items: center; }
        .user-btn { display: flex; align-items: center; gap: 15px; width: 100%; padding: 15px; background: white; border: none; border-radius: 12px; margin-bottom: 15px; cursor: pointer; transition: transform 0.2s; text-align: left; }
        .user-btn:hover { transform: scale(1.03); }
        .user-btn .avatar { width: 45px; height: 45px; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-weight: bold; }
        .btn-ida .avatar { background: linear-gradient(45deg, #ff007f, #ff7300); }
        .btn-aidara .avatar { background: linear-gradient(45deg, #0076ff, #00ffaa); }
        .user-info-btn { display: flex; flex-direction: column; }
        .user-info-btn .name { font-weight: 600; color: #111; }
        .user-info-btn .tag { font-size: 0.85rem; color: #666; }

        /* HEADERS */
        .chat-header { height: 60px; border-bottom: 1px solid var(--border-color); display: flex; align-items: center; justify-content: space-between; padding: 0 15px; background: var(--bg-main); z-index: 10; }
        .header-left { display: flex; align-items: center; gap: 15px; cursor: pointer; }
        .header-avatar { width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-weight: 600; }
        .header-info .h-name { font-weight: 600; font-size: 0.95rem; }
        .header-info .h-status { font-size: 0.75rem; font-weight: bold; transition: color 0.3s; }
        .status-online { color: #22c55e !important; }
        .status-offline { color: #ef4444 !important; }
        .header-actions { display: flex; gap: 18px; font-size: 1.2rem; cursor: pointer; color: var(--text-main); }

        /* FILLES DE MESSAGES & BULLLES */
        .message-row { display: flex; width: 100%; margin-bottom: 4px; position: relative; }
        .message-row.sent { justify-content: flex-end; }
        .message-row.received { justify-content: flex-start; }
        
        .message-bubble { 
            max-width: 70%; padding: 10px 16px; border-radius: 22px; font-size: 0.95rem; 
            line-height: 1.4; position: relative; display: flex; flex-direction: column; gap: 4px; 
            box-shadow: 0 2px 5px rgba(0,0,0,0.05); transition: filter 0.2s;
        }
        .sent .message-bubble { background: var(--bubble-sent); color: var(--bubble-sent-text); border-bottom-right-radius: 4px; }
        .received .message-bubble { background: var(--bubble-received); color: var(--text-main); border-bottom-left-radius: 4px; }
        
        /* Option Floutée Spécifique */
        .blur-active .message-bubble { filter: blur(8px); cursor: pointer; }
        .blur-active .message-bubble:active { filter: blur(0px); }

        .msg-meta { font-size: 0.7rem; opacity: 0.7; align-self: flex-end; display: flex; align-items: center; gap: 4px; padding-right: 12px; }
        .sent .msg-meta { color: #fff; }
        .received .msg-meta { color: var(--text-muted); }
        .status-tick { color: #0095f6; font-weight: bold; }

        /* 3. REACTION DECALEES SANS CACHER L'HEURE */
        .applied-reactions { 
            display: flex; gap: 2px; position: absolute; 
            bottom: -8px; right: -8px; 
            background: var(--panel-bg); border: 1px solid var(--border-color); 
            padding: 2px 5px; border-radius: 12px; font-size: 0.75rem; z-index: 5;
        }

        /* CONTEXT ACTION PANEL (2. Long-clic au lieu de double clic pour actions complètes) */
        .context-action-panel {
            display: none; position: fixed; bottom: 0; left: 0; right: 0;
            background: var(--panel-bg); backdrop-filter: blur(20px);
            border-top-left-radius: 20px; border-top-right-radius: 20px;
            padding: 20px; z-index: 500; box-shadow: 0 -5px 25px rgba(0,0,0,0.2);
            animation: slideUp 0.25s cubic-bezier(0.1, 1, 0.1, 1);
        }
        .action-row-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 15px; text-align: center; }
        .action-item-btn { display: flex; flex-direction: column; align-items: center; gap: 8px; color: var(--text-main); cursor: pointer; font-size: 0.85rem; }
        .action-item-btn i { width: 45px; height: 45px; background: rgba(168,0,255,0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; }

        /* LIVE PREVIEW BANNER (Saisie Volatile) */
        .live-volatile-indicator { font-size: 0.75rem; font-style: italic; color: #a800ff; padding: 2px 15px; display: none; }

        /* 3D EMOTION SWIPE CANVAS & FLOATING OVERLAYS */
        .swipe-zone-overlay { position: absolute; inset: 0; z-index: 100; pointer-events: none; overflow: hidden; }
        .swiped-projectile { position: absolute; font-size: 4rem; animation: projectileMove 1.2s cubic-bezier(0.25, 1, 0.5, 1) forwards; pointer-events: none; }
        
        @keyframes projectileMove {
            0% { bottom: 20px; left: 50%; transform: translateX(-50%) scale(1); opacity: 1; }
            100% { bottom: 110vh; left: 50%; transform: translateX(-50%) scale(0.2); opacity: 0; }
        }

        .incoming-float-emoji { position: absolute; font-size: 4rem; animation: floatUpIncoming 2.5s ease-out forwards; pointer-events: none; }
        @keyframes floatUpIncoming {
            0% { bottom: -70px; left: 30%; transform: scale(0.5); opacity: 0; }
            20% { opacity: 1; transform: scale(1.2); }
            100% { bottom: 70vh; left: 70%; transform: scale(0.8); opacity: 0; }
        }

        /* REPLIES, PANELS, INPUTS */
        .chat-input-bar { padding: 12px; background: var(--bg-main); border-top: 1px solid var(--border-color); display: flex; flex-direction: column; gap: 8px; position: relative; }
        .input-box-container { display: flex; align-items: center; background: var(--input-bg); border: 1px solid var(--border-color); border-radius: 25px; padding: 4px 12px; }
        .chat-input { flex: 1; background: transparent; border: none; padding: 8px; font-size: 0.95rem; color: var(--text-main); outline: none; }
        .input-actions { display: flex; align-items: center; gap: 14px; font-size: 1.15rem; color: var(--text-main); }
        #send-btn { color: #0095f6; font-weight: 600; font-size: 0.95rem; cursor: pointer; display: none; }

        .floating-panel { display: none; position: absolute; bottom: 70px; left: 15px; right: 15px; background: var(--panel-bg); backdrop-filter: blur(15px); border: 1px solid var(--border-color); border-radius: 15px; padding: 15px; z-index: 50; }
        
        /* 7. PAGES INDÉPENDANTES (INFO & ANALYSE) */
        .fullscreen-overlay-page { 
            display: none; position: absolute; inset: 0; 
            background: var(--bg-main); color: var(--text-main); 
            z-index: 800; padding: 25px; overflow-y: auto;
            animation: slideInLeft 0.3s cubic-bezier(0.1, 1, 0.1, 1);
        }
        .close-page-btn { display: flex; align-items: center; gap: 10px; font-weight: bold; margin-bottom: 25px; cursor: pointer; }
        .analysis-stat-card { background: rgba(168,0,255,0.06); border: 1px solid var(--border-color); padding: 15px; border-radius: 12px; margin-bottom: 12px; }

        /* Reste des animations minimales */
        @keyframes slideUp { from { transform: translateY(100%); } to { transform: translateY(0); } }
        @keyframes slideInLeft { from { transform: translateX(100%); } to { transform: translateX(0); } }
        .giant-emoji { font-size: 3.5rem; background: none !important; }
        .date-separator { text-align: center; font-size: 0.75rem; color: var(--text-muted); margin: 15px 0; }
        .ephemeral-overlay { display: none; position: absolute; inset: 60px 0 70px 0; background: rgba(150,47,191,0.05); pointer-events: none; z-index: 1; align-items: center; justify-content: center; }
        .ephemeral-overlay span { background: #962fbf; color: #fff; padding: 4px 12px; border-radius: 12px; font-size: 0.75rem; }
    </style>
</head>
<body>

    <div class="app-container" id="main-app">
        
        <div class="swipe-zone-overlay" id="swipe-canvas-container"></div>

        <div id="login-screen">
            <div class="login-card">
                <h2><i class="fab fa-instagram"></i> Espace Privé</h2>
                <button class="user-btn btn-ida" onclick="selectUser('ida')">
                    <div class="avatar">IDA</div>
                    <div class="user-info-btn">
                        <span class="name">Ida Diallo</span>

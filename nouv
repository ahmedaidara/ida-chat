            </div>
        </div>

        <div class="chat-header">
            <div class="header-left" onclick="openProfilePage()">
                <div class="header-avatar" id="header-av">--</div>
                <div class="header-info">
                    <div class="h-name" id="header-display-name">Chargement...</div>

                <i class="fa-solid fa-chart-pie" title="Analyse Data" onclick="openAnalysisPage()"></i>
                <i class="fa-solid fa-folder-plus" title="Import WhatsApp" onclick="toggleModal('import-modal', true)"></i>
                <i class="fa-solid fa-sliders" title="Outils Secrets" onclick="togglePanel('settings-panel')"></i>
            </div>
        </div>

        <div class="live-volatile-indicator" id="live-volatile-banner"></div>

        <div class="messages-area" id="msg-area"></div>

        <div class="ephemeral-overlay" id="eph-overlay"><span>MODE ÉPHÉMÈRE</span></div>


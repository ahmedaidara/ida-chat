        </div>

        <div class="floating-panel" id="settings-panel">
            <div class="settings-grid">
                <div>
                    <h4 style="font-size:0.8rem; margin-bottom:6px;">Options Expérimentales Interactives</h4>
                    <label style="display:flex; align-items:center; gap:8px; font-size:0.8rem; margin-bottom:8px;">
                        <input type="checkbox" id="chk-volatile" onchange="toggleVolatileMode(this)"> Mode Saisie Volatile (Lettres en direct)
                    </label>
                    <label style="display:flex; align-items:center; gap:8px; font-size:0.8rem;">
                        <input type="checkbox" id="chk-blur" onchange="toggleBlurMode(this)"> Mode Flou Protecteur (Maintenir pour lire)
                    </label>
                </div>
                <hr style="border:0; border-top:1px solid var(--border-color); margin:8px 0;">
                <div>
                    <h4 style="font-size:0.8rem; margin-bottom:6px;">Personnaliser le fond</h4>
                    <button style="padding:5px 10px; font-size:0.75rem; border:1px solid var(--border-color); border-radius:6px; cursor:pointer;" onclick="document.getElementById('bg-user-file').click()">Importer mon image</button>
                </div>
            </div>
        </div>

        <div class="context-action-panel" id="custom-action-sheet">
            <div class="action-row-grid">
                <div class="action-item-btn" onclick="execActionSheet('reply')"><i class="fa-solid fa-reply"></i>Répondre</div>
                <div class="action-item-btn" onclick="execActionSheet('pin')"><i class="fa-solid fa-thumbtack"></i>Épingler</div>
                <div class="action-item-btn" onclick="execActionSheet('edit')"><i class="fa-solid fa-pen"></i>Modifier</div>
                <div class="action-item-btn" style="color:#ef4444;" onclick="execActionSheet('delete')"><i class="fa-solid fa-trash"></i>Supprimer</div>

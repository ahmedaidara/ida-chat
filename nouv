                    <i class="fa-regular fa-image" onclick="triggerCustomBgUpload()"></i>
                </div>
                <span id="send-btn" onclick="sendTextMessage()">Envoyer</span>
            </div>
            <input type="file" id="bg-user-file" accept="image/*" style="display:none;" onchange="applyCustomUserBg(this)">
        </div>

        <div class="floating-panel" id="emoji-panel">
            <p style="font-size:0.7rem; color:var(--text-muted); margin-bottom:8px; text-align:center;">Swipe vers le haut (Entrée après l'émoji) pour le propulser chez l'autre !</p>
            <div class="emoji-grid">
                <span onclick="insertEmojiDirect('💍')">💍</span>
                <span onclick="insertEmojiDirect('❤️')">❤️</span>
                <span onclick="insertEmojiDirect('🔥')">🔥</span>
                <span onclick="insertEmojiDirect('🎈')">🎈</span>
                <span onclick="insertEmojiDirect('😂')">😂</span>
                <span onclick="insertEmojiDirect('👍')">👍</span>

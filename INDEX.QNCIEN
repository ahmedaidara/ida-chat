// ========== NOTIFICATION PUSH DANS L'APP ==========
async function notifierDansApp(expediteurNom) {
    if (!("Notification" in window)) return;
    
    if (Notification.permission === "granted") {
        let corps = `${expediteurNom} vous a envoy茅 un message. Ouvrez l'application pour le lire.`;
        new Notification(`馃摡 Nouveau message de ${expediteurNom}`, {
            body: corps,
            icon: "https://i.postimg.cc/J400K7Sd/new-Notification.png",
            vibrate: [200, 100, 200],
            silent: false
        });
        console.log("鉁? Notification push affich茅e");
    }
}


    if (code === "0507") {
        // Cr茅er l'overlay pour l'iframe
        const overlay = document.createElement('div');
        overlay.id = 'secret-overlay';
        overlay.style.cssText = `
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.85);
            backdrop-filter: blur(20px);
            z-index: 99999;
            display: flex;
            flex-direction: column;
            animation: fadeInOverlay 0.3s ease;
        `;
        
        // Header de l'iframe
        const header = document.createElement('div');
        header.style.cssText = `
            background: linear-gradient(135deg, #1a0a2e, #2d1b69);
            padding: 12px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 2px solid #a800ff;
            flex-shrink: 0;
        `;
        header.innerHTML = `
            <div style="display:flex; align-items:center; gap:12px;">
                <i class="fa-solid fa-lock" style="color:#ffd700; font-size:1.2rem;"></i>
                <span style="color:white; font-weight:700; font-size:1rem;">馃摉 Carnet Secret</span>
                <span style="color:rgba(255,255,255,0.4); font-size:0.7rem;">馃敀 Priv茅</span>
            </div>
            <button onclick="closeSecretIframe()" style="
                background:rgba(255,255,255,0.1);
                border:none;
                color:white;
                padding:8px 16px;
                border-radius:20px;
                cursor:pointer;
                font-size:0.85rem;
                transition:all 0.3s;
            " onmouseover="this.style.background='rgba(255,0,0,0.3)'" onmouseout="this.style.background='rgba(255,255,255,0.1)'">
                <i class="fa-solid fa-xmark"></i> Fermer
            </button>
        `;
        
        // Iframe
        const iframe = document.createElement('iframe');
        iframe.id = 'secret-iframe';
        iframe.src = 'secret.html';
        iframe.style.cssText = `
            flex: 1;
            width: 100%;
            border: none;
            background: #0a0a0a;
        `;
        
        overlay.appendChild(header);
        overlay.appendChild(iframe);
        document.body.appendChild(overlay);
        
        // Emp锚cher le scroll
        document.body.style.overflow = 'hidden';
        
        // Ajouter l'animation
        const style = document.createElement('style');
        style.textContent = `
            @keyframes fadeInOverlay {
                from { opacity: 0; transform: scale(0.95); }
                to { opacity: 1; transform: scale(1); }
            }
        `;
        document.head.appendChild(style);
        
    } else {
        alert("鉂? Code incorrect !");
    }
}

// Fermer l'iframe
function closeSecretIframe() {
    const overlay = document.getElementById('secret-overlay');
    if (overlay) {
        overlay.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
        overlay.style.opacity = '0';
        overlay.style.transform = 'scale(0.95)';
        setTimeout(() => {
            overlay.remove();
            document.body.style.overflow = '';
        }, 300);
    }
}


let unsubProfilMoi = null;
let unsubProfilAutre = null;

function avatarGradientPour(id) {
    return id === 'ida' ? 'linear-gradient(45deg, #0076ff, #00ffaa)' : 'linear-gradient(45deg, #ff007f, #ff7300)';
}

function updateSettingsInfo() {
    if (currentUser) {
        const avMoi = document.getElementById('settings-avatar-moi');
        avMoi.innerText = currentUser.name.substring(0, 2);
        avMoi.style.background = avatarGradientPour(currentUser.id);
        document.getElementById('settings-name-moi').innerText = currentUser.name;
        document.getElementById('settings-username-moi').innerText = '@' + currentUser.full.toLowerCase();
    }
    if (targetUser) {
        const avAutre = document.getElementById('settings-avatar-autre');
        avAutre.innerText = targetUser.name.substring(0, 2);
        avAutre.style.background = avatarGradientPour(targetUser.id);
        document.getElementById('settings-name-autre').innerText = targetUser.name;
        document.getElementById('settings-username-autre').innerText = '@' + targetUser.full.toLowerCase();
    }

    // Charger les infos de CHACUN depuis Firestore (users/{id}.profile)
    if (unsubProfilMoi) { unsubProfilMoi(); unsubProfilMoi = null; }
    if (unsubProfilAutre) { unsubProfilAutre(); unsubProfilAutre = null; }

    if (currentUser) {
        unsubProfilMoi = db.collection('users').doc(currentUser.id).onSnapshot((doc) => {
            const profile = (doc.exists && doc.data().profile) ? doc.data().profile : {};
            document.getElementById('birthdate-moi').innerText = profile.birthdate || '鈥?';
            document.getElementById('email-moi').innerText = profile.email || 'non renseign茅';
            document.getElementById('location-moi').innerText = profile.location || '鈥?';
        });
    }
    if (targetUser) {
        unsubProfilAutre = db.collection('users').doc(targetUser.id).onSnapshot((doc) => {
            const profile = (doc.exists && doc.data().profile) ? doc.data().profile : {};
            document.getElementById('birthdate-autre').innerText = profile.birthdate || '鈥?';
            document.getElementById('email-autre').innerText = profile.email || 'non renseign茅';
            document.getElementById('location-autre').innerText = profile.location || '鈥?';
            if (profile.memberSince) document.getElementById('member-since').innerText = profile.memberSince;
        });
    }
}

 function initSettingsBubbles() {
    const savedColor = localStorage.getItem('bubbleColor') || 'linear-gradient(45deg, #a800ff, #0076ff)';
    document.querySelectorAll('.color-option-bubble').forEach(opt => {
        if (opt.style.background === savedColor || opt.getAttribute('data-color') === savedColor) {
            opt.classList.add('active');
        }
        opt.onclick = function() {
            const color = this.getAttribute('data-color') || this.style.background;
            document.documentElement.style.setProperty('--bubble-sent', color);
            localStorage.setItem('bubbleColor', color);
            document.querySelectorAll('.color-option-bubble').forEach(o => o.classList.remove('active'));
            this.classList.add('active');
        };
    });
    
    initBgOptions();
    initCallBgOptions();
    verifierStatutsPermissions();
    loadDefaultAccentColor();
    loadApparence();
    loadTailleTexte();
}

 function appliquerFondEcran(bg) {
    const app = document.querySelector('.app-container');
    if (!app) return;
    
    if (!bg || bg === 'none') {
        app.style.background = 'var(--bg-main)';
    } else if (bg.startsWith('gradient:')) {
        app.style.background = bg.slice('gradient:'.length);
        app.style.backgroundSize = 'cover';
    } else {
        app.style.background = `url('${bg}') center/cover no-repeat fixed`;
    }
    
    // La zone de messages prend le m锚me fond
    const msgArea = document.getElementById('msg-area');
    if (msgArea) {
        msgArea.style.background = 'transparent';
    }
    
    localStorage.setItem('chat_background', bg || 'none');
}

// Marque visuellement la bonne vignette comme active (data-bg correspondant)
function marquerFondActif(bg) {
    document.querySelectorAll('.bg-option[data-bg]').forEach(o => {
        o.classList.toggle('active', o.getAttribute('data-bg') === bg);
    });
}

function selectionnerFond(optionEl) {
    const bg = optionEl.getAttribute('data-bg');
    appliquerFondEcran(bg);
    marquerFondActif(bg);
}

// Recr茅e une vignette de fond personnalis茅 (image upload茅e par l'utilisateur), avec un bouton pour la supprimer
function creerVignetteFondPerso(dataUrl) {
    const opt = document.createElement('div');
    opt.className = 'bg-option';
    opt.setAttribute('data-custom', 'true');
    opt.style.backgroundImage = `url('${dataUrl}')`;
    opt.setAttribute('data-bg', dataUrl);
    opt.title = 'Ton image';

    const removeBtn = document.createElement('div');
    removeBtn.className = 'bg-option-remove';
    removeBtn.innerHTML = '<i class="fa-solid fa-xmark"></i>';
    removeBtn.onclick = function(e) {
        e.stopPropagation();
        supprimerFondPerso(dataUrl, opt);
    };
    opt.appendChild(removeBtn);

    opt.addEventListener('click', function(e) {
        if (e.target.closest('.bg-option-remove')) return;
        selectionnerFond(opt);
    });

    return opt;
}

function supprimerFondPerso(dataUrl, opt) {
    let fonds = JSON.parse(localStorage.getItem('custom_backgrounds') || '[]');
    fonds = fonds.filter(f => f !== dataUrl);
    localStorage.setItem('custom_backgrounds', JSON.stringify(fonds));
    opt.remove();
    // Si c'茅tait le fond actif, on revient au fond par d茅faut
    if (localStorage.getItem('chat_background') === dataUrl) {
        appliquerFondEcran('none');
        marquerFondActif('none');
    }
}

// Redimensionne/compresse l'image choisie avant de la stocker (茅vite de saturer le localStorage)
function redimensionnerImage(file, maxLargeur, callback) {
    const reader = new FileReader();
    reader.onload = function(e) {
        const img = new Image();
        img.onload = function() {
            const ratio = Math.min(1, maxLargeur / img.width);
            const canvas = document.createElement('canvas');
            canvas.width = img.width * ratio;
            canvas.height = img.height * ratio;
            const ctx = canvas.getContext('2d');
            ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
            callback(canvas.toDataURL('image/jpeg', 0.75));
        };
        img.src = e.target.result;
    };
    reader.readAsDataURL(file);
}

function initBgOptions() {
    // Vignettes pr茅d茅finies (couleurs, d茅grad茅s, photos) : on n'attache l'茅couteur
    // qu'une seule fois par vignette, m锚me si les param猫tres sont r茅ouverts plusieurs fois.
    document.querySelectorAll('.bg-option[data-bg]').forEach(opt => {
        if (opt.dataset.bound === 'true') return;
        opt.dataset.bound = 'true';
        opt.addEventListener('click', () => selectionnerFond(opt));
    });

    // Retirer d'茅ventuelles vignettes personnalis茅es d茅j脿 ins茅r茅es (cas d'une r茅ouverture
    // des param猫tres) avant de les recharger depuis le localStorage, pour 茅viter les doublons.
    const bgOptionsContainer = document.getElementById('bg-options');
    const addTile = document.getElementById('bg-option-add');
    bgOptionsContainer.querySelectorAll('.bg-option[data-custom="true"]').forEach(el => el.remove());

    // Charge les fonds personnalis茅s d茅j脿 ajout茅s pr茅c茅demment
    const fondsPersos = JSON.parse(localStorage.getItem('custom_backgrounds') || '[]');
    fondsPersos.forEach(dataUrl => {
        const vignette = creerVignetteFondPerso(dataUrl);
        bgOptionsContainer.insertBefore(vignette, addTile);
    });

    // Tuile "+" : ouvre le s茅lecteur de fichier (茅couteur attach茅 une seule fois)
    if (addTile && addTile.dataset.bound !== 'true') {
        addTile.dataset.bound = 'true';
        addTile.addEventListener('click', () => {
            document.getElementById('bg-upload-input').click();
        });
    }

    // Gestion de l'upload d'une image personnalis茅e (茅couteur attach茅 une seule fois)
    const uploadInput = document.getElementById('bg-upload-input');
    if (uploadInput && uploadInput.dataset.bound !== 'true') {
        uploadInput.dataset.bound = 'true';
        uploadInput.addEventListener('change', function() {
            const file = this.files && this.files[0];
            if (!file) return;
            if (!file.type.startsWith('image/')) {
                showTempNotification("鉂? Choisis un fichier image");
                return;
            }
            redimensionnerImage(file, 1080, (dataUrl) => {
                // Sauvegarder dans la liste des fonds personnalis茅s
                const fonds = JSON.parse(localStorage.getItem('custom_backgrounds') || '[]');
                fonds.push(dataUrl);
                localStorage.setItem('custom_backgrounds', JSON.stringify(fonds));

                // Ajouter la vignette juste avant le bouton "+"
                const container = document.getElementById('bg-options');
                const tile = document.getElementById('bg-option-add');
                const vignette = creerVignetteFondPerso(dataUrl);
                container.insertBefore(vignette, tile);

                // Appliquer imm茅diatement comme fond d'茅cran
                appliquerFondEcran(dataUrl);
                marquerFondActif(dataUrl);
                showTempNotification("馃柤锔? Image ajout茅e en fond d'茅cran");
            });
            uploadInput.value = '';
        });
    }

    // Restaurer le fond d'茅cran sauvegard茅 au chargement de la page
    const fondSauvegarde = localStorage.getItem('chat_background');
    if (fondSauvegarde) {
        appliquerFondEcran(fondSauvegarde);
        marquerFondActif(fondSauvegarde);
    } else {
        marquerFondActif('none');
    }
}


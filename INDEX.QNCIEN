        }).catch(err => console.error('Erreur envoi signal coeurs:', err));
    }
    return;
}
     
    let finalText = text;
    let isCoded = codeModeActive;
    if (codeModeActive) {
        finalText = generateMask(text.length);
        codeModeActive = false;
        const codeBtn = document.getElementById('code-mode-btn');

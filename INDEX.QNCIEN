function saveDefaultBubbleStyle() {
    const select = document.getElementById('default-bubble-style');
    const selectedStyle = select.value;
    localStorage.setItem('default_bubble_style', selectedStyle);
    // Choisir un style de bulle d茅sactive la couleur d'accent : les deux sont deux fa莽ons
    // alternatives de r茅gler le m锚me d茅faut, elles ne doivent jamais 锚tre actives ensemble.
    localStorage.setItem('default_accent_color', 'none');
    marquerAccentActif('none');
    
    // Met 脿 jour IMM脡DIATEMENT tous les messages sans style perso
    updateAllMessagesDefaultStyle();
    
    showTempNotification("鉁? Style par d茅faut appliqu茅");
 }

// ========== COULEUR D'ACCENT PAR D脡FAUT (alternative 脿 un style de bulle complet) ==========
function choisirCouleurAccent(color) {
    localStorage.setItem('default_accent_color', color);
    // Mutuellement exclusif avec le style de bulle par d茅faut (dropdown)
    localStorage.setItem('default_bubble_style', 'none');
    const select = document.getElementById('default-bubble-style');
    if (select) select.value = 'none';
    marquerAccentActif(color);
    updateAllMessagesDefaultStyle();
    showTempNotification("鉁? Couleur d'accent appliqu茅e");
}

function marquerAccentActif(color) {
    document.querySelectorAll('.accent-color-dot').forEach(dot => {
        dot.classList.toggle('active', dot.getAttribute('data-color') === color);
    });
}

function loadDefaultAccentColor() {
    const saved = localStorage.getItem('default_accent_color');
    marquerAccentActif(saved && saved !== 'none' ? saved : null);
}
setTimeout(loadDefaultAccentColor, 200);

// Met 脿 jour tous les messages qui n'ont PAS de style personnalis茅
function updateAllMessagesDefaultStyle() {
    const defaultStyle = localStorage.getItem('default_bubble_style');
    const defaultAccent = localStorage.getItem('default_accent_color');
    
    document.querySelectorAll('.message-row.sent').forEach(row => {
        const bubble = row.querySelector('.message-bubble');
        if (!bubble) return;
        
        // V茅rifie si ce message a un style personnalis茅 en base de donn茅es
        const msgId = row.getAttribute('data-id');
        if (!msgId) return;
        
        // On v茅rifie dans Firestore si ce message a un bubbleStyle ou une couleur perso
        db.collection('chats').doc(CHAT_ID).collection('messages').doc(msgId).get().then(doc => {
            if (doc.exists) {
                const data = doc.data();
                // Si le message a un style/couleur perso, on ne touche pas
                if (data.bubbleStyle || data.customColor || data.customGradient) return;
                
                const allStyles = ['bicolor','dark-passion','grid-style','rainbow','neon','wood','code-style','comics','watercolor','retro','glassmorphism','crystal','sunset','ocean','forest','midnight','rose','gold','galaxy','cyberpunk','handwritten'];
                allStyles.forEach(style => bubble.classList.remove(style));

                if (defaultAccent && defaultAccent !== 'none') {
                    // Couleur d'accent unie par d茅faut
                    bubble.style.setProperty('background', defaultAccent, 'important');
                    bubble.style.setProperty('color', getContrastColor(defaultAccent), 'important');
                } else if (defaultStyle && defaultStyle !== 'none') {
                    bubble.style.background = '';
                    bubble.style.color = '';
                    bubble.classList.add(defaultStyle);
                } else {
                    // Style par d茅faut Instagram (aucune classe, aucune couleur)
                    bubble.style.background = '';
                    bubble.style.color = '';
                }
            }
        });
    });
}

// Charger le style par d茅faut sauvegard茅

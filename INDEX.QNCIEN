// ========== MENU MEDIA ==========
function ouvrirMenuMedia() {
    const mediaPanel = document.getElementById('media-panel');
    if (mediaPanel) mediaPanel.style.display = 'block';
    const toolsPanel = document.getElementById('tools-panel');
    if (toolsPanel) toolsPanel.style.display = 'none';
    const audioPanel = document.getElementById('audio-panel');
    if (audioPanel) audioPanel.style.display = 'none';
}

function fermerMenuMedia() {
    const mediaPanel = document.getElementById('media-panel');
    if (mediaPanel) mediaPanel.style.display = 'none';
}

// Fermer TOUS les menus quand on clique ailleurs
// 鈿狅笍 On utilise composedPath() plut么t que .contains(e.target) : certains boutons
// (ex. play/pause du vocal) remplacent leur innerHTML au clic, ce qui d茅tache
// e.target du DOM avant que ce listener (bubbling) ne s'ex茅cute. Avec .contains(),
// un noeud d茅tach茅 n'est "contenu" par rien => le panneau se fermait 脿 tort et
// r茅initialisait (donc effa莽ait) l'enregistrement vocal en cours. composedPath()
// capture le chemin AVANT toute mutation du DOM, donc reste fiable.
document.addEventListener('click', function(e) {
    const chemin = typeof e.composedPath === 'function' ? e.composedPath() : [e.target];
    const estDans = (el) => !!el && chemin.includes(el);

    const mediaPanel = document.getElementById('media-panel');
    const audioPanel = document.getElementById('audio-panel');
    const toolsPanel = document.getElementById('tools-panel');
    const positionPanel = document.getElementById('position-panel');
    const toolsBtn = document.getElementById('tools-menu-btn');
    const mediaBtn = document.getElementById('media-btn');
    const audioBtn = document.getElementById('audio-btn');

    if (mediaPanel && !estDans(mediaPanel) && !estDans(mediaBtn)) {
        mediaPanel.style.display = 'none';
    }
    if (audioPanel && !estDans(audioPanel) && !estDans(audioBtn)) {
        audioPanel.style.display = 'none';
    }
    if (toolsPanel && !estDans(toolsPanel) && !estDans(toolsBtn)) {
        toolsPanel.style.display = 'none';
    }
    if (positionPanel && !estDans(positionPanel) && chemin.every(el => !el || el.getAttribute?.('onclick') !== 'ouvrirMenuPosition()')) {
        positionPanel.style.display = 'none';
    }
});

function ouvrirGalerie() {
    fermerMenuMedia();
    triggerImageUpload();
}

function prendrePhoto() {
    fermerMenuMedia();
    const input = document.createElement('input');
    input.type = 'file';
    input.accept = 'image/*';
    input.capture = 'environment';
    input.onchange = (e) => {
        if (e.target.files && e.target.files[0]) {
            const reader = new FileReader();
            reader.onload = event => sendMediaMessage('image', event.target.result);
            reader.readAsDataURL(e.target.files[0]);
        }
    };
    input.click();
}

function prendreVideo() {
    fermerMenuMedia();
    const input = document.createElement('input');
    input.type = 'file';
    input.accept = 'video/*';
    input.capture = 'environment';
    input.onchange = (e) => {
        if (e.target.files && e.target.files[0]) {
            const reader = new FileReader();
            reader.onload = event => sendMediaMessage('video', event.target.result);
            reader.readAsDataURL(e.target.files[0]);
        }
    };
    input.click();
}

// ========== 馃敟 FLAMME (item 4) 鈥? remplace l'ancien outil "Effets/Filtre" jamais
// termin茅. Ouvre directement l'appareil photo/vid茅o natif ; le m茅dia est envoy茅 en
// vue unique avec un design "flamme" distinctif (ic么ne flamme + couleur al茅atoire
// diff茅rente 脿 chaque envoi), au lieu d'une bulle de chat classique. ==========
const FLAMME_COULEURS = ['#ff5722', '#e91e63', '#9c27b0', '#3f51b5', '#00bcd6', '#4caf50', '#ff9800', '#795548', '#ff3b30', '#a800ff'];
function ouvrirFlamme() {
    const input = document.createElement('input');
    input.type = 'file';
    // "image/*,video/*" + capture=environment : sur mobile, la cam茅ra native
    // s'ouvre et laisse l'utilisateur choisir lui-m锚me photo ou vid茅o.
    input.accept = 'image/*,video/*';
    input.capture = 'environment';
    input.style.cssText = 'position:fixed; top:-9999px; left:-9999px; opacity:0; width:1px; height:1px;';
    document.body.appendChild(input);
    input.onchange = (e) => {
        const fichier = e.target.files && e.target.files[0];
        if (fichier) {
            const type = fichier.type.startsWith('video/') ? 'video' : 'image';
            const tailleMax = type === 'video' ? 50 * 1024 * 1024 : 15 * 1024 * 1024;
            if (fichier.size > tailleMax) {
                showTempNotification(type === 'video' ? "鉂? Vid茅o trop grande (max 50 MB)" : "鉂? Photo trop grande (max 15 MB)");
            } else {
                const couleur = FLAMME_COULEURS[Math.floor(Math.random() * FLAMME_COULEURS.length)];
                showTempNotification(type === 'video' ? "馃摛 Envoi de la vid茅o flamme..." : "馃摛 Envoi de la photo flamme...");
                (async () => {
                    // 鈿狅笍 Les photos brutes de l'appareil peuvent peser plusieurs Mo : on les
                    // redimensionne/compresse avant envoi (comme le fait d茅j脿 l'envoi photo
                    // classique via l'茅diteur), sinon l'upload est inutilement long.
                    // Les vid茅os ne sont pas compress茅es ici (traitement trop lourd c么t茅
                    // navigateur) : leur temps d'envoi reste proportionnel 脿 leur poids r茅el.
                    const fichierAEnvoyer = type === 'image'
                        ? await compresserImageAvantEnvoi(fichier)
                        : fichier;
                    sendMediaMessage(type, fichierAEnvoyer, null, true, couleur);
                })();
            }
        }
        input.remove();
    };
    input.click();
}

// ========== MENU AUDIO ==========
function ouvrirMenuAudio() {
    const audioPanel = document.getElementById('audio-panel');
    if (audioPanel) audioPanel.style.display = 'block';
    const toolsPanel = document.getElementById('tools-panel');
    if (toolsPanel) toolsPanel.style.display = 'none';
    const mediaPanel = document.getElementById('media-panel');
    if (mediaPanel) mediaPanel.style.display = 'none';
    reinitialiserAudioUI();
}

function fermerMenuAudio() {
    const audioPanel = document.getElementById('audio-panel');
    if (audioPanel) audioPanel.style.display = 'none';
    // Arr锚ter l'enregistrement si en cours
    if (mediaRecorderAudio && mediaRecorderAudio.state === 'recording') {
        mediaRecorderAudio.stop();
    }
    if (streamAudio) {
        streamAudio.getTracks().forEach(track => track.stop());
    }
    if (animationFrame) {
        cancelAnimationFrame(animationFrame);
        animationFrame = null;
    }
    reinitialiserAudioUI();
}

function reinitialiserAudioUI() {
    audioVueUnique = false;
    const vuBtn = document.getElementById('voice-viewonce-btn');
    if (vuBtn) vuBtn.classList.remove('active');
    audioChunksEnregistres = [];
    if (audioBlobOriginal) {
        URL.revokeObjectURL(URL.createObjectURL(audioBlobOriginal));
    }
    if (previewAudioURL) {
        URL.revokeObjectURL(previewAudioURL);
    }
    if (previewAudioPlayer) { previewAudioPlayer.pause(); previewAudioPlayer = null; }
    previewAudioPlayerBlob = null;
    audioBlobOriginal = null;
    audioBlobFiltre = null;
    previewAudioURL = null;
    
    const previewDiv = document.getElementById('audio-preview');
    if (previewDiv) previewDiv.style.display = 'none';
    
    const sendBtn = document.getElementById('send-audio-btn');
    if (sendBtn) sendBtn.disabled = true;
    
    const recordBtn = document.getElementById('record-audio-btn');
    if (recordBtn) {
        recordBtn.disabled = false;
        recordBtn.style.display = 'flex';
    }
    
    const stopBtn = document.getElementById('stop-audio-btn');
    if (stopBtn) {
        stopBtn.disabled = true;
        stopBtn.style.display = 'none';
    }

    const zone = document.getElementById('voice-record-zone');
    if (zone) zone.classList.remove('recording');
    const statut = document.getElementById('voice-record-status');
    if (statut) statut.innerText = 'Appuie sur le micro pour enregistrer';
    const timer = document.getElementById('voice-record-timer');
    if (timer) { timer.style.display = 'none'; timer.innerText = '00:00'; }
    arreterChronoVocal();
    
    const visualizer = document.getElementById('audio-visualizer');
    if (visualizer) visualizer.innerHTML = '';

    const transcriptZone = document.getElementById('voice-transcript-zone');
    if (transcriptZone) transcriptZone.style.display = 'none';
    const transcriptTexte = document.getElementById('voice-transcript-texte');
    if (transcriptTexte) transcriptTexte.textContent = '';
    transcriptionVocaleTexte = '';
}

function choisirFiltreAudio(filtre) {
    filtreAudioActif = filtre;
    document.querySelectorAll('.voice-filter-chip').forEach(btn => {
        btn.classList.toggle('active', btn.getAttribute('data-filter') === filtre);
    });
    
    if (audioBlobOriginal) {
        appliquerFiltreAudio();
    }
}

// Chrono d'enregistrement (affichage mm:ss pendant qu'on parle)
let voiceChronoInterval = null;
let voiceChronoSecondes = 0;
function demarrerChronoVocal() {
    arreterChronoVocal();
    voiceChronoSecondes = 0;
    const timer = document.getElementById('voice-record-timer');
    if (timer) { timer.style.display = 'block'; timer.innerText = '00:00'; }
    voiceChronoInterval = setInterval(() => {
        voiceChronoSecondes++;
        const m = String(Math.floor(voiceChronoSecondes / 60)).padStart(2, '0');
        const s = String(voiceChronoSecondes % 60).padStart(2, '0');
        if (timer) timer.innerText = `${m}:${s}`;
    }, 1000);
}
function arreterChronoVocal() {
    if (voiceChronoInterval) { clearInterval(voiceChronoInterval); voiceChronoInterval = null; }
    voiceChronoSecondes = 0;
}

async function demarrerEnregistrementAudio() {
    try {
        streamAudio = await navigator.mediaDevices.getUserMedia({ audio: true });
        
        // Cr茅er l'analyseur pour la visualisation
        const audioContext = new (window.AudioContext || window.webkitAudioContext)();
        // 鈿狅笍 CORRECTIF IMPORTANT : sur mobile, un AudioContext d茅marre parfois
        // "suspendu" (茅tat 'suspended') tant qu'il n'a pas 茅t茅 explicitement repris.
        // C'est exactement ce qui faisait que la barre ne bougeait pas pendant qu'on
        // parlait (l'analyseur ne recevait aucune donn茅e avant la reprise implicite).
        if (audioContext.state === 'suspended') {
            await audioContext.resume();
        }
        analyseurAudio = audioContext.createAnalyser();
        sourceAudio = audioContext.createMediaStreamSource(streamAudio);
        sourceAudio.connect(analyseurAudio);
        analyseurAudio.fftSize = 256;
        analyseurAudio.smoothingTimeConstant = 0.6;
        
        mediaRecorderAudio = new MediaRecorder(streamAudio);
        audioChunksEnregistres = [];
        
        mediaRecorderAudio.ondataavailable = (event) => {
            if (event.data.size > 0) {
                audioChunksEnregistres.push(event.data);
            }
        };
        
        mediaRecorderAudio.onstop = async () => {
            const audioBlob = new Blob(audioChunksEnregistres, { type: 'audio/webm' });
            audioBlobOriginal = audioBlob;
            await appliquerFiltreAudio();
            
            const duration = await getAudioDuration(audioBlob);
            const durationSpan = document.getElementById('audio-duration');
            if (durationSpan) durationSpan.innerText = `${duration} sec`;
            
            const previewDiv = document.getElementById('audio-preview');
            if (previewDiv) previewDiv.style.display = 'flex';
            
            const sendBtn = document.getElementById('send-audio-btn');
            if (sendBtn) sendBtn.disabled = false;

            const zone = document.getElementById('voice-record-zone');
            if (zone) zone.classList.remove('recording');
            const statut = document.getElementById('voice-record-status');
            if (statut) statut.innerText = 'Enregistrement termin茅';
            arreterChronoVocal();
            const visualizer = document.getElementById('audio-visualizer');
            if (visualizer) visualizer.innerHTML = '';
            
            // Arr锚ter l'analyseur
            if (animationFrame) cancelAnimationFrame(animationFrame);
            if (analyseurAudio) analyseurAudio.disconnect();
            if (sourceAudio) sourceAudio.disconnect();
            if (audioContext) audioContext.close();
        };
        
        mediaRecorderAudio.start(100); // Capturer toutes les 100ms
        
        const recordBtn = document.getElementById('record-audio-btn');
        if (recordBtn) {
            recordBtn.disabled = true;
            recordBtn.style.display = 'none';
        }
        
        const stopBtn = document.getElementById('stop-audio-btn');
        if (stopBtn) {
            stopBtn.disabled = false;
            stopBtn.style.display = 'flex';
        }

        const zone = document.getElementById('voice-record-zone');
        if (zone) zone.classList.add('recording');
        const statut = document.getElementById('voice-record-status');
        if (statut) statut.innerText = 'Enregistrement en cours...';
        demarrerChronoVocal();
        
        // D茅marrer la visualisation en temps r茅el
        demarrerVisualisationReelle();
        // 馃摑 D茅marre la transcription automatique en parall猫le (best-effort, voir plus bas)
        demarrerTranscriptionVocale();
        
    } catch(err) {
        console.error("Erreur micro:", err);
        showTempNotification("鉂? Impossible d'acc茅der au microphone");
    }
}

function demarrerVisualisationReelle() {
    const visualizer = document.getElementById('audio-visualizer');
    if (!visualizer || !analyseurAudio) return;
    
    const bufferLength = analyseurAudio.frequencyBinCount;
    const dataArray = new Uint8Array(bufferLength);
    const NB_BARRES = 24;

    // Cr茅er les barres une seule fois (on ne fait ensuite que changer leur hauteur,
    // beaucoup plus fluide que tout reconstruire 脿 chaque frame).
    visualizer.innerHTML = '';
    const barres = [];
    for (let i = 0; i < NB_BARRES; i++) {
        const bar = document.createElement('div');
        bar.className = 'audio-wave-bar';
        bar.style.height = '5px';
        visualizer.appendChild(bar);
        barres.push(bar);
    }
    
    function animer() {
        if (!analyseurAudio || !visualizer) return;
        
        analyseurAudio.getByteFrequencyData(dataArray);
        
        for (let i = 0; i < NB_BARRES; i++) {
            const valeur = dataArray[i % bufferLength] || 0;
            const hauteur = Math.max(4, Math.min(40, (valeur / 255) * 40));
            barres[i].style.height = hauteur + 'px';
        }
        
        animationFrame = requestAnimationFrame(animer);
    }
    
    if (animationFrame) cancelAnimationFrame(animationFrame);
    animer();
}

function arreterEnregistrementAudio() {
    if (mediaRecorderAudio && mediaRecorderAudio.state === 'recording') {
        mediaRecorderAudio.stop();
        if (animationFrame) {
            cancelAnimationFrame(animationFrame);
            animationFrame = null;
        }
    }
    arreterTranscriptionVocale();
}

// ========== TRANSCRIPTION VOCALE AUTOMATIQUE (Web Speech API) ==========
// Fonctionne sur Chrome/Android et Safari 14.5+ (donc iPhone r茅cents aussi).
// Best-effort : si le navigateur ne supporte pas l'API, la zone reste simplement cach茅e
// et le message vocal continue de fonctionner normalement (rien n'est cass茅).
let reconnaissanceVocaleActive = null;
let transcriptionVocaleTexte = '';
let transcriptionVocaleTexteBrut = ''; // texte final accumul茅 sur tous les red茅marrages
let transcriptionVocaleEnCours = false; // reste true tant que l'enregistrement tourne, sert 脿 savoir si on doit relancer
let transcriptionModifieeManuellement = false;

function demarrerTranscriptionVocale() {
    transcriptionVocaleTexte = '';
    transcriptionVocaleTexteBrut = '';
    transcriptionModifieeManuellement = false;
    transcriptionVocaleEnCours = true;
    const zone = document.getElementById('voice-transcript-zone');
    const texteEl = document.getElementById('voice-transcript-texte');
    if (texteEl) texteEl.setAttribute('contenteditable', 'false');

    // La transcription requiert un contexte s茅curis茅 (https ou localhost) : sur http,
    // window.SpeechRecognition existe parfois mais .start() 茅choue silencieusement.
    const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
    if (!SR || (window.isSecureContext === false)) {
        if (zone) zone.style.display = 'none';
        return;
    }
    lancerReconnaissanceVocale(SR, zone, texteEl);
}

function lancerReconnaissanceVocale(SR, zone, texteEl) {
    try {
        reconnaissanceVocaleActive = new SR();
        reconnaissanceVocaleActive.lang = 'fr-FR';
        reconnaissanceVocaleActive.continuous = true;
        reconnaissanceVocaleActive.interimResults = true;
        reconnaissanceVocaleActive.onresult = (event) => {
            let texteFinalSession = '', texteProvisoire = '';
            for (let i = 0; i < event.results.length; i++) {
                if (event.results[i].isFinal) texteFinalSession += event.results[i][0].transcript;
                else texteProvisoire += event.results[i][0].transcript;
            }
            const texteComplet = (transcriptionVocaleTexteBrut + ' ' + texteFinalSession).trim();
            if (!transcriptionModifieeManuellement) {
                transcriptionVocaleTexte = texteComplet;
                if (texteEl) texteEl.textContent = (texteComplet + ' ' + texteProvisoire).trim() || '...';
            }
            if (zone) zone.style.display = 'block';
        };
        reconnaissanceVocaleActive.onerror = (e) => {
            console.error('Erreur reconnaissance vocale:', e && e.error);
        };
        // 馃攣 Beaucoup de navigateurs mobiles coupent la reconnaissance apr猫s quelques
        // secondes de silence m锚me en mode "continuous". On la relance automatiquement
        // tant que l'enregistrement est toujours en cours, pour que "莽a ne marche pas"
        // ne se produise plus sur un vocal un peu long.
        reconnaissanceVocaleActive.onend = () => {
            if (transcriptionVocaleTexte) transcriptionVocaleTexteBrut = transcriptionVocaleTexte;
            if (transcriptionVocaleEnCours) {
                try { lancerReconnaissanceVocale(SR, zone, texteEl); } catch (e) {}
            }
        };
        reconnaissanceVocaleActive.start();
        if (zone) zone.style.display = 'block';
        if (texteEl && !texteEl.textContent) texteEl.textContent = '...';
    } catch (e) {
        console.error('Transcription vocale indisponible:', e);
        if (zone) zone.style.display = 'none';
    }
}

function arreterTranscriptionVocale() {
    transcriptionVocaleEnCours = false;
    if (reconnaissanceVocaleActive) {
        try { reconnaissanceVocaleActive.onend = null; reconnaissanceVocaleActive.stop(); } catch (e) {}
        reconnaissanceVocaleActive = null;
    }
}

// 鉁忥笍 Rend le texte transcrit modifiable (ic么ne "modifier" 脿 c么t茅 de la transcription)
function modifierTranscriptionVocale() {
    const texteEl = document.getElementById('voice-transcript-texte');
    if (!texteEl) return;
    const estEditable = texteEl.getAttribute('contenteditable') === 'true';
    if (!estEditable) {
        texteEl.setAttribute('contenteditable', 'true');
        texteEl.focus();
        // Place le curseur 脿 la fin
        const range = document.createRange();
        range.selectNodeContents(texteEl);
        range.collapse(false);
        const sel = window.getSelection();
        sel.removeAllRanges();
        sel.addRange(range);
    } else {
        texteEl.setAttribute('contenteditable', 'false');
        transcriptionModifieeManuellement = true;
        transcriptionVocaleTexte = texteEl.textContent.trim();
    }
}

// 馃摛 Envoie directement le texte transcrit comme message texte classique
async function envoyerTranscriptionCommeTexte() {
    const texteEl = document.getElementById('voice-transcript-texte');
    const texte = (texteEl ? texteEl.textContent : transcriptionVocaleTexte || '').trim();
    if (!texte || texte === '...') { showTempNotification('鉂? Aucun texte transcrit 脿 envoyer'); return; }
    await envoyerMessageSimple(texte);
    showTempNotification('鉁? Texte envoy茅');
}

async function appliquerFiltreAudio() {
    if (!audioBlobOriginal) return;
    
    try {
        const arrayBuffer = await audioBlobOriginal.arrayBuffer();
        const audioContext = new (window.AudioContext || window.webkitAudioContext)();
        const audioBuffer = await audioContext.decodeAudioData(arrayBuffer);
        
        const numberOfChannels = audioBuffer.numberOfChannels;
        const length = audioBuffer.length;
        const sampleRate = audioBuffer.sampleRate;
        const newBuffer = audioContext.createBuffer(numberOfChannels, length, sampleRate);
        
        for (let channel = 0; channel < numberOfChannels; channel++) {
            const inputData = audioBuffer.getChannelData(channel);
            const outputData = newBuffer.getChannelData(channel);
            
            switch(filtreAudioActif) {
                case 'grave':
                    for (let i = 0; i < length; i++) {
                        const index = Math.floor(i * 0.7);
                        outputData[i] = inputData[Math.min(index, length - 1)] || 0;
                    }
                    break;
                case 'aigu':
                    for (let i = 0; i < length; i++) {
                        const index = Math.floor(i * 1.4);
                        outputData[i] = inputData[Math.min(index, length - 1)] || 0;
                    }
                    break;
                case 'robot':
                    for (let i = 0; i < length; i++) {
                        let val = inputData[i];
                        val = Math.round(val * 8) / 8;
                        outputData[i] = val;
                    }
                    break;
                case 'echo':
                    for (let i = 0; i < length; i++) {
                        let val = inputData[i];
                        if (i > 2000) val += inputData[i - 2000] * 0.5;
                        if (i > 4000) val += inputData[i - 4000] * 0.25;
                        outputData[i] = Math.min(0.99, Math.max(-0.99, val));
                    }
                    break;
                case 'chipmunk':
                    for (let i = 0; i < length; i++) {
                        const index = Math.floor(i * 1.8);
                        outputData[i] = inputData[Math.min(index, length - 1)] || 0;
                    }
                    break;
                case 'profond':
                    for (let i = 0; i < length; i++) {
                        const index = Math.floor(i * 0.5);
                        outputData[i] = inputData[Math.min(index, length - 1)] || 0;
                    }
                    break;
                case 'alien':
                    for (let i = 0; i < length; i++) {
                        const index = Math.floor(i * 1.15);
                        let val = inputData[Math.min(index, length - 1)] || 0;
                        val *= (1 + 0.5 * Math.sin(i / 200));
                        outputData[i] = Math.min(0.99, Math.max(-0.99, val));
                    }
                    break;
                case 'caverne':
                    for (let i = 0; i < length; i++) {
                        let val = inputData[i];
                        if (i > 3000) val += inputData[i - 3000] * 0.45;
                        if (i > 6500) val += inputData[i - 6500] * 0.3;
                        if (i > 10000) val += inputData[i - 10000] * 0.18;
                        outputData[i] = Math.min(0.99, Math.max(-0.99, val));
                    }
                    break;
                case 'telephone':
                    for (let i = 0; i < length; i++) {
                        const a = inputData[i] || 0;
                        const b = inputData[Math.max(0, i - 1)] || 0;
                        const c = inputData[Math.max(0, i - 2)] || 0;
                        let val = (a + b + c) / 3;
                        outputData[i] = Math.max(-0.7, Math.min(0.7, val * 1.4));
                    }
                    break;
                case 'nasillard':
                    for (let i = 0; i < length; i++) {
                        const prev = inputData[Math.max(0, i - 1)] || 0;
                        const val = inputData[i] - prev * 0.55;
                        outputData[i] = Math.min(0.99, Math.max(-0.99, val * 1.6));
                    }
                    break;
                case 'rapide':
                    for (let i = 0; i < length; i++) {
                        const index = Math.floor(i * 1.6);
                        outputData[i] = inputData[Math.min(index, length - 1)] || 0;
                    }
                    break;
                case 'ralenti':
                    for (let i = 0; i < length; i++) {
                        const index = Math.floor(i * 0.6);
                        outputData[i] = inputData[Math.min(index, length - 1)] || 0;
                    }
                    break;
                default:
                    outputData.set(inputData);
            }
        }
        
        audioBlobFiltre = await bufferToWav(newBuffer, audioContext);
        audioContext.close();
        
    } catch(e) {
        console.error("Erreur filtrage:", e);
        audioBlobFiltre = audioBlobOriginal;
    }
}

async function bufferToWav(buffer, audioContext) {
    const numberOfChannels = buffer.numberOfChannels;
    const length = buffer.length * numberOfChannels * 2;
    const sampleRate = buffer.sampleRate;
    const wavData = new DataView(new ArrayBuffer(44 + length));
    
    function writeString(view, offset, str) {
        for (let i = 0; i < str.length; i++) {
            view.setUint8(offset + i, str.charCodeAt(i));
        }
    }
    
    writeString(wavData, 0, 'RIFF');
    wavData.setUint32(4, 36 + length, true);
    writeString(wavData, 8, 'WAVE');
    writeString(wavData, 12, 'fmt ');
    wavData.setUint32(16, 16, true);
    wavData.setUint16(20, 1, true);
    wavData.setUint16(22, numberOfChannels, true);
    wavData.setUint32(24, sampleRate, true);
    wavData.setUint32(28, sampleRate * numberOfChannels * 2, true);
    wavData.setUint16(32, numberOfChannels * 2, true);
    wavData.setUint16(34, 16, true);
    writeString(wavData, 36, 'data');
    wavData.setUint32(40, length, true);
    
    let offset = 44;
    for (let i = 0; i < buffer.length; i++) {
        for (let channel = 0; channel < numberOfChannels; channel++) {
            const sample = buffer.getChannelData(channel)[i];
            const intSample = Math.max(-32768, Math.min(32767, Math.floor(sample * 32767)));
            wavData.setInt16(offset, intSample, true);
            offset += 2;
        }
    }
    
    return new Blob([wavData], { type: 'audio/wav' });
}

let previewAudioPlayer = null;
let previewAudioPlayerBlob = null;

function previsualiserAudio() {
    const blob = audioBlobFiltre || audioBlobOriginal;
    if (!blob) return;
    const btn = document.querySelector('.voice-preview-play');

    // Le filtre a chang茅 depuis la derni猫re 茅coute : on recr茅e le lecteur
    if (previewAudioPlayer && previewAudioPlayerBlob !== blob) {
        previewAudioPlayer.pause();
        previewAudioPlayer = null;
    }

    if (!previewAudioPlayer) {
        if (previewAudioURL) URL.revokeObjectURL(previewAudioURL);
        previewAudioURL = URL.createObjectURL(blob);
        previewAudioPlayerBlob = blob;
        previewAudioPlayer = new Audio(previewAudioURL);
        previewAudioPlayer.addEventListener('ended', () => {
            if (btn) btn.innerHTML = '<i class="fa-solid fa-play"></i>';
        });
    }

    if (previewAudioPlayer.paused) {
        previewAudioPlayer.play();
        if (btn) btn.innerHTML = '<i class="fa-solid fa-pause"></i>';
    } else {
        previewAudioPlayer.pause();
        previewAudioPlayer.currentTime = 0;
        if (btn) btn.innerHTML = '<i class="fa-solid fa-play"></i>';
    }
}

function supprimerAudioPreview() {
    if (previewAudioPlayer) { previewAudioPlayer.pause(); previewAudioPlayer = null; }
    previewAudioPlayerBlob = null;
    reinitialiserAudioUI();
}

function getAudioDuration(blob) {
    return new Promise((resolve) => {
        const url = URL.createObjectURL(blob);
        const audio = new Audio();
        
        audio.addEventListener('loadedmetadata', () => {
            URL.revokeObjectURL(url);
            const duration = audio.duration;
            if (isFinite(duration) && duration > 0) {
                resolve(Math.round(duration));
            } else {
                // Si la dur茅e n'est pas disponible, on estime
                resolve(Math.round(blob.size / 16000)); // Approximation
            }
        });
        
        audio.addEventListener('error', () => {
            URL.revokeObjectURL(url);
            resolve(0);
        });
        
        audio.src = url;
        audio.load(); // Force le chargement des m茅tadonn茅es
    });
}
function mettreAJourProgressionAudio(audioElement, progressBar) {
    if (!audioElement.paused) {
        const progress = (audioElement.currentTime / audioElement.duration) * 100;
        if (progressBar) progressBar.style.width = progress + '%';
        requestAnimationFrame(() => mettreAJourProgressionAudio(audioElement, progressBar));
    }
}

// Initialiser les audios apr猫s l'affichage
function initialiserAudios() {
    document.querySelectorAll('.audio-message').forEach(container => {
        const playBtn = container.querySelector('.fa-circle-play');
        const pauseBtn = container.querySelector('.fa-circle-pause');
        const audio = container.querySelector('audio');
        const durationSpan = container.querySelector('.audio-duration');
        const progressBar = container.querySelector('.audio-progress');
        
        if (audio && durationSpan) {
            audio.addEventListener('loadedmetadata', () => {
                const minutes = Math.floor(audio.duration / 60);
                const secondes = Math.floor(audio.duration % 60);
                durationSpan.textContent = `${minutes}:${secondes.toString().padStart(2, '0')}`;
            });
            
            audio.addEventListener('play', () => {
                mettreAJourProgressionAudio(audio, progressBar);
            });
            
            audio.addEventListener('timeupdate', () => {
                if (progressBar && audio.duration) {
                    const progress = (audio.currentTime / audio.duration) * 100;
                    progressBar.style.width = progress + '%';
                }
            });
            
            audio.addEventListener('ended', () => {
                playBtn.style.display = 'inline';
                pauseBtn.style.display = 'none';
                if (progressBar) progressBar.style.width = '0%';
            });
        }
    });
}

// Appeler cette fonction apr猫s avoir charg茅 les messages
const observerAudio = new MutationObserver(() => {
    initialiserAudios();
});
observerAudio.observe(document.getElementById('msg-area'), { childList: true, subtree: true });
// ========== NOUVEAU BLOC CORRIG脡 ==========
async function envoyerAudioAvecFiltre() {
    if (!audioBlobFiltre && !audioBlobOriginal) {
        showTempNotification("鉂? Aucun audio 脿 envoyer");
        return;
    }
    
    if (!currentUser) {
        showTempNotification("鉂? Vous n'锚tes pas connect茅");
        return;
    }
    
    showTempNotification("馃摛 Envoi de l'audio...");
    
    const blob = audioBlobFiltre || audioBlobOriginal;
    
    // 鉁? CORRECTION : Upload vers Supabase au lieu de Firestore
    const file = new File([blob], `audio_${currentUser.id}_${Date.now()}.wav`, { type: 'audio/wav' });
    const audioUrl = await uploadVersSupabase(file, 'audio');
    
    if (audioUrl) {
        // 馃摑 On capture le texte transcrit AVANT que fermerMenuAudio() ne r茅initialise l'UI
        const transcriptionAEnvoyer = transcriptionVocaleTexte ? transcriptionVocaleTexte.trim() : '';
        const vocalEstVueUnique = audioVueUnique; // captur茅 avant que fermerMenuAudio() ne r茅initialise le flag
        // On envoie juste l'URL dans Firestore (tr猫s petit)
        const donneesVocal = {
            text: null,
            senderId: currentUser.id,
            senderName: currentUser.name,
            timestamp: firebase.firestore.FieldValue.serverTimestamp(),
            status: "sent",
            readBy: [currentUser.id],
            type: "audio",
            mediaUrl: audioUrl,  // 鈫? JUSTE L'URL, pas le fichier !
            filtreAudio: filtreAudioActif,
            transcription: transcriptionAEnvoyer || null
        };
        // 鉁? Vue unique (item 2) : chacun des deux ne pourra 茅couter ce vocal en entier
        // qu'une seule fois (voir rendreCarteVueUniqueAudio / ouvrirVocalVueUnique).
        if (vocalEstVueUnique) {
            donneesVocal.viewOnce = true;
            donneesVocal.viewOnceOpenedBy = [];
        }
        await db.collection('chats').doc(CHAT_ID).collection('messages').add(donneesVocal);
        
        showTempNotification("鉁? Audio envoy茅 avec succ猫s !");
        fermerMenuAudio();
    } else {
        showTempNotification("鉂? 脡chec de l'upload audio");
    }
}
// ========== FIN NOUVEAU BLOC ==========

// (2 anciennes fonctions sendMediaMessage bas茅es sur le base64 supprim茅es : elles
// 茅crasaient la nouvelle version Supabase d茅finie plus haut dans ce script, ce qui
// causait la lenteur d'envoi/affichage des photos et vid茅os.)
      
      // ========== GALERIE PLEIN 脡CRAN (photo + vid茅o) avec navigation par glissement ==========
let mediaGalerieListe = [];   // [{msgId, type, url}] dans l'ordre d'affichage du chat
let mediaGalerieIndex = 0;
let photoModalSwiped = false;

function construireListeMediasGalerie() {
    mediaGalerieListe = [];
    document.querySelectorAll('#msg-area .message-row').forEach(row => {
        const msgId = row.getAttribute('data-id');
        const img = row.querySelector('.img-msg');
        const video = row.querySelector('.video-wrapper video');
        if (img) {
            mediaGalerieListe.push({ msgId, type: 'image', url: img.getAttribute('data-fullsrc') || img.src });
        } else if (video) {
            mediaGalerieListe.push({ msgId, type: 'video', url: video.getAttribute('src') });
        }
    });
}

function openFullscreenPhoto(event, imgElement) {
    if (event) event.stopPropagation();
    construireListeMediasGalerie();
    const msgId = imgElement.closest('.message-row')?.getAttribute('data-id');
    const idx = mediaGalerieListe.findIndex(m => m.msgId === msgId);
    afficherMediaGalerie(idx >= 0 ? idx : 0);
}

// Ouvre une vid茅o du chat en plein 茅cran, avec la m锚me galerie navigable que les photos
function ouvrirVideoPleinEcran(event, videoElement) {
    if (event) event.stopPropagation();
    construireListeMediasGalerie();
    const msgId = videoElement.closest('.message-row')?.getAttribute('data-id');
    const idx = mediaGalerieListe.findIndex(m => m.msgId === msgId);
    afficherMediaGalerie(idx >= 0 ? idx : 0);
}

function afficherMediaGalerie(index) {
    if (index < 0 || index >= mediaGalerieListe.length) return;
    mediaGalerieIndex = index;
    const media = mediaGalerieListe[index];
    currentPhotoUrl = media.url;

    const modal = document.getElementById('photo-modal');
    const modalImg = document.getElementById('modal-image');
    let modalVideo = document.getElementById('modal-video');
    if (!modalVideo) {
        modalVideo = document.createElement('video');
        modalVideo.id = 'modal-video';
        modalVideo.controls = true;
        modalVideo.playsInline = true;
        modalVideo.style.cssText = 'max-width:100%; max-height:100%; object-fit:contain; display:none;';
        modalImg.insertAdjacentElement('afterend', modalVideo);
    }

    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';

    if (media.type === 'video') {
        modalImg.style.display = 'none';
        modalVideo.src = media.url;
        modalVideo.style.display = 'block';
        modalVideo.currentTime = 0;
        modalVideo.play().catch(() => {});
        activerZoomLibre('modal-video');
    } else {
        modalVideo.pause();
        modalVideo.removeAttribute('src');
        modalVideo.style.display = 'none';
        modalImg.src = media.url;
        modalImg.style.display = 'block';
        modalImg.style.maxWidth = '100%';
        modalImg.style.maxHeight = '100%';
        modalImg.style.width = 'auto';
        modalImg.style.height = 'auto';
        modalImg.style.objectFit = 'contain';
        modalImg.style.margin = '0';
        modalImg.style.borderRadius = '0';
        modalImg.style.boxShadow = 'none';
        modalImg.style.cursor = 'zoom-out';
        modalImg.style.touchAction = 'none';
        activerZoomLibre('modal-image');
    }
}

function mediaGalerieSuivant() {
    if (mediaGalerieIndex < mediaGalerieListe.length - 1) afficherMediaGalerie(mediaGalerieIndex + 1);
}
function mediaGaleriePrecedent() {
    if (mediaGalerieIndex > 0) afficherMediaGalerie(mediaGalerieIndex - 1);
}

// Vrai si l'image/vid茅o affich茅e est actuellement zoom茅e (pour ne jamais
// naviguer par erreur pendant qu'on est en train de zoomer/d茅placer)
function mediaActuelEstZoome() {
    const img = document.getElementById('modal-image');
    const video = document.getElementById('modal-video');
    const scaleImg = img && img._zoomState ? img._zoomState.scale : 1;
    const scaleVideo = video && video._zoomState ? video._zoomState.scale : 1;
    return scaleImg > 1.02 || scaleVideo > 1.02;
}

// Clic 脿 gauche = m茅dia pr茅c茅dent, clic 脿 droite = m茅dia suivant, clic au
// centre = fermer. Ignor茅 si on est zoom茅 (le zoom reste prioritaire).
function gererClicModalPhoto(event) {
    if (photoModalSwiped) return; // 茅vite un "faux clic fant么me" juste apr猫s un glissement
    if (mediaActuelEstZoome()) return; // ne jamais naviguer pendant qu'on est zoom茅
    const modal = document.getElementById('photo-modal');
    const rect = modal.getBoundingClientRect();
    const clickX = event.clientX - rect.left;
    const tiers = rect.width / 3;
    if (clickX < tiers) {
        mediaGaleriePrecedent();
    } else if (clickX > tiers * 2) {
        mediaGalerieSuivant();
    } else {
        closePhotoModal();
    }
}

// Navigation par glissement gauche/droite, et par clic/tap gauche-centre-droite 鈥?
// volontairement SANS bouton visible, comme demand茅. Attach茅 via addEventListener
// (plus fiable qu'un attribut onclick pour ce genre d'interaction).
(function initGalerieClicEtSwipe() {
    let startX = 0, startY = 0;
    function demarrer() {
        const modal = document.getElementById('photo-modal');
        if (!modal || modal.dataset.navBound === 'true') return;
        modal.dataset.navBound = 'true';

        modal.addEventListener('click', (e) => {
            // Les boutons (fermer/enregistrer/r茅pondre) g猫rent d茅j脿 leur propre clic
            // avec stopPropagation ; s'ils sont cliqu茅s, cet 茅v茅nement ne remonte pas ici.
            gererClicModalPhoto(e);
        });

        modal.addEventListener('touchstart', (e) => {
            if (mediaActuelEstZoome()) return; // le zoom (pincement/d茅placement) reste prioritaire
            startX = e.touches[0].clientX;
            startY = e.touches[0].clientY;
        }, { passive: true });
        modal.addEventListener('touchend', (e) => {
            if (mediaActuelEstZoome()) return;
            const dx = e.changedTouches[0].clientX - startX;
            const dy = e.changedTouches[0].clientY - startY;
            if (Math.abs(dx) > 60 && Math.abs(dx) > Math.abs(dy)) {
                photoModalSwiped = true;
                if (dx < 0) mediaGalerieSuivant(); else mediaGaleriePrecedent();
                setTimeout(() => { photoModalSwiped = false; }, 300);
            }
        }, { passive: true });
    }
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', demarrer);
    } else {
        demarrer();
    }
})();

function closePhotoModal() {
    if (photoModalSwiped) return; // un glissement ne doit jamais fermer la vue
    document.getElementById('photo-modal').style.display = 'none';
    const modalVideo = document.getElementById('modal-video');
    if (modalVideo) { modalVideo.pause(); modalVideo.removeAttribute('src'); }
    document.body.style.overflow = '';
    currentPhotoUrl = null;
}
      

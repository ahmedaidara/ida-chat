      // ========== METTRE 脌 JOUR LE STATUT D'UN MESSAGE ==========
function updateMessageStatus(messageId, newStatus) {
    const messageRow = document.querySelector(`[data-id="${messageId}"]`);
    if (!messageRow) return;
    const isSent = messageRow.classList.contains('sent');
    if (!isSent) return;
    const bubble = messageRow.querySelector('.message-bubble');
    if (!bubble) return;
    const msgMeta = bubble.querySelector('.msg-meta');
    if (!msgMeta) return;
    let timeText = msgMeta.textContent;
    timeText = timeText.replace(/鉁?/g, '').replace(/鉁撯湏/g, '').replace(/\(modifi茅\)/gi, '').trim();
    let statusHtml = '';
    if (newStatus === 'read') {
        statusHtml = `<span class="status-tick" style="color: #53bdeb; margin-left: 3px;"><i class="fa-solid fa-check-double"></i></span>`;
    } else if (newStatus === 'delivered') {
        statusHtml = `<span class="status-tick" style="color: #8696a0; margin-left: 3px;"><i class="fa-solid fa-check-double"></i></span>`;
    } else {
        statusHtml = `<span class="status-tick" style="color: #8696a0; margin-left: 3px;"><i class="fa-solid fa-check"></i></span>`;
    }
    const modifiedTag = msgMeta.innerHTML.includes('modifi茅') ? ' <span style="font-size:0.65rem; opacity:0.6;">(modifi茅)</span>' : '';
    msgMeta.innerHTML = `${timeText} ${statusHtml}${modifiedTag}`;
}

// ========== 脡COUTER LES CHANGEMENTS DE STATUT ==========
// 脡coute en temps r茅el des statuts de message
function listenToMessageStatus() {
    if (!currentUser) return;
    
    db.collection('chats').doc(CHAT_ID).collection('messages')
        .where('senderId', '==', currentUser.id)
        .onSnapshot((snapshot) => {
            snapshot.docChanges().forEach((change) => {
                if (change.type === 'modified') {
                    const data = change.doc.data();
                    const msgId = change.doc.id;
                    updateMessageStatus(msgId, data.status);
                }
            });
        });
} 

// ========== MARQUER LES MESSAGES COMME LUS ==========
function markMessagesAsRead() {
    if (!currentUser || !targetUser) return;
    
    const now = Date.now();
    if (lastReadUpdate && (now - lastReadUpdate) < 2000) return;
    lastReadUpdate = now;
    
    console.log("馃摉 Marquage des messages de", targetUser.name, "comme lus...");
    
    db.collection('chats').doc(CHAT_ID).collection('messages')
        .where('senderId', '==', targetUser.id)
        .where('status', '!=', 'read')
        .get()
        .then(snapshot => {
            if (snapshot.empty) {
                console.log("鉁? Aucun message 脿 marquer");
                return;
            }
            
            const batch = db.batch();
            snapshot.docs.forEach(doc => {
                batch.update(doc.ref, { 
                    status: 'read',
                    readAt: firebase.firestore.FieldValue.serverTimestamp()
                });
            });
            
            return batch.commit().then(() => {
                console.log(`鉁? ${snapshot.size} messages marqu茅s comme LUS`);
            });
        })
        .catch(err => console.error("Erreur marquage lu:", err));
}

      
      // ========== D脡TECTER L'ACTIVIT脡 UTILISATEUR ==========
function detecterActivitePourMarquerLu() {
    let timeoutMarquage = null;
    
    const marquer = () => {
        if (timeoutMarquage) clearTimeout(timeoutMarquage);
        timeoutMarquage = setTimeout(() => {
            markMessagesAsRead();
        }, 1000);
    };
    
    // 脡v茅nements qui indiquent que l'utilisateur est actif
    const events = ['click', 'touchstart', 'scroll', 'keydown', 'focus'];
    events.forEach(event => {
        document.addEventListener(event, marquer);
    });
    
    // Quand la page redevient visible
    document.addEventListener('visibilitychange', () => {
        if (!document.hidden) {
            markMessagesAsRead();
        }
    });
}

// Appeler cette fonction apr猫s la connxon
// Dans selectUser(), ajoute : detecterActivitePourMarquerLu();
      
// ========== V脡RIFIER LA LIVRAISON D'UN MESSAGE ==========
async function checkMessageDelivery(messageId) {
    try {
        const doc = await db.collection('chats').doc(CHAT_ID).collection('messages').doc(messageId).get();
        if (!doc.exists) return;
        const data = doc.data();
        if (data.status === 'sent') {
            await doc.ref.update({ 
                status: 'delivered',
                deliveredAt: firebase.firestore.FieldValue.serverTimestamp()
            });
            console.log(`馃摠 Message ${messageId} marqu茅 comme d茅livr茅`);
        }
    } catch(err) {
        console.error("Erreur v茅rification livraison:", err);
    }
}
// ========== FONCTION POUR DEMANDER LES NOTIFICATIONS ==========
async function demanderPermissionNotifications() {
    console.log("馃敂 Tentative d'activation des notifications...");
    
    // V茅rifier si le navigateur supporte les notifications
    if (!("Notification" in window)) {
        console.log("Ce navigateur ne supporte pas les notifications");
        alert("鈿狅笍 Votre navigateur ne supporte pas les notifications");
        return;
    }
    
    // Demander la permission DIRECTEMENT (sans v茅rifier l'茅tat actuel)
    console.log("馃摙 Demande de permission en cours...");
    const permission = await Notification.requestPermission();
    
    console.log("馃敂 R茅sultat:", permission);
    
    if (permission === "granted") {
        console.log("鉁? Permission accord茅e !");
        // Afficher une notification test
        
        enregistrerTokenPush();
    } else if (permission === "denied") {
        console.log("鉂? Permission refus茅e par l'utilisateur");
     } else {
        console.log("鈴革笍 Permission:", permission);
    }
}

// Fonction pour enregistrer le token push
async function enregistrerTokenPush() {
    try {
        // V茅rifier si le service worker est support茅
        if (!('serviceWorker' in navigator)) {
            console.log("Service Worker non support茅");
            return;
        }
        
        // Enregistrer le service worker
        const registration = await navigator.serviceWorker.register('/firebase-messaging-sw.js');
        console.log("Service Worker enregistr茅");
        
        // R茅cup茅rer le token FCM
        const vapidKey = 'BPwxUfJfIr_sR5sMxa6ZAFr0XWxsf3Vin904KaB1CXj6THncXEDqwIfbceN8DxGhyUTPVY1d5khXbxMUtV29Fog';
        const token = await messaging.getToken({
            serviceWorkerRegistration: registration,
            vapidKey: vapidKey
        });
        
        if (token) {
            console.log("馃幆 Token FCM:", token);
            
            // Sauvegarder dans Firestor
            if (currentUser) {
                await db.collection('users').doc(currentUser.id).set({
                    fcmToken: token,
                    lastTokenUpdate: firebase.firestore.FieldValue.serverTimestamp()
                }, { merge: true });
                console.log("馃捑 Token sauvegard茅 pour", currentUser.name);
            }
        } else {
            console.log("鈿狅笍 Aucun token re莽u");
        }
    } catch(error) {
        console.error("鉂? Erreur token:", error);
    }
}

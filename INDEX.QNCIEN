    }

    // 馃攼 D脡TECTION DU CODE SECRET 5432
    if (text === '5432') {
        input.value = '';
        autoResizeTextarea();
        cancelReply();
        toggleSendBtn(false);
        stopTypingNotify();
        clearLiveTyping();
        
        const msgData = {
            text: '********',
            originalText: '5432',

        // ========== STYLES DE BULLES ==========
      // ========== GESTION DU MENU STYLE ==========
let styleMenuActive = false;

function showStyleMenu() {
    const messageRow = document.querySelector(`[data-id="${selectedMessageId}"]`);
    const isSentMessage = messageRow && messageRow.classList.contains('sent');
    
    if (!isSentMessage) {
        showTempNotification("鈿狅笍 Tu ne peux changer que le style de TES messages !");
        document.getElementById('ctx-menu').style.display = 'none';
        return;
    }
    
    // Si le menu style est d茅j脿 ouvert, on le ferme
    if (styleMenuActive) {
        closeStyleMenu();
        return;
    }
    
    const mainMenu = document.getElementById('ctx-menu');
    const styleMenu = document.getElementById('style-submenu');
    
    // Cacher le menu principal
    mainMenu.style.display = 'none';
    
    // Positionner le sous-menu
    const rect = mainMenu.getBoundingClientRect();
    const windowWidth = window.innerWidth;
    const windowHeight = window.innerHeight;
    
    let leftPos = (windowWidth / 2) - 120; // Centr茅
    let topPos = (windowHeight / 2) - 150; // Centr茅
    
    styleMenu.style.position = 'fixed';
    styleMenu.style.top = topPos + 'px';
    styleMenu.style.left = leftPos + 'px';
    styleMenu.style.display = 'block';
    styleMenu.style.zIndex = '10001';
    styleMenuActive = true;
    
    // Fermer le menu si on clique en dehors
    function fermerStyleMenu(e) {
        if (!styleMenu.contains(e.target)) {
            closeStyleMenu();
            document.removeEventListener('click', fermerStyleMenu);
        }
    }
    
    setTimeout(() => {
        document.addEventListener('click', fermerStyleMenu);
    }, 100);
}

function closeStyleMenu() {
    const styleMenu = document.getElementById('style-submenu');
    styleMenu.style.display = 'none';
    styleMenuActive = false;
}

// R茅appliquer apr猫s s茅lection d'un style
async function applyStyleToMessage(styleName) {
    if (!selectedMessageId) return;
    
    const styleNames = { 
        'bicolor':'Bicolore', 'dark-passion':'Rouge et Noir', 'grid-style':'Style Tableau',
        'rainbow':'Arc-en-ciel', 'neon':'N茅on Glow', 'wood':'Style Bois',
        'code-style':'Style Code', 'comics':'Style Comics', 'watercolor':'Aquarelle',
        'retro':'Style Retro', 'glassmorphism':'Glassmorphism', 'crystal':'Crystal',
        'sunset':'Sunset', 'ocean':'Ocean', 'forest':'Forest', 'midnight':'Midnight',
        'rose':'Rose', 'gold':'Gold', 'galaxy':'Galaxy', 'cyberpunk':'Cyberpunk',
        'handwritten':'脡criture manuscrite'
    };
    
    const msgId = selectedMessageId;
    const messageRow = document.querySelector(`[data-id="${msgId}"]`);
    const isSentMessage = messageRow && messageRow.classList.contains('sent');
    
    if (!isSentMessage) {
        showTempNotification("鉂? Tu ne peux changer que le style de TES propres messages !");
        closeStyleMenu();
        return;
    }
    
    const nouvellesDonnees = { bubbleStyle: styleName, customColor: null, customGradient: null };

    // Mettre 脿 jour l'affichage LOCAL imm茅diatement (optimiste), uniquement sur CE message
    const bubble = messageRow.querySelector('.message-bubble');
    appliquerRenduBulleMessage(bubble, messageRow, nouvellesDonnees);
    
    // Fermer les menus tout de suite (pas besoin d'attendre le r茅seau)
    closeStyleMenu();
    document.getElementById('ctx-menu').style.display = 'none';
    showTempNotification(`鉁? Style "${styleNames[styleName]}" appliqu茅 !`);
    
    // R茅initialiser selectedMessageId pour 茅viter les conflits avec un autre message
    selectedMessageId = null;

    // Puis mettre 脿 jour Firestore (synchro temps r茅el pour l'autre personne)
    await db.collection('chats').doc(CHAT_ID).collection('messages').doc(msgId).update(nouvellesDonnees);
}
        
      async function removeStyleFromMessage() {
    if (!selectedMessageId) return;
    
    const msgId = selectedMessageId;
    const messageRow = document.querySelector(`[data-id="${msgId}"]`);
    if (!messageRow || !messageRow.classList.contains('sent')) {
        showTempNotification("鉂? Tu ne peux supprimer que le style de TES messages !");
        closeStyleMenu();
        return;
    }
    
    // Supprimer le style visuellement tout de suite, uniquement sur CE message
    const bubble = messageRow.querySelector('.message-bubble');
    appliquerRenduBulleMessage(bubble, messageRow, { bubbleStyle: null, customColor: null, customGradient: null });
    
    closeStyleMenu();
    document.getElementById('ctx-menu').style.display = 'none';
    showTempNotification(`馃棏锔? Style supprim茅`);
    
    selectedMessageId = null;

    // Supprimer le style de Firestore
    await db.collection('chats').doc(CHAT_ID).collection('messages').doc(msgId).update({ 
        bubbleStyle: null 
    });
}
        
        // ========== TRADUCTION ========== 
        // ========== TRADUCTION 鈥? M脡THODE SIMPLE ET FIABLE ==========
        // Un seul point d'entr茅e pour toute l'app : l'API publique de Google Translate,
        // gratuite et sans cl茅, utilis茅e par de tr猫s nombreux projets pour sa fiabilit茅.
        async function traduireTexteSimple(texte, langueCible, langueSource) {
            if (!texte || !texte.trim()) return null;
            langueSource = langueSource || 'auto';
            try {
                const url = `https://translate.googleapis.com/translate_a/single?client=gtx&sl=${langueSource}&tl=${langueCible}&dt=t&q=${encodeURIComponent(texte)}`;
                const response = await fetch(url);
                if (!response.ok) return null;
                const data = await response.json();
                // data[0] est une liste de segments traduits : [[texteTraduit, texteOriginal, ...], ...]
                return data[0].map(segment => segment[0]).join('');
            } catch (err) {
                console.error("Erreur de traduction:", err);
                return null;
            }
        }

        async function translateTextToLanguage(text, targetLang) {
            return await traduireTexteSimple(text, targetLang);
        }
        
        function toggleTranslateMenu(event) {
            event.stopPropagation();
            const dropdown = document.getElementById('translate-dropdown');
            dropdown.classList.toggle('show');
        }
        
        async function translateInputText(targetLang) {
            const input = document.getElementById('chat-in');
            const originalText = input.value.trim();
            if (!originalText) {
                alert("馃摑 脡cris d'abord un message !");
                document.getElementById('translate-dropdown').classList.remove('show');
                return;
            }
            const langNames = { 'en':'Anglais 馃嚞馃嚙','ar':'Arabe 馃嚫馃嚘','es':'Espagnol 馃嚜馃嚫','ja':'Japonais 馃嚡馃嚨' };
            const translatedText = await translateTextToLanguage(originalText, targetLang);
            if (translatedText && translatedText !== originalText) {
                input.value = translatedText;
                document.getElementById('translate-dropdown').classList.remove('show');
                showTempNotification(`鉁? Traduit en ${langNames[targetLang]}`);
                handleTyping();
            } else if (translatedText === originalText) {
                showTempNotification(`鈿狅笍 Le texte est d茅j脿 en ${langNames[targetLang]}`);
            } else {
                showTempNotification("鉂? Erreur de traduction");
            }
        }
        
  // ========== TRADUCTION D'UN MESSAGE (clic droit / appui long 鈫? Traduire) ==========
async function translateSelectedMessage() {
    if (!selectedMessageId) return;
    
    const messageRow = document.querySelector(`[data-id="${selectedMessageId}"]`);
    if (!messageRow) return;
    
    const messageSpan = messageRow.querySelector('.message-bubble span:not(.coded-mask)');
    if (!messageSpan) return;
    
    const originalText = messageSpan.innerText;
    const originalHTML = messageSpan.innerHTML;
    
    // Traduit vers le fran莽ais si le message ne l'est pas d茅j脿, sinon vers l'anglais
    const estFrancais = detecterFrancais(originalText);
    const langueCible = estFrancais ? 'en' : 'fr';
    const langueNom = estFrancais ? 'Anglais 馃嚞馃嚙' : 'Fran莽ais 馃嚝馃嚪';
    
    messageSpan.innerHTML = '<span style="opacity:0.6;">馃攧 Traduction...</span>';
    
    const translated = await traduireTexteSimple(originalText, langueCible);
    
    if (translated && translated.trim().toLowerCase() !== originalText.trim().toLowerCase()) {
        messageSpan.setAttribute('data-original', originalText);
        messageSpan.innerHTML = `${escapeHTML(translated)} <span style="font-size:0.65rem; opacity:0.5; cursor:pointer;" onclick="restaurerMessageOriginal(this.parentElement)">[${langueNom}]</span>`;
    } else {
        messageSpan.innerHTML = originalHTML;
        showTempNotification(translated ? "鈿狅笍 Le message est d茅j脿 dans cette langue" : "鉂? Service de traduction indisponible, r茅essaie");
    }
    
    hideContextMenus();
}

// ========== D脡TECTION FRAN脟AIS (SIMPLIFI脡E) ==========
function detecterFrancais(texte) {
    if (!texte) return false;
    
    // Caract猫res accentu茅s typiquement fran莽ais
    const accents = /[茅猫锚毛脿芒盲么枚霉没眉莽艙]/i;
    if (accents.test(texte)) return true;
    
    // Mots tr猫s communs en fran莽ais
    const motsFrancais = ['je', 'tu', 'il', 'elle', 'nous', 'vous', 'ils', 'elles', 
                          'le', 'la', 'les', 'un', 'une', 'du', 'de', 'est', 'sont',
                          'bonjour', 'merci', 'salut', 'oui', 'non', 'et', 'ou', 'mais'];
    
    const texteLower = texte.toLowerCase();
    let compteur = 0;
    for (const mot of motsFrancais) {
        if (texteLower.includes(mot)) compteur++;
        if (compteur >= 2) return true;
    }
    return false;
}

function restaurerMessageOriginal(element) {
    const original = element.getAttribute('data-original');
    if (original) {
        element.innerHTML = original;
        element.removeAttribute('data-original');
    }
}

 
        
    function toggleTranslateMenuDirect(event) {
    event.stopPropagation();
    let existingMenu = document.getElementById('direct-lang-menu');
    if (existingMenu) { 
        existingMenu.remove(); 
        return;
    }
    
    const menu = document.createElement('div');
    menu.id = 'direct-lang-menu';
    menu.style.cssText = `position:fixed; bottom:80px; right:20px; background:var(--panel-bg); backdrop-filter:blur(15px); border:1px solid var(--border-color); border-radius:12px; padding:8px 0; z-index:1000; min-width:150px;`;
    
    const languages = [
        { code:'fr', flag:'馃嚝馃嚪', name:'Fran莽ais' },
        { code:'en', flag:'馃嚞馃嚙', name:'Anglais' },
        { code:'ar', flag:'馃嚫馃嚘', name:'Arabe' },
        { code:'es', flag:'馃嚜馃嚫', name:'Espagnol' },
        { code:'it', flag:'馃嚠馃嚬', name:'Italien' },
        { code:'de', flag:'馃嚛馃嚜', name:'Allemand' },
        { code:'pt', flag:'馃嚨馃嚬', name:'Portugais' },
        { code:'ru', flag:'馃嚪馃嚭', name:'Russe' },
        { code:'ja', flag:'馃嚡馃嚨', name:'Japonais' },
        { code:'zh', flag:'馃嚚馃嚦', name:'Chinois' }
    ];
    
    languages.forEach(lang => {
        const option = document.createElement('div');
        option.style.cssText = 'padding:10px 20px; cursor:pointer; display:flex; align-items:center; gap:10px;';
        option.innerHTML = `<span class="flag">${lang.flag}</span><span>${lang.name}</span>`;
        option.onclick = () => { 
            traduireEtRemplacerInput(lang.code, lang.name);
            menu.remove(); 
        };
        menu.appendChild(option);
    });
    
    document.body.appendChild(menu);
    
    setTimeout(() => {
        document.addEventListener('click', function closeMenu(e) {
            if (!menu.contains(e.target) && e.target.id !== 'translate-menu-btn' && e.target.id !== 'translate-btn') { 
                menu.remove(); 
                document.removeEventListener('click', closeMenu); 
            }
        });
    }, 10);
}

// 鉁? Traduit directement le message en cours de saisie et le remplace dans le champ texte,
// pr锚t 脿 锚tre envoy茅. Simple : tu 茅cris, tu choisis une langue, ton texte est traduit.
async function traduireEtRemplacerInput(code, nom) {
    const input = document.getElementById('chat-in');
    const texte = input.value.trim();
    if (!texte) {
        showTempNotification("馃摑 脡cris d'abord un message !");
        return;
    }
    showTempNotification(`馃攧 Traduction en ${nom}...`);
    const traduit = await traduireTexteSimple(texte, code);
    if (traduit && traduit.trim().toLowerCase() !== texte.toLowerCase()) {
        input.value = traduit;
        handleTyping();
        autoResizeTextarea();
        showTempNotification(`鉁? Traduit en ${nom}`);
    } else if (traduit) {
        showTempNotification(`鈿狅笍 Le texte est d茅j脿 en ${nom}`);
    } else {
        showTempNotification("鉂? Service de traduction indisponible, r茅essaie");
    }
}

// (Anciennes fonctions de traduction obsol猫tes supprim茅es : traduireTexte, fallbackTraduction,
// detecterFrancaisRapide. Elles n'茅taient jamais appel茅es et contenaient le m锚me bug de sens
// de traduction invers茅 que translateTextToLanguage 鈥? tout est unifi茅 dans traduireTexteSimple.)
        
        // ========== MODE CODE ==========
        function toggleCodeMode() { codeModeActive = !codeModeActive; showTempNotification(codeModeActive ? "馃敀 Mode Cod茅 ACTIV脡" : "馃敁 Mode Cod茅 D脡SACTIV脡"); }
        function toggleCodeModeDirect() { toggleCodeMode(); const btn = document.getElementById('code-mode-btn'); if(btn) btn.style.color = codeModeActive ? '#ffaa00' : ''; }
        
        function showPinModal(messageId) {
            pendingMessageId = messageId;
            document.getElementById('pin-modal').style.display = 'flex';
            document.getElementById('pin-input').value = '';
            document.getElementById('pin-input').focus();
        }
        function closePinModal() { document.getElementById('pin-modal').style.display = 'none'; pendingMessageId = null; }
        function verifyPin() {
            const input = document.getElementById('pin-input');
            if (input.value === SECRET_PIN) {
                unlockMessage(pendingMessageId);
                closePinModal();
            } else { showTempNotification("鉂? Code PIN incorrect !"); input.value = ''; input.focus(); }
        }
        // 鉁? D脡VERROUILLAGE AUTOMATIQUE INSTANTAN脡 : d猫s que le code tap茅 correspond
        // EXACTEMENT au code secret, on d茅verrouille imm茅diatement, sans attendre un
        // clic sur "Entrer". On ne d茅clenche rien tant que le code est incomplet ou
        // faux (pas de message d'erreur pr茅matur茅), ce qui 茅vite toute boucle infinie :
        // l'茅couteur ne fait rien de plus une fois le modal ferm茅 (input vid茅, plus d'event).
        function verifierPinAutomatique() {
            const input = document.getElementById('pin-input');
            if (!input) return;
            if (input.value === SECRET_PIN) {
                unlockMessage(pendingMessageId);
                closePinModal();
            }
        }
        const pinInputEl = document.getElementById('pin-input');
        if (pinInputEl) {
            pinInputEl.addEventListener('input', verifierPinAutomatique);
        }
        
        function unlockMessage(messageId) {
            const messageRow = document.querySelector(`[data-id="${messageId}"]`);
            if (!messageRow) return;
            const bubble = messageRow.querySelector('.message-bubble');
            const messageSpan = bubble.querySelector('.coded-mask');
            if (messageSpan) {
                const originalText = messageSpan.getAttribute('data-original-text');
                if (originalText) { messageSpan.innerHTML = originalText; messageSpan.classList.remove('coded-mask'); messageSpan.style.fontFamily = ''; }
                bubble.classList.remove('coded');
                const badge = bubble.querySelector('.locked-badge');
                if (badge) { badge.textContent = '馃敁'; badge.classList.add('unlocked-badge'); }
            }
        }
        
        // ========== AUDIO 脡PH脡M脠RE MODE ==========
        function toggleEphemeralAudioMode() { ephemeralAudioMode = !ephemeralAudioMode; showTempNotification(ephemeralAudioMode ? "馃帣锔? Audio 脡ph茅m猫re ACTIV脡" : "馃帣锔? Audio 脡ph茅m猫re D脡SACTIV脡"); }
        function toggleEphemeralAudioModeDirect() { toggleEphemeralAudioMode(); const btn = document.getElementById('ephemeral-audio-btn'); if(btn) btn.style.color = ephemeralAudioMode ? '#ff4444' : ''; }
        
        // ========== MODE 脡PH脡M脠RE ==========
       
        
        // ========== MODE FLOU ==========
        function toggleBlurMode() {
            blurModeActive = !blurModeActive;
            const container = document.getElementById('msg-area');
            const blurBtn = document.getElementById('blur-toggle-btn');
            if (blurModeActive) {
                container.classList.add('blur-mode');
                blurBtn.classList.add('active');
                blurBtn.classList.remove('fa-eye-slash');
                blurBtn.classList.add('fa-eye');
                applyBlurToAllMessages();
                 
            } else {
                container.classList.remove('blur-mode');
                blurBtn.classList.remove('active');
                blurBtn.classList.remove('fa-eye');
                blurBtn.classList.add('fa-eye-slash');
                removeBlurFromAllMessages();
                 
            }
        }
        
        function applyBlurToAllMessages() {
            document.querySelectorAll('.message-bubble').forEach(bubble => {
                bubble.classList.add('blur-active');
                attachBlurEvents(bubble);
            });
        }
        
        function removeBlurFromAllMessages() {
            document.querySelectorAll('.message-bubble').forEach(bubble => {
                bubble.classList.remove('blur-active', 'blur-cleared');
                removeBlurEvents(bubble);
            });
        }
        
        function attachBlurEvents(bubble) {
            bubble.removeEventListener('mousedown', startPressToRead);
            bubble.removeEventListener('mouseup', endPressToRead);
            bubble.removeEventListener('mouseleave', cancelPressToRead);
            bubble.addEventListener('mousedown', startPressToRead);
            bubble.addEventListener('mouseup', endPressToRead);
            bubble.addEventListener('mouseleave', cancelPressToRead);
        }
        
        function removeBlurEvents(bubble) {
            bubble.removeEventListener('mousedown', startPressToRead);
            bubble.removeEventListener('mouseup', endPressToRead);
            bubble.removeEventListener('mouseleave', cancelPressToRead);
        }
        
        function startPressToRead(e) {
            if (!blurModeActive) return;
            const bubble = e.currentTarget;
            currentBlurMessage = bubble;
            pressTimer = setTimeout(() => {
                if (currentBlurMessage) {
                    currentBlurMessage.classList.remove('blur-active');
                    currentBlurMessage.classList.add('blur-cleared');
                }
            }, 200);
        }
        
        function endPressToRead(e) {
            if (!blurModeActive) return;
            if (pressTimer) { clearTimeout(pressTimer); pressTimer = null; }
            if (currentBlurMessage) {
                setTimeout(() => {
                    if (currentBlurMessage && blurModeActive) {
                        currentBlurMessage.classList.add('blur-active');
                        currentBlurMessage.classList.remove('blur-cleared');
                    }
                    currentBlurMessage = null;
                }, 500);
            }
        }
        
        function cancelPressToRead(e) {
            if (!blurModeActive) return;
            if (pressTimer) { clearTimeout(pressTimer); pressTimer = null; }
            if (currentBlurMessage) {
                currentBlurMessage.classList.add('blur-active');
                currentBlurMessage.classList.remove('blur-cleared');
                currentBlurMessage = null;
            }
        }
        
        // ========== MODE LIVE ==========
        function toggleLiveMode() {
            liveModeActive = !liveModeActive;
            const liveBtn = document.getElementById('live-toggle-btn');
            const liveContainer = document.getElementById('live-container');
            if (liveModeActive) {
                liveBtn.classList.add('active');
                liveBtn.style.color = '#ff4444';
                liveContainer.classList.add('active');
                startLiveTypingListener();
                
            } else {
                liveBtn.classList.remove('active');
                liveBtn.style.color = '';
                liveContainer.classList.remove('active');
                stopLiveTypingListener();
                 
            }
        }
        
        // 馃寛 Palette de couleurs vives pour l'effet multicolore lettre par lettre
        const PALETTE_MULTICOLORE = [
            '#ff1744', '#ff6d00', '#ffd600', '#00e676', '#00e5ff',
            '#2979ff', '#651fff', '#d500f9', '#f50057', '#00c853',
            '#ff3d00', '#ffab00', '#76ff03', '#1de9b6', '#3d5afe'
        ];

        // Transforme un texte en HTML o霉 chaque lettre a une couleur diff茅rente
        function colorerTexteMulticolore(texte) {
            if (!texte) return '';
            const echappe = escapeHTML(texte);
            let html = '';
            let indexCouleur = 0;
            for (const car of echappe) {
                if (car === ' ') {
                    html += ' ';
                } else {
                    const couleur = PALETTE_MULTICOLORE[indexCouleur % PALETTE_MULTICOLORE.length];
                    html += `<span style="color:${couleur};">${car}</span>`;
                    indexCouleur++;
                }
            }
            return html;
        }

        function startLiveTypingListener() {
            if (!targetUser) return;
            db.collection('live_typing').doc(CHAT_ID).onSnapshot((doc) => {
                if (doc.exists && liveModeActive) {
                    const data = doc.data();
                    const currentText = data.text || "";
                    const senderId = data.senderId;
                    const senderName = data.senderName;
                    if (senderId === targetUser.id && currentText !== currentLiveText) {
                        currentLiveText = currentText;
                        document.getElementById('live-sender-name').innerText = senderName || targetUser.name;
                        const previewSpan = document.getElementById('live-message-preview');
                        if (previewSpan) {
                            previewSpan.innerHTML = currentText
                                ? colorerTexteMulticolore(currentText)
                                : "en train d'茅crire...";
                        }
                        const bar = document.getElementById('live-bar');
                        if (bar) bar.style.width = Math.min(currentText.length * 2, 100) + '%';
                        if (liveUpdateTimeout) clearTimeout(liveUpdateTimeout);
                        liveUpdateTimeout = setTimeout(() => { if(bar) bar.style.width = '0%'; }, 2000);
                    }
                }
            });
        }
        
        function stopLiveTypingListener() {
            const previewSpan = document.getElementById('live-message-preview');
            if (previewSpan) previewSpan.innerText = "";
            const bar = document.getElementById('live-bar');
            if (bar) bar.style.width = '0%';
            currentLiveText = "";
        }
        
        function sendLiveTypingUpdate() {
            if (!currentUser) return;
            const input = document.getElementById('chat-in');
            const text = input.value;
            if (liveUpdateTimeout) clearTimeout(liveUpdateTimeout);
            liveUpdateTimeout = setTimeout(() => {
                db.collection('live_typing').doc(CHAT_ID).set({
                    text: text,
                    senderId: currentUser.id,
                    senderName: currentUser.name,
                    timestamp: firebase.firestore.FieldValue.serverTimestamp()
                });
            }, 50);
        }
        
        function clearLiveTyping() {
            db.collection('live_typing').doc(CHAT_ID).set({
                text: "", senderId: currentUser.id, senderName: currentUser.name,
                timestamp: firebase.firestore.FieldValue.serverTimestamp()
            });
            const bar = document.getElementById('live-bar');
            if (bar) bar.style.width = '0%';
        }
        
        // ========== PENSE 脌 TOI ==========
        // Remplace l'ancien "Flash" (qui ne fonctionnait que si l'app 茅tait ouverte c么t茅
        // destinataire, via Firestore). On garde ce canal pour la vibration + animation
        // instantan茅e quand l'app est ouverte, ET on ajoute en plus une vraie notification
        // Telegram pour que 莽a arrive aussi quand le t茅l茅phone de l'autre est verrouill茅/ferm茅.
        async function triggerPenseAToi() {
            if (!targetUser) return;
            const btn = document.getElementById('pense-toi-btn');
            if (btn) {
                btn.classList.add('pense-toi-active');
                setTimeout(() => btn.classList.remove('pense-toi-active'), 300);
            }
            await db.collection('flash_signals').add({
                targetUserId: targetUser.id, sourceUserId: currentUser.id, sourceUserName: currentUser.name,
                timestamp: firebase.firestore.FieldValue.serverTimestamp(), pattern: [200,100,200]
            });
            envoyerNotificationTelegram('馃挏 Pense 脿 toi', `${currentUser.name} pense 脿 toi en ce moment 馃挏`);
            showTempNotification(`馃挏 "Pense 脿 toi" envoy茅 脿 ${targetUser.name}`);
            if (navigator.vibrate) navigator.vibrate(100);
        }

        function listenForFlashSignals() {
            if (!currentUser) return;
            db.collection('flash_signals').where('targetUserId', '==', currentUser.id).orderBy('timestamp', 'desc').limitToLast(10).onSnapshot((snapshot) => {
                snapshot.docChanges().forEach((change) => {
                    if (change.type === 'added') {
                        const signalData = change.doc.data();
                        if (navigator.vibrate) navigator.vibrate([200,100,200]);
                        const notif = document.createElement('div');
                        notif.className = 'flash-notification';
                        notif.innerHTML = `馃挏<br><span style="font-size:0.8rem;">${signalData.sourceUserName} pense 脿 toi !</span>`;
                        document.body.appendChild(notif);
                        setTimeout(() => notif.remove(), 1000);
                        setTimeout(() => change.doc.ref.delete(), 5000);
                    }
                });
            });
        }
        
      // ========== PLUIE DE C艗URS FLOTTANTS (code "520") ==========
function lancerPluieCoeurs() {
    const nbCoeurs = 34;
    const emojisCoeurs = ['鉂わ笍', '馃挄', '馃挅', '馃挆', '馃挀', '馃挊'];
    for (let i = 0; i < nbCoeurs; i++) {
        setTimeout(() => {
            const coeur = document.createElement('div');
            coeur.className = 'coeur-flottant';
            coeur.textContent = emojisCoeurs[Math.floor(Math.random() * emojisCoeurs.length)];
            const startLeft = Math.random() * 100;
            const drift = (Math.random() * 160 - 80) + 'px';
            const rot = (Math.random() * 60 - 30) + 'deg';
            const size = (1.4 + Math.random() * 1.8).toFixed(2) + 'rem';
            const duree = (2.4 + Math.random() * 0.6).toFixed(2) + 's';
            coeur.style.left = startLeft + 'vw';
            coeur.style.bottom = '-40px';
            coeur.style.fontSize = size;
            coeur.style.setProperty('--drift', drift);
            coeur.style.setProperty('--rot', rot);
            coeur.style.animationDuration = duree;
            document.body.appendChild(coeur);
            setTimeout(() => coeur.remove(), 3200);
        }, i * 45);  
    }
}

 function listenForCoeursSignals() {
    if (!currentUser) return;
    let isFirstSnapshot = true;

    db.collection('coeurs_signals')
      .where('targetUserId', '==', currentUser.id)
      .onSnapshot((snapshot) => {
        // Premier snapshot = documents d茅j脿 existants 鈫? on les nettoie sans jouer l'animation
        if (isFirstSnapshot) {
            isFirstSnapshot = false;
            snapshot.docs.forEach(doc => {
                doc.ref.delete().catch(() => {});
            });
            return;
        }

        // Seulement les vrais nouveaux signaux (en temps r茅el ou arriv茅s pendant qu'on 茅tait hors ligne)
        snapshot.docChanges().forEach((change) => {
            if (change.type === 'added') {
                lancerPluieCoeurs();
                change.doc.ref.delete().catch(() => {});
            }
        });
    }, (error) => {
        console.error('Erreur 茅coute coeurs_signals:', error);
    });
}
      
        // ========== BATTERIE ==========
        async function getBatteryLevel() {
            if ('getBattery' in navigator) {
                try {
                    const battery = await navigator.getBattery();
                    updateBatteryAndSync(battery);
                    battery.addEventListener('levelchange', () => updateBatteryAndSync(battery));
                    battery.addEventListener('chargingchange', () => updateBatteryAndSync(battery));
                } catch(e) { console.log("Battery API error"); }
            }
        }
        
       async function updateBatteryAndSync(battery) {
    const level = Math.floor(battery.level * 100);
    currentBatteryLevel = level;
    isCharging = battery.charging;
    
    // G茅n茅rer un ID d'appareil unique (stock茅 dans localStorage)
    let deviceId = localStorage.getItem('deviceId');
    if (!deviceId) {
        deviceId = 'device_' + Date.now() + '_' + Math.random().toString(36).substr(2, 6);
        localStorage.setItem('deviceId', deviceId);
    }
    
    const deviceInfo = {
        deviceId: deviceId,
        battery: {
            level: level,
            charging: battery.charging
        },
        lastUpdate: firebase.firestore.FieldValue.serverTimestamp(),
        userAgent: navigator.userAgent.substring(0, 100),
        platform: navigator.platform || 'unknown'
    };
    
    // Mettre 脿 jour dans Firestore
    // 鈿狅笍 IMPORTANT : on ne touche PAS aux champs "online" / "lastSeen" ici.
    // Ce sont des champs de PR脡SENCE, g茅r茅s exclusivement par
    // mettreAJourStatutUtilisateur() (voir plus bas). Les 茅v茅nements de batterie
    // (levelchange/chargingchange) peuvent se d茅clencher m锚me quand l'茅cran est en
    // arri猫re-plan ou l'utilisateur inactif : les inclure ici r茅initialisait
    // silencieusement le statut 脿 "en ligne" 脿 chaque changement de batterie, ce qui
    // 茅tait la cause du bug "affich茅 EN LIGNE alors que d茅connect茅/hors ligne".
    await db.collection('users').doc(currentUser.id).set({
        battery: {
            level: level,
            charging: battery.charging,
            deviceId: deviceId,
            lastUpdate: firebase.firestore.FieldValue.serverTimestamp()
        },
        // Ajouter/ mettre 脿 jour la liste des appareils
        devices: firebase.firestore.FieldValue.arrayUnion(deviceInfo)
    }, { merge: true });
    
    // Nettoyer les anciens appareils (garder seulement les 5 derniers)
    nettoyerAnciensAppareils();
    
    // 鈿狅笍 CORRECTIF : la batterie affich茅e dans l'en-t锚te doit TOUJOURS 锚tre celle
    // de l'autre personne (g茅r茅e par ecouterStatutAutreAvecHorodatage), jamais la
    // n么tre. L'ancien appel ci-dessous 茅crasait parfois l'affichage avec NOTRE
    // propre batterie (notamment quand l'autre est hors ligne) 鈥? supprim茅.
    // updateBatteryDisplay(level, battery.charging);
}

// Fonction pour nettoyer les anciens appareils
async function nettoyerAnciensAppareils() {
    if (!currentUser) return;
    
    try {
        const doc = await db.collection('users').doc(currentUser.id).get();
        if (doc.exists && doc.data().devices) {
            let devices = doc.data().devices;
            if (devices.length > 5) {
                // Trier par date et garder les 5 plus r茅cents
                devices.sort((a, b) => {
                    const dateA = a.lastUpdate ? new Date(a.lastUpdate) : new Date(0);
                    const dateB = b.lastUpdate ? new Date(b.lastUpdate) : new Date(0);
                    return dateB - dateA;
                });
                devices = devices.slice(0, 5);
                
                await db.collection('users').doc(currentUser.id).update({
                    devices: devices
                });
                console.log(`馃Ч Nettoy茅: ${doc.data().devices.length - 5} anciens appareils supprim茅s`);
            }
        }
    } catch(e) {
        console.error("Erreur nettoyage appareils:", e);
    }
}
        
       function updateBatteryDisplay(level, charging) {
    // Ne met 脿 jour que si c'est la batterie de l'utilisateur courant
    // et que l'autre n'est pas affich茅
    const percentSpan = document.getElementById('battery-percent');
    const iconSpan = document.getElementById('battery-icon');
    if (!percentSpan) return;
    
    // V茅rifier si on affiche le statut de l'autre ou le sien
    const statusSpan = document.getElementById('header-status-text');
    if (statusSpan && statusSpan.innerHTML.includes('馃煝 En ligne') && currentUser) {
        // Si l'autre est en ligne, on affiche SA batterie, pas la n么tre
        return;
    }
    
    // Sinon, afficher sa propre batterie
    percentSpan.textContent = level + '%';
    if (charging) {
        iconSpan.innerHTML = '鈿?';
        percentSpan.className = 'battery-percent battery-charging';
    } else if (level <= 15) {
        iconSpan.innerHTML = '馃';
        percentSpan.className = 'battery-percent battery-low';
    } else if (level <= 30) {
        iconSpan.innerHTML = '馃攱';
        percentSpan.className = 'battery-percent battery-medium';
    } else {
        iconSpan.innerHTML = '馃攱';
        percentSpan.className = 'battery-percent battery-high';
    }
}
        
      function listenToOtherUserBattery() {
    if (!targetUser) return;
    
    // Cette fonction est maintenant g茅r茅e par ecouterStatutAutreAvecHorodatage()
    // On garde juste un fallback
    console.log("馃攱 La batterie de l'autre est g茅r茅e par ecouterStatutAutreAvecHorodatage()");
}
      
      // ========== FORCER LA MISE 脌 JOUR DE LA BATTERIE ==========
function forcerMiseAJourBatterieAutre() {
    if (!targetUser) return;
    
    console.log(`馃攧 For莽age de la batterie de ${targetUser.name}...`);
    
    db.collection('users').doc(targetUser.id).get().then(doc => {
        if (doc.exists) {
            const data = doc.data();
            
            // Chercher la batterie du dernier appareil
            let batterie = null;
            
            if (data.devices && data.devices.length > 0) {
                const devicesSorted = [...data.devices].sort((a, b) => {
                    const dateA = a.lastUpdate ? new Date(a.lastUpdate) : new Date(0);
                    const dateB = b.lastUpdate ? new Date(b.lastUpdate) : new Date(0);
                    return dateB - dateA;
                });
                
                const dernier = devicesSorted[0];
                if (dernier && dernier.battery) {
                    batterie = dernier.battery;
                    console.log(`馃摫 Dernier appareil: ${dernier.deviceId || 'inconnu'} 鈫? ${batterie.level}%`);
                }
            }
            
            if (!batterie && data.battery) {
                batterie = data.battery;
            }
            
            if (batterie) {
                // Mettre 脿 jour l'affichage
                const statusSpan = document.getElementById('header-status-text');
                const iconSpan = document.getElementById('battery-icon');
                const percentSpan = document.getElementById('battery-percent');
                
                if (iconSpan && percentSpan) {
                    const level = batterie.level || 0;
                    const charging = batterie.charging || false;
                    iconSpan.textContent = charging ? '鈿?' : (level <= 15 ? '馃' : '馃攱');
                    percentSpan.textContent = level + '%';
                    percentSpan.className = 'battery-percent';
                    percentSpan.classList.add(charging ? 'battery-charging' : (level <= 15 ? 'battery-low' : (level <= 30 ? 'battery-medium' : 'battery-high')));
                }
            }
        }
    });
}

// Exposer la fonction dans la console
console.log("馃挕 Tape 'forcerMiseAJourBatterieAutre()' pour forcer la mise 脿 jour");
        
        // ========== STATUT D'HUMEUR ==========
        function toggleMoodPanel() {

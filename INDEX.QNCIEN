document.body.addEventListener('touchmove', function(e) {
    // Si on est en train de d茅filer horizontalement
    if (Math.abs(e.touches[0].clientX - (e.touches[0].clientX - e.touches[0].movementX)) > 10) {
        e.preventDefault();
    }
}, { passive: false });


    // Ce message n'est JAMAIS envoy茅 ni affich茅 dans le chat, ni chez toi ni chez l'autre.
    if (text.toLowerCase() === 'direct') {
        input.value = '';
        autoResizeTextarea();
        cancelReply();
        toggleSendBtn(false);
        stopTypingNotify();
        clearLiveTyping();
        toggleLiveMode();
        showTempNotification(liveModeActive ? "馃憗锔? Mode Live activ茅" : "馃憗锔? Mode Live d茅sactiv茅");

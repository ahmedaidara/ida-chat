// ---------- CALENDRIER 脌 DEUX ----------
// Note honn锚te : sans serveur d茅di茅, on ne peut pas envoyer un vrai rappel "le jour J"
// si personne n'ouvre l'app. On fait donc un rappel "au mieux" : 脿 l'ouverture de l'app,
// si un 茅v茅nement tombe aujourd'hui ou demain, une notification Telegram est envoy茅e.
let calendrierUnsub = null;
function ouvrirCalendrierPage() {
    document.getElementById('calendrier-modal').style.display = 'flex';
    if (calendrierUnsub) calendrierUnsub();
    calendrierUnsub = db.collection('chats').doc(CHAT_ID).collection('calendar_events')
        .orderBy('date', 'asc')
        .onSnapshot((snap) => {
            const cont = document.getElementById('calendrier-items');
            cont.innerHTML = '';
            if (snap.empty) { cont.innerHTML = '<p style="color:var(--text-muted); font-size:0.85rem;">Aucun 茅v茅nement pr茅vu.</p>'; return; }
            const aujourdhui = new Date(); aujourdhui.setHours(0,0,0,0);
            snap.forEach(doc => {
                const d = doc.data();
                const dateEvt = new Date(d.date + 'T00:00:00');
                const diffJours = Math.round((dateEvt - aujourdhui) / 86400000);
                let quand;
                if (diffJours === 0) quand = "Aujourd'hui 馃帀";
                else if (diffJours === 1) quand = "Demain";
                else if (diffJours > 1) quand = `Dans ${diffJours} jours`;
                else quand = "Pass茅";
                const item = document.createElement('div');
                item.className = 'liste-item';
                item.innerHTML = `<div class="liste-item-texte"><div><strong>${escapeHtmlTexte(d.title)}</strong> 鈥? ${dateEvt.toLocaleDateString('fr-FR')}</div>
                    <div class="liste-item-note">${quand}${d.note ? ' 路 ' + escapeHtmlTexte(d.note) : ''}</div></div>
                    <div class="liste-item-actions"><i class="fa-solid fa-trash" onclick="supprimerEvenement('${doc.id}')"></i></div>`;
                cont.appendChild(item);
            });
        });
}
function fermerCalendrierPage() {
    document.getElementById('calendrier-modal').style.display = 'none';
    if (calendrierUnsub) { calendrierUnsub(); calendrierUnsub = null; }
}
function toggleFormulaireCalendrier() {
    const form = document.getElementById('calendrier-form');
    form.style.display = (form.style.display === 'none' || !form.style.display) ? 'block' : 'none';
}
async function ajouterEvenementCalendrier() {
    const titre = document.getElementById('calendrier-titre-input').value.trim();
    const date = document.getElementById('calendrier-date-input').value;
    const note = document.getElementById('calendrier-note-input').value.trim();
    if (!titre || !date) { showTempNotification('Titre et date obligatoires'); return; }
    await db.collection('chats').doc(CHAT_ID).collection('calendar_events').add({
        title: titre, date, note, createdBy: currentUser.id, createdByName: currentUser.name,
        createdAt: firebase.firestore.FieldValue.serverTimestamp(), dernierRappelEnvoye: null
    });
    document.getElementById('calendrier-titre-input').value = '';
    document.getElementById('calendrier-date-input').value = '';
    document.getElementById('calendrier-note-input').value = '';
    document.getElementById('calendrier-form').style.display = 'none';
}
async function supprimerEvenement(id) {
    if (!confirm("Supprimer cet 茅v茅nement du calendrier ?")) return;
    try {
        await db.collection('chats').doc(CHAT_ID).collection('calendar_events').doc(id).delete();
    } catch (e) {
        console.error("Suppression 茅v茅nement calendrier impossible :", e);
        if (typeof showTempNotification === 'function') showTempNotification("鉂? Suppression impossible (droits Firestore ?)");
    }
}
// Envoie un rappel directement comme MESSAGE dans le chat (pas juste une notif) :
// le jour J, la veille, puis chaque semaine compl猫te restante avant l'茅v茅nement.
// Un seul rappel par jour et par 茅v茅nement (champ dernierRappelEnvoye anti-doublon).
async function verifierRappelsCalendrierAuChargement() {
    try {
        const snap = await db.collection('chats').doc(CHAT_ID).collection('calendar_events').get();
        const aujourdhui = new Date(); aujourdhui.setHours(0, 0, 0, 0);
        const todayStr = aujourdhui.toISOString().slice(0, 10);
        for (const doc of snap.docs) {
            const d = doc.data();
            if (!d.date) continue;
            const dateEvt = new Date(d.date + 'T00:00:00');
            const diffJours = Math.round((dateEvt - aujourdhui) / 86400000);
            if (diffJours < 0) continue;
            const doitRappeler = diffJours === 0 || diffJours === 1 || (diffJours > 1 && diffJours % 7 === 0);
            if (!doitRappeler) continue;
            if (d.dernierRappelEnvoye === todayStr) continue;
            let texte;
            if (diffJours === 0) texte = `馃搮 Rappel : c'est aujourd'hui 鈥? ${d.title} !${d.note ? ' (' + d.note + ')' : ''}`;
            else if (diffJours === 1) texte = `馃搮 Rappel : c'est demain 鈥? ${d.title} !`;
            else texte = `馃搮 Rappel : dans ${diffJours} jours 鈥? ${d.title}`;
            await envoyerMessageSimple(texte);
            await db.collection('chats').doc(CHAT_ID).collection('calendar_events').doc(doc.id).update({ dernierRappelEnvoye: todayStr });
        }
    } catch (e) { console.error('V茅rification rappels calendrier :', e); }
}

// ---------- UTILITAIRE COMMUN ----------
function escapeHtmlTexte(str) {
    if (!str) return '';
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
}

// Formate un timestamp Firestore en date+heure lisible (ou cha卯ne vide si absent).
function formaterDateModif(timestamp) {
    if (!timestamp) return '';
    const date = timestamp.toDate ? timestamp.toDate() : new Date(timestamp);
    if (isNaN(date.getTime())) return '';
    return date.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' }) +
        ' 脿 ' + date.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' });
}

// ---------- 脡DITEUR PLEIN 脡CRAN (r茅utilis茅 par la bucket-list et les notes partag茅es) ----------
let editeurPleinEcranContexte = null;
function ouvrirEditeurPleinEcran(config) {
    editeurPleinEcranContexte = config;
    document.getElementById('fs-editor-titre').textContent = config.titre || '';
    document.getElementById('fs-editor-textarea').value = config.valeurActuelle || '';
    document.getElementById('fs-editor-textarea').placeholder = config.placeholder || '脡cris ici...';
    document.getElementById('fs-editor-date').textContent = config.dateModif ? `Modifi茅 le ${formaterDateModif(config.dateModif)}` : 'Pas encore modifi茅';
    document.getElementById('fs-editor-overlay').classList.add('show');
    setTimeout(() => document.getElementById('fs-editor-textarea').focus(), 200);
}
function fermerEditeurPleinEcran() {
    document.getElementById('fs-editor-overlay').classList.remove('show');
    editeurPleinEcranContexte = null;
}
async function sauvegarderEditeurPleinEcran() {
    if (!editeurPleinEcranContexte) return;
    const texte = document.getElementById('fs-editor-textarea').value;
    const maj = {};
    maj[editeurPleinEcranContexte.champTexte] = texte;
    maj[editeurPleinEcranContexte.champDate] = firebase.firestore.FieldValue.serverTimestamp();
    await db.collection('chats').doc(CHAT_ID).collection(editeurPleinEcranContexte.collection)
        .doc(editeurPleinEcranContexte.docId).update(maj);
    showTempNotification('鉁? Enregistr茅');
    fermerEditeurPleinEcran();
}

// ---------- M脡T脡O 脌 DEUX ----------
// Utilise Open-Meteo (gratuit, sans cl茅 API). Envoy茅e comme une carte dans le chat,
// comme demand茅, avec la m茅t茅o "chez toi" et "chez elle/lui" c么te 脿 c么te.
const METEO_CODES = {
    0: '鈽?锔? Ciel d茅gag茅', 1: '馃尋锔? Plut么t clair', 2: '鉀? Partiellement nuageux', 3: '鈽侊笍 Couvert',
    45: '馃尗锔? Brumeux', 48: '馃尗锔? Brume givrante',
    51: '馃對锔? Bruine l茅g猫re', 53: '馃對锔? Bruine', 55: '馃對锔? Bruine forte',
    61: '馃導锔? Pluie l茅g猫re', 63: '馃導锔? Pluie', 65: '馃導锔? Forte pluie',
    71: '馃尐锔? Neige l茅g猫re', 73: '馃尐锔? Neige', 75: '馃尐锔? Forte neige',
    80: '馃對锔? Averses', 81: '馃對锔? Averses fortes', 82: '鉀堬笍 Averses violentes',
    95: '鉀堬笍 Orage', 96: '鉀堬笍 Orage avec gr锚le', 99: '鉀堬笍 Orage violent'
};
async function obtenirMeteoPourCoords(lat, lng) {
    const url = `https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lng}&current_weather=true`;
    const res = await fetch(url);
    if (!res.ok) throw new Error('Erreur m茅t茅o');
    const data = await res.json();
    const cw = data.current_weather;
    return { temp: Math.round(cw.temperature), condition: METEO_CODES[cw.weathercode] || '馃尅锔? M茅t茅o' };
}
async function ouvrirMeteoADeux() {
    showTempNotification('鈽侊笍 R茅cup茅ration de la m茅t茅o...');
    try {
        // 1) Ma position + ma m茅t茅o
        const { lat: latMoi, lng: lngMoi } = await obtenirPositionActuelle();
        const meteoMoi = await obtenirMeteoPourCoords(latMoi, lngMoi);

        // 2) Derni猫re position connue de l'autre (via son dernier message de type 'location')
        let meteoAutre = null;
        const snap = await db.collection('chats').doc(CHAT_ID).collection('messages')
            .where('senderId', '==', targetUser.id)
            .where('type', '==', 'location')
            .orderBy('timestamp', 'desc')
            .limit(1)
            .get();
        if (!snap.empty) {
            const loc = snap.docs[0].data();
            meteoAutre = await obtenirMeteoPourCoords(loc.lat, loc.lng);
        }

        await db.collection('chats').doc(CHAT_ID).collection('messages').add({
            type: 'meteo',
            text: '馃尋锔? M茅t茅o 脿 deux',
            nomMoi: currentUser.name, tempMoi: meteoMoi.temp, condMoi: meteoMoi.condition,
            nomAutre: targetUser.name,
            tempAutre: meteoAutre ? meteoAutre.temp : null,
            condAutre: meteoAutre ? meteoAutre.condition : null,
            senderId: currentUser.id, senderName: currentUser.name,
            timestamp: firebase.firestore.FieldValue.serverTimestamp(),
            readBy: [currentUser.id]
        });
    } catch (e) {
        console.error('Erreur m茅t茅o 脿 deux:', e);
        showTempNotification(messageErreurGeoloc(e));
    }
}

// ---------- COMPTEUR DE JOURS ENSEMBLE ----------
const DATE_DEBUT_COUPLE = '2023-07-13';
function afficherCompteurJoursEnsemble() {
    const debut = new Date(DATE_DEBUT_COUPLE + 'T00:00:00');
    const maintenant = new Date();
    const diffJours = Math.floor((maintenant - debut) / 86400000);
    const elNombre = document.getElementById('jours-ensemble-nombre');
    const elDate = document.getElementById('jours-ensemble-date');
    if (elNombre) elNombre.textContent = diffJours >= 0 ? diffJours : 0;
    if (elDate) elDate.textContent = `Depuis le ${debut.toLocaleDateString('fr-FR')}`;
}

// ---------- STATISTIQUES DU COUPLE ----------
async function afficherStatistiquesCouple() {
    try {
        const debutMois = new Date(); debutMois.setDate(1); debutMois.setHours(0, 0, 0, 0);
        const snap = await db.collection('chats').doc(CHAT_ID).collection('messages')
            .where('timestamp', '>=', debutMois).get();
        let totalMessagesMois = 0, jeTaime = 0;
        snap.forEach(doc => {
            const d = doc.data();
            totalMessagesMois++;
            if (d.text && /je\s*t['\s]?aime/i.test(d.text)) jeTaime++;
        });
        const elJetaime = document.getElementById('stats-jetaime');
        const elMsg = document.getElementById('stats-messages-mois');
        if (elJetaime) elJetaime.textContent = jeTaime;
        if (elMsg) elMsg.textContent = totalMessagesMois;
    } catch (e) {
        console.error('Erreur statistiques du couple:', e);
    }
}

// ---------- SOS C脗LIN ----------
async function envoyerSOSCalin() {
    if (!targetUser) return;
    await db.collection('chats').doc(CHAT_ID).collection('messages').add({
        type: 'sos_calin', text: '馃啒 SOS C芒lin', senderId: currentUser.id, senderName: currentUser.name,
        timestamp: firebase.firestore.FieldValue.serverTimestamp(), readBy: [currentUser.id]
    });
    envoyerNotificationTelegram('馃啒 SOS C芒lin', `${currentUser.name} a besoin d'un c芒lin, va vite la/le voir 馃挏`);
    showTempNotification('馃啒 SOS C芒lin envoy茅');
    ouvrirAnimationCarteSpeciale('sos_calin', { senderName: currentUser.name });
}
// ========================================================================
// 鉁? NOUVELLE ANIMATION "CARTE SP脡CIALE" (item 6) 鈥? cadeau / SOS C芒lin / lettre.
// Se joue aussi bien pour l'exp茅diteur (aper莽u imm茅diat apr猫s envoi) que pour le
// destinataire (quand il/elle appuie sur la carte ferm茅e dans le chat).
// ========================================================================
// 鈿狅笍 Les donn茅es (nom, texte, cadeau...) passent par cette map index茅e par msgId plut么t
// que d'锚tre inject茅es telles quelles dans l'attribut onclick="" : un texte contenant une
// apostrophe (tr猫s fr茅quent en fran莽ais) casserait l'attribut HTML et, comme 莽a a d茅j脿 caus茅
// un bug bloquant une fois sur ces m锚mes cartes, on 茅vite absolument de reproduire 莽a ici.
const carteSpecialeDonnees = {};

async function ouvrirCarteRecue(msgId) {
    const donnees = carteSpecialeDonnees[msgId];
    if (!donnees) return;
    
    // 鉁? Marquer comme ouvert dans Firestore
    try {
        await db.collection('chats').doc(CHAT_ID).collection('messages').doc(msgId).update({ opened: true });
    } catch (e) { console.error('Erreur marquage carte ouverte:', e); }
    
    // 鉁? Ouvrir l'animation
    ouvrirAnimationCarteSpeciale(donnees.type, donnees);
}

function fermerCarteSpeciale() {
    const overlay = document.getElementById('carte-speciale-overlay');
    if (overlay) {
        overlay.classList.remove('active');
        overlay.innerHTML = '';
    }
}

function lancerConfettiCarteSpeciale(centreX, centreY, emojis) {
    const nombre = 10 + Math.floor(Math.random() * 6);
    for (let i = 0; i < nombre; i++) {
        const piece = document.createElement('span');
        piece.className = 'carte-confetti-piece';
        piece.textContent = emojis[Math.floor(Math.random() * emojis.length)];
        // 脡ventail : dispersion vers le haut et les c么t茅s depuis le haut de la carte
        const angle = Math.PI + Math.random() * Math.PI; // demi-cercle vers le haut
        const distance = 90 + Math.random() * 140;
        const tx = Math.cos(angle) * distance;
        const ty = Math.sin(angle) * distance - 30;
        piece.style.left = centreX + 'px';
        piece.style.top = centreY + 'px';
        piece.style.setProperty('--tx', tx.toFixed(0) + 'px');
        piece.style.setProperty('--ty', ty.toFixed(0) + 'px');
        piece.style.setProperty('--rot', (Math.random() * 360 - 180).toFixed(0) + 'deg');
        piece.style.animation = `confettiBurst ${(0.9 + Math.random() * 0.5).toFixed(2)}s cubic-bezier(.22,.61,.36,1) forwards`;
        document.body.appendChild(piece);
        setTimeout(() => piece.remove(), 1700);
    }
}

function ouvrirAnimationCarteSpeciale(typeCarte, options) {
    options = options || {};
    let overlay = document.getElementById('carte-speciale-overlay');
    if (!overlay) {
        overlay = document.createElement('div');
        overlay.id = 'carte-speciale-overlay';
        overlay.className = 'carte-speciale-overlay';
        overlay.addEventListener('click', (e) => { if (e.target === overlay) fermerCarteSpeciale(); });
        document.body.appendChild(overlay);
    }

    let icone = '馃巵', titre = 'Cadeau virtuel', texte = '', emojisConfetti = ['鉁?', '馃帀'];
    if (typeCarte === 'cadeau') {
        icone = (options.cadeau || '馃巵').split(' ')[0];
        titre = 'Cadeau virtuel';
        texte = options.cadeau || '';
        emojisConfetti = [icone, '鉁?', '馃帀', '馃挮'];
    } else if (typeCarte === 'sos_calin') {
        icone = '馃啒';
        titre = 'SOS C芒lin';
        texte = `${options.senderName || ''} `;
        emojisConfetti = ['鉂わ笍', '馃', '馃挄', '鉁?'];
    } else if (typeCarte === 'lettre') {
        // 鉁? NOUVEAU RENDU POUR LA LETTRE - FEUILLE BLANCHE STYLE PDF
        overlay.innerHTML = `
            <div class="carte-speciale-box lettre-pdf">
                <div class="carte-speciale-close" onclick="fermerCarteSpeciale()" style="color: #666 !important; background: rgba(0,0,0,0.05) !important; position: fixed !important; top: calc(env(safe-area-inset-top, 16px) + 20px) !important; right: 20px !important; width: 40px !important; height: 40px !important; display: flex !important; align-items: center !important; justify-content: center !important; cursor: pointer !important; font-size: 1.5rem !important; z-index: 10 !important; transition: all 0.2s ease !important; border-radius: 50% !important;">
                    <i class="fa-solid fa-xmark"></i>
                </div>
                <div class="lettre-papier">
                    <div class="lettre-en-tete">
                        <span>馃搫</span>
                        <span>Lettre</span>
                    </div>
                    <div class="lettre-contenu">${escapeHtmlTexte(options.texte || '')}</div>
                    <div class="lettre-signature">
                        鈥? ${escapeHtmlTexte(options.senderName || '')}
                    </div>
                </div>
            </div>
        `;
        overlay.classList.add('active');
        if (navigator.vibrate) navigator.vibrate(150);
        return;
    }

    // Rendu normal pour cadeau et SOS c芒lin
    overlay.innerHTML = `
        <div class="carte-speciale-box" style="background: transparent !important; backdrop-filter: none !important; box-shadow: none !important; border: none !important; padding: 0 !important; max-width: 90% !important; width: auto !important; display: flex !important; flex-direction: column !important; align-items: center !important; justify-content: center !important; min-height: 60vh !important;">
            <div class="carte-speciale-close" onclick="fermerCarteSpeciale()" style="color: #fff !important; background: transparent !important; position: fixed !important; top: calc(env(safe-area-inset-top, 16px) + 20px) !important; right: 20px !important; width: 40px !important; height: 40px !important; display: flex !important; align-items: center !important; justify-content: center !important; cursor: pointer !important; font-size: 1.5rem !important; z-index: 10 !important; transition: all 0.2s ease !important; text-shadow: 0 2px 12px rgba(0,0,0,0.5) !important;">
                <i class="fa-solid fa-xmark"></i>
            </div>
            <div class="carte-speciale-icone" style="font-size: 12rem !important; margin-bottom: 20px !important; line-height: 1 !important; text-shadow: 0 0 80px rgba(255,255,255,0.15), 0 0 160px rgba(255,255,255,0.05); animation: emojiBounce 0.7s ease;">${icone}</div>
            <div class="carte-speciale-titre" style="color: #fff !important; font-weight: 700; font-size: 1.4rem; margin-bottom: 10px; text-shadow: 0 2px 24px rgba(0,0,0,0.8); letter-spacing: 0.5px;">${escapeHtmlTexte(titre)}</div>
            <div class="carte-speciale-texte" style="color: #fff !important; font-size: 1rem; line-height: 1.6; text-shadow: 0 2px 20px rgba(0,0,0,0.7); white-space: pre-wrap; max-width: 90%; opacity: 0.95;">${escapeHtmlTexte(texte)}</div>
        </div>
    `;
    overlay.classList.add('active');
    if (navigator.vibrate) navigator.vibrate(typeCarte === 'sos_calin' ? [300, 100, 300, 100, 300] : 150);

    setTimeout(() => {
        const box = overlay.querySelector('.carte-speciale-box');
        if (box) {
            const rect = box.getBoundingClientRect();
            lancerConfettiCarteSpeciale(rect.left + rect.width / 2, rect.top + 24, emojisConfetti);
        }
        if (typeCarte === 'lettre') {
            const input = document.getElementById('chat-in');
            if (input) input.focus();
        }
    }, 520);
}

// (anciennes fonctions declencherAnimationCadeau / declencherAnimationCoeurGeant
// remplac茅es par ouvrirAnimationCarteSpeciale ci-dessus 鈥? conserv茅es en alias pour
// compatibilit茅 si jamais appel茅es ailleurs, sans dupliquer la logique)
function declencherAnimationCoeurGeant(options) { ouvrirAnimationCarteSpeciale('sos_calin', options || {}); }
function declencherAnimationCadeau(cadeau, options) { ouvrirAnimationCarteSpeciale('cadeau', Object.assign({ cadeau }, options || {})); }

// ---------- CADEAU VIRTUEL ----------
const CADEAUX_VIRTUELS = { 
    cafe: '鈽? Caf茅', 
    fleur: '馃尭 Fleur', 
    pizza: '馃崟 Pizza', 
    chocolat: '馃崼 Chocolat', 
    glace: '馃崷 Glace', 
    calin: '馃 C芒lin virtuel',
    coccinelle: '馃悶 Coccinelle porte-bonheur',
    rose: '馃尮 Rose rouge',
    marteau: '馃敤 Marteau magique'
};
function ouvrirMenuCadeauVirtuel() {
    document.getElementById('cadeau-modal').style.display = 'flex';
}
function fermerMenuCadeauVirtuel() {
    document.getElementById('cadeau-modal').style.display = 'none';
}
async function envoyerCadeauVirtuel(cle) {
    const cadeau = CADEAUX_VIRTUELS[cle];
    if (!cadeau) return;
    await db.collection('chats').doc(CHAT_ID).collection('messages').add({
        type: 'cadeau', cadeau, text: cadeau,
        senderId: currentUser.id, senderName: currentUser.name,
        timestamp: firebase.firestore.FieldValue.serverTimestamp(), readBy: [currentUser.id]
    });
    envoyerNotificationTelegram('馃巵 Cadeau re莽u', `${currentUser.name} t'envoie : ${cadeau} !`);
    fermerMenuCadeauVirtuel();
    
    // 鉁? Extraction de l'emoji pour l'animation
    const emoji = cadeau.split(' ')[0];
    const nom = cadeau.replace(emoji, '').trim();
    
    ouvrirAnimationCarteSpeciale('cadeau', { 
        cadeau: cadeau,
        emoji: emoji,
        nom: nom
    });
}
function declencherAnimationCadeau(cadeau) {
    const overlay = document.createElement('div');
    overlay.className = 'cadeau-overlay';
    overlay.innerHTML = `<div class="cadeau-emoji-bounce">${cadeau.split(' ')[0]}</div><div class="cadeau-texte">${escapeHtmlTexte(cadeau)}</div>`;
    document.body.appendChild(overlay);
    if (navigator.vibrate) navigator.vibrate(150);
    setTimeout(() => overlay.remove(), 2200);
}

// ---------- LETTRES PROGRAMM脡ES ---------- 
// Honn锚tet茅 : sans serveur d茅di茅, l'envoi ne peut se d茅clencher que lorsque le/la
// destinataire ouvre l'app 脿 la date pr茅vue (ou apr猫s). D猫s qu'il/elle ouvre l'app
function ouvrirLettreProgrammee() {
    const modal = document.getElementById('lettre-modal');
    if (modal) {
        modal.style.display = 'flex';
        modal.style.visibility = 'visible';
        modal.style.opacity = '1';
    }
    const input = document.getElementById('lettre-texte-input');
    if (input) input.value = '';
}
function fermerLettreProgrammee() {
    document.getElementById('lettre-modal').style.display = 'none';
}
async function programmerLettre() {
    const texte = document.getElementById('lettre-texte-input').value.trim();
    if (!texte) { showTempNotification('脡cris ta lettre d\'abord 馃拰'); return; }
    
    // 鉁? Envoi direct dans le chat (comme le cadeau)
    await db.collection('chats').doc(CHAT_ID).collection('messages').add({
        type: 'lettre',
        text: texte,
        senderId: currentUser.id,
        senderName: currentUser.name,
        timestamp: firebase.firestore.FieldValue.serverTimestamp(),
        readBy: [currentUser.id],
        opened: false
    });
    
    fermerLettreProgrammee();
    showTempNotification('馃拰 Lettre envoy茅e !');
    
    // 鉁? Aper莽u imm茅diat pour l'exp茅diteur
    ouvrirAnimationCarteSpeciale('lettre', { 
        senderName: currentUser.name, 
        texte: texte,
        emoji: '馃拰'
    });
}
async function verifierLettresProgrammees() {
    if (!currentUser) return;
    try {
        const snap = await db.collection('chats').doc(CHAT_ID).collection('lettres_programmees')
            .where('delivered', '==', false).get();
        const todayStr = new Date().toISOString().slice(0, 10);
        for (const doc of snap.docs) {
            const d = doc.data();
            if (d.senderId === currentUser.id) continue; // seul le/la destinataire d茅clenche la livraison
            if (d.sendDate <= todayStr) {
                await db.collection('chats').doc(CHAT_ID).collection('messages').add({
                    type: 'lettre', text: d.text,
                    senderId: d.senderId, senderName: d.senderName,
                    timestamp: firebase.firestore.FieldValue.serverTimestamp(), readBy: []
                });
                await db.collection('chats').doc(CHAT_ID).collection('lettres_programmees').doc(doc.id).update({ delivered: true });
            }
        }
    } catch (e) { console.error('Erreur v茅rification lettres programm茅es:', e); }
}

// ---------- CARTE / TR脡SOR CACH脡 ----------
// Un tr茅sor est envoy茅 comme une carte scell茅e dans le chat (avec un indice) ;
// l'autre doit appuyer dessus pour la "trouver" et r茅v茅ler le message cach茅.
function ouvrirTresorCache() {
    document.getElementById('tresor-indice-input').value = '';
    document.getElementById('tresor-secret-input').value = '';
    document.getElementById('tresor-modal').style.display = 'flex';
}
function fermerTresorCache() {
    document.getElementById('tresor-modal').style.display = 'none';
}
async function cacherUnTresor() {
    const indice = document.getElementById('tresor-indice-input').value.trim();
    const secret = document.getElementById('tresor-secret-input').value.trim();
    if (!indice || !secret) { showTempNotification("脡cris un indice et le message cach茅"); return; }
    await db.collection('chats').doc(CHAT_ID).collection('messages').add({
        type: 'tresor', indice, secret, revealed: false, text: '馃巵 Tr茅sor cach茅',
        senderId: currentUser.id, senderName: currentUser.name,
        timestamp: firebase.firestore.FieldValue.serverTimestamp(), readBy: [currentUser.id]
    });
    showTempNotification('馃巵 Tr茅sor cach茅 envoy茅 !');
    fermerTresorCache();
}
async function reveleTresor(msgId) {
    const row = document.querySelector(`[data-id="${msgId}"]`);
    const zone = row ? row.querySelector('.tresor-secret-zone') : null;
    if (zone && zone.style.display === 'none') {
        zone.style.display = 'block';
        const doc = await db.collection('chats').doc(CHAT_ID).collection('messages').doc(msgId).get();
        const d = doc.data();
        if (d && !d.revealed && d.senderId !== currentUser.id) {
            await db.collection('chats').doc(CHAT_ID).collection('messages').doc(msgId).update({ revealed: true });
            envoyerNotificationTelegram('馃巵 Tr茅sor trouv茅', `${currentUser.name} a trouv茅 ton tr茅sor cach茅 !`);
        }
    }
}

// ---------- RECETTES 脌 DEUX ----------
let recettesUnsub = null;
function ouvrirRecettesADeux() {
    document.getElementById('recettes-modal').style.display = 'flex';
    if (recettesUnsub) recettesUnsub();
    recettesUnsub = db.collection('chats').doc(CHAT_ID).collection('recettes')
        .orderBy('createdAt', 'desc')
        .onSnapshot((snap) => {
            const cont = document.getElementById('recettes-items');
            cont.innerHTML = '';
            if (snap.empty) { cont.innerHTML = '<p style="color:var(--text-muted); font-size:0.85rem;">Aucune recette. Sauvegarde le plat que tu as fait dimanche !</p>'; return; }
            snap.forEach(doc => {
                const d = doc.data();
                const item = document.createElement('div');
                item.className = 'liste-item';
                item.innerHTML = `<div class="liste-item-texte"><div><strong>${escapeHtmlTexte(d.titre)}</strong></div>
                    ${d.description ? `<div class="liste-item-note">${escapeHtmlTexte(d.description)}</div>` : ''}
                    <div class="liste-item-note">par ${escapeHtmlTexte(d.createdByName || '')}</div></div>
                    <div class="liste-item-actions"><i class="fa-solid fa-trash" onclick="supprimerRecette('${doc.id}')"></i></div>`;
                cont.appendChild(item);
            });
        });
}
function fermerRecettesADeux() {
    document.getElementById('recettes-modal').style.display = 'none';
    if (recettesUnsub) { recettesUnsub(); recettesUnsub = null; }
}
async function ajouterRecette() {
    const titre = document.getElementById('recette-titre-input').value.trim();
    const description = document.getElementById('recette-description-input').value.trim();
    if (!titre) { showTempNotification('Donne au moins un nom au plat'); return; }
    await db.collection('chats').doc(CHAT_ID).collection('recettes').add({
        titre, description, createdBy: currentUser.id, createdByName: currentUser.name,
        createdAt: firebase.firestore.FieldValue.serverTimestamp()
    });
    document.getElementById('recette-titre-input').value = '';
    document.getElementById('recette-description-input').value = '';
}
async function supprimerRecette(id) {
    await db.collection('chats').doc(CHAT_ID).collection('recettes').doc(id).delete();
}

// ---------- MESSAGES QUI S'AUTOD脡TRUISENT (vu puis supprim茅) ----------
// Activable via clic droit / appui long sur UN de tes propres messages 鈫? "Autod茅truire
// apr猫s lecture". D猫s que l'autre personne a l'app ouverte et que le message est
// d茅tect茅 comme re莽u, il se supprime pour les deux ~4 secondes apr猫s (m锚me m茅canisme
// de suppression fluide que les messages secrets d茅j脿 pr茅sents dans l'app).
async function activerAutodestructionMessage() {
    if (!selectedMessageId) return;
    const row = document.querySelector(`[data-id="${selectedMessageId}"]`);
    const isSent = row && row.classList.contains('sent');
    if (!isSent) {
        showTempNotification("Tu ne peux activer l'autodestruction que sur TES messages");
        document.getElementById('ctx-menu').style.display = 'none';
        return;
    }
    await db.collection('chats').doc(CHAT_ID).collection('messages').doc(selectedMessageId).update({
        selfDestruct: true, selfDestructTriggered: false
    });
    showTempNotification("馃挘 Ce message s'autod茅truira une fois lu par l'autre");
    document.getElementById('ctx-menu').style.display = 'none';
    selectedMessageId = null;
}
function ecouterMessagesAutodestruction() {
    if (!currentUser) return;
    db.collection('chats').doc(CHAT_ID).collection('messages')
        .where('selfDestruct', '==', true)
        .where('selfDestructTriggered', '==', false)
        .onSnapshot((snap) => {
            snap.forEach((doc) => {
                const d = doc.data();
                if (d.senderId === currentUser.id) return; // seul le/la destinataire d茅clenche la disparition 
                db.collection('chats').doc(CHAT_ID).collection('messages').doc(doc.id)
                    .update({ selfDestructTriggered: true }).catch(() => {});
                setTimeout(() => {
                    db.collection('chats').doc(CHAT_ID).collection('messages').doc(doc.id).delete().catch(() => {});
                }, 4000);
            });
        });
}

// ========== EXPORT "NOTRE HISTOIRE" ==========
// G茅n猫re un fichier HTML autonome et esth茅tique (t茅l茅chargeable, imprimable en PDF
// depuis le navigateur) : tous les messages texte en journal chronologique, + les
// photos du mois en galerie. Rien n'est envoy茅 脿 un serveur externe, tout se passe
// dans le t茅l茅phone.
async function exporterNotreHistoire() {
    // Si d茅j脿 ouvert, on ne relance pas une deuxi猫me fois
    if (document.getElementById('histoire-overlay')) return;
    showTempNotification('馃摉 Pr茅paration de votre histoire...');
    try {
        const snap = await db.collection('chats').doc(CHAT_ID).collection('messages')
            .orderBy('timestamp', 'asc').get();

        const debutMois = new Date(); debutMois.setDate(1); debutMois.setHours(0, 0, 0, 0);
        const messages = [];
        const photosDuMois = [];

        snap.forEach(doc => {
            const d = doc.data();
            if (!d.timestamp || !d.timestamp.toDate) return;
            const date = d.timestamp.toDate();
            if (d.type === 'image' && d.mediaUrl && date >= debutMois) {
                photosDuMois.push({ url: d.mediaUrl, date, senderName: d.senderName });
            }
            if ((d.type === 'text' || !d.type) && d.text) {
                messages.push({ text: d.text, date, senderName: d.senderName, senderId: d.senderId });
            }
        });

        if (messages.length === 0 && photosDuMois.length === 0) {
            showTempNotification("Pas encore assez de souvenirs 脿 exporter 馃挏");
            return;
        }

        const debutCouple = new Date(DATE_DEBUT_COUPLE + 'T00:00:00');
        const joursEnsemble = Math.max(0, Math.floor((new Date() - debutCouple) / 86400000));
        const nomA = currentUser ? currentUser.name : 'Nous';
        const nomB = targetUser ? targetUser.name : '';

        // Regroupement des messages par jour
        const parJour = {};
        messages.forEach(m => {
            const cle = m.date.toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' });
            if (!parJour[cle]) parJour[cle] = [];
            parJour[cle].push(m);
        });

        let journalHtml = '';
        Object.keys(parJour).forEach(jour => {
            journalHtml += `<div class="ni-jour"><div class="ni-jour-titre">${jour}</div>`;
            parJour[jour].forEach(m => {
                journalHtml += `<div class="ni-msg"><span class="ni-msg-auteur">${escapeHtmlTexte(m.senderName || '')}</span><span class="ni-msg-heure">${m.date.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' })}</span><div class="ni-msg-texte">${escapeHtmlTexte(m.text)}</div></div>`;
            });
            journalHtml += `</div>`;
        });

        let galerieHtml = '';
        if (photosDuMois.length > 0) {
            galerieHtml = `<div class="ni-section-titre">馃摳 Ce mois-ci en photos</div><div class="ni-galerie">`;
            photosDuMois.forEach(p => {
                galerieHtml += `<div class="ni-photo"><img src="${p.url}" loading="lazy"></div>`;
            });
            galerieHtml += `</div>`;
        }

        const html = `<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Notre Histoire</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
    * { margin:0; padding:0; box-sizing:border-box; }
    body { font-family:'Inter',sans-serif; background:#fdf6f0; color:#2c2c2c; line-height:1.5; }
    .ni-cover { background:linear-gradient(135deg,#a800ff,#ff007f,#ff7300); color:#fff; text-align:center; padding:70px 20px 90px; }
    .ni-cover h1 { font-family:'Playfair Display',serif; font-size:2.6rem; margin-bottom:10px; opacity:0; animation:niFadeUp 1s ease forwards; }
    .ni-cover .ni-noms { font-size:1.1rem; opacity:0; animation:niFadeUp 1s ease 0.2s forwards; }
    .ni-cover .ni-jours { font-size:3.2rem; font-weight:700; margin-top:24px; opacity:0; animation:niFadeUp 1s ease 0.4s forwards; }
    .ni-cover .ni-jours-label { font-size:0.9rem; opacity:0.85; }
    @keyframes niFadeUp { from { opacity:0; transform:translateY(18px); } to { opacity:1; transform:translateY(0); } }
    .ni-content { max-width:640px; margin:-50px auto 60px; padding:0 18px; }
    .ni-section-titre { font-family:'Playfair Display',serif; font-size:1.4rem; margin:36px 0 16px; text-align:center; color:#a800ff; }
    .ni-galerie { display:grid; grid-template-columns:repeat(auto-fill,minmax(140px,1fr)); gap:10px; }
    .ni-photo { border-radius:14px; overflow:hidden; box-shadow:0 6px 18px rgba(0,0,0,0.12); aspect-ratio:1/1; opacity:0; animation:niFadeUp 0.6s ease forwards; }
    .ni-photo img { width:100%; height:100%; object-fit:cover; display:block; }
    .ni-jour { background:#fff; border-radius:18px; padding:18px 20px; margin-bottom:16px; box-shadow:0 6px 18px rgba(0,0,0,0.06); opacity:0; animation:niFadeUp 0.6s ease forwards; }
    .ni-jour-titre { font-family:'Playfair Display',serif; font-weight:700; color:#ff007f; margin-bottom:10px; text-transform:capitalize; }
    .ni-msg { padding:8px 0; border-top:1px solid #f1e8f5; }
    .ni-msg:first-of-type { border-top:none; }
    .ni-msg-auteur { font-weight:600; font-size:0.8rem; color:#a800ff; margin-right:8px; }
    .ni-msg-heure { font-size:0.7rem; color:#999; }
    .ni-msg-texte { margin-top:2px; font-size:0.92rem; white-space:pre-wrap; word-break:break-word; }
    .ni-footer { text-align:center; padding:30px; color:#a88; font-size:0.8rem; }
</style>
</head>
<body>
    <div class="ni-cover">
        <h1>馃挏 Notre Histoire</h1>
        <div class="ni-noms">${escapeHtmlTexte(nomA)} &amp; ${escapeHtmlTexte(nomB)}</div>
        <div class="ni-jours">${joursEnsemble}</div>
        <div class="ni-jours-label">jours ensemble</div>
    </div>
    <div class="ni-content">
        ${galerieHtml}
        <div class="ni-section-titre">馃摂 Notre journal</div>
        ${journalHtml}
    </div>
    <div class="ni-footer">G茅n茅r茅 depuis CHAT-IDA le ${new Date().toLocaleDateString('fr-FR')} 馃挏</div>
    <script>
        // Petite animation d'apparition en d茅filant, pour un rendu plus vivant 脿 l'ouverture.
        const niObs = new IntersectionObserver((entries) => {
            entries.forEach(e => { if (e.isIntersecting) e.target.style.animationPlayState = 'running'; });
        }, { threshold: 0.1 });
        document.querySelectorAll('.ni-jour, .ni-photo').forEach(el => niObs.observe(el));
    <\/script>
</body>
</html>`;

        ouvrirHistoireEnIframe(html);
    } catch (e) {
        console.error('Erreur export Notre histoire:', e);
        showTempNotification("鉂? Erreur pendant l'export, r茅essaie");
    }
}

// Affiche "Notre histoire" en plein 茅cran dans une iframe, exactement comme la Galerie et 脡tude.
function ouvrirHistoireEnIframe(html) {
    if (document.getElementById('histoire-overlay')) return;

    const overlay = document.createElement('div');
    overlay.id = 'histoire-overlay';
    overlay.style.cssText = `
        position: fixed; top: 0; left: 0; width: 100%; height: 100%;
        background: rgba(0, 0, 0, 0.92);
        backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
        z-index: 99999; display: flex; flex-direction: column;
        animation: fadeInOverlay 0.3s ease;
    `;

    const header = document.createElement('div');
    header.style.cssText = `
        background: linear-gradient(135deg, #4f0a2e, #a800ff, #4f0a2e);
        background-size: 200% 200%;
        animation: gradientMove 4s ease infinite;
        padding: 12px 20px; display: flex; justify-content: space-between; align-items: center;
        border-bottom: 2px solid #ff007f; flex-shrink: 0; min-height: 60px; z-index: 10;
    `;
    header.innerHTML = `
        <div style="display:flex; align-items:center; gap:12px;">
            <i class="fa-solid fa-book-open" style="color:#ff007f; font-size:1.3rem;"></i>
            <span style="color:white; font-weight:700; font-size:1.1rem; letter-spacing:0.5px;">馃摉 Notre Histoire</span>
        </div>
        <button id="btn-fermer-histoire" style="
            background: rgba(255, 50, 50, 0.15); border: 1px solid rgba(255, 50, 50, 0.3);
            color: #ff6b6b; padding: 8px 20px; border-radius: 25px; cursor: pointer;
            font-size: 0.9rem; font-weight: 600; transition: all 0.3s ease;
            display: flex; align-items: center; gap: 8px;
        "
        onmouseover="this.style.background='rgba(255,50,50,0.3)'; this.style.transform='scale(1.05)';"
        onmouseout="this.style.background='rgba(255,50,50,0.15)'; this.style.transform='scale(1)';">
            <i class="fa-solid fa-xmark"></i> Quitter
        </button>
    `;

    setTimeout(() => {
        const btnFermer = document.getElementById('btn-fermer-histoire');
        if (btnFermer) {
            btnFermer.onclick = function() {
                const overlayEl = document.getElementById('histoire-overlay');
                if (overlayEl) {
                    overlayEl.style.transition = 'all 0.3s ease';
                    overlayEl.style.opacity = '0';
                    overlayEl.style.transform = 'scale(0.95)';
                    setTimeout(() => {
                        overlayEl.remove();
                        document.body.style.overflow = '';
                    }, 300);
                }
            };
        }
    }, 100);

    const iframe = document.createElement('iframe');
    iframe.id = 'histoire-iframe';
    // Pas de fichier "histoire.html" s茅par茅 sur le serveur : le contenu est g茅n茅r茅 脿 la
    // vol茅e depuis vos messages/photos r茅els, donc on l'injecte directement via srcdoc
    // plut么t que via une URL 鈥? le rendu et le comportement (plein 茅cran, quitter) sont
    // identiques 脿 la Galerie et 脿 脡tude.
    iframe.srcdoc = html;
    iframe.style.cssText = `flex: 1; width: 100%; border: none; background: #fdf6f0; display: block;`;

    overlay.appendChild(header);
    overlay.appendChild(iframe);
    document.body.appendChild(overlay);
    document.body.style.overflow = 'hidden';
    showTempNotification('馃摉 "Notre histoire" est pr锚te !');
}
// ========== D脡TECTION DU CLAVIER POUR CACHER LA BARRE (MOBILE) ==========
function detecterClavierMobile() {
    const toolbar = document.getElementById('etude-toolbar');
    if (!toolbar) return;
    
    // D茅tecter l'ouverture du clavier via le focus sur les inputs
    const inputs = document.querySelectorAll('input, textarea, [contenteditable="true"]');
    
    inputs.forEach(input => {
        input.addEventListener('focus', function() {
            // V茅rifier si c'est un mobile (largeur < 768px)
            if (window.innerWidth < 768) {
                toolbar.classList.add('hidden-keyboard');
                toolbar.classList.remove('visible-keyboard');
            }
        });
        
        input.addEventListener('blur', function() {
            if (window.innerWidth < 768) {
                // Petit d茅lai pour s'assurer que le clavier est bien ferm茅
                setTimeout(() => {
                    toolbar.classList.remove('hidden-keyboard');
                    toolbar.classList.add('visible-keyboard');
                }, 300);
            }
        });
    });
    
    // D茅tecter le redimensionnement (le clavier change la hauteur)
    let lastHeight = window.innerHeight;
    window.addEventListener('resize', function() {
        if (window.innerWidth < 768) {
            const currentHeight = window.innerHeight;
            // Si la hauteur diminue significativement, le clavier est probablement ouvert
            if (currentHeight < lastHeight - 150) {
                toolbar.classList.add('hidden-keyboard');
                toolbar.classList.remove('visible-keyboard');
            } else if (currentHeight > lastHeight + 150) {
                // Le clavier s'est ferm茅
                setTimeout(() => {
                    toolbar.classList.remove('hidden-keyboard');
                    toolbar.classList.add('visible-keyboard');
                }, 300);
            }
            lastHeight = currentHeight;
        }
    });
}

// ========== GESTION DU CLAVIER MOBILE VIA visualViewport (moderne, fiable) ==========
// Redimensionne pr茅cis茅ment .app-container 脿 la hauteur visible r茅elle (donc EXCLUANT le
// clavier virtuel), ce qui garde le header fixe en haut, colle la barre de saisie juste
// au-dessus du clavier, et laisse la zone de messages se contracter proprement au milieu.
function initGestionClavierVisualViewport() {
    if (!window.visualViewport) return; // repli sur 100dvh (d茅j脿 en place) si non support茅
    const appContainer = document.querySelector('.app-container');
    if (!appContainer) return;

    const ajusterHauteur = () => {
        appContainer.style.height = window.visualViewport.height + 'px';
        // Garde la conversation scroll茅e en bas quand on tape, pour ne jamais perdre
        // de vue le message en cours de saisie.
        const actif = document.activeElement;
        if (actif && (actif.tagName === 'TEXTAREA' || actif.tagName === 'INPUT')) {
            const msgArea = document.getElementById('msg-area');
            if (msgArea) requestAnimationFrame(() => { msgArea.scrollTop = msgArea.scrollHeight; });
        }
    };

    window.visualViewport.addEventListener('resize', ajusterHauteur);
    window.visualViewport.addEventListener('scroll', ajusterHauteur);
    ajusterHauteur();
}
document.addEventListener('DOMContentLoaded', function() {
    setTimeout(initGestionClavierVisualViewport, 300);
});

// ========== INITIALISATION ==========
document.addEventListener('DOMContentLoaded', function() {
    // D茅tecter le clavier apr猫s un petit d茅lai (pour que le DOM soit pr锚t)
    setTimeout(detecterClavierMobile, 500);
});

// Exposer les fonctions globalement
window.ouvrirEtude = ouvrirEtude;
window.fermerEtude = fermerEtude;
window.ouvrirJeux = ouvrirJeux;
window.ouvrirEffets = ouvrirEffets;
  
  // ========== COULEURS PERSONNALIS脡ES POUR LES BULLES ==========
  // 鉁? Version nettoy茅e : ces fonctions n'existent plus qu'UNE seule fois dans le
  // fichier (avant elles 茅taient dupliqu茅es, ce qui rendait le code fragile) et
  // utilisent toutes appliquerRenduBulleMessage() pour rester 100% coh茅rentes avec
  // ce que la synchronisation temps r茅el affichera.

// Fonction pour obtenir une couleur de texte contrast茅e
function getContrastColor(hexColor) {
    if (!hexColor || !hexColor.startsWith('#')) {
        return '#ffffff';
    }
    try {
        const r = parseInt(hexColor.slice(1, 3), 16);
        const g = parseInt(hexColor.slice(3, 5), 16);
        const b = parseInt(hexColor.slice(5, 7), 16);
        const luminance = (0.299 * r + 0.587 * g + 0.114 * b) / 255;
        return luminance > 0.5 ? '#000000' : '#ffffff';
    } catch(e) {
        return '#ffffff';
    }
}

// Ouvrir le s茅lecteur de couleur (pour LE message s茅lectionn茅 uniquement)
function openColorPickerForMessage() {
    if (!selectedMessageId) {
        showTempNotification("鉂? S茅lectionne d'abord un message");
        return;
    }

    const messageRow = document.querySelector(`[data-id="${selectedMessageId}"]`);
    if (!messageRow || !messageRow.classList.contains('sent')) {
        showTempNotification("鉂? Tu ne peux colorer que TES messages !");
        return;
    }

    document.getElementById('color-picker-modal').style.display = 'flex';
    hideContextMenus();
    closeStyleMenu();
}

// Fermer le s茅lecteur
function closeColorPicker() {
    document.getElementById('color-picker-modal').style.display = 'none';
}

// Appliquer la couleur personnalis茅e UNIQUEMENT au message s茅lectionn茅
async function applyCustomColorToMessage() {
    if (!selectedMessageId) {
        closeColorPicker();
        return;
    }

    const color = document.getElementById('custom-color-picker').value;
    await applyColorToMessage(selectedMessageId, color);
    closeColorPicker();
}

// Fonction principale pour appliquer une couleur 脿 UN message pr茅cis
async function applyColorToMessage(msgId, color) {
    const messageRow = document.querySelector(`[data-id="${msgId}"]`);
    if (!messageRow || !messageRow.classList.contains('sent')) {
        showTempNotification("鉂? Tu ne peux colorer que TES messages !");
        return;
    }

    const nouvellesDonnees = { customColor: color, customGradient: null, bubbleStyle: null };

    // Appliquer visuellement TOUT DE SUITE (optimiste), uniquement sur CE message
    const bubble = messageRow.querySelector('.message-bubble');
    appliquerRenduBulleMessage(bubble, messageRow, nouvellesDonnees);

    // Puis sauvegarder dans Firestore (ce qui d茅clenchera aussi la synchro temps r茅el
    // chez l'autre personne, et re-confirmera l'affichage local)
    await db.collection('chats').doc(CHAT_ID).collection('messages').doc(msgId).update(nouvellesDonnees);

    showTempNotification(`馃帹 Couleur appliqu茅e !`);
    selectedMessageId = null;
    hideContextMenus();
    closeStyleMenu();
}

// Appliquer un d茅grad茅 脿 UN message pr茅cis
async function applyGradientToMessage() {
    if (!selectedMessageId) {
        showTempNotification("鉂? S茅lectionne d'abord un message");
        return;
    }

    const messageRow = document.querySelector(`[data-id="${selectedMessageId}"]`);
    if (!messageRow || !messageRow.classList.contains('sent')) {
        showTempNotification("鉂? Tu ne peux colorer que TES messages !");
        return;
    }

    const color1 = prompt("馃帹 Couleur 1 (ex: #ff0000 ou red) :", "#a800ff");
    if (!color1) return;
    const color2 = prompt("馃帹 Couleur 2 (ex: #0076ff ou blue) :", "#0076ff");
    if (!color2) return;

    const gradient = `linear-gradient(135deg, ${color1}, ${color2})`;
    const msgId = selectedMessageId;
    const nouvellesDonnees = { customGradient: gradient, customColor: null, bubbleStyle: null };

    // Appliquer visuellement TOUT DE SUITE, uniquement sur CE message
    const bubble = messageRow.querySelector('.message-bubble');
    appliquerRenduBulleMessage(bubble, messageRow, nouvellesDonnees);

    await db.collection('chats').doc(CHAT_ID).collection('messages').doc(msgId).update(nouvellesDonnees);

    showTempNotification(`馃寛 D茅grad茅 appliqu茅 !`);
    selectedMessageId = null;
    hideContextMenus();
    closeStyleMenu();
}

// Supprimer la couleur personnalis茅e d'UN message pr茅cis
async function removeCustomColorFromMessage() {
    if (!selectedMessageId) {
        showTempNotification("鉂? S茅lectionne d'abord un message");
        return;
    }

    const messageRow = document.querySelector(`[data-id="${selectedMessageId}"]`);
    if (!messageRow || !messageRow.classList.contains('sent')) {
        showTempNotification("鉂? Tu ne peux supprimer la couleur que de TES messages !");
        return;
    }

    const msgId = selectedMessageId;
    const nouvellesDonnees = { customColor: null, customGradient: null };

    const bubble = messageRow.querySelector('.message-bubble');
    // On garde le bubbleStyle existant s'il y en avait un (on ne le touche pas ici)
    appliquerRenduBulleMessage(bubble, messageRow, { customColor: null, customGradient: null, bubbleStyle: null });

    await db.collection('chats').doc(CHAT_ID).collection('messages').doc(msgId).update(nouvellesDonnees);

    showTempNotification("馃棏锔? Couleur supprim茅e !");
    selectedMessageId = null;
    hideContextMenus();
    closeStyleMenu();
}


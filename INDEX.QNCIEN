            <div style="width:30px;height:30px;border-radius:50%;background:#ff6b00;cursor:pointer;" onclick="document.getElementById('custom-color-picker').value='#ff6b00'"></div>
            <div style="width:30px;height:30px;border-radius:50%;background:#ffd700;cursor:pointer;" onclick="document.getElementById('custom-color-picker').value='#ffd700'"></div>
            <div style="width:30px;height:30px;border-radius:50%;background:#00cc44;cursor:pointer;" onclick="document.getElementById('custom-color-picker').value='#00cc44'"></div>
            <div style="width:30px;height:30px;border-radius:50%;background:#0095f6;cursor:pointer;" onclick="document.getElementById('custom-color-picker').value='#0095f6'"></div>
            <div style="width:30px;height:30px;border-radius:50%;background:#a800ff;cursor:pointer;" onclick="document.getElementById('custom-color-picker').value='#a800ff'"></div>
            <div style="width:30px;height:30px;border-radius:50%;background:#ff00ff;cursor:pointer;" onclick="document.getElementById('custom-color-picker').value='#ff00ff'"></div>
            <div style="width:30px;height:30px;border-radius:50%;background:#000000;cursor:pointer;border:1px solid #ccc;" onclick="document.getElementById('custom-color-picker').value='#000000'"></div>
            <div style="width:30px;height:30px;border-radius:50%;background:#ffffff;cursor:pointer;border:1px solid #ccc;" onclick="document.getElementById('custom-color-picker').value='#ffffff'"></div>

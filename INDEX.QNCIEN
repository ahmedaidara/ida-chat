 async function initialiserProfilsParDefaut() {
    const profilsParDefaut = {
        ida: { birthdate: '06/04/2006', location: 'WAKHIM NIMZAT' },
        aidara: { birthdate: '10/01/2005', location: 'SACRE COEUR 3' }
    };
    for (const [id, profil] of Object.entries(profilsParDefaut)) {
        try {
            const doc = await db.collection('users').doc(id).get();
            const dejaProfil = doc.exists && doc.data().profile && doc.data().profile.birthdate;

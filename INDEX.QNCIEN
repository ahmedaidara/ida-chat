// =========================================================================
// STATUT EN LIGNE/HORS LIGNE AVEC HEURE EXACTE DE D脡CONNEXION (CORRIG脡)
// =========================================================================

// 1. 脡tat global du statut (Concerne uniquement l'utilisateur local)
const STATUT_UTILISATEUR = {
    estActif: false,
    derniereAction: Date.now(),
    ecranVisible: true,
    pingInterval: null,
    statutListener: null,
    heureDeconnexion: null
};

// 2. Fonction pour mettre 脿 jour mon statut dans Firestore
function mettreAJourStatutUtilisateur(estEnLigne, type = 'manuel') {
    if (!currentUser) return;
    
    const userRef = db.collection('users').doc(currentUser.id);
    const maintenant = firebase.firestore.FieldValue.serverTimestamp();
    const maintenantDate = new Date();
    
    if (!estEnLigne) {
        STATUT_UTILISATEUR.heureDeconnexion = maintenantDate;
        console.log(`鈴? Ma d茅connexion sauvegard茅e: ${maintenantDate.toLocaleTimeString()}`);
    } else {
        STATUT_UTILISATEUR.heureDeconnexion = null;
    }
    
    userRef.set({
        online: estEnLigne,
        lastSeen: maintenant,
        lastSeenExact: maintenantDate.toISOString(),
        heureDeconnexion: STATUT_UTILISATEUR.heureDeconnexion ? STATUT_UTILISATEUR.heureDeconnexion.toISOString() : null,
        userId: currentUser.id,
        userName: currentUser.name,
        lastActivity: maintenant,
        statusType: type
    }, { merge: true }).then(() => {
        console.log(`馃搳 Mon statut mis 脿 jour: ${estEnLigne ? '馃煝 EN LIGNE' : '鈿? HORS LIGNE'} (${type})`);
    }).catch(err => console.error("Erreur mise 脿 jour statut:", err));
}

// 3. D茅tection de mes actions (Envoie les donn茅es 脿 Firestore, SANS toucher 脿 l'茅cran)
function detecterActiviteEcran() {
    document.addEventListener('visibilitychange', function() {
        if (document.hidden) {
            console.log("馃摫 Mon 茅cran est en arri猫re-plan 鈫? Hors ligne");
            STATUT_UTILISATEUR.ecranVisible = false;
            mettreAJourStatutUtilisateur(false, 'background');
        } else {
            console.log("馃摫 Mon 茅cran est visible 鈫? En ligne");
            STATUT_UTILISATEUR.ecranVisible = true;
            STATUT_UTILISATEUR.derniereAction = Date.now();
            mettreAJourStatutUtilisateur(true, 'visible');
        }
    });
    
    window.addEventListener('beforeunload', function() {
        mettreAJourStatutUtilisateur(false, 'depart');
    });
    
    // 'pagehide' est d茅clench茅 de fa莽on bien plus fiable que 'beforeunload' sur mobile
    // (Safari iOS / apps PWA en arri猫re-plan), ce qui 茅vite qu'un utilisateur reste
    // affich茅 芦 en ligne 禄 alors qu'il a quitt茅 le site.
    window.addEventListener('pagehide', function() {
        mettreAJourStatutUtilisateur(false, 'depart');
    });
    
    let tempsInactivite = Date.now();
    let estInactif = false;
    
    const resetInactivite = () => {
        tempsInactivite = Date.now();
        STATUT_UTILISATEUR.derniereAction = Date.now();
        
        if (STATUT_UTILISATEUR.ecranVisible && !document.hidden && estInactif) {
            estInactif = false;
            mettreAJourStatutUtilisateur(true, 'actif');
        }
    };
    
    // 脡couter mes mouvements
    const events = ['click', 'touchstart', 'scroll', 'keydown', 'mousemove', 'focus'];
    events.forEach(event => {
        document.addEventListener(event, resetInactivite, { passive: true });
    });
    
    // V茅rifier mon inactivit茅 toutes les 5 secondes
    setInterval(() => {
        const now = Date.now();
        const diff = now - tempsInactivite;
        
        if (diff > 30000 && STATUT_UTILISATEUR.ecranVisible && !document.hidden && !estInactif) {
            estInactif = true;
            console.log("鈴? Je suis inactif depuis 30s 鈫? Hors ligne");
            mettreAJourStatutUtilisateur(false, 'inactif');
        }
    }, 5000);
    
    // Mon Ping p茅riodique
    STATUT_UTILISATEUR.pingInterval = setInterval(() => {
        if (!document.hidden && STATUT_UTILISATEUR.ecranVisible) {
            const diff = Date.now() - STATUT_UTILISATEUR.derniereAction;
            if (diff < 30000) {
                mettreAJourStatutUtilisateur(true, 'ping');
            }
        }
    }, 10000);
}

// ========== 脡COUTER LE STATUT DE L'AUTRE (AVEC DERNIER APPAREIL) ==========
function ecouterStatutAutreAvecHorodatage() {
    if (!currentUser || !targetUser) return;
    
    console.log(`馃憖 脡coute du statut de ${targetUser.name}...`);
    
    // 鈿狅笍 IMPORTANT : ce listener utilise SA PROPRE variable (window._presenceListener),
    // distincte de window._statutListener (utilis茅e par les accus茅s de lecture).
    // Avant cette correction, les deux syst猫mes partageaient la m锚me variable globale :
    // chacun annulait silencieusement l'茅couteur de l'autre en d茅marrant, ce qui gelait
    // le statut 芦 en ligne 禄/humeur affich茅 sur l'茅cran du destinataire.
    if (window._presenceListener) {
        window._presenceListener();
        window._presenceListener = null;
    }
    
    const statusSpan = document.getElementById('header-status-text');
    if (!statusSpan) return;
    
    window._presenceListener = db.collection('users').doc(targetUser.id)
        .onSnapshot((doc) => {
            if (!doc.exists) {
                statusSpan.innerHTML = `<span style="color: #8696a0;">鈿? Hors ligne</span>`;
                return;
            }
            
            const data = doc.data();
            const estEnLigne = data.online === true;
            
            // R茅cup茅rer l'heure de d茅connexion
            let heureDeconnexion = null;
            if (data.heureDeconnexion) {
                heureDeconnexion = new Date(data.heureDeconnexion);
            } else if (data.lastSeen) {
                heureDeconnexion = data.lastSeen.toDate ? data.lastSeen.toDate() : new Date(data.lastSeen);
            }
            
            // V茅rifier si vraiment en ligne
            let estVraimentEnLigne = false;
            if (estEnLigne && data.lastSeen) {
                const lastSeenDate = data.lastSeen.toDate ? data.lastSeen.toDate() : new Date(data.lastSeen);
                const diffSecondes = (Date.now() - lastSeenDate.getTime()) / 1000;
                if (diffSecondes < 35) {
                    estVraimentEnLigne = true;
                }
            }
            
            // ============================================================
            // 猸愨瓙猸? PARTIE BATTERIE - DERNIER APPAREIL UTILIS脡 猸愨瓙猸?
            // ============================================================
            
            // R茅cup茅rer la batterie du DERNIER appareil utilis茅
            let batterie = null;
            
            // 1. V茅rifier si la batterie est dans les donn茅es principales (dernier appareil)
            if (data.battery) {
                batterie = {
                    level: data.battery.level || 0,
                    charging: data.battery.charging || false,
                    deviceId: data.battery.deviceId || 'default',
                    lastUpdate: data.battery.lastUpdate || data.lastSeen || new Date()
                };
                console.log(`馃攱 Batterie du dernier appareil: ${batterie.level}%`);
            }
            
            // 2. Si plusieurs appareils, prendre le dernier mis 脿 jour
            if (data.devices && Array.isArray(data.devices) && data.devices.length > 0) {
                // Trier les appareils par date de derni猫re mise 脿 jour (le plus r茅cent en premier)
                const devicesSorted = [...data.devices].sort((a, b) => {
                    const dateA = a.lastUpdate ? new Date(a.lastUpdate) : new Date(0);
                    const dateB = b.lastUpdate ? new Date(b.lastUpdate) : new Date(0);
                    return dateB - dateA;
                });
                
                // Prendre le dernier appareil utilis茅
                const dernierAppareil = devicesSorted[0];
                if (dernierAppareil && dernierAppareil.battery) {
                    batterie = {
                        level: dernierAppareil.battery.level || 0,
                        charging: dernierAppareil.battery.charging || false,
                        deviceId: dernierAppareil.deviceId || 'unknown',
                        lastUpdate: dernierAppareil.lastUpdate || new Date()
                    };
                    console.log(`馃摫 Dernier appareil: ${dernierAppareil.deviceId || 'inconnu'} 鈫? ${batterie.level}%`);
                }
            }
            
            // 3. Fallback : utiliser la batterie du document principal
            if (!batterie && data.battery) {
                batterie = {
                    level: data.battery.level || 0,
                    charging: data.battery.charging || false,
                    deviceId: 'default',
                    lastUpdate: data.lastSeen || new Date()
                };
            }
            
            // ============================================================
            // AFFICHAGE
            // ============================================================
            
            // Statut
            let statutHtml = '';
            if (estVraimentEnLigne) {
                statutHtml = `<span style="color: #00cc44; font-weight: 600;">馃煝 En ligne</span>`;
            } else if (heureDeconnexion) {
                const h = heureDeconnexion.getHours().toString().padStart(2, '0');
                const m = heureDeconnexion.getMinutes().toString().padStart(2, '0');
                statutHtml = `<span style="color: #8696a0;">Vu 脿 ${h}:${m}</span>`;
            } else {
                statutHtml = `<span style="color: #8696a0;">Hors ligne</span>`;
            }
            
            // Batterie avec indicateur de dernier appareil
            let batteryHtml = '';
            if (batterie) {
                const level = batterie.level || 0;
                const charging = batterie.charging || false;
                const icon = charging ? '鈿?' : (level <= 15 ? '馃' : '馃攱');
                const colorClass = charging ? 'battery-charging' : (level <= 15 ? 'battery-low' : (level <= 30 ? 'battery-medium' : 'battery-high'));
                
                // Ajouter un petit indicateur si plusieurs appareils
                const deviceIndicator = (data.devices && data.devices.length > 1) ? ' 馃摫' : '';
                
                batteryHtml = `
                    <span class="battery-indicator" id="battery-indicator">
                        <span class="battery-icon" id="battery-icon">${icon}</span>
                        <span class="battery-percent ${colorClass}" id="battery-percent">${level}%${deviceIndicator}</span>
                    </span>
                `;
            } else {
                batteryHtml = `
                    <span class="battery-indicator" id="battery-indicator">
                        <span class="battery-icon" id="battery-icon">馃攱</span>
                        <span class="battery-percent" id="battery-percent">--%</span>
                    </span>
                `;
            }
            
            statusSpan.innerHTML = statutHtml + batteryHtml;
            
            // Mood
            if (data.mood) {
                const otherMoodSpan = document.getElementById('other-mood-emoji');
                if (otherMoodSpan) otherMoodSpan.textContent = data.mood.emoji || '馃槉';
            }
            
        }, (error) => {
            console.error("Erreur 茅coute statut:", error);
        });
}

// 5. Fonction pour forcer mon statut initial
function forcerStatutEnLigneSiVisible() {
    if (!currentUser) return;
    if (!document.hidden) {
        mettreAJourStatutUtilisateur(true, 'force');
    } else {
        mettreAJourStatutUtilisateur(false, 'force_background');
    }
}

// 6. Activer le syst猫me
function activerSystemeStatutComplet() {
    if (!currentUser || !targetUser) return;
    
    detecterActiviteEcran();
    
    setTimeout(() => {
        forcerStatutEnLigneSiVisible();
    }, 500);
    
    setTimeout(() => {
        ecouterStatutAutreAvecHorodatage();
    }, 1000);
}

// 7. Surcharger selectUser
const originalSelectUser6 = window.selectUser;
window.selectUser = function(userKey) {

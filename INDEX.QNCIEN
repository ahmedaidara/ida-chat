    let currentType = "gifs"; // "gifs", "stickers" ou "emoji"
    let jetonChargement = 0; // pour ignorer une r茅ponse r茅seau devenue p茅rim茅e (recherche tap茅e vite)
    let minuteurRecherche = null;

    if (!triggerBtn) return;

    // Ouvrir/fermer le tiroir
    triggerBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        if (drawer.style.display === 'none' || drawer.style.display === '') {
            positionnerTiroirGiphy();
            drawer.style.display = 'flex';
            afficherContenu();
        } else {
            drawer.style.display = 'none';
        }
    });

    // Basculer entre GIFs, Stickers et Emoji (3 modes)
    if (toggleBtn) {
        toggleBtn.addEventListener('click', () => {
            currentType = currentType === "gifs" ? "stickers" : (currentType === "stickers" ? "emoji" : "gifs");
            const libelles = { gifs: "馃帹 GIFS", stickers: "馃帾 STICKERS", emoji: "馃榾 EMOJI" };
            const couleurs = { gifs: "#f0f2f5", stickers: "#25D366", emoji: "#a855f7" };
            toggleBtn.innerHTML = libelles[currentType];
            toggleBtn.style.background = couleurs[currentType];
            toggleBtn.style.color = currentType === "gifs" ? "#000" : "#fff";
            if (searchInput) searchInput.value = "";
            afficherContenu();
        });
    }

    // Recherche (fonctionne pour les 3 modes, avec un l茅ger d茅lai pour ne pas
    // spammer l'API Giphy 脿 chaque frappe)
    if (searchInput) {
        searchInput.addEventListener('input', (e) => {
            const query = e.target.value.trim().toLowerCase();
            clearTimeout(minuteurRecherche);
            minuteurRecherche = setTimeout(() => afficherContenu(query), 350);
        });
    }

    // ========== CL脡 PUBLIQUE GIPHY (d茅mo officielle Giphy pour petits projets) ==========
    // Permet de piocher en direct dans TOUT le catalogue Giphy (tendances + recherche),
    // au lieu de se limiter aux quelques GIFs/stickers pr茅charg茅s ci-dessus, qui ne
    // servent plus que de secours si le r茅seau ou l'API sont indisponibles.
    const GIPHY_KEY = "dc6zaTOxFJmzC";

    async function chargerDepuisGiphy(type, query) {
        const base = type === "gifs" ? "https://api.giphy.com/v1/gifs" : "https://api.giphy.com/v1/stickers";
        const url = query
            ? `${base}/search?api_key=${GIPHY_KEY}&q=${encodeURIComponent(query)}&limit=36&rating=pg-13&lang=fr`
            : `${base}/trending?api_key=${GIPHY_KEY}&limit=36&rating=pg-13`;
        const res = await fetch(url);
        if (!res.ok) throw new Error("Giphy indisponible");
        const json = await res.json();
        return (json.data || []).map(item => ({
            url: (item.images.original || item.images.fixed_height).url,
            preview: (item.images.fixed_width_small || item.images.fixed_width || item.images.original).url,
            tags: (item.title || "").toLowerCase()
        }));
    }

    async function afficherContenu(query) {
        if (currentType === "emoji") {
            afficherEmoji(query);
            return;
        }

        const monJeton = ++jetonChargement;
        resultsContainer.style.gridTemplateColumns = "repeat(3, 1fr)";
        resultsContainer.innerHTML = '<div style="grid-column: span 3; text-align: center; padding: 20px; color: var(--text-muted);">鈴? Chargement...</div>';

        let contenu = [];
        try {
            contenu = await chargerDepuisGiphy(currentType, query);
            if (!contenu.length) throw new Error("Aucun r茅sultat Giphy");
        } catch (err) {
            // Repli hors-ligne : on utilise la petite collection pr茅charg茅e si l'API
            // Giphy est injoignable (pas de r茅seau, cl茅 bloqu茅e, etc.)
            const locale = currentType === "gifs" ? gifsPopulaires : stickersCollection;
            const source = locale.map(item => typeof item === "string" ? { url: item, preview: item, tags: "" } : item);
            contenu = query ? source.filter(g => (g.tags || "").includes(query)) : source;
            if (query && contenu.length === 0) contenu = source;
        }

        if (monJeton !== jetonChargement) return; // une recherche plus r茅cente a 茅t茅 lanc茅e entre-temps
        afficherMedias(contenu, currentType);
    }

    function afficherMedias(liste, type) {
        if (!resultsContainer) return;
        resultsContainer.innerHTML = "";

        if (!liste.length) {
            resultsContainer.innerHTML = `<div style="grid-column: span 3; text-align: center; padding: 20px; color: var(--text-muted);">馃槙 Aucun ${type === "gifs" ? "GIF" : "sticker"} trouv茅</div>`;
            return;
        }

        liste.forEach(raw => {
            const item = typeof raw === "string" ? { url: raw, preview: raw } : raw;
            const img = document.createElement('img');
            img.src = item.preview || item.url;
            img.loading = 'lazy';
            img.style.cssText = type === "stickers"
                ? "width: 80px; height: 80px; object-fit: contain; border-radius: 16px; cursor: pointer; transition: transform 0.2s; background: transparent; margin: auto;"
                : "width: 100%; height: 90px; object-fit: cover; border-radius: 12px; cursor: pointer; transition: transform 0.2s; border: 1px solid var(--border-color); background: var(--input-bg);";
            img.onmouseover = () => img.style.transform = type === "stickers" ? "scale(1.1)" : "scale(1.05)";
            img.onmouseout = () => img.style.transform = "scale(1)";
            img.onerror = () => { img.style.display = 'none'; };

            img.onclick = () => {
                envoyerMedia(type === "gifs" ? "gif" : "sticker", item.url || item.preview);
                drawer.style.display = 'none';
            };

            resultsContainer.appendChild(img);
        });
    }


function initialiserTiroirGiphy() {
    const drawer = document.getElementById('giphy-drawer');

    // 鈿狅笍 CORRECTIF : le tiroir 茅tait un enfant de .chat-input-bar, qui a un
    // "overflow: hidden !important" 鈥? comme le tiroir remonte au-dessus de la
    // barre via "bottom: 75px" en position absolute, il se faisait couper/
    // masquer par cet overflow du parent (il s'ouvrait bien en display:flex,
    // mais restait invisible). On le d茅place donc directement dans <body> en
    // position fixed, et on recalcule sa position 脿 chaque ouverture 脿 partir
    // de l'emplacement r茅el de la barre de saisie (fonctionne aussi bien en
    // plein 茅cran mobile que sur la carte centr茅e desktop).
    if (drawer && drawer.parentElement !== document.body) {
        document.body.appendChild(drawer);
        drawer.style.position = 'fixed';
    }
    function positionnerTiroirGiphy() {
        const barre = document.querySelector('.chat-input-bar');
        if (!drawer || !barre) return;
        const rect = barre.getBoundingClientRect();
        drawer.style.left = (rect.left + 10) + 'px';
        drawer.style.right = (window.innerWidth - rect.right + 10) + 'px';
        drawer.style.bottom = (window.innerHeight - rect.top + 10) + 'px';
    }
    const resultsContainer = document.getElementById('giphy-results');
    const searchInput = document.getElementById('giphy-search');
    const toggleBtn = document.getElementById('btn-toggle-type');
    const triggerBtn = document.getElementById('gif-trigger-btn');
    
    // ========== COLLECTION DE GIFS ==========
    // ========== COLLECTION DE GIFS - VERSION CORRIG脡E (i.giphy.com = fichier brut, media.giphy.com sert une page HTML et casse les <img>) ==========

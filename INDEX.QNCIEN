        senderId: currentUser.id,
        senderName: currentUser.name,
        timestamp: firebase.firestore.FieldValue.serverTimestamp(),
        status: "sent",
        readBy: [currentUser.id],
        type: "text",
        mediaUrl: null
    };

    if(replyToId) {
        const parentRow = document.querySelector(`[data-id="${replyToId}"]`);
        if(parentRow) {
            msgData.replyToId = replyToId;
            msgData.replyToText = obtenirTexteCompletMessage(parentRow);
            msgData.replyToSender = parentRow.classList.contains('sent') ? currentUser.name : targetUser.name;
        }
    }

    input.value = '';
    autoResizeTextarea();
    cancelReply();
    toggleSendBtn(false);
    stopTypingNotify();
    clearLiveTyping();

    const messageRef = db.collection('chats').doc(CHAT_ID).collection('messages').doc();
    await messageRef.set(msgData);
    setTimeout(() => checkMessageDelivery(messageRef.id), 3000);

    // 馃 Hook IA : @bot, /game, /quiz, d茅tection rappel/r茅sum茅 (silencieux si IA d茅sactiv茅e)
    if (!isCoded && !msgData.isSecretMessage) {
        handleIAApresEnvoi(finalText);
    }
}
      
      
   // ========== GESTION DES MESSAGES SECRETS ******** ==========
 // ========== GESTION DES MESSAGES SECRETS ******** ==========
let messagesSecretsUtilises = new Set();

function traiterMessagesSecrets() {
    document.querySelectorAll('.message-row').forEach(row => {
        const msgId = row.getAttribute('data-id');
        if (!msgId) return;
        
        const bubble = row.querySelector('.message-bubble');
        if (!bubble) return;
        
        const span = bubble.querySelector('span:not(.coded-mask)');
        if (!span) return;
        
        const textContent = span.textContent;
        
        // V茅rifier si c'est un message secret (5432 ou 2345)
        if (textContent === '********' || textContent === '馃柤锔? ********') {
            const isGalerie = textContent === '馃柤锔? ********';
            
            // V茅rifier si d茅j脿 utilis茅
            if (messagesSecretsUtilises.has(msgId)) {
                span.style.cursor = 'default';
                span.style.opacity = '0.5';
                span.style.color = '#888';
                span.style.textShadow = 'none';
                span.style.pointerEvents = 'none';
                span.style.background = 'transparent';
                return;
            }
            
            // V茅rifier dans Firestore si d茅j脿 utilis茅
            const docRef = db.collection('chats').doc(CHAT_ID).collection('messages').doc(msgId);
            docRef.get().then(doc => {
                if (doc.exists && doc.data().secretUsed === true) {
                    messagesSecretsUtilises.add(msgId);
                    span.style.cursor = 'default';
                    span.style.opacity = '0.5';
                    span.style.color = '#888';
                    span.style.textShadow = 'none';
                    span.style.pointerEvents = 'none';
                    span.style.background = 'transparent';
                    return;
                }
                
                // Style diff茅rent selon le type
                if (isGalerie) {
                    // Style pour GALERIE (couleur verte)
                    span.style.cursor = 'pointer';
                    span.style.color = '#00ff88';
                    span.style.fontWeight = 'bold';
                    span.style.textShadow = '0 0 15px rgba(0,255,136,0.4)';
                    span.style.transition = 'all 0.3s ease';
                    span.style.background = 'rgba(0,255,136,0.1)';
                    span.style.padding = '4px 12px';
                    span.style.borderRadius = '8px';
                    
                    // Ajouter badge 馃柤锔?
                    if (!span.querySelector('.secret-badge')) {
                        const badge = document.createElement('span');
                        badge.className = 'secret-badge';
                        badge.textContent = ' 馃柤锔?';
                        badge.style.fontSize = '0.8rem';
                        badge.style.opacity = '0.8';
                        span.appendChild(badge);
                    }
                } else {
                    // Style pour CARNET (couleur dor茅e)
                    span.style.cursor = 'pointer';
                    span.style.color = '#ffd700';
                    span.style.fontWeight = 'bold';
                    span.style.textShadow = '0 0 15px rgba(255,215,0,0.4)';
                    span.style.transition = 'all 0.3s ease';
                    span.style.background = 'rgba(255,215,0,0.1)';
                    span.style.padding = '4px 12px';
                    span.style.borderRadius = '8px';
                    
                    // Ajouter badge 馃攼
                    if (!span.querySelector('.secret-badge')) {
                        const badge = document.createElement('span');
                        badge.className = 'secret-badge';
                        badge.textContent = ' 馃攼';
                        badge.style.fontSize = '0.8rem';
                        badge.style.opacity = '0.8';
                        span.appendChild(badge);
                    }
                }
                
                // 脡v茅nement clic UNIQUE
                span.onclick = function(e) {
                    e.stopPropagation();
                    const msgIdRow = this.closest('.message-row').getAttribute('data-id');
                    
                    if (messagesSecretsUtilises.has(msgIdRow)) {
                        showTempNotification("馃敀 Ce message a d茅j脿 茅t茅 utilis茅");
                        return;
                    }
                    
                    // Marquer comme utilis茅 LOCALEMENT
                    messagesSecretsUtilises.add(msgIdRow);
                    
                    // D茅sactiver visuellement IMM脡DIATEMENT
                    this.style.transition = 'all 0.3s ease';
                    this.style.transform = 'scale(0.95)';
                    this.style.opacity = '0.6';
                    
                    // Mettre 脿 jour Firestore
                    const docRef2 = db.collection('chats').doc(CHAT_ID).collection('messages').doc(msgIdRow);
                    docRef2.update({ 
                        secretUsed: true,
                        usedAt: firebase.firestore.FieldValue.serverTimestamp()
                    }).catch(err => {
                        console.error("Erreur mise 脿 jour secret:", err);
                    });
                    
                    // D茅terminer quoi ouvrir
                    const estGalerie = span.textContent.includes('馃柤锔?');
                    
                    if (estGalerie) {
                     } else {
                     }
                    
                    setTimeout(() => {
                        this.style.cursor = 'default';
                        this.style.opacity = '0.4';
                        this.style.color = '#666';
                        this.style.textShadow = 'none';
                        this.style.background = 'transparent';
                        this.style.pointerEvents = 'none';
                        this.onclick = null;
                        
                        const badgeEl = this.querySelector('.secret-badge');
                        if (badgeEl) badgeEl.remove();
                        
                        // Ouvrir la bonne page
                        if (estGalerie) {
                            // Ouvrir galerie.html
                            if (typeof openGaleriePage === 'function') {
                                openGaleriePage();
                            } else {
                                // Fallback : ouvrir en iframe
                                ouvrirGalerieIframe();
                            }
                        } else {
                            // Ouvrir le carnet secret
                            if (typeof openSecretPageInIframe === 'function') {
                                openSecretPageInIframe();
                            }
                        }
                    }, 500);
                };
            }).catch(err => {
                console.error("Erreur v茅rification secret:", err);
            });
        }
    });
}
      
      
      // ========== OUVERTURE DE GALERIE.HTML EN IFRAME ==========
function ouvrirGalerieIframe() {
    // V茅rifier si d茅j脿 ouvert
    if (document.getElementById('galerie-overlay')) {
        return;
    }

    const overlay = document.createElement('div');
    overlay.id = 'galerie-overlay';
    overlay.style.cssText = `
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.92);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        z-index: 99999;
        display: flex;
        flex-direction: column;
        animation: fadeInOverlay 0.3s ease;
    `;

    // Header avec bouton quitter
    const header = document.createElement('div');
    header.style.cssText = `
        background: linear-gradient(135deg, #0a2e1a, #1b693d, #0a2e1a);
        background-size: 200% 200%;
        animation: gradientMove 4s ease infinite;
        padding: 12px 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 2px solid #00ff88;
        flex-shrink: 0;
        min-height: 60px;
        z-index: 10;
    `;
    header.innerHTML = `
        <div style="display:flex; align-items:center; gap:12px;">
            <i class="fa-solid fa-images" style="color:#00ff88; font-size:1.3rem;"></i>
            <span style="color:white; font-weight:700; font-size:1.1rem; letter-spacing:0.5px;">馃柤锔? Galerie</span>
            <span style="color:rgba(255,255,255,0.3); font-size:0.7rem; border-left:1px solid rgba(255,255,255,0.1); padding-left:10px;">馃摳 Photos</span>
        </div>
        <button id="btn-fermer-galerie" style="
            background: rgba(255, 50, 50, 0.15);
            border: 1px solid rgba(255, 50, 50, 0.3);
            color: #ff6b6b;
            padding: 8px 20px;
            border-radius: 25px;
            cursor: pointer;
            font-size: 0.9rem;
            font-weight: 600;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 8px;
        " 
        onmouseover="this.style.background='rgba(255,50,50,0.3)'; this.style.transform='scale(1.05)';"
        onmouseout="this.style.background='rgba(255,50,50,0.15)'; this.style.transform='scale(1)';">
            <i class="fa-solid fa-xmark"></i> Quitter
        </button>
    `;
    
    // Ajouter l'茅v茅nement de fermeture
    setTimeout(() => {
        const btnFermer = document.getElementById('btn-fermer-galerie');
        if (btnFermer) {
            btnFermer.onclick = function() {
                const overlayEl = document.getElementById('galerie-overlay');
                if (overlayEl) {
                    overlayEl.style.transition = 'all 0.3s ease';
                    overlayEl.style.opacity = '0';
                    overlayEl.style.transform = 'scale(0.95)';
                    setTimeout(() => {
                        overlayEl.remove();
                        document.body.style.overflow = '';
                    }, 300);
                }
            };
        }
    }, 100);

    // Iframe vers galerie.html
    const iframe = document.createElement('iframe');
    iframe.id = 'galerie-iframe';
    iframe.src = 'galerie.html';
    iframe.style.cssText = `
        flex: 1;
        width: 100%;
        border: none;
        background: #0a0a0a;
        display: block;
    `;

    overlay.appendChild(header);
    overlay.appendChild(iframe);
    document.body.appendChild(overlay);
    document.body.style.overflow = 'hidden';
}

// Exposer la fonction globalement
window.openGaleriePage = ouvrirGalerieIframe;
        // ========== 脡COUTE EN TEMPS R脡EL DES MESSAGES SECRETS ==========
function ecouterMessagesSecretsTempsReel() {
    if (!currentUser) return;
    
    db.collection('chats').doc(CHAT_ID).collection('messages')
        .where('isSecretMessage', '==', true)
        .onSnapshot((snapshot) => {
            snapshot.docChanges().forEach((change) => {
                if (change.type === 'added' || change.type === 'modified') {
                    setTimeout(traiterMessagesSecrets, 300);
                }
            });
        }, (error) => {
            console.error("Erreur 茅coute messages secrets:", error);
        });
}
      
        function generateMask(length) {
            const chars = ['#', '@', '脳', '/', '+', '-', '鈥?', '鈽?', '鈼?', '鈻?', '鈻?', '鈼?', '鈼?', '鈼?', '鈾?', '鈾?', '鈾?', '鈾?'];
            let mask = '';
            for (let i = 0; i < length; i++) {
                mask += chars[Math.floor(Math.random() * chars.length)];
            }
            return mask;
        }
        

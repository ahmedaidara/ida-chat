       async function setMood(emoji, label) {
    currentMood = { emoji, label };
    document.getElementById('mood-emoji').textContent = emoji;
    const moodDiv = document.getElementById('mood-status');
    moodDiv.classList.add('animated');
    setTimeout(() => moodDiv.classList.remove('animated'), 2000);
    
    // Sauvegarder dans Firestore
    await db.collection('users').doc(currentUser.id).set({ 
        mood: currentMood, 
        lastUpdate: firebase.firestore.FieldValue.serverTimestamp() 
    }, { merge: true });
    
    // --- NOUVEAU : Sauvegarder DANS LE LOCAL STORAGE pour persistance ---
    try {
        localStorage.setItem('mon_mood', JSON.stringify(currentMood));
    } catch(e) {}
    
    document.getElementById('mood-panel').style.display = 'none';
}
        
       async function clearMood() {
    // NE PAS remettre 脿 "Heureux" automatiquement
    // On efface carr茅ment le champ moo d
    await db.collection('users').doc(currentUser.id).set({ 
        mood: firebase.firestore.FieldValue.delete()
    }, { merge: true });
    
    // On affiche un statut neutre
    document.getElementById('mood-emoji').textContent = '馃槉';
    currentMood = { emoji: '馃槉', label: 'Heureux' };
    document.getElementById('mood-panel').style.display = 'none';
}
        
      function listenToUserMood() {
    if (!targetUser) return;
    
    // Nettoie l'ancien 茅couteur
    if (window._moodListener) {
        window._moodListener();
        window._moodListener = null;
    }
    
    // --- NOUVEAU : Restaurer le mood de l'autre depuis le localStorage ---
    try {
        const savedMood = localStorage.getItem('mood_autre');
        if (savedMood) {
            const mood = JSON.parse(savedMood);
            const otherMoodSpan = document.getElementById('other-mood-emoji');
            if (otherMoodSpan) {
                otherMoodSpan.innerHTML = mood.emoji;
                otherMoodSpan.title = mood.label || '';
            }
        }
    } catch(e) {}
    
    // 脡coute en temps r茅el
    window._moodListener = db.collection('users').doc(targetUser.id)
        .onSnapshot((doc) => {
            if (doc.exists) {
                const data = doc.data();
                if (data.mood) {
                    const mood = data.mood;
                    const otherMoodSpan = document.getElementById('other-mood-emoji');
                    if (otherMoodSpan) {
                        otherMoodSpan.innerHTML = mood.emoji;
                        otherMoodSpan.title = mood.label || '';
                    }
                    // --- NOUVEAU : Sauvegarder dan s localStorage ---
                    try {
                        localStorage.setItem('mood_autre', JSON.stringify(mood));
                    } catch(e) {}
                }
            }
        });
}
        
      async function saveDefaultMood() {
    if (!currentUser) return;
    
    // 1. D'abord, on v茅rifie si un mood existe d茅j脿
    const doc = await db.collection('users').doc(currentUser.id).get();
    
    if (doc.exists && doc.data().mood) {
        // 2. Si un mood existe, on le GARDE (on ne l'茅crase pas)
        const existingMood = doc.data().mood;
        currentMood = existingMood;  // On met 脿 jour currentMood avec la vraie valeur
        document.getElementById('mood-emoji').textContent = existingMood.emoji;
        console.log("馃槉 Mood existant conserv茅:", existingMood);
        return;  // 鈫? On sort de la fonction, on ne fait rien d'autre !
    }
    
    // 3. Si aucun mood n'existe, on cr茅e le mood par d茅faut
    await db.collection('users').doc(currentUser.id).set({ 
        mood: currentMood,  // '馃槉' par d茅faut
        lastUpdate: firebase.firestore.FieldValue.serverTimestamp() 
    }, { merge: true });
}
        
        // ========== CANVAS DESSIN ========== 
       
        
        // ========== PHOTO PLEIN 脡CRAN ==========
        // (Anciennes d茅finitions dupliqu茅es de openFullscreenPhoto/closePhotoModal supprim茅es :
        // elles 茅taient 茅cras茅es de toute fa莽on par les versions d茅finies plus bas.)
        // ========== ENREGISTREMENT FIABLE SUR L'APPAREIL (PC + iPhone + Android) ==========
        // Sur iPhone/Android, un simple <a download> ouvre juste l'image/vid茅o dans un nouvel
        // onglet au lieu de l'enregistrer (Safari ignore l'attribut "download"). La solution
        // fiable consiste 脿 utiliser le menu de partage natif (Web Share API avec fichiers),
        // qui propose directement "Enregistrer l'image" / "Enregistrer la vid茅o" -> Galerie/Photos.
        async function enregistrerMediaSurAppareil(url, filename, mimeType) {
            let blob;
            try {
                const response = await fetch(url);
                if (!response.ok) throw new Error('HTTP ' + response.status);
                blob = await response.blob();
            } catch (err) {
                console.error('Erreur r茅cup茅ration du fichier (enregistrement):', err);
                // Repli ultime : au moins ouvrir le fichier dans un nouvel onglet, pour
                // que la personne puisse l'enregistrer manuellement (clic droit / appui long).
                showTempNotification("鉂? T茅l茅chargement direct impossible 鈥? ouverture dans un nouvel onglet");
                window.open(url, '_blank');
                return false;
            }

            const file = new File([blob], filename, { type: mimeType || blob.type || 'application/octet-stream' });

            // 1) Mobile (iPhone/Android) : menu de partage natif -> "Enregistrer" sauvegarde
            // directement dans la Galerie/Photos, sans page interm茅diaire.
            if (navigator.canShare && navigator.canShare({ files: [file] })) {
                try {
                    await navigator.share({ files: [file] });
                    return true;
                } catch (err) {
                    if (err && err.name === 'AbortError') return false; // l'utilisateur a annul茅
                    console.warn('Partage natif indisponible, repli sur t茅l茅chargement direct:', err);
                    // on continue vers le repli ci-dessous, on n'arr锚te pas l脿
                }
            }

            // 2) Repli (PC, ou navigateurs sans partage de fichiers) : t茅l茅chargement classique
            try {
                const blobUrl = URL.createObjectURL(blob);
                const link = document.createElement('a');
                link.href = blobUrl;
                link.download = filename;
                document.body.appendChild(link);
                link.click();
                link.remove();
                setTimeout(() => URL.revokeObjectURL(blobUrl), 3000);
                return true;
            } catch (err) {
                console.error('Erreur t茅l茅chargement direct:', err);
                showTempNotification("鉂? 脡chec de l'enregistrement");
                return false;
            }
        }

        async function downloadCurrentPhoto() {
            if (!currentPhotoUrl) {
                console.warn('downloadCurrentPhoto: currentPhotoUrl est vide');
                showTempNotification('鉂? Aucun m茅dia 脿 enregistrer');
                return;
            }
            const downloadBtn = document.getElementById('download-photo-btn');
            if (downloadBtn) downloadBtn.classList.add('downloading');
            try {
                const estVideo = mediaGalerieListe[mediaGalerieIndex]?.type === 'video';
                if (estVideo) {
                    await enregistrerMediaSurAppareil(currentPhotoUrl, 'video_' + Date.now() + '.mp4', 'video/mp4');
                } else {
                    await enregistrerMediaSurAppareil(currentPhotoUrl, 'photo_' + Date.now() + '.jpg', 'image/jpeg');
                }
            } catch (e) {
                console.error('Erreur enregistrement m茅dia:', e);
                showTempNotification('鉂? Erreur t茅l茅chargement');
            }
            setTimeout(() => { if (downloadBtn) downloadBtn.classList.remove('downloading'); }, 500);
        }

        // R茅pond au message actuellement affich茅 dans le visualiseur plein 茅cran
        function repondreDepuisVisualiseur() {
            const media = mediaGalerieListe[mediaGalerieIndex];
            if (!media) return;
            closePhotoModal();
            fermerGalerieMediaPage();
            closeSettingsPage();
            selectedMessageId = media.msgId;
            initiateReply();
        }

        async function telechargerVideo(btnEl, url) {
            if (!url) return;
            const icon = btnEl.querySelector('i');
            const originalClass = icon.className;
            icon.className = 'fa-solid fa-spinner fa-spin';
            try {
                await enregistrerMediaSurAppareil(url, 'video_' + Date.now() + '.mp4', 'video/mp4');
            } catch (e) {
                console.error('Erreur enregistrement vid茅o:', e);
                showTempNotification('鉂? Erreur t茅l茅chargement');
            }
            icon.className = originalClass;
        }
        
        // ========== OUTILS ET PANNEAUX ==========
        function toggleToolsMenu() {
            const panel = document.getElementById('tools-panel');
            const btn = document.getElementById('tools-menu-btn');
            const isOpen = panel.style.display === 'block';
            document.querySelectorAll('.floating-panel').forEach(p => { if(p.id !== 'tools-panel') p.style.display = 'none'; });
            if (isOpen) { panel.style.display = 'none'; btn.classList.remove('active'); }
            else { panel.style.display = 'block'; btn.classList.add('active'); setTimeout(() => { if(panel.style.display === 'block') { panel.style.display = 'none'; btn.classList.remove('active'); } }, 5000); }
        }
        function closeToolsPanel() { const panel = document.getElementById('tools-panel'); panel.style.display = 'none'; document.getElementById('tools-menu-btn').classList.remove('active'); }
        function togglePanel(panelId) {
            const panel = document.getElementById(panelId);
            const currentDisplay = panel.style.display;
            document.querySelectorAll('.floating-panel').forEach(p => p.style.display = 'none');
            if (currentDisplay !== 'block') panel.style.display = 'block';
        }

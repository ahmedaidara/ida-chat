`;
document.head.appendChild(styleMorpionClean);

// Fonction pour appliquer le style 脿 tous les Morpion existants
function nettoyerStyleMorpion() {
    document.querySelectorAll('.morpion-card').forEach(card => {
        // S'assurer que la carte est bien styl茅e
        card.style.background = 'rgba(255, 255, 255, 0.1)';
        card.style.backdropFilter = 'blur(8px)';
        card.style.webkitBackdropFilter = 'blur(8px)';
        card.style.borderRadius = '24px';
        card.style.padding = '12px';
        card.style.boxShadow = '0 8px 20px rgba(0, 0, 0, 0.3)';
        
        // Nettoyer la bulle parente
        const bulle = card.closest('.message-bubble');
        if (bulle) {
            bulle.style.background = 'transparent';
            bulle.style.backgroundColor = 'transparent';
            bulle.style.border = 'none';
            bulle.style.padding = '0';
            bulle.style.boxShadow = 'none';
        }
    });
}

// Observer les nouveaux messages pour appliquer le style automatiquement
const observateurMorpionStyle = new MutationObserver(() => {
    nettoyerStyleMorpion();
});

// D茅marrer l'observation
const zoneChatMorpion = document.getElementById('msg-area');
if (zoneChatMorpion) {
    observateurMorpionStyle.observe(zoneChatMorpion, { childList: true, subtree: true });
    nettoyerStyleMorpion(); // Application imm茅diate
}
      

// 鉁? SAUVEGARDE ET RESTAURATION DU TH脠ME (MODE NUIT/JOUR)
// ============================================================

// 1. Fonction pour sauvegarder le th猫me actuel
function sauvegarderTheme(theme) {
    try {
        localStorage.setItem('theme', theme);
        console.log("馃捑 Th猫me sauvegard茅 :", theme);
    } catch(e) {
        console.warn("Impossible de sauvegarder le th猫me:", e);
    }
}

// 2. Fonction pour restaurer le th猫me sauvegard茅
function restaurerTheme() {
    try {
        const themeSauvegarde = localStorage.getItem('theme');
        if (themeSauvegarde) {
            document.documentElement.setAttribute('data-theme', themeSauvegarde);
            console.log("馃寵 Th猫me restaur茅 :", themeSauvegarde);
            return themeSauvegarde;
        } else {
            // Si aucun th猫me sauvegard茅, on utilise le th猫me par d茅faut (clair)
            console.log("鈽?锔? Aucun th猫me sauvegard茅, mode clair par d茅faut");
            // Optionnel : mettre en mode clair par d茅faut
            document.documentElement.setAttribute('data-theme', 'light');
            return 'light';
        }
    } catch(e) {
        console.warn("Impossible de restaurer le th猫me:", e);
        return 'light';
    }
}

// 3. SURCHARGER la fonction toggleTheme() existante
// Sauvegarde la version originale
const originalToggleTheme = window.toggleTheme;

// Remplace par la nouvelle version
window.toggleTheme = function() {
    // R茅cup茅rer le th猫me actuel
    const current = document.documentElement.getAttribute('data-theme');
    const target = current === 'dark' ? 'light' : 'dark';
    
    // Appliquer le nouveau th猫me
    document.documentElement.setAttribute('data-theme', target);
    
    // SAUVEGARDER dans localStorage
    sauvegarderTheme(target);
    
    console.log(`馃攧 Th猫me chang茅 : ${current} 鈫? ${target}`);
};

// 4. AUTO-RESTAURATION au chargement de la page
(function autoRestaurerTheme() {
    // Restaurer le th猫me sauvegard茅
    const theme = restaurerTheme();
    
    // Si le th猫me est 'dark', appliquer aussi aux 茅l茅ments CSS personnalis茅s
    if (theme === 'dark') {
        document.documentElement.setAttribute('data-theme', 'dark');
        // Mettre 脿 jour l'ic么ne si elle existe
        const moonIcon = document.querySelector('.header-actions .fa-moon');
        if (moonIcon) {
            moonIcon.className = 'fa-solid fa-sun';
        }
    } else {
        document.documentElement.setAttribute('data-theme', 'light');
        const moonIcon = document.querySelector('.header-actions .fa-moon');
        if (moonIcon) {
            moonIcon.className = 'fa-solid fa-moon';
        }
    }
    
    // Synchroniser avec l'ic么ne du panneau outils (si elle existe)
    setTimeout(() => {
        const toolThemeBtn = document.querySelector('.tool-item[onclick*="toggleTheme"] i');
        if (toolThemeBtn) {
            const themeActuel = document.documentElement.getAttribute('data-theme');
            if (themeActuel === 'dark') {
                toolThemeBtn.className = 'fa-solid fa-sun';
            } else {
                toolThemeBtn.className = 'fa-solid fa-moon';
            }
        }
    }, 500);
})();

// 5. Optionnel : Sauvegarder automatiquement quand l'utilisateur quitte la page  
window.addEventListener('beforeunload', function() {
    const themeActuel = document.documentElement.getAttribute('data-theme');
    if (themeActuel) {
        sauvegarderTheme(themeActuel);
    }
});

console.log("鉁? Syst猫me de sauvegarde du th猫me activ茅 !");

      // ============================================================
// 鉁? "VOIR TOUT" : bascule l'affichage tronqu茅 / complet d'un message long
// ============================================================
function basculerVoirTout(btnEl) {
    const bulle = btnEl.closest('.message-bubble');
    if (!bulle) return;
    const elTronque = bulle.querySelector('.msg-text-tronque');
    const elComplet = bulle.querySelector('.msg-text-complet');
    if (!elTronque || !elComplet) return;
    
    const estDeplie = elComplet.style.display !== 'none';
    if (estDeplie) {
        elComplet.style.display = 'none';
        elTronque.style.display = 'block';
        btnEl.textContent = 'VOIR TOUT';
    } else {
        elComplet.style.display = 'block';
        elTronque.style.display = 'none';
        btnEl.textContent = 'VOIR MOINS';
    }
    // Forcer un reflow imm茅diat : 茅vite que le changement d'affichage reste "gel茅"
    // visuellement juste apr猫s l'envoi d'un message (bulle encore en cours d'animation
    // d'entr茅e), un cas qui ne se manifestait auparavant qu'en rafra卯chissant la page.
    void bulle.offsetHeight;
}

// 鉁? D茅l茅gation d'茅v茅nement bind茅e UNE SEULE FOIS au chargement du script (et non 脿
// chaque rendu de message). C'est ce qui corrige le bug o霉 "VOIR TOUT" ne r茅pondait
// pas au clic juste apr猫s l'envoi d'un message long : auparavant le clic d茅pendait
// d'un attribut onclick inline r茅g茅n茅r茅 脿 chaque rendu, ce qui pouvait rater le tout
// premier rendu d'un message fra卯chement envoy茅 et n'茅tait r茅solu qu'au rafra卯chissement.
document.addEventListener('click', function(e) {
    const btn = e.target.closest('.voir-tout-btn');
    if (!btn) return;
    e.preventDefault();
    e.stopPropagation();
    basculerVoirTout(btn);
});
      
      // ============================================================
// 鉁? FONCTION POUR AFFICHER TOUS LES MESSAGES
// ============================================================
// ========== VUE UNIQUE (photo/vid茅o) 鈥? rendu de la carte dans la bulle ==========  
// 鉁? Chacun des deux (l'envoyeur ET le destinataire) a droit 脿 SA PROPRE vue unique,
// ind茅pendamment l'un de l'autre 鈥? on suit donc une LISTE des personnes ayant d茅j脿
// consult茅 (viewOnceOpenedBy), pas un simple bool茅en partag茅.
function rendreCarteVueUnique(msgId, data, type) {
    const icone = data.flamme ? 'fa-fire' : (type === 'video' ? 'fa-video' : 'fa-image');
    const dejaVuParMoi = Array.isArray(data.viewOnceOpenedBy) && data.viewOnceOpenedBy.includes(currentUser.id);
    if (dejaVuParMoi) {
        if (data.flamme) {
            return `
                <div class="viewonce-card flamme-card opened" style="background: rgba(120,120,120,0.18); border-color: rgba(120,120,120,0.3);">
                    <i class="fa-solid fa-fire" style="opacity:0.4;"></i>
                    <span>Flamme d茅j脿 vue</span>
                </div>
            `;
        }
        return `
            <div class="viewonce-card opened">
                <i class="fa-solid fa-eye-slash"></i>
                <span>${type === 'video' ? 'Vid茅o' : 'Photo'} d茅j脿 vue</span>
            </div>
        `;
    }
    if (data.flamme) {
        const couleur = data.flammeCouleur || '#ff5722';
        return `
            <div class="viewonce-card flamme-card" style="background:${couleur}22; border:1.5px solid ${couleur};" onclick="ouvrirVueUnique('${msgId}')">
                <i class="fa-solid ${icone}" style="color:${couleur};"></i>
                <span style="color:${couleur};"> ${type === 'video' ? 'Vid茅o' : 'Photo'} flamme 馃敟</span>
            </div>
        `;
    }
    return `
        <div class="viewonce-card" onclick="ouvrirVueUnique('${msgId}')">
            <i class="fa-solid ${icone}"></i>
            <span> ${type === 'video' ? 'Vid茅o' : 'Photo'} vue unique 1锔忊儯</span>
        </div>
    `;
}

 // on ajoute seulement mon id 脿 la liste "viewOnceOpenedBy" dans Firestore, ce qui fait
// que le prochain rendu m'affichera la carte "d茅j脿 vue" 脿 MOI, sans affecter la vue
// de l'autre personne (qui garde son propre droit 脿 une vue unique).
let vueUniqueMsgIdActif = null;
async function ouvrirVueUnique(msgId) {
    try {
        // 鉁? On utilise d'abord la donn茅e d茅j脿 en m茅moire (re莽ue via l'茅coute en
        // direct) au lieu de syst茅matiquement re-t茅l茅charger le document depuis
        // Firestore : 莽a 茅vite un aller-retour r茅seau avant m锚me que le m茅dia ne
        // commence 脿 charger, ce qui rendait l'ouverture d'une flamme/vue unique
        // sensiblement plus lente qu'une photo/vid茅o classique.
        let data = messagesEnMemoire[msgId];
        if (!data) {
            const doc = await db.collection('chats').doc(CHAT_ID).collection('messages').doc(msgId).get();
            if (!doc.exists) return;
            data = doc.data();
        }
        const dejaVuParMoi = Array.isArray(data.viewOnceOpenedBy) && data.viewOnceOpenedBy.includes(currentUser.id);
        if (dejaVuParMoi) {
             return;
        }

        vueUniqueMsgIdActif = msgId;
        const content = document.getElementById('viewonce-viewer-content');
        if (data.type === 'video') {
            content.innerHTML = `<video src="${data.mediaUrl}" controls autoplay playsinline></video>`;
        } else {
            content.innerHTML = `<img src="${data.mediaUrl}" alt="Photo vue unique">`;
        }
        document.getElementById('viewonce-viewer-overlay').classList.add('active');
    } catch (err) {
        console.error("Erreur ouverture vue unique:", err);
        showTempNotification("鉂? Impossible d'ouvrir ce m茅dia");
    }
}

async function fermerVueUnique() {
    document.getElementById('viewonce-viewer-overlay').classList.remove('active');
    document.getElementById('viewonce-viewer-content').innerHTML = '';
    if (vueUniqueMsgIdActif) {
        const msgId = vueUniqueMsgIdActif;
        vueUniqueMsgIdActif = null;
        try {
            await db.collection('chats').doc(CHAT_ID).collection('messages').doc(msgId).update({
                viewOnceOpenedBy: firebase.firestore.FieldValue.arrayUnion(currentUser.id),
                viewOnceOpenedAt: firebase.firestore.FieldValue.serverTimestamp()
            });
        } catch (err) {
            console.error("Erreur fermeture vue unique:", err);
        }
    }
}

// ========== VOCAL 脌 VUE UNIQUE (item 2) 鈥? m锚me logique que photo/vid茅o, mais on ne
// marque "茅cout茅" qu'脿 la FIN de la lecture compl猫te (pas au simple clic d'ouverture),
// puisque la demande est "celui qui lit le vocal AU COMPLET une fois n'aura plus
// l'occasion de le lire une deuxi猫me fois". Chacun des deux garde son propre droit
// 脿 une 茅coute, ind茅pendamment de l'autre (m锚me principe que viewOnceOpenedBy).
function rendreCarteVueUniqueAudio(msgId, data) {
    const dejaEcouteParMoi = Array.isArray(data.viewOnceOpenedBy) && data.viewOnceOpenedBy.includes(currentUser.id);
    if (dejaEcouteParMoi) {
        return `
            <div class="viewonce-card opened">
                <i class="fa-solid fa-eye-slash"></i>
                <span>Vocal d茅j脿 茅cout茅</span>
            </div>
        `;
    }
    return `
        <div class="viewonce-card" id="carte-vocal-${msgId}" onclick="ouvrirVocalVueUnique('${msgId}')">
            <i class="fa-solid fa-microphone-lines"></i>
            <span> Vocal vue unique 1锔忊儯 鈥? appuie pour 茅couter</span>
        </div>
    `;
}

let vocalVueUniqueLecteurActif = null;
async function ouvrirVocalVueUnique(msgId) {
    const carte = document.getElementById(`carte-vocal-${msgId}`);
    try {
        let data = messagesEnMemoire[msgId];
        if (!data) {
            const doc = await db.collection('chats').doc(CHAT_ID).collection('messages').doc(msgId).get();
            if (!doc.exists) return;
            data = doc.data();
        }
        const dejaEcouteParMoi = Array.isArray(data.viewOnceOpenedBy) && data.viewOnceOpenedBy.includes(currentUser.id);
        if (dejaEcouteParMoi) return;

        if (vocalVueUniqueLecteurActif) { vocalVueUniqueLecteurActif.pause(); vocalVueUniqueLecteurActif = null; }

        if (carte) {
            carte.onclick = null;
            carte.innerHTML = `<i class="fa-solid fa-volume-high"></i><span> Lecture en cours...</span>`;
        }

        const audio = new Audio(data.mediaUrl);
        vocalVueUniqueLecteurActif = audio;
        audio.addEventListener('ended', async () => {
            vocalVueUniqueLecteurActif = null;
            if (carte) {
                carte.outerHTML = `<div class="viewonce-card opened"><i class="fa-solid fa-eye-slash"></i><span>Vocal d茅j脿 茅cout茅</span></div>`;
            }
            try {
                await db.collection('chats').doc(CHAT_ID).collection('messages').doc(msgId).update({
                    viewOnceOpenedBy: firebase.firestore.FieldValue.arrayUnion(currentUser.id),
                    viewOnceOpenedAt: firebase.firestore.FieldValue.serverTimestamp()
                });
            } catch (e) { console.error('Erreur marquage vocal vue unique:', e); }
        });
        audio.play();
    } catch (err) {
        console.error("Erreur lecture vocal vue unique:", err);
        showTempNotification("鉂? Impossible de lire ce vocal");
        if (carte) carte.onclick = () => ouvrirVocalVueUnique(msgId);
    }
}

function afficherTousLesMessages(snapshot, isInitialLoad) {
    const msgArea = document.getElementById('msg-area');
    if (!msgArea) return;
    
    // Si pas de messages
    if (snapshot.empty) {
        msgArea.innerHTML = `
            <div style="text-align:center; color:var(--text-muted); padding:40px;">
                <i class="fa-regular fa-comment" style="font-size:3rem; margin-bottom:10px;"></i>
                <p>Aucun message</p>
                <p style="font-size:0.8rem; opacity:0.5;">馃挰 Envoyez votre premier message</p>
            </div>
        `;
        return;
    }
    
    // On m茅morise la position de lecture actuelle AVANT de reconstruire la liste
    const wasAtBottom = (msgArea.scrollHeight - msgArea.scrollTop - msgArea.clientHeight) < 150;
    const previousScrollTop = msgArea.scrollTop;
    
    // Vider la zone
    msgArea.innerHTML = '';
    
    let lastDateStr = "";
    
    const docsTries = snapshot.docs.slice().sort((a, b) => {
        const ta = a.data().timestamp;
        const tb = b.data().timestamp;
        const msA = ta && ta.toMillis ? ta.toMillis() : Date.now();
        const msB = tb && tb.toMillis ? tb.toMillis() : Date.now();
        return msA - msB;
    });
    
    docsTries.forEach(doc => {
        const data = doc.data();
        const msgId = doc.id;
        messagesEnMemoire[msgId] = data;

        // 鉁? L'animation d'envoi ne doit jouer qu'UNE SEULE FOIS, sur le message qui vient
        // literalement d'appara卯tre 鈥? jamais sur les anciens messages r茅-affich茅s lors d'un
        // nouveau rendu complet du chat (nouveau message, accus茅 de lecture, etc.), ni au
        // chargement initial de la conversation.
        const estNouveauMessage = !isInitialLoad && !idsMessagesDejaAnimes.has(msgId);
        idsMessagesDejaAnimes.add(msgId);
        
        // Ajouter le s茅parateur de date
        if (data.timestamp) {
            const dateObj = data.timestamp.toDate ? data.timestamp.toDate() : new Date(data.timestamp);
            const dateStr = dateObj.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
            if (dateStr !== lastDateStr) {
                const sep = document.createElement('div');
                sep.className = 'date-separator';
                sep.innerText = dateStr;
                msgArea.appendChild(sep);
                lastDateStr = dateStr;
            }
        }
        
        const row = document.createElement('div');
        const isSent = data.senderId === currentUser.id;
        row.className = `message-row ${isSent ? 'sent' : 'received'}`;
        row.setAttribute('data-id', msgId);
        row.setAttribute('data-msgtype', data.type || 'text');
        if (data.isGif) row.setAttribute('data-isgif', 'true');
        if (data.isSticker) row.setAttribute('data-issticker', 'true');
        if (data.fileName) row.setAttribute('data-filename', data.fileName);
        
  const isGiant = isOnlyEmojis(data.text);
// 鉁? Pas de bulle (fond/ombre/padding) pour les photos, vid茅os, GIFs, stickers,
// et pour un message qui n'est qu'un SEUL emoji (envoy茅 ou re莽u) : ce dernier cas
// doit toujours rester sans fond, m锚me avec un style de bulle par d茅faut, une
// couleur d'accent, ou une couleur/d茅grad茅 perso choisi sur ce message pr茅cis.
const isMediaNoBubble = data.type === 'image' || data.type === 'video' || data.type === 'document' || data.type === 'media_group';
let customStyle = '';
let inlineStyle = '';
// 馃毃 PRIORIT脡 : Si une couleur personnalis茅e existe, on d茅sactive les styles de classe
const hasCustomColor = !isMediaNoBubble && !isGiant && (data.customColor || data.customGradient);

if (isMediaNoBubble || isGiant) {
    // Une photo/vid茅o/document/envoi group茅 鈥? ou un message qui n'est qu'un seul
    // emoji 鈥? n'a JAMAIS de fond de bulle color茅, m锚me si une couleur d'accent ou
    // un style de bulle par d茅faut est choisi.
} else if (hasCustomColor) {
    // 鉁? Couleur/d茅grad茅 choisi pour CE message pr茅cis (prioritaire sur tout le reste)
    if (data.customColor) {
        inlineStyle = `background: ${data.customColor} !important; color: ${getContrastColor(data.customColor)} !important;`;
    } else if (data.customGradient) {
        inlineStyle = `background: ${data.customGradient} !important; color: white !important;`;
    }
} else if (data.bubbleStyle) {
    customStyle = data.bubbleStyle;
} else if (data.messageStyle) {
    customStyle = data.messageStyle;
} else if (isSent) {
    // Aucun style choisi pour CE message : on applique la pr茅f茅rence par d茅faut de l'utilisateur.
    // La couleur d'accent (si choisie) est prioritaire sur le style de bulle par d茅faut 鈥?
    // ce sont deux fa莽ons alternatives de d茅finir le m锚me r茅glage par d茅faut.
    const defaultAccent = localStorage.getItem('default_accent_color');
    if (defaultAccent && defaultAccent !== 'none') {
        inlineStyle = `background: ${defaultAccent} !important; color: ${getContrastColor(defaultAccent)} !important;`;
    } else {
        const defaultStyle = localStorage.getItem('default_bubble_style');
        if (defaultStyle && defaultStyle !== 'none') {
            customStyle = defaultStyle;
        }
    }
}
        
        let codedClass = '';
        let lockBadge = '';
        if (data.isCoded === true) {
            codedClass = 'coded';
            lockBadge = `<div class="locked-badge" onclick="event.stopPropagation(); showPinModal('${msgId}')">馃敀</div>`;
        }
        
        const sendAnimClass = (isSent && estNouveauMessage) ? getSendAnimationClass() : '';
        
        // 鉁? MODIFICATION : ajout de style="${inlineStyle}"
        let bubbleHtml = `<div class="message-bubble ${isGiant ? 'giant-emoji' : ''} ${isMediaNoBubble ? 'media-no-bubble' : ''} ${customStyle} ${codedClass} ${sendAnimClass}" 
            style="${inlineStyle}"
            onclick="${data.isCoded === true ? `showPinModal('${msgId}')` : ''}"
            oncontextmenu="handleContextMenu(event, '${msgId}'); return false;" 
            ondblclick="handleDoubleTap(event, '${msgId}')"
            ontouchstart="gererSwipeDebut(event, '${msgId}')"
            ontouchend="gererSwipeFin()"
            ontouchmove="gererSwipeMouvement(event, '${msgId}')"
            onmousedown="demarrerAppuiLong(event, '${msgId}')"
            onmouseup="annulerAppuiLong()"
            onmouseleave="annulerAppuiLong()">`;
        
        if (data.replyToText) {
            const messageOrigineSupprime = (data.replyToText === MARQUEUR_REPONSE_SUPPRIMEE);
            if (messageOrigineSupprime) {
                // 鉁? Le message cit茅 a 茅t茅 supprim茅 entre-temps : on n'affiche plus son ancien contenu
                bubbleHtml += `<div class="reply-citation" style="font-style: italic; opacity: 0.7; cursor: default;"><i class="fa-solid fa-ban" style="margin-right:4px;"></i>Message supprim茅</div>`;
            } else {
                // 鉁? Clic sur la citation 鈫? d茅filer jusqu'au message d'origine avec flash de surbrillance
                // --- NOUVEAU : 4 mots pour l'aper莽u DANS le message ---
let apercuCitation = data.replyToText;
const motsCitation = apercuCitation.trim().split(/\s+/).filter(Boolean);
if (motsCitation.length > 4) {
    apercuCitation = motsCitation.slice(0, 4).join(' ') + '...';
}
bubbleHtml += `<div class="reply-citation" onclick="event.stopPropagation(); scrollToOriginalMessage('${data.replyToId || ''}')"><b>${data.replyToSender}:</b> ${escapeHTML(apercuCitation)}</div>`;
            }
        }
         
        // TEXTE
        if (data.type === 'text') {
            let displayText = data.text;
            if (data.isCoded === true) {
                const originalMessage = data.originalText || data.text;
                displayText = `<span class="coded-mask" data-original-text="${escapeHTML(originalMessage)}">${escapeHTML(data.text)}</span>`;
                bubbleHtml += displayText;
            } else if (typeof displayText === 'string' && displayText.length > 100) {
                // Message long : on tronque le texte BRUT 脿 100 caract猫res (avant mise en
                // forme) pour ne jamais couper au milieu d'une balise HTML g茅n茅r茅e par
                // formatText/escapeHTML, puis on pr茅pare les deux versions (courte/compl猫te).
                const texteTronqueBrut = displayText.slice(0, 100);
                let htmlTronque = formatText(escapeHTML(texteTronqueBrut)).replace(/\n/g, '<br>');
                let htmlComplet = formatText(escapeHTML(displayText)).replace(/\n/g, '<br>');
                bubbleHtml += `<span class="msg-text-tronque" style="white-space: pre-wrap; display: block; font-size: 0.82rem; line-height: 1.35;">${htmlTronque}鈥?</span>`;
                bubbleHtml += `<span class="msg-text-complet" style="white-space: pre-wrap; display: none; font-size: 0.82rem; line-height: 1.35;">${htmlComplet}</span>`;
                bubbleHtml += `<span class="voir-tout-btn" style="color:#00c853; font-weight:600; cursor:pointer; display:inline-block; margin-top:2px; font-size:0.6rem;">VOIR TOUT</span>`;
            } else { 
                displayText = formatText(escapeHTML(displayText));
                displayText = displayText.replace(/\n/g, '<br>');
                bubbleHtml += `<span style="white-space: pre-wrap; display: block;">${displayText}</span>`;
            }
        } else if (data.type === 'image') {
            if (data.viewOnce) {
                bubbleHtml += rendreCarteVueUnique(msgId, data, 'image');
            } else {
                bubbleHtml += `<img src="${data.mediaUrl}" class="img-msg" data-fullsrc="${data.mediaUrl}" onclick="openFullscreenPhoto(event, this)"/>`;
                if (data.text) {
                    bubbleHtml += `<span style="white-space: pre-wrap; display: block; margin-top: 4px;">${formatText(escapeHTML(data.text))}</span>`;
                }
            }
        } else if (data.type === 'drawing') {
            bubbleHtml += `<div><img src="${data.mediaUrl}" class="img-msg" data-fullsrc="${data.mediaUrl}" onclick="openFullscreenPhoto(this)" style="max-width:200px; max-height:200px; border-radius:12px; background:white; cursor:pointer;"></div>`;
        } else if (data.type === 'video') {
            if (data.viewOnce) {
                bubbleHtml += rendreCarteVueUnique(msgId, data, 'video');
            } else {
                const videoUrl = data.mediaUrl || data.fileUrl || "";
                bubbleHtml += `
                    <div class="video-wrapper" onclick="ouvrirVideoPleinEcran(event, this.querySelector('video'))" style="max-width: 250px; width: 100%; border-radius: 12px; overflow: hidden; background: #000; margin-top: 5px; position: relative; cursor: pointer;">
                        <video src="${videoUrl}" playsinline preload="metadata" style="width:100%; display:block; object-fit:cover; pointer-events:none;"></video>
                        <div class="video-play-overlay"><i class="fa-solid fa-play"></i></div>
                        <button class="video-save-btn" onclick="event.stopPropagation(); telechargerVideo(this, '${videoUrl}')" title="Enregistrer la vid茅o" style="position:absolute; top:8px; right:8px; background:rgba(0,0,0,0.6); color:#fff; border:none; width:32px; height:32px; border-radius:50%; display:flex; align-items:center; justify-content:center; cursor:pointer; z-index:2; font-size:0.9rem;">
                            <i class="fa-solid fa-download"></i>
                        </button>
                    </div>
                `;
                if (data.text) {
                    bubbleHtml += `<span style="white-space: pre-wrap; display: block; margin-top: 4px;">${formatText(escapeHTML(data.text))}</span>`;
                }
            }
       } else if (data.type === 'media_group' && Array.isArray(data.items)) {
    const items = data.items;
    const total = items.length;
    
    // G茅n茅rer autant de positions qu'il y a d'images
    const FAN_POSITIONS = [];
    const angleTotal = Math.min(total * 6, 30); // Rotation max 30掳
    for (let i = 0; i < total; i++) {
        const progress = total > 1 ? i / (total - 1) : 0.5;
        const angle = -angleTotal / 2 + progress * angleTotal;
        const offsetX = 20 + progress * 30;
        const offsetY = 10 + progress * 25;
        FAN_POSITIONS.push({
            top: offsetY,
            left: offsetX,
            rotate: angle
        });
    }
    
    let cardsHtml = '';
    items.forEach((item, i) => {
        const pos = FAN_POSITIONS[i] || { top: i * 20, left: i * 15, rotate: 0 };
        const estFrontMost = i === items.length - 1;
        const contenu = item.type === 'video'
            ? `<video src="${item.url}" muted playsinline></video><div class="media-fan-video-icon"><i class="fa-solid fa-play"></i></div>`
            : `<img src="${item.url}" loading="lazy">`;
        cardsHtml += `
            <div class="media-fan-card" style="top:${pos.top}px; left:${pos.left}px; transform:rotate(${pos.rotate}deg); z-index:${i + 1};" onclick="ouvrirMediaGroupItem('${item.url}', '${item.type}')">
                ${contenu}
            </div>`;
    });
    
    // Ajuster la hauteur en fonction du nombre d'images
    const hauteur = Math.min(80 + total * 30, 350);
    bubbleHtml += `<div class="media-fan" style="height:${hauteur}px;">${cardsHtml}</div>`;
        } else if (data.type === 'document') {
            const ext = data.fileExt || (data.fileName || '').split('.').pop().toLowerCase();
            const icone = icoenPourExtensionDoc(ext);
            const couleur = couleurPourExtensionDoc(ext);
            bubbleHtml += `
                <div class="document-card" onclick="ouvrirDocumentIntelligent('${data.mediaUrl}', '${ext}')">
                    <div class="document-card-icon" style="background:${couleur};"><i class="fa-solid ${icone}"></i></div>
                    <div class="document-card-info">
                        <div class="document-card-name">${escapeHTML(data.fileName || 'Document')}</div>
                        <div class="document-card-meta">${ext.toUpperCase()} 路 ${formaterTailleFichier(data.fileSize)}</div>
                    </div>
                    <i class="fa-solid fa-arrow-up-right-from-square document-card-open"></i>
                </div>
            `;
        } else if (data.type === 'audio') {
            const audioId = `audio_${msgId}`;
            if (data.viewOnce) {
                bubbleHtml += rendreCarteVueUniqueAudio(msgId, data);
            } else if (!data.isEphemeralAudio) {
                bubbleHtml += `
                    <div class="audio-player-container" style="display: flex; align-items: center; gap: 8px; background: rgba(0,0,0,0.08); padding: 6px 12px; border-radius: 25px; min-width: 200px;">
                        <button class="audio-play-btn" data-audio="${audioId}" style="background: none; border: none; font-size: 1.2rem; cursor: pointer; color: #0095f6;">
                            <i class="fa-solid fa-play"></i>
                        </button>
                        <audio id="${audioId}" src="${data.mediaUrl}" preload="metadata" style="display: none;"></audio>
                        <span class="audio-time" style="font-size: 0.75rem; min-width: 40px;">--:--</span>
                        <div style="flex: 1; height: 3px; background: rgba(0,0,0,0.2); border-radius: 3px; overflow: hidden;">
                            <div class="audio-progress" style="width: 0%; height: 100%; background: #0095f6;"></div>
                        </div>
                        <span class="audio-duration" style="font-size: 0.7rem; min-width: 35px;">0:00</span>
                    </div>
                    ${data.transcription ? `<div class="audio-transcription-affichee"><i class="fa-solid fa-closed-captioning"></i> ${escapeHtmlTexte(data.transcription)}</div>` : ''}
                `;
            }
        } else if (data.type === 'whiteboard') {
    // Afficher le tableau blanc
    afficherWb(msgId, data);
} else if (data.type === 'screenshare_invite') {
            const estExpediteur = data.senderId === currentUser.id;
            if (data.status === 'pending') {
                if (estExpediteur) {
                    bubbleHtml += `<div class="screenshare-invite-card"><span class="screenshare-invite-text"><i class="fa-solid fa-display"></i> En attente de r茅ponse...</span></div>`;
                } else {
                    bubbleHtml += `
                        <div class="screenshare-invite-card">
                            <span class="screenshare-invite-text"><i class="fa-solid fa-display"></i> ${escapeHTML(data.senderName)} vous invite 脿 un partage d'茅cran</span>
                            <div class="screenshare-invite-actions">
                                <button onclick="repondreInvitationPartageEcran('${msgId}', false)">Non</button>
                                <button onclick="repondreInvitationPartageEcran('${msgId}', true)" class="accept">Oui</button>
                            </div>
                        </div>`;
                }
            } else if (data.status === 'accepted') {
                bubbleHtml += `<div class="screenshare-invite-card"><span class="screenshare-invite-text"><i class="fa-solid fa-display"></i> 鉁? Invitation accept茅e</span></div>`;
                if (estExpediteur && !screenShareClient) {
                    setTimeout(afficherBandeauDemarragePartageEcran, 0);
                }
            } else if (data.status === 'declined') {
                bubbleHtml += `<div class="screenshare-invite-card"><span class="screenshare-invite-text"><i class="fa-solid fa-display"></i> 鉂? Invitation refus茅e</span></div>`;
            }
} else if (data.type === 'location') {
          try {
            const estLive = data.mode === 'live';
            const dejaTerminee = data.liveEnded || (data.expiresAt && Date.now() > data.expiresAt);
            let statutTexte = estLive ? (dejaTerminee ? 'Partage termin茅' : 'Position en direct') : 'Position partag茅e';
            if (data.eta) statutTexte += ` 路 ${data.eta}`;
            bubbleHtml += `
                <div class="location-card" data-msgid="${msgId}" data-lat="${data.lat}" data-lng="${data.lng}" onclick="ouvrirPositionSurMaps(this.getAttribute('data-lat'), this.getAttribute('data-lng'))">
                    <div class="location-card-map"><i class="fa-solid fa-location-dot"></i></div>
                    <div class="location-card-info">
                        <div class="location-card-titre">${estLive ? 'Position en direct' : 'Position'}</div>
                        <div class="location-card-statut">${statutTexte}</div>
                    </div>
                </div>`;
            if (estLive && !dejaTerminee) {
                setTimeout(() => ecouterPositionEnDirect(msgId), 0);
            }
          } catch(eLoc) { console.error('Erreur rendu carte position:', eLoc); }
} else if (data.type === 'meteo') {
          try {
            bubbleHtml += `
                <div class="location-card" style="cursor:default; gap:0; flex-direction:column; align-items:stretch;">
                    <div class="location-card-titre" style="padding:8px 10px 0;">馃尋锔? M茅t茅o 脿 deux</div>
                    <div style="display:flex; gap:10px; padding:8px 10px 10px;">
                        <div style="flex:1; text-align:center;">
                            <div style="font-size:0.72rem; color:var(--text-muted);">${escapeHTML(data.nomMoi || 'Moi')}</div>
                            <div style="font-size:1.3rem; font-weight:700;">${data.tempMoi}掳C</div>
                            <div style="font-size:0.7rem;">${data.condMoi}</div>
                        </div>
                        <div style="width:1px; background:var(--border-color);"></div>
                        <div style="flex:1; text-align:center;">
                            <div style="font-size:0.72rem; color:var(--text-muted);">${escapeHTML(data.nomAutre || "L'autre")}</div>
                            <div style="font-size:1.3rem; font-weight:700;">${data.tempAutre !== null && data.tempAutre !== undefined ? data.tempAutre + '掳C' : '鈥?'}</div>
                            <div style="font-size:0.7rem;">${data.condAutre || 'Pas encore de position partag茅e'}</div>
                        </div>
                    </div>
                </div>`;
          } catch(eMeteo) { console.error('Erreur rendu carte m茅t茅o:', eMeteo); }
} else if (data.type === 'sos_calin') {
          try {
            carteSpecialeDonnees[msgId] = { type: 'sos_calin', senderName: data.senderName || '' };
            const dejaOuverteSos = !!data.opened || data.senderId === currentUser.id;
            if (dejaOuverteSos) {
                bubbleHtml += `<div class="carte-fermee" style="opacity:0.7;" onclick="ouvrirAnimationCarteSpeciale('sos_calin', carteSpecialeDonnees['${msgId}'])"><div class="carte-fermee-icone">馃啒</div><div><div class="carte-fermee-titre">SOS C芒lin</div><div class="carte-fermee-sous">${escapeHTML(data.senderName)}  </div></div></div>`;
            } else {
                bubbleHtml += `<div class="carte-fermee" data-id="${msgId}" onclick="ouvrirCarteRecue('${msgId}')"><div class="carte-fermee-icone">馃啒</div><div><div class="carte-fermee-titre">SOS C芒lin</div><div class="carte-fermee-sous">Appuie pour voir</div></div></div>`;
            }
          } catch(eSos) { console.error('Erreur rendu carte SOS C芒lin:', eSos); }
} else if (data.type === 'cadeau') {
          try {
            carteSpecialeDonnees[msgId] = { 
                type: 'cadeau', 
                cadeau: data.cadeau || '馃巵 Cadeau',
                emoji: (data.cadeau || '馃巵').split(' ')[0] || '馃巵',
                texte: data.cadeau || ''
            };
            const dejaOuvertCadeau = !!data.opened || data.senderId === currentUser.id;
            
            // 鉁? Affichage simplifi茅 : juste un 馃巵 sans fond
            if (dejaOuvertCadeau) {
                bubbleHtml += `<div class="cadeau-chat-icon" style="font-size: 3.5rem; cursor: pointer; display: inline-block; padding: 4px; opacity: 0.7; transition: transform 0.2s;" onclick="ouvrirAnimationCarteSpeciale('cadeau', carteSpecialeDonnees['${msgId}'])">馃巵</div>`;
            } else {
                bubbleHtml += `<div class="cadeau-chat-icon" data-id="${msgId}" style="font-size: 3.5rem; cursor: pointer; display: inline-block; padding: 4px; transition: transform 0.2s; animation: cadeauPulse 2s infinite;" onclick="ouvrirCarteRecue('${msgId}')">馃巵</div>`;
            }
          } catch(eCadeau) { console.error('Erreur rendu carte cadeau:', eCadeau); }
} else if (data.type === 'lettre') {
          try {
            // 鉁? On stocke le texte pour l'animation
            carteSpecialeDonnees[msgId] = { 
                type: 'lettre', 
                senderName: data.senderName || '', 
                texte: data.text || '',
                emoji: '馃拰'
            };
            
            // 鉁? On affiche TOUJOURS seulement 馃拰, pour tout le monde (exp茅diteur ET receveur)
            bubbleHtml += `<div class="lettre-chat-icon" data-id="${msgId}" style="font-size: 3.5rem; cursor: pointer; display: inline-block; padding: 4px; transition: transform 0.2s; animation: lettrePulse 2s infinite;" onclick="ouvrirCarteRecue('${msgId}')">馃拰</div>`;
          } catch(eLettre) { console.error('Erreur rendu carte lettre:', eLettre); }
} else if (data.type === 'tresor') { 
          try {
            const dejaRevele = !!data.revealed;
            bubbleHtml += `
                <div class="tresor-card" data-id="${msgId}" onclick="reveleTresor('${msgId}')">
                    <div class="tresor-card-titre">馃巵 Tr茅sor cach茅</div>
                    <div class="tresor-card-indice">Indice : ${escapeHtmlTexte(data.indice || '')}</div>
                    <div class="tresor-secret-zone" style="display:${dejaRevele ? 'block' : 'none'};">${escapeHtmlTexte(data.secret || '')}</div>
                    ${!dejaRevele ? `<div class="tresor-card-cta">Appuie pour ouvrir</div>` : ''}
                </div>`;
          } catch(eTresor) { console.error('Erreur rendu carte tr茅sor:', eTresor); }
} else if (data.type === 'call_log') {
            const isMissed = data.callStatus === 'missed';
            const isDeclined = data.callStatus === 'declined';
            const isVideo = data.callType === 'video';
            const iconClass = isVideo ? 'fa-video' : 'fa-phone';
            let titre, sousTitre, classeIcone = '';
            if (isMissed) {
                titre = isVideo ? 'Appel vid茅o manqu茅' : 'Appel vocal manqu茅';
                sousTitre = 'Appuyez pour rappeler';
                classeIcone = 'missed';
            } else if (isDeclined) {
                titre = isVideo ? 'Appel vid茅o refus茅' : 'Appel vocal refus茅';
                sousTitre = 'Appuyez pour rappeler';
                classeIcone = 'missed';
            } else {
                titre = isVideo ? 'Appel vid茅o' : 'Appel vocal';
                sousTitre = formatDureeAppel(data.durationSec || 0);
            }
            const peutRappeler = isMissed || isDeclined;
            bubbleHtml += `
                <div class="call-log-card" ${peutRappeler ? `onclick="startCall('${data.callType}')"` : ''}>
                    <div class="call-log-icon ${classeIcone}"><i class="fa-solid ${iconClass}"></i></div>
                    <div class="call-log-text">
                        <div class="call-log-title">${titre}</div>
                        <div class="call-log-subtitle">${sousTitre}</div>
                    </div>
                </div>`;
} else if (data.type === 'screenshare_log') {
            const failed = data.screenshareStatus === 'failed';
            bubbleHtml += `
                <div class="call-log-card">
                    <div class="call-log-icon ${failed ? 'missed' : ''}"><i class="fa-solid fa-display"></i></div>
                    <div class="call-log-text">
                        <div class="call-log-title">${escapeHTML(data.titre || "Partage d'茅cran")}</div>
                        <div class="call-log-subtitle">${data.durationSec != null ? formatDureeAppel(data.durationSec) : ''}</div>
                    </div>
                </div>`;
} else if (data.type === 'game' && data.gameData && data.gameData.gameType === 'morpion') {
            // MORPION - code simplifi茅
            const game = data.gameData;
            const isMyTurn = game.turn === currentUser.id;
            const interactionClass = (game.status === 'active' && isMyTurn) ? '' : 'morpion-overlay-block';
            
            let cardHtml = `
                <div class="morpion-card" style="margin: 5px 0;">
                    <div class="morpion-header">
                        <span>馃幃 MORPION </span>
                        <span>馃弳 ${game.scores.X} - ${game.scores.O}</span>
                    </div>
                    <div class="morpion-status ${isMyTurn && game.status === 'active' ? 'active-turn' : ''}">
                        ${game.status === 'finished' ? (game.winner === 'nul' ? "馃幆 Match nul !" : `馃憫 Gagnant : ${game.winner === currentUser.id ? 'Toi' : targetUser.name}`) : (isMyTurn ? "鈿? 脌 ton tour !" : `鈴? ${targetUser.name} r茅fl茅chit...`)}
                    </div>
                    <div class="morpion-grid ${interactionClass}" style="grid-template-columns: repeat(3, 1fr); gap: 8px; aspect-ratio: 1/1;">
            `;
            
            for (let i = 0; i < 9; i++) {
                const cellValue = game.board[i] || "";
                const cellClass = cellValue ? `taken ${cellValue.toLowerCase()}` : "";
                const isWinCell = game.winningLine && game.winningLine.includes(i) ? "win-cell" : "";
                cardHtml += `
                    <div class="morpion-cell ${cellClass} ${isWinCell}" 
                         data-cell-index="${i}" 
                         onclick="jouerCoupMorpion('${msgId}', ${i})"
                         style="display: flex; align-items: center; justify-content: center; font-size: 2rem; font-weight: bold; cursor: ${(game.status === 'active' && isMyTurn && !cellValue) ? 'pointer' : 'not-allowed'}; background: rgba(255,255,255,0.05); border-radius: 12px; aspect-ratio: 1/1;">
                        ${cellValue}
                    </div>
                `;
            }
            
            cardHtml += `</div></div>`;
            bubbleHtml += cardHtml;
        }
        
        // HEURE ET STATUT
        const timeStr = data.timestamp ? data.timestamp.toDate().toLocaleTimeString('fr-FR', {hour: '2-digit', minute:'2-digit'}) : '--:--';
        
        let checkMark = '<span>鉁?</span>';
        if (data.status === 'read') {
            checkMark = `<span class="status-tick" style="color: #53bdeb; margin-left: 3px;"><i class="fa-solid fa-check-double"></i></span>`;
        } else if (data.status === 'delivered') {
            checkMark = `<span class="status-tick" style="color: #8696a0; margin-left: 3px;"><i class="fa-solid fa-check-double"></i></span>`;
        } else {
            checkMark = `<span class="status-tick" style="color: #8696a0; margin-left: 3px;"><i class="fa-solid fa-check"></i></span>`;
        }
        
        const modifiedTag = (data.modified && data.type !== 'call_log' && data.type !== 'screenshare_log')
            ? ' <span style="font-size:0.65rem; opacity:0.6;">(modifi茅)</span>' : '';
        const iaTag = data.isIA ? ' <span style="font-size:0.65rem; opacity:0.75; font-weight:600; color: #00cc44;">IDA-GPT</span>' : '';
        bubbleHtml += `<div class="msg-meta">${timeStr} ${isSent ? checkMark : ''}${modifiedTag}${iaTag}</div>`;
        
        // R脡ACTIONS
        if (data.reactions && Object.keys(data.reactions).length > 0) {
            bubbleHtml += `<div class="applied-reactions">`;
            Object.entries(data.reactions).forEach(([user, react]) => { bubbleHtml += `<span>${react}</span>`; });
            bubbleHtml += `</div>`;
        }
        
        bubbleHtml += `</div>`;
        row.innerHTML = bubbleHtml;
        
        if (blurModeActive) {
            const bubble = row.querySelector('.message-bubble');
            if (bubble) {
                bubble.classList.add('blur-active');
                attachBlurEvents(bubble);
            }
        }
        msgArea.appendChild(row);
    });
    
    // ===== SCROLL INTELLIGENT =====
    // - Premier chargement : on restaure la position sauvegard茅e (localStorage), sinon tout en bas.
    // - Mise 脿 jour en temps r茅el : si l'utilisateur 茅tait en bas, on le garde en bas ;
    //   sinon on pr茅serve exactement sa position de lecture (aucun saut).
    requestAnimationFrame(() => {
        if (isInitialLoad) {
            restaurerPositionScrollInitiale();
        } else if (wasAtBottom) {
            msgArea.scrollTop = msgArea.scrollHeight;
        } else {
            msgArea.scrollTop = previousScrollTop;
        }
        if (typeof detecterPositionDefilement === 'function') {
            detecterPositionDefilement();
        }
    });
}
      // ========== AFFICHER LES DERNIERS MESSAGES EN BAS ==========
function scrollToLatestMessage() {
    restaurerPositionScrollInitiale();
}
      // ========== NOTIFICATION INSTANTAN脡E (SANS TELEGRAM) ==========
function notifierInstantane(expediteurId) {
    // Met 脿 jour le statut en temps r茅el
    if (expediteurId !== currentUser.id) {
        // Marquer comme d茅livr茅 imm茅diatement
        const messages = document.querySelectorAll('.message-row.received');
        messages.forEach(row => {
            const meta = row.querySelector('.msg-meta');
            if (meta && !meta.querySelector('.status-tick')) {
                const timeStr = meta.textContent.trim();
                meta.innerHTML = `${timeStr} <span class="status-tick" style="color: #8696a0; margin-left: 3px;"><i class="fa-solid fa-check-double"></i></span>`;
            }
        });
    }
}
      
      
// ============================================================
// TABLEAU BLANC SIMPLIFI脡 (VERSION COMPL脠TE ET FONCTIONNELLE)
// ============================================================
// ============================================================
// 馃殌 TABLEAU BLANC ULTRA RAPIDE (OPTIMIS脡)
// ============================================================

let wb = {
    msgId: null,
    canvas: null,
    ctx: null,
    drawing: false,
    color: '#000000',
    size: 4,
    eraser: false,
    lastX: 0,
    lastY: 0,
    unsubscribe: null,
    lines: [],           // Stockage local des lignes
    isSyncing: false,    // Emp锚che les boucles
    syncTimeout: null,
    lastSyncTime: 0
};

const WB_COLORS = ['#000000', '#ff0000', '#ff6b00', '#ffd700', '#00cc44', '#0095f6', '#a800ff', '#ff00ff', '#ffffff'];
const WB_SIZES = [2, 4, 6, 10, 16];

// ========== CR脡ER UN TABLEAU BLANC ==========
function creerTableauBlanc() {
    if (!currentUser || !targetUser) {
        showTempNotification("鉂? Connecte-toi d'abord");
        return;
    }

    const msgData = {
        text: null,
        senderId: currentUser.id,
        senderName: currentUser.name,
        timestamp: firebase.firestore.FieldValue.serverTimestamp(),
        status: "sent",
        readBy: [currentUser.id],
        type: "whiteboard",
        whiteboardData: {
            lines: [],
            color: '#000000',
            size: 4,
            lastUpdate: firebase.firestore.FieldValue.serverTimestamp()
        }
    };

    db.collection('chats').doc(CHAT_ID).collection('messages').add(msgData)
        .then(docRef => {
            wb.msgId = docRef.id;
            wb.lines = [];
            showTempNotification("馃帹 Tableau cr茅茅 !");
            afficherWb(docRef.id, msgData);
        })
        .catch(err => {
            console.error("Erreur cr茅ation tableau:", err);
            showTempNotification("鉂? Erreur cr茅ation");
        });
}

// ========== AFFICHER LE TABLEAU ==========
function afficherWb(msgId, data) {
    if (document.querySelector(`[data-id="${msgId}"]`)) return;

    const msgArea = document.getElementById('msg-area');
    if (!msgArea) return;

    const row = document.createElement('div');
    const isSent = data.senderId === currentUser.id;
    row.className = `message-row ${isSent ? 'sent' : 'received'}`;
    row.setAttribute('data-id', msgId);

    const bubble = document.createElement('div');
    bubble.className = 'message-bubble';
    bubble.style.padding = '0';
    bubble.style.background = 'transparent';
    bubble.style.boxShadow = 'none';
    bubble.style.borderRadius = '0';

    const cardHtml = genererCarteWb(msgId, data);
    bubble.innerHTML = cardHtml;
    row.appendChild(bubble);
    msgArea.appendChild(row);

    setTimeout(() => {
        const canvas = document.getElementById(`wb-canvas-${msgId}`);
        if (canvas) {
            initialiserWb(msgId, canvas);
          ecouterWbEnTempsReel(msgId);
        }
    }, 200);

    // Ne pas scroller si l'utilisateur est en train de dessiner
    if (!wb.drawing) {
        msgArea.scrollTop = msgArea.scrollHeight;
    }
}

      // 脡coute en temps r茅el du tableau
function ecouterWbEnTempsReel(msgId) {
    if (!msgId) return;
    
    // Nettoie l'ancien 茅couteur s'il existe
    if (window._wbListener) {
        window._wbListener();
    }
    
    window._wbListener = db.collection('chats').doc(CHAT_ID).collection('messages').doc(msgId)
        .onSnapshot((doc) => {
            if (!doc.exists) return;
            const data = doc.data();
            if (!data.whiteboardData) return;
            
            // R茅cup猫re les nouvelles lignes
            const nouvellesLignes = data.whiteboardData.lines || [];
            const canvas = document.getElementById(`wb-canvas-${msgId}`);
            if (!canvas) return;
            
            // Redessine tout sur le canvas local
            const ctx = canvas.getContext('2d');
            const rect = canvas.parentElement.getBoundingClientRect();
            ctx.clearRect(0, 0, rect.width, rect.height);
            ctx.fillStyle = '#ffffff';
            ctx.fillRect(0, 0, rect.width, rect.height);
            
            nouvellesLignes.forEach(line => {
                ctx.beginPath();
                ctx.moveTo(line.x1, line.y1);
                ctx.lineTo(line.x2, line.y2);
                ctx.strokeStyle = line.color || '#000000';
                ctx.lineWidth = line.size || 4;
                ctx.lineCap = 'round';
                ctx.lineJoin = 'round';
                ctx.stroke();
            });
            
            // Met 脿 jour le cache local
            wb.lines = nouvellesLignes;
        });
}
// ============================================================
// 鉁? SUPPRESSION S脡CURIS脡E D'UN TABLEAU "DESSIN EN DIRECT"
// ============================================================
function demanderSuppressionTableau(msgId) {
    // S茅curit茅 c么t茅 client : on ne peut supprimer QUE ses propres tableaux
    // (l'ic么ne elle-m锚me n'est d茅j脿 g茅n茅r茅e que pour le propri茅taire, ceci est
    // une double v茅rification avant toute 茅criture en base).
    const row = document.querySelector(`[data-id="${msgId}"]`);
    if (!row || !row.classList.contains('sent')) {
        showTempNotification("鉂? Tu ne peux supprimer que tes propres tableaux");
        return;
    }
    if (!confirm("Supprimer ce tableau de dessin ? Il sera remplac茅 par 'Tableau supprim茅'.")) return;
    supprimerTableauWb(msgId);
}

async function supprimerTableauWb(msgId) {
    try {
        // Couper l'茅coute temps r茅el
        if (window._wbListener && wb.msgId === msgId) {
            window._wbListener();
            window._wbListener = null;
        }

        // --- EFFET THANOS DIRECT SUR L'脡CRAN ---
        const row = document.querySelector(`[data-id="${msgId}"]`);
        if (row) {
            // Ajouter la classe d'animation
            row.classList.add('thanos-effect');
            
            // Attendre 1 seconde pour l'animation
            await new Promise(resolve => setTimeout(resolve, 1000));
            
            // Supprimer l'茅l茅ment du DOM
            row.remove();
        }

        // Supprimer de Firestore
        const msgRef = db.collection('chats').doc(CHAT_ID).collection('messages').doc(msgId);
        await msgRef.delete();

         
    } catch (err) {
        console.error("Erreur suppression tableau:", err);
        showTempNotification("鉂? Erreur lors de la suppression");
    }
}

// ========== G脡N脡RER LA CARTE ==========
function genererCarteWb(msgId, data) {
    const linesCount = data.whiteboardData?.lines?.length || 0;
    const senderName = data.senderName || 'inconnu';
    // 鉁? S茅curit茅 : l'ic么ne de suppression n'est g茅n茅r茅e QUE si l'utilisateur courant
    // est bien l'auteur du tableau 鈥? elle n'existe donc m锚me pas dans le HTML des
    // tableaux re莽us des autres (ni visible, ni exploitable).
    const estProprietaireTableau = data.senderId === currentUser?.id;
    const iconeSuppressionTableau = estProprietaireTableau
        ? `<i class="fa-solid fa-trash wb-delete-icon" title="Supprimer ce tableau" onclick="event.stopPropagation(); demanderSuppressionTableau('${msgId}')"></i>`
        : '';

    return `
        <div class="wb-card" data-wb-id="${msgId}">
            <div class="wb-header">
                <span>馃帹 Dessin</span>
                <span style="font-size:0.6rem;opacity:0.6;">En direct-Ida au carr茅</span>
                ${iconeSuppressionTableau}
            </div>
            <div class="wb-canvas-box">
                <canvas id="wb-canvas-${msgId}" data-msg-id="${msgId}"></canvas>
            </div>
            <div class="wb-tools" id="wb-tools-${msgId}">
                ${genererOutilsWb(msgId)}
            </div>
            
        </div>
    `;
}

// ========== G脡N脡RER LES OUTILS ==========
function genererOutilsWb(msgId) {
    let html = '';

    WB_COLORS.forEach(color => {
        const isWhite = color === '#ffffff';
        const isActive = color === '#000000' ? 'active' : '';
        html += `<button class="wb-color ${isActive}" data-msg="${msgId}" data-color="${color}" 
            style="background:${color}; border-color:${isWhite ? '#ddd' : 'transparent'};"
            onclick="wbSetColor('${msgId}', '${color}', this)"></button>`;
    });

    html += `<span class="wb-separator"></span>`;

    WB_SIZES.forEach(size => {
        const isActive = size === 4 ? 'active' : '';
        const ps = Math.min(size, 14);
        html += `<button class="wb-btn ${isActive}" data-msg="${msgId}" data-size="${size}" onclick="wbSetSize('${msgId}', ${size}, this)">
            <span style="display:inline-block;width:${ps}px;height:${ps}px;border-radius:50%;background:#000;"></span>
        </button>`;
    });

    html += `<span class="wb-separator"></span>`;

    html += `<button class="wb-btn" data-msg="${msgId}" onclick="wbToggleEraser('${msgId}', this)" title="Gomme">
        <i class="fa-solid fa-eraser"></i>
    </button>`;

    return html;
}

// ========== INITIALISER LE CANVAS ==========
function initialiserWb(msgId, canvas) {
    const wrapper = canvas.parentElement;
    const rect = wrapper.getBoundingClientRect();
    const dpr = window.devicePixelRatio || 1;

    canvas.width = rect.width * dpr;
    canvas.height = rect.height * dpr;
    canvas.style.width = rect.width + 'px';
    canvas.style.height = rect.height + 'px';

    const ctx = canvas.getContext('2d');
    ctx.scale(dpr, dpr);

    ctx.fillStyle = '#ffffff';
    ctx.fillRect(0, 0, rect.width, rect.height);

    wb.canvas = canvas;
    wb.ctx = ctx;
    wb.msgId = msgId;
    wb.lines = [];

    // 脡v茅nements
    canvas.addEventListener('mousedown', (e) => wbStart(e, msgId));
    canvas.addEventListener('mousemove', (e) => wbMove(e, msgId));
    canvas.addEventListener('mouseup', () => wbStop(msgId));
    canvas.addEventListener('mouseleave', () => wbStop(msgId));
    canvas.addEventListener('touchstart', (e) => wbStartTouch(e, msgId), { passive: false });
    canvas.addEventListener('touchmove', (e) => wbMoveTouch(e, msgId), { passive: false });
    canvas.addEventListener('touchend', () => wbStop(msgId), { passive: false });

    // Charger les lignes existantes depuis Firestore
    const docRef = db.collection('chats').doc(CHAT_ID).collection('messages').doc(msgId);
    docRef.get().then(doc => {
        if (doc.exists && doc.data().whiteboardData?.lines) {
            wb.lines = doc.data().whiteboardData.lines || [];
            dessinerToutesLesLignes(msgId);
        }
    });

    // 脡couter en temps r茅el (mais OPTIMIS脡)
    ecouterWbOptimise(msgId);
}

// ========== 脡COUTE OPTIMIS脡E ==========
function ecouterWbOptimise(msgId) {
    if (wb.unsubscribe) wb.unsubscribe();

    wb.unsubscribe = db.collection('chats').doc(CHAT_ID).collection('messages').doc(msgId)
        .onSnapshot((doc) => {
            if (!doc.exists) return;
            const data = doc.data();
            if (!data.whiteboardData) return;

            const newLines = data.whiteboardData.lines || [];
            
            // Ne mettre 脿 jour que si le nombre de lignes a chang茅
            if (newLines.length !== wb.lines.length) {
                wb.lines = newLines;
                // Redessiner uniquement si ce n'est pas nous qui dessinons
                if (!wb.drawing) {
                    dessinerToutesLesLignes(msgId);
                }
            }
        });
}

// ========== DESSINER TOUTES LES LIGNES ==========
function dessinerToutesLesLignes(msgId) {
    const canvas = document.getElementById(`wb-canvas-${msgId}`);
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    const rect = canvas.parentElement.getBoundingClientRect();
    const dpr = window.devicePixelRatio || 1;

    ctx.save();
    ctx.setTransform(1, 0, 0, 1, 0, 0);
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    ctx.restore();

    ctx.fillStyle = '#ffffff';
    ctx.fillRect(0, 0, rect.width, rect.height);

    wb.lines.forEach(line => {
        ctx.beginPath();
        ctx.moveTo(line.x1, line.y1);
        ctx.lineTo(line.x2, line.y2);
        ctx.strokeStyle = line.color || '#000000';
        ctx.lineWidth = line.size || 4;
        ctx.lineCap = 'round';
        ctx.lineJoin = 'round';
        ctx.stroke();
    });
}

// ========== FONCTIONS DE DESSIN OPTIMIS脡ES ==========
function wbStart(e, msgId) {
    const canvas = document.getElementById(`wb-canvas-${msgId}`);
    if (!canvas) return;
    const rect = canvas.getBoundingClientRect();

    wb.drawing = true;
    wb.canvas = canvas;
    wb.ctx = canvas.getContext('2d');
    wb.msgId = msgId;
    wb.lastX = e.clientX - rect.left;
    wb.lastY = e.clientY - rect.top;
    
    // Dessiner un point
    const size = wb.eraser ? wb.size * 2 : wb.size;
    wb.ctx.beginPath();
    wb.ctx.arc(wb.lastX, wb.lastY, size / 2, 0, Math.PI * 2);
    wb.ctx.fillStyle = wb.eraser ? '#ffffff' : wb.color;
    wb.ctx.fill();
}

function wbMove(e, msgId) {
    if (!wb.drawing) return;
    const canvas = document.getElementById(`wb-canvas-${msgId}`);
    if (!canvas) return;
    const rect = canvas.getBoundingClientRect();

    const x = e.clientX - rect.left;
    const y = e.clientY - rect.top;

    // Dessiner localement (instantan茅)
    const size = wb.eraser ? wb.size * 2 : wb.size;
    wb.ctx.beginPath();
    wb.ctx.moveTo(wb.lastX, wb.lastY);
    wb.ctx.lineTo(x, y);
    wb.ctx.strokeStyle = wb.eraser ? '#ffffff' : wb.color;
    wb.ctx.lineWidth = size;
    wb.ctx.lineCap = 'round';
    wb.ctx.lineJoin = 'round';
    wb.ctx.stroke();

    // Sauvegarder dans le buffer local
    const line = {
        x1: wb.lastX, y1: wb.lastY,
        x2: x, y2: y,
        color: wb.eraser ? '#ffffff' : wb.color,
        size: size
    };
    wb.lines.push(line);

    wb.lastX = x;
    wb.lastY = y;

    // Sauvegarder sur Firestore (mais en RALENTI avec throttle)
    sauvegarderWbThrottle(msgId);
}

function wbStartTouch(e, msgId) {
    e.preventDefault();
    const touch = e.touches[0];
    const canvas = document.getElementById(`wb-canvas-${msgId}`);
    if (!canvas) return;
    const rect = canvas.getBoundingClientRect();

    wb.drawing = true;
    wb.canvas = canvas;
    wb.ctx = canvas.getContext('2d');
    wb.msgId = msgId;
    wb.lastX = touch.clientX - rect.left;
    wb.lastY = touch.clientY - rect.top;

    const size = wb.eraser ? wb.size * 2 : wb.size;
    wb.ctx.beginPath();
    wb.ctx.arc(wb.lastX, wb.lastY, size / 2, 0, Math.PI * 2);
    wb.ctx.fillStyle = wb.eraser ? '#ffffff' : wb.color;
    wb.ctx.fill();
}

function wbMoveTouch(e, msgId) {
    e.preventDefault();
    if (!wb.drawing) return;
    const touch = e.touches[0];
    const canvas = document.getElementById(`wb-canvas-${msgId}`);
    if (!canvas) return;
    const rect = canvas.getBoundingClientRect();

    const x = touch.clientX - rect.left;
    const y = touch.clientY - rect.top;

    const size = wb.eraser ? wb.size * 2 : wb.size;
    wb.ctx.beginPath();
    wb.ctx.moveTo(wb.lastX, wb.lastY);
    wb.ctx.lineTo(x, y);
    wb.ctx.strokeStyle = wb.eraser ? '#ffffff' : wb.color;
    wb.ctx.lineWidth = size;
    wb.ctx.lineCap = 'round';
    wb.ctx.lineJoin = 'round';
    wb.ctx.stroke();

    const line = {
        x1: wb.lastX, y1: wb.lastY,
        x2: x, y2: y,
        color: wb.eraser ? '#ffffff' : wb.color,
        size: size
    };
    wb.lines.push(line);

    wb.lastX = x;
    wb.lastY = y;

    sauvegarderWbThrottle(msgId);
}

function wbStop(msgId) {
    wb.drawing = false;
    // Sauvegarder une derni猫re fois
    if (msgId) {
        sauvegarderWbForce(msgId);
    }
}

// ========== SAUVEGARDE AVEC THROTTLE (R脡DUIT LES REQU脢TES) ==========
let wbThrottleTimer = null;
let wbThrottleLines = [];

function sauvegarderWbThrottle(msgId) {
    if (!msgId) return;
    
    clearTimeout(wbThrottleTimer);
    wbThrottleTimer = setTimeout(() => {
        sauvegarderWbForce(msgId);
    }, 300); // Sauvegarde toutes les 300ms
}

function sauvegarderWbForce(msgId) {
    if (!msgId || wb.isSyncing) return;
    
    wb.isSyncing = true;
    
    // Prendre uniquement les nouvelles lignes (les 20 derni猫res maximum)
    const linesToSave = wb.lines;  // 鈫? Pas de limite, sauvegarde TOUT
    
    const docRef = db.collection('chats').doc(CHAT_ID).collection('messages').doc(msgId);
    docRef.update({
        'whiteboardData.lines': linesToSave,
        'whiteboardData.color': wb.color,
        'whiteboardData.size': wb.size,
        'whiteboardData.lastUpdate': firebase.firestore.FieldValue.serverTimestamp()
    }).catch(err => {
        console.error("Erreur sauvegarde:", err);
    }).finally(() => {
        wb.isSyncing = false;
    });
}

// ========== OUTILS ==========
function wbSetColor(msgId, color, btn) {
    wb.color = color;
    wb.eraser = false;

    document.querySelectorAll(`#wb-tools-${msgId} .wb-color`).forEach(b => b.classList.remove('active'));
    btn.classList.add('active');

    document.querySelectorAll(`#wb-tools-${msgId} .wb-btn`).forEach(b => b.classList.remove('active'));
}

function wbSetSize(msgId, size, btn) {
    wb.size = size;
    document.querySelectorAll(`#wb-tools-${msgId} .wb-btn`).forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
}

function wbToggleEraser(msgId, btn) {
    wb.eraser = !wb.eraser;
    btn.classList.toggle('active');

    if (wb.eraser) {
        document.querySelectorAll(`#wb-tools-${msgId} .wb-color`).forEach(b => b.classList.remove('active'));
    }
}

// ========== EFFACER ==========
function effacerWb(msgId) {
    if (!confirm("馃棏锔? Effacer tout le dessin ?")) return;

    wb.lines = [];
    
    const canvas = document.getElementById(`wb-canvas-${msgId}`);
    if (canvas) {
        const ctx = canvas.getContext('2d');
        const rect = canvas.parentElement.getBoundingClientRect();
        ctx.fillStyle = '#ffffff';
        ctx.fillRect(0, 0, rect.width, rect.height);
    }

    const docRef = db.collection('chats').doc(CHAT_ID).collection('messages').doc(msgId);
    docRef.update({ 'whiteboardData.lines': [] }).then(() => {
        showTempNotification("馃棏锔? Tableau effac茅");
    }).catch(err => {
        console.error("Erreur effacement:", err);
        showTempNotification("鉂? Erreur");
    });
}

console.log("鉁? Tableau Blanc OPTIMIS脡 charg茅 !");

// ========== D脡TECTER L'ARRIV脡E D'UN TABLEAU BLANC ==========
// Cette fonction est appel茅e automatiquement quand un message "whiteboard" arrive
function verifierWb(data, msgId) {
    if (data.type === 'whiteboard') {
        if (!document.querySelector(`[data-id="${msgId}"]`)) {
            afficherWb(msgId, data);
        }
    }
}

console.log("鉁? Tableau Blanc charg茅 !");
      
      
      // ===== SAUT DE LIGNE PAR ENTR脡E =====
const inputChat = document.getElementById('chat-in');

inputChat.addEventListener('keydown', function(e) {
    if (e.key === 'Enter') {
        // On stoppe le comportement par d茅faut (qui pourrait soumettre un formulaire ou d茅clencher un envoi)
        e.preventDefault(); 
        
        // On r茅cup猫re la position actuelle du curseur
        const start = this.selectionStart;
        const end = this.selectionEnd;
        
        // On ins猫re le saut de ligne (\n) 脿 l'endroit exact du curseur
        this.value = this.value.substring(0, start) + "\n" + this.value.substring(end);
        
        // On remet le curseur juste apr猫s le saut de ligne qu'on vient de cr茅er
        this.selectionStart = this.selectionEnd = start + 1;
    }
});
      
      
      // ========== CR脡ER UN TABLEAU BLANC ==========
function creerTableauBlanc() {
    if (!currentUser || !targetUser) {
        showTempNotification("鉂? Connecte-toi d'abord");
        return;
    }

    const msgData = {
        text: null,
        senderId: currentUser.id,
        senderName: currentUser.name,
        timestamp: firebase.firestore.FieldValue.serverTimestamp(),
        status: "sent",
        readBy: [currentUser.id],
        type: "whiteboard",
        whiteboardData: {
            lines: [],
            color: '#000000',
            size: 4,
            lastUpdate: firebase.firestore.FieldValue.serverTimestamp()
        }
    };

    db.collection('chats').doc(CHAT_ID).collection('messages').add(msgData)
        .then(docRef => {
            showTempNotification("馃帹 Tableau cr茅茅 !");
            // Afficher directement le tableau
            afficherWb(docRef.id, msgData);
        })
        .catch(err => {
            console.error("Erreur cr茅ation tableau:", err);
            showTempNotification("鉂? Erreur cr茅ation");
        });
}
      
      // ============================================================
// 鈿? FORCER LA SYNCHRONISATION EN TEMPS R脡EL DU TABLEAU 鈿?
// ============================================================

// 1. 脡COUTEUR D脡DI脡 POUR LE TABLEAU BLANC
function ecouterTableauBlancTempsReel(msgId) {
    if (!msgId) return;
    
    console.log("馃憖 脡coute du tableau en temps r茅el:", msgId);
    
    // Nettoyer l'ancien 茅couteur
    if (window._wbListener) {
        window._wbListener();
        window._wbListener = null;
    }
    
    window._wbListener = db.collection('chats').doc(CHAT_ID).collection('messages').doc(msgId)
        .onSnapshot(function(doc) {
            if (!doc.exists) return;
            
            const data = doc.data();
            if (!data.whiteboardData) return;
            
            const wbData = data.whiteboardData;
            
            // Mettre 脿 jour le canvas en temps r茅el
            const canvas = document.getElementById(`wb-canvas-${msgId}`);
            if (!canvas) return;
            
            // Forcer le redessin
            dessinerLignesWbTempsReel(msgId, wbData.lines);
            
            console.log("馃攧 Tableau mis 脿 jour en temps r茅el");
        }, function(error) {
            console.error("Erreur 茅coute tableau:", error);
        });
}

// 2. VERSION FORC脡E DE DESSIN
function dessinerLignesWbTempsReel(msgId, lines) {
    const canvas = document.getElementById(`wb-canvas-${msgId}`);
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    const rect = canvas.parentElement.getBoundingClientRect();
    const dpr = window.devicePixelRatio || 1;

    // Effacer et redessiner TOUT
    ctx.save();
    ctx.setTransform(1, 0, 0, 1, 0, 0);
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    ctx.restore();

    ctx.fillStyle = '#ffffff';
    ctx.fillRect(0, 0, rect.width, rect.height);

    if (lines && lines.length > 0) {
        lines.forEach(line => {
            ctx.beginPath();
            ctx.moveTo(line.x1, line.y1);
            ctx.lineTo(line.x2, line.y2);
            ctx.strokeStyle = line.color || '#000000';
            ctx.lineWidth = line.size || 4;
            ctx.lineCap = 'round';
            ctx.lineJoin = 'round';
            ctx.stroke();
        });
    }
}

// 3. MODIFIER LA FONCTION INITIALISERWb
const originalInitialiserWb = initialiserWb;
initialiserWb = function(msgId, canvas) {
    // Appeler l'originale
    originalInitialiserWb(msgId, canvas);
    
    // AJOUTER L'脡COUTEUR TEMPS R脡EL
    setTimeout(function() {
        ecouterTableauBlancTempsReel(msgId);
    }, 500);
};

// 4. MODIFIER AFFICHERWB POUR ACTIVER L'脡COUTE
const originalAfficherWb = afficherWb;
afficherWb = function(msgId, data) {
    // Appeler l'originale
    originalAfficherWb(msgId, data);
    
    // Attendre que le canvas soit cr茅茅 puis 茅couter
    setTimeout(function() {
        ecouterTableauBlancTempsReel(msgId);
    }, 1000);
};

// (Ancien correctif "FORCER LA MISE 脌 JOUR QUAND UN TRAIT EST AJOUT脡" supprim茅 : il
// tentait de surcharger une fonction "sauvegarderTraitWb" qui n'a jamais exist茅 dans ce
// fichier, ce qui provoquait une erreur JS bloquant l'ex茅cution du reste du script.)

// 6. AJOUTER UN 脡COUTEUR GLOBAL POUR TOUS LES TABLEAUX
function ecouterTousLesTableaux() {
    if (!currentUser) return;
    
    console.log("馃攳 Recherche des tableaux blancs existants...");
    
    // Chercher tous les messages de type whiteboard
    db.collection('chats').doc(CHAT_ID).collection('messages')
        .where('type', '==', 'whiteboard')
        .onSnapshot(function(snapshot) {
            snapshot.docChanges().forEach(function(change) {
                if (change.type === 'added') {
                    const data = change.doc.data();
                    const msgId = change.doc.id;
                    
                    console.log("馃帹 Nouveau tableau d茅tect茅:", msgId);
                    
                    // V茅rifier si le tableau est d茅j脿 affich茅
                    if (!document.querySelector(`[data-id="${msgId}"]`)) {
                        afficherWb(msgId, data);
                    }
                }
            });
        });
}

// 7. APPELER L'脡COUTEUR GLOBAL AU D脡MARRAGE
setTimeout(function() {
    if (currentUser) {
        ecouterTousLesTableaux();
        console.log("鉁? 脡coute globale des tableaux activ茅e");
    }
}, 2000);

console.log("鉁? SYNCHRONISATION TEMPS R脡EL ACTIV脡E POUR LE TABLEAU BLANC");
      

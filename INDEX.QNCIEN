const SUPABASE_ANON_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im5vaWx1a2Voc3dudGZnY3N1c29lIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODEzNzQwOTEsImV4cCI6MjA5Njk1MDA5MX0.y2_dGvo_SrLaozd5zkLe4PFXSY1kSW0DKY5kNv2Keds"; // Remplace par ta cl茅

const supabaseClient = supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

// ========== UPLOAD DE FICHIER VERS SUPRABASE ==========
// ========== COMPRESSION IMAGE AVANT ENVOI ==========
// Redimensionne et compresse une image c么t茅 client avant upload : 茅vite d'envoyer
// des photos brutes de 5-15 MB directement depuis l'appareil photo, ce qui est la
// principale cause de lenteur 脿 l'envoi (l'envoi photo "classique" via l'茅diteur
// le fait d茅j脿 ; cette fonction permet d'appliquer le m锚me traitement 脿 la Flamme).
function compresserImageAvantEnvoi(file, maxDim = 1600, quality = 0.85) {
    return new Promise((resolve) => {
        const objectUrl = URL.createObjectURL(file);
        const img = new Image();
        img.onload = () => {
            let { width, height } = img;
            if (width > maxDim || height > maxDim) {
                const ratio = Math.min(maxDim / width, maxDim / height);
                width = Math.round(width * ratio);
                height = Math.round(height * ratio);
            }
            const canvas = document.createElement('canvas');
            canvas.width = width;
            canvas.height = height;
            canvas.getContext('2d').drawImage(img, 0, 0, width, height);
            URL.revokeObjectURL(objectUrl);
            canvas.toBlob((blob) => {
                if (!blob) { resolve(file); return; } // 茅chec : on retombe sur le fichier original
                resolve(new File([blob], `photo_${Date.now()}.jpg`, { type: 'image/jpeg' }));
            }, 'image/jpeg', quality);
        };
        img.onerror = () => resolve(file); // 茅chec de lecture : on retombe sur le fichier original
        img.src = objectUrl;
    });
}

async function uploadVersSupabase(file, type) {
    if (!currentUser) {
        showTempNotification("鉂? Connecte-toi d'abord");
        return null;
    }
    
    // Cr茅er un nom unique
    const fileExt = file.name.split('.').pop();
    const fileName = `${currentUser.id}_${Date.now()}.${fileExt}`;
    const filePath = fileName;  // 鈫? Plus de dossier "messages", directement 脿 la racine
    
    console.log("馃摛 Upload vers Supabase...");
    console.log("Bucket: chat_media");
    console.log("Chemin:", filePath);
    console.log("Taille:", (file.size / 1024).toFixed(2), "KB");
    
    try {
        const { data, error } = await supabaseClient.storage
            .from('chat_media')
            .upload(filePath, file, {
                cacheControl: '3600',
                contentType: file.type,
                upsert: true  // Permet d'茅craser si existe
            });
        
        if (error) {
            console.error("鉂? Erreur Supabase:", error);
            showTempNotification(`鉂? Erreur: ${error.message}`);
            return null;
        }
        
        console.log("鉁? Upload r茅ussi:", data);
        
        // R茅cup茅rer l'URL publique
        const { data: urlData } = supabaseClient.storage
            .from('chat_media')
            .getPublicUrl(filePath);
        
        console.log("馃摲 URL publique:", urlData.publicUrl);
        
        return urlData.publicUrl;
        
    } catch (error) {
        console.error("鉂? Exception:", error);
        showTempNotification("鉂? Erreur de connexion");
        return null;
    }
}
// (Ancienne fonction basculerVoirTout supprim茅e : elle 茅crasait la version corrig茅e
// d茅finie plus bas, qui inclut le fix anti-gel apr猫s envoi/r茅ception d'un message.
// Voir la fonction basculerVoirTout() plus loin dans ce script.)
// ========== FONCTION SUPPRIMER UN FICHIER ==========
async function supprimerFichierSupabase(filePath) {
    const { error } = await supabaseClient.storage
        .from('chat_media')
        .remove([filePath]);
    
    if (error) console.error("Erreur suppression:", error);
}

// ========== S脡LECTION PHOTO 鈫? OUVRE L'脡DITEUR (au lieu d'envoyer direct) ==========
function prendrePhotoAvecSupabase() {
    fermerMenuMedia();
    const input = document.createElement('input');
    input.type = 'file';
    input.accept = 'image/*';
    input.capture = 'environment';
    input.style.cssText = 'position:fixed; top:-9999px; left:-9999px; opacity:0; width:1px; height:1px;';
    document.body.appendChild(input);
    input.onchange = (e) => {
        if (e.target.files && e.target.files[0]) {
            const file = e.target.files[0];
            if (file.size > 15 * 1024 * 1024) {
                showTempNotification("鉂? Photo trop grande (max 15 MB)");
            } else {
                ouvrirEditeurMedia(file);
            }
        }
        input.remove();
    };
    input.click();
}

// ========== S脡LECTION VID脡O 鈫? OUVRE L'脡DITEUR ==========
function prendreVideoAvecSupabase() {
    fermerMenuMedia();
    const input = document.createElement('input');
    input.type = 'file';
    input.accept = 'video/*';
    input.capture = 'environment';
    input.style.cssText = 'position:fixed; top:-9999px; left:-9999px; opacity:0; width:1px; height:1px;';
    document.body.appendChild(input);
    input.onchange = (e) => {
        if (e.target.files && e.target.files[0]) {
            const file = e.target.files[0];
            if (file.size > 50 * 1024 * 1024) {
                showTempNotification("鉂? Vid茅o trop grande (max 50 MB)");
            } else {
                ouvrirEditeurMedia(file);
            }
        }
        input.remove();
    };
    input.click();
}

// ========== S脡LECTION DEPUIS LA GALERIE 鈫? OUVRE L'脡DITEUR (multi-s茅lection possible) ==========
function ouvrirGalerieSupabase() {
    fermerMenuMedia();
    const input = document.createElement('input');
    input.type = 'file';
    input.accept = 'image/*,video/*';
    input.multiple = true;
    input.style.cssText = 'position:fixed; top:-9999px; left:-9999px; opacity:0; width:1px; height:1px;';
    document.body.appendChild(input);
    input.onchange = (e) => {
        const fichiers = e.target.files ? Array.from(e.target.files) : [];
        input.remove();
        if (fichiers.length === 0) return;

        const valides = [];
        for (const file of fichiers) {
            const isVideo = file.type.startsWith('video/');
            const maxMB = isVideo ? 50 : 15;
            if (file.size > maxMB * 1024 * 1024) {
                showTempNotification(`鉂? "${file.name}" trop grand (max ${maxMB} MB) 鈥? ignor茅`);
                continue;
            }
            valides.push(file);
        }
        if (valides.length === 0) return;

        if (valides.length === 1) {
            ouvrirEditeurMedia(valides[0]);
        } else {
            envoyerPlusieursMedias(valides);
        }
    };
    input.click();
}

// ========== ENVOI DE PLUSIEURS PHOTOS/VID脡OS 脌 LA FOIS ==========
async function envoyerPlusieursMedias(fichiers) {
    if (!currentUser || !targetUser) return;
    showTempNotification(`馃摛 Envoi de ${fichiers.length} fichiers...`);
    const items = [];
    for (const file of fichiers) {
        const isVideo = file.type.startsWith('video/');
        try {
            const url = await uploadVersSupabase(file, isVideo ? 'video' : 'image');
            if (url) items.push({ type: isVideo ? 'video' : 'image', url });
        } catch (e) {
            console.error('Erreur upload (envoi multiple):', e);
        }
    }
    if (items.length === 0) {
        showTempNotification("鉂? Aucun fichier n'a pu 锚tre envoy茅");
        return;
    }
    try {
        await db.collection('chats').doc(CHAT_ID).collection('messages').add({
            type: 'media_group',
            items: items,
            text: null,
            senderId: currentUser.id,
            senderName: currentUser.name,
            timestamp: firebase.firestore.FieldValue.serverTimestamp(),
            status: 'sent',
            readBy: [currentUser.id],
            storage: 'supabase'
        });
        showTempNotification(`鉁? ${items.length} fichiers envoy茅s !`);
    } catch (e) {
        console.error('Erreur envoi groupe m茅dia:', e);
        showTempNotification("鉂? 脡chec de l'envoi du groupe");
    }
}

// Ouvre un 茅l茅ment d'un groupe de m茅dias en plein 茅cran (avec zoom libre)
function ouvrirMediaGroupItem(url, type) {
    currentPhotoUrl = url;
    mediaGalerieListe = [{ msgId: null, type: type, url: url }];
    mediaGalerieIndex = 0;
    const modal = document.getElementById('photo-modal');
    const modalImg = document.getElementById('modal-image');
    let modalVideo = document.getElementById('modal-video');
    if (!modalVideo) {
        modalVideo = document.createElement('video');
        modalVideo.id = 'modal-video';
        modalVideo.controls = true;
        modalVideo.playsInline = true;
        modalVideo.style.cssText = 'max-width:100%; max-height:100%; object-fit:contain; display:none;';
        modalImg.insertAdjacentElement('afterend', modalVideo);
    }
    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
    if (type === 'video') {
        modalImg.style.display = 'none';
        modalVideo.src = url;
        modalVideo.style.display = 'block';
        modalVideo.currentTime = 0;
        modalVideo.play().catch(() => {});
        activerZoomLibre('modal-video');
    } else {
        modalVideo.pause();
        modalVideo.removeAttribute('src');
        modalVideo.style.display = 'none';
        modalImg.src = url;
        modalImg.style.display = 'block';
        modalImg.style.maxWidth = '100%';
        modalImg.style.maxHeight = '100%';
        modalImg.style.width = 'auto';
        modalImg.style.height = 'auto';
        modalImg.style.objectFit = 'contain';
        modalImg.style.margin = '0';
        modalImg.style.borderRadius = '0';
        modalImg.style.boxShadow = 'none';
        modalImg.style.touchAction = 'none';
        activerZoomLibre('modal-image');
    }
}

// ========== ENVOI DE DOCUMENT (PDF, TXT, Word, Excel...) ==========
function envoyerDocumentAvecSupabase() {
    fermerMenuMedia();
    envoyerFichierVersChat('.pdf,.txt,.doc,.docx,.xls,.xlsx,.csv,.ppt,.pptx,application/pdf,text/plain,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/csv');
}

// "Fichier" : comme Document, mais sans restriction de type 鈥? ouvre l'app
// Fichiers (iOS) / le gestionnaire de fichiers (Android) sans filtrer les formats.
function envoyerFichierGenerique() {
    fermerMenuMedia();
    envoyerFichierVersChat('*/*');
}

// Ouvre un document intelligemment : les fichiers HTML sont rendus comme une
// vraie page (au lieu d'afficher le code source, ce qui arrivait si le
// stockage servait le fichier avec un type de contenu g茅n茅rique).
async function ouvrirDocumentIntelligent(url, ext) {
    const extension = (ext || '').toLowerCase();
    if (extension === 'html' || extension === 'htm') {
        try {
            const reponse = await fetch(url);
            const html = await reponse.text();
            const fenetre = window.open('', '_blank');
            if (fenetre) {
                fenetre.document.open();
                fenetre.document.write(html);
                fenetre.document.close();
                return;
            }
        } catch (e) {
            console.error('Erreur ouverture HTML:', e);
        }
    }
    window.open(url, '_blank');
}

function envoyerFichierVersChat(accept) {
    const input = document.createElement('input');
    input.type = 'file';
    input.accept = accept;
    input.style.cssText = 'position:fixed; top:-9999px; left:-9999px; opacity:0; width:1px; height:1px;';
    document.body.appendChild(input);
    input.onchange = async (e) => {
        if (!e.target.files || !e.target.files[0]) { input.remove(); return; }
        const file = e.target.files[0];
        input.remove();
        if (file.size > 25 * 1024 * 1024) {
            showTempNotification("鉂? Fichier trop grand (max 25 MB)");
            return;
        }
        showTempNotification("馃摛 Envoi du fichier...");
        const url = await uploadVersSupabase(file, 'document');
        if (!url) return;
        try {
            await db.collection('chats').doc(CHAT_ID).collection('messages').add({
                text: null,
                senderId: currentUser.id,
                senderName: currentUser.name,
                timestamp: firebase.firestore.FieldValue.serverTimestamp(),
                status: "sent",
                readBy: [currentUser.id],
                type: 'document',
                mediaUrl: url,
                fileName: file.name,
                fileSize: file.size,
                fileExt: (file.name.split('.').pop() || '').toLowerCase(),
                storage: 'supabase'
            });
            showTempNotification("馃搫 Fichier envoy茅 !");
        } catch (err) {
            console.error("Erreur envoi fichier:", err);
            showTempNotification("鉂? 脡chec de l'envoi du fichier");
        }
    };
    input.click();
}

// ========== PARTAGE DE POSITION (actuelle ou en direct) ==========
function ouvrirMenuPosition() {
    fermerMenuMedia();
    const panel = document.getElementById('position-panel');
    if (panel) panel.style.display = 'block';
}
function fermerMenuPosition() {
    const panel = document.getElementById('position-panel');
    if (panel) panel.style.display = 'none';
}

function obtenirPositionActuelle() {
    return new Promise((resolve, reject) => {
        if (!navigator.geolocation) { reject(new Error('G茅olocalisation non support茅e par ce navigateur')); return; }
        if (window.isSecureContext === false) { reject(new Error('INSECURE_CONTEXT')); return; }
        navigator.geolocation.getCurrentPosition(
            (pos) => resolve({ lat: pos.coords.latitude, lng: pos.coords.longitude }),
            (err) => reject(err),
            { enableHighAccuracy: true, timeout: 12000 }
        );
    });
}

// Traduit une erreur de g茅olocalisation en message clair et actionnable pour l'utilisateur.
function messageErreurGeoloc(err) {
    if (err && err.message === 'INSECURE_CONTEXT') {
        return "鉂? La g茅olocalisation n茅cessite que le site soit ouvert en HTTPS (pas en simple http:// ni en fichier local).";
    }
    if (!err || typeof err.code === 'undefined') {
        return "鉂? Impossible d'acc茅der 脿 ta position (erreur inconnue).";
    }
    switch (err.code) {
        case 1: // PERMISSION_DENIED
            return "鉂? Localisation refus茅e. Va dans les r茅glages de ton navigateur/t茅l茅phone 鈫? Site 鈫? Localisation, et autorise-la pour cette app.";
        case 2: // POSITION_UNAVAILABLE
            return "鉂? Position indisponible pour le moment (GPS/r茅seau). R茅essaie dans un instant.";
        case 3: // TIMEOUT
            return "鉂? La localisation a mis trop de temps 脿 r茅pondre. R茅essaie.";
        default:
            return "鉂? Impossible d'acc茅der 脿 ta position.";
    }
}

async function partagerPositionActuelle() {
    fermerMenuPosition();
    try {
        const { lat, lng } = await obtenirPositionActuelle();
        sauvegarderStatutPermission('loc', 'granted');
        majStatutPermission('loc', 'granted');
        await db.collection('chats').doc(CHAT_ID).collection('messages').add({
            type: 'location',
            mode: 'once',
            lat, lng,
            text: '馃搷 Position',
            senderId: currentUser.id,
            senderName: currentUser.name,
            timestamp: firebase.firestore.FieldValue.serverTimestamp(),
            readBy: [currentUser.id]
        });
        showTempNotification('馃搷 Position envoy茅e');
    } catch (e) {
        console.error('Erreur position:', e);
        sauvegarderStatutPermission('loc', 'denied');
        majStatutPermission('loc', 'denied');
        showTempNotification(messageErreurGeoloc(e));
    }
}

async function partagerPositionAvecETA() {
    fermerMenuPosition();
    const eta = prompt("J'arrive dans... (ex: 45min, 1h, 脿 19h)");
    if (eta === null) return;
    try {
        const { lat, lng } = await obtenirPositionActuelle();
        sauvegarderStatutPermission('loc', 'granted');
        majStatutPermission('loc', 'granted');
        await db.collection('chats').doc(CHAT_ID).collection('messages').add({
            type: 'location',
            mode: 'once',
            lat, lng,
            eta: eta.trim() ? `J'arrive dans ${eta.trim()}` : '',
            text: '馃搷 Position',
            senderId: currentUser.id,
            senderName: currentUser.name,
            timestamp: firebase.firestore.FieldValue.serverTimestamp(),
            readBy: [currentUser.id]
        });
        showTempNotification('馃搷 Position + heure d\'arriv茅e envoy茅es');
    } catch (e) {
        console.error('Erreur position ETA:', e);
        sauvegarderStatutPermission('loc', 'denied');
        majStatutPermission('loc', 'denied');
        showTempNotification(messageErreurGeoloc(e));
    }
}

let liveLocationWatchId = null;
let liveLocationMsgId = null;
let liveLocationExpireTimeout = null;

async function partagerPositionEnDirect() {
    fermerMenuPosition();
    if (liveLocationWatchId) {
        showTempNotification('馃搷 Un partage en direct est d茅j脿 actif');
        return;
    }
    try {
        const { lat, lng } = await obtenirPositionActuelle();
        sauvegarderStatutPermission('loc', 'granted');
        majStatutPermission('loc', 'granted');

        const DUREE_MS = 15 * 60 * 1000;
        const docRef = await db.collection('chats').doc(CHAT_ID).collection('messages').add({
            type: 'location',
            mode: 'live',
            lat, lng,
            liveEnded: false,
            expiresAt: Date.now() + DUREE_MS,
            text: '馃搷 Position en direct',
            senderId: currentUser.id,
            senderName: currentUser.name,
            timestamp: firebase.firestore.FieldValue.serverTimestamp(),
            readBy: [currentUser.id]
        });
        liveLocationMsgId = docRef.id;

        liveLocationWatchId = navigator.geolocation.watchPosition(
            (pos) => {
                db.collection('chats').doc(CHAT_ID).collection('messages').doc(liveLocationMsgId).update({
                    lat: pos.coords.latitude,
                    lng: pos.coords.longitude
                }).catch(() => {});
            },
            (err) => console.error('Erreur suivi position:', err),
            { enableHighAccuracy: true, maximumAge: 5000 }
        );

        liveLocationExpireTimeout = setTimeout(arreterPositionEnDirect, DUREE_MS);
        afficherBandeauPositionDirect();
        showTempNotification('馃搷 Position en direct activ茅e (15 min)');
    } catch (e) {
        console.error('Erreur position en direct:', e);
        sauvegarderStatutPermission('loc', 'denied');
        majStatutPermission('loc', 'denied');
        showTempNotification(messageErreurGeoloc(e));
    }
}

async function arreterPositionEnDirect() {
    if (liveLocationWatchId) { navigator.geolocation.clearWatch(liveLocationWatchId); liveLocationWatchId = null; }
    if (liveLocationExpireTimeout) { clearTimeout(liveLocationExpireTimeout); liveLocationExpireTimeout = null; }
    if (liveLocationMsgId) {
        try {
            await db.collection('chats').doc(CHAT_ID).collection('messages').doc(liveLocationMsgId).update({ liveEnded: true });
        } catch (e) {}
    }
    liveLocationMsgId = null;
    masquerBandeauPositionDirect();
}

function afficherBandeauPositionDirect() {
    let banner = document.getElementById('live-location-banner');
    if (!banner) {
        banner = document.createElement('div');
        banner.id = 'live-location-banner';
        banner.className = 'chat-call-banner';
        banner.style.display = 'flex';
        banner.innerHTML = `
            <div class="chat-call-banner-info">
                <i class="fa-solid fa-location-dot chat-call-banner-icon"></i>
                <div><div class="chat-call-banner-title">Position en direct active</div></div>
            </div>
            <div class="chat-call-banner-actions">
                <button class="chat-call-banner-btn end" onclick="arreterPositionEnDirect()">Arr锚ter</button>
            </div>`;
        const msgArea = document.getElementById('msg-area');
        if (msgArea && msgArea.parentNode) msgArea.parentNode.insertBefore(banner, msgArea);
    }
    banner.style.display = 'flex';
}
function masquerBandeauPositionDirect() {
    const banner = document.getElementById('live-location-banner');
    if (banner) banner.style.display = 'none';
}

// Ouvre Google Maps 脿 l'emplacement partag茅
function ouvrirPositionSurMaps(lat, lng) {
    window.open(`https://www.google.com/maps?q=${lat},${lng}`, '_blank');
}

// 脡coute en direct une position "live" affich茅e 脿 l'茅cran, pour que le
// destinataire voie la mise 脿 jour sans avoir 脿 rafra卯chir la page.
const positionLiveListeners = {};
function ecouterPositionEnDirect(msgId) {
    if (positionLiveListeners[msgId]) return;
    positionLiveListeners[msgId] = db.collection('chats').doc(CHAT_ID).collection('messages').doc(msgId)
        .onSnapshot((docSnap) => {
            if (!docSnap.exists) return;
            const data = docSnap.data();
            const card = document.querySelector(`.location-card[data-msgid="${msgId}"]`);
            if (!card) return;
            card.setAttribute('data-lat', data.lat);
            card.setAttribute('data-lng', data.lng);
            const statutEl = card.querySelector('.location-card-statut');
            if (data.liveEnded || (data.expiresAt && Date.now() > data.expiresAt)) {
                if (statutEl) statutEl.textContent = 'Partage termin茅';
                if (positionLiveListeners[msgId]) { positionLiveListeners[msgId](); delete positionLiveListeners[msgId]; }
            } else if (statutEl) {
                statutEl.textContent = 'Mise 脿 jour 脿 l\'instant';
            }
        });
}

function formaterTailleFichier(octets) {
    if (!octets) return '';
    if (octets < 1024) return octets + ' o';
    if (octets < 1024 * 1024) return (octets / 1024).toFixed(0) + ' Ko';
    return (octets / (1024 * 1024)).toFixed(1) + ' Mo';
}

function icoenPourExtensionDoc(ext) {
    const map = {
        pdf: 'fa-file-pdf', txt: 'fa-file-lines',
        doc: 'fa-file-word', docx: 'fa-file-word',
        xls: 'fa-file-excel', xlsx: 'fa-file-excel', csv: 'fa-file-excel',
        ppt: 'fa-file-powerpoint', pptx: 'fa-file-powerpoint'
    };
    return map[ext] || 'fa-file';
}
function couleurPourExtensionDoc(ext) {
    const map = {
        pdf: '#ff3b30', txt: '#8696a0',
        doc: '#2b579a', docx: '#2b579a',
        xls: '#217346', xlsx: '#217346', csv: '#217346',
        ppt: '#d24726', pptx: '#d24726'
    };
    return map[ext] || '#8696a0';
}

// ========== ENVOI UNIFI脡 VERS SUPABASE + FIRESTORE (URL l茅g猫re, jamais de base64) ==========
async function sendMediaMessage(type, file, caption, viewOnce, flammeCouleur) {
    const url = await uploadVersSupabase(file, type);
    if (!url) {
        showTempNotification("鉂? 脡chec de l'upload");
        return false;
    }
    const msgData = {
        text: caption || null,
        senderId: currentUser.id,
        senderName: currentUser.name,
        timestamp: firebase.firestore.FieldValue.serverTimestamp(),
        status: "sent",
        readBy: [currentUser.id],
        type: type,
        mediaUrl: url,
        storage: 'supabase'
    };
    // 鉁? Vue unique : le fichier reste sur Supabase (jamais supprim茅), mais dans le chat
    // il ne sera affichable qu'une seule fois (voir le rendu des bulles + ouvrirVueUnique).
    if (viewOnce) {
        msgData.viewOnce = true;
        msgData.viewOnceOpenedBy = []; // liste des id utilisateur ayant d茅j脿 consult茅 (chacun 1 fois)
    }
    // 馃敟 Flamme (item 4) : m茅dia envoy茅 depuis l'outil Flamme, affich茅 en carte
    // color茅e distincte dans le chat au lieu de la bulle classique.
    if (flammeCouleur) {
        msgData.flamme = true;
        msgData.flammeCouleur = flammeCouleur;
    }
    const messageRef = db.collection('chats').doc(CHAT_ID).collection('messages').doc();
    await messageRef.set(msgData);
    setTimeout(() => checkMessageDelivery(messageRef.id), 3000);
    showTempNotification(type === 'video' ? "馃帴 Vid茅o envoy茅e !" : "馃摲 Photo envoy茅e !");
    return true;
}

// ============================================================
// 鉁? 脡DITEUR DE M脡DIA 鈥? recadrage / dessin / rotation avant envoi
// ============================================================
let meType = 'image';          // 'image' | 'video'
let meVideoFile = null;        // fichier vid茅o original (non modifiable c么t茅 client)
let meCropMode = false;
let meDrawMode = false;
let meDrawColor = '#ff1744';
let meDrawing = false;
let meLastPoint = null;
let meCropDrag = null;
let meVideoDuration = 0;
let meTrimStart = 0;
let meTrimEnd = 0;
let meVideoCropRect = null; // {x,y,w,h} en pixels vid茅o r茅els, appliqu茅 via ffmpeg 脿 l'envoi
let meViewOnce = false; // vue unique : le m茅dia dispara卯t du chat apr猫s ouverture

const MEDIA_EDITOR_MAX_DIM = 1600; // redimensionnement pour un envoi rapide

function toggleMeViewOnce() {
    meViewOnce = !meViewOnce;
    document.getElementById('me-viewonce-btn').classList.toggle('active', meViewOnce);
    showTempNotification(meViewOnce ? "1锔忊儯 Vue unique activ茅e" : "Vue unique d茅sactiv茅e");
}

function ouvrirEditeurMedia(file) {
    const overlay = document.getElementById('media-editor-overlay');
    const canvas = document.getElementById('me-canvas');
    const video = document.getElementById('me-video-preview');
    const toolbar = document.getElementById('me-toolbar');
    const cropActions = document.getElementById('me-crop-actions');
    const captionInput = document.getElementById('me-caption-input');

    captionInput.value = '';
    meCropMode = false;
    meDrawMode = false;
    meViewOnce = false;
    document.getElementById('me-viewonce-btn').classList.remove('active');
    document.getElementById('me-crop-box').style.display = 'none';
    document.getElementById('me-color-swatches').style.display = 'none';
    cropActions.style.display = 'none';
    setMeToolActive(null);

    const isVideo = file.type.startsWith('video/');
    meType = isVideo ? 'video' : 'image';
    document.getElementById('me-header-title').textContent = isVideo ? 'Vid茅o' : 'Photo';
    toolbar.style.display = 'flex';
    // Rotation et dessin ne sont disponibles que pour les photos (n茅cessitent un re-rendu
    // pixel par pixel non applicable simplement 脿 une vid茅o). Le rognage, lui, fonctionne
    // aussi pour la vid茅o (appliqu茅 via ffmpeg au moment de l'envoi).
    document.querySelector('.me-tool-btn[data-tool="rotate"]').style.display = isVideo ? 'none' : 'flex';
    document.querySelector('.me-tool-btn[data-tool="draw"]').style.display = isVideo ? 'none' : 'flex';
    meVideoCropRect = null;
    document.getElementById('me-crop-box').classList.remove('locked');
    document.getElementById('me-crop-badge').style.display = 'none';

    if (isVideo) {
        meVideoFile = file;
        canvas.style.display = 'none';
        video.style.display = 'block';
        video.src = URL.createObjectURL(file);
        meSetupVideoTrim();
        meLoadFFmpegScript().catch(() => {}); // pr茅chargement silencieux en arri猫re-plan
    } else {
        meVideoFile = null;
        document.getElementById('me-video-trim').style.display = 'none';
        video.style.display = 'none';
        canvas.style.display = 'block';
        const objectUrl = URL.createObjectURL(file);
        const img = new Image();
        img.onload = () => {
            let { width, height } = img;
            if (width > MEDIA_EDITOR_MAX_DIM || height > MEDIA_EDITOR_MAX_DIM) {
                const ratio = Math.min(MEDIA_EDITOR_MAX_DIM / width, MEDIA_EDITOR_MAX_DIM / height);
                width = Math.round(width * ratio);
                height = Math.round(height * ratio);
            }
            canvas.width = width;
            canvas.height = height;
            canvas.getContext('2d').drawImage(img, 0, 0, width, height);
            URL.revokeObjectURL(objectUrl);
        };
        img.src = objectUrl;
    }

    overlay.classList.add('active');
}

function fermerEditeurMedia() {
    document.getElementById('media-editor-overlay').classList.remove('active');
    const video = document.getElementById('me-video-preview');
    video.pause();
    video.removeAttribute('src');
    video.load();
    video.ontimeupdate = null;
    meVideoFile = null;
    meVideoDuration = 0;
    meTrimStart = 0;
    meTrimEnd = 0;
    meVideoCropRect = null;
    document.getElementById('me-crop-box').classList.remove('locked');
    document.getElementById('me-crop-badge').style.display = 'none';
    document.getElementById('me-video-trim').style.display = 'none';
    meCropMode = false;
    meDrawMode = false;
    document.getElementById('me-crop-box').style.display = 'none';
    document.getElementById('me-crop-actions').style.display = 'none';
    setMeToolActive(null);
}

// ----- D脡COUPE VID脡O (choisir un d茅but et une fin avant l'envoi) -----
function meFormatTime(s) {
    if (!isFinite(s) || s < 0) s = 0;
    const m = Math.floor(s / 60);
    const sec = Math.floor(s % 60);
    return `${m}:${sec.toString().padStart(2, '0')}`;
}

function meSetupVideoTrim() {
    const video = document.getElementById('me-video-preview');
    const trimUI = document.getElementById('me-video-trim');
    trimUI.style.display = 'none';
    video.onloadedmetadata = () => {
        meVideoDuration = video.duration || 0;
        meTrimStart = 0;
        meTrimEnd = meVideoDuration;
        const startInput = document.getElementById('me-trim-start');
        const endInput = document.getElementById('me-trim-end');
        startInput.min = 0; startInput.max = meVideoDuration; startInput.step = 0.1; startInput.value = 0;
        endInput.min = 0; endInput.max = meVideoDuration; endInput.step = 0.1; endInput.value = meVideoDuration;
        // La d茅coupe n'a de sens que si la vid茅o dure plus de 2 secondes
        trimUI.style.display = meVideoDuration > 2 ? 'block' : 'none';
        meUpdateTrimUI();
        video.ontimeupdate = () => {
            if (video.currentTime >= meTrimEnd) {
                video.pause();
                video.currentTime = meTrimStart;
            }
        };
    };
}

function meUpdateTrimUI() {
    const startInput = document.getElementById('me-trim-start');
    const endInput = document.getElementById('me-trim-end');
    let start = parseFloat(startInput.value);
    let end = parseFloat(endInput.value);
    const minGap = Math.min(0.5, meVideoDuration || 0.5);

    if (end - start < minGap) {
        if (document.activeElement === endInput) {
            end = Math.min(meVideoDuration, start + minGap);
            endInput.value = end;
        } else {
            start = Math.max(0, end - minGap);
            startInput.value = start;
        }
    }

    meTrimStart = start;
    meTrimEnd = end;

    const pctStart = meVideoDuration ? (start / meVideoDuration) * 100 : 0;
    const pctEnd = meVideoDuration ? (end / meVideoDuration) * 100 : 100;
    const selected = document.getElementById('me-trim-selected');
    selected.style.left = pctStart + '%';
    selected.style.width = Math.max(0, pctEnd - pctStart) + '%';

    document.getElementById('me-trim-start-label').textContent = meFormatTime(start);
    document.getElementById('me-trim-end-label').textContent = meFormatTime(end);
    document.getElementById('me-trim-duration-label').textContent = 'Dur茅e : ' + meFormatTime(end - start);

    const video = document.getElementById('me-video-preview');
    video.currentTime = start;
}

// ----- Chargement paresseux de ffmpeg.wasm (uniquement si l'utilisateur d茅coupe une vid茅o) -----
let meFFmpegScriptPromise = null;
function meLoadFFmpegScript() {
    if (window.FFmpeg) return Promise.resolve();
    if (meFFmpegScriptPromise) return meFFmpegScriptPromise;
    meFFmpegScriptPromise = new Promise((resolve, reject) => {
        const script = document.createElement('script');
        script.src = 'https://unpkg.com/@ffmpeg/ffmpeg@0.11.6/dist/ffmpeg.min.js';
        script.crossOrigin = 'anonymous';
        script.onload = () => resolve();
        script.onerror = () => reject(new Error('ffmpeg-script-failed'));
        document.head.appendChild(script);
    });
    return meFFmpegScriptPromise;
}

let meFFmpegInstance = null;
async function meGetFFmpeg() {
    await meLoadFFmpegScript();
    if (!window.FFmpeg) throw new Error('ffmpeg-unavailable');
    if (!meFFmpegInstance) {
        const { createFFmpeg } = window.FFmpeg;
        meFFmpegInstance = createFFmpeg({
            log: false,
            // Core mono-thread : fonctionne sans les en-t锚tes serveur COOP/COEP
            // (n茅cessaires uniquement pour la variante multi-thread), donc compatible
            // avec un simple fichier HTML statique, y compris sur Safari/iOS.
            corePath: 'https://unpkg.com/@ffmpeg/core-st@0.11.1/dist/ffmpeg-core.js',
            // Requis par la variante "core-st" : sans cette option le WASM plante avec
            // "Cannot call unknown function proxy_main" (test茅 et confirm茅).
            mainName: 'main'
        });
    }
    if (!meFFmpegInstance.isLoaded()) {
        await meFFmpegInstance.load();
    }
    return meFFmpegInstance;
}

async function meTrimVideo(file, start, end, cropRect) {
    const ffmpeg = await meGetFFmpeg();
    const { fetchFile } = window.FFmpeg;
    const ext = (file.name.split('.').pop() || 'mp4').toLowerCase();
    const inputName = 'entree.' + ext;
    ffmpeg.FS('writeFile', inputName, await fetchFile(file));
    const duration = Math.max(0.1, end - start).toFixed(2);

    const args = ['-ss', String(start), '-i', inputName, '-t', duration];
    if (cropRect && cropRect.w > 0 && cropRect.h > 0) {
        // Un recadrage n茅cessite un r茅-encodage (impossible de "copier" un flux recadr茅)
        args.push(
            '-vf', `crop=${cropRect.w}:${cropRect.h}:${cropRect.x}:${cropRect.y}`,
            '-c:v', 'libx264', '-preset', 'ultrafast', '-crf', '23',
            '-c:a', 'aac'
        );
    } else {
        // Pas de recadrage : copie directe des flux, beaucoup plus rapide
        args.push('-c', 'copy');
    }
    args.push('-avoid_negative_ts', 'make_zero', 'sortie.mp4');

    await ffmpeg.run(...args);
    const data = ffmpeg.FS('readFile', 'sortie.mp4');
    try { ffmpeg.FS('unlink', inputName); } catch (e) {}
    try { ffmpeg.FS('unlink', 'sortie.mp4'); } catch (e) {}
    return new File([data.buffer], `video_${Date.now()}.mp4`, { type: 'video/mp4' });
}

function setMeToolActive(tool) {
    document.querySelectorAll('.me-tool-btn').forEach(b => b.classList.remove('active'));
    if (tool) {
        const btn = document.querySelector(`.me-tool-btn[data-tool="${tool}"]`);
        if (btn) btn.classList.add('active');
    }
}

// ----- ROTATION -----
function meRotate() {
    if (meCropMode) meFinCrop(false);
    const canvas = document.getElementById('me-canvas');
    const ctx = canvas.getContext('2d');
    const w = canvas.width, h = canvas.height;
    const tmp = document.createElement('canvas');
    tmp.width = h; tmp.height = w;
    const tctx = tmp.getContext('2d');
    tctx.translate(h / 2, w / 2);
    tctx.rotate(Math.PI / 2);
    tctx.drawImage(canvas, -w / 2, -h / 2);
    canvas.width = h; canvas.height = w;
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    ctx.drawImage(tmp, 0, 0);
}

// ----- RECADRAGE (rognage) -----
function meGetActiveMediaEl() {
    return meType === 'video' ? document.getElementById('me-video-preview') : document.getElementById('me-canvas');
}

function meToggleCrop() {
    if (meCropMode) { meFinCrop(false); return; }
    meDrawMode = false;
    document.getElementById('me-color-swatches').style.display = 'none';
    setMeToolActive('crop');
    meCropMode = true;

    const mediaEl = meGetActiveMediaEl();
    const stage = document.getElementById('me-stage').getBoundingClientRect();
    const rect = mediaEl.getBoundingClientRect();
    const box = document.getElementById('me-crop-box');
    box.classList.remove('locked');

    const mediaLeft = rect.left - stage.left;
    const mediaTop = rect.top - stage.top;

    box.dataset.canvasLeft = mediaLeft;
    box.dataset.canvasTop = mediaTop;
    box.dataset.canvasW = rect.width;
    box.dataset.canvasH = rect.height;

    if (meType === 'video' && meVideoCropRect && meVideoFile) {
        // R茅-ouvrir l'茅dition avec la s茅lection pr茅c茅dente (en pixels vid茅o -> 茅cran)
        const video = mediaEl;
        const scaleX = rect.width / (video.videoWidth || rect.width);
        const scaleY = rect.height / (video.videoHeight || rect.height);
        box.style.left = (mediaLeft + meVideoCropRect.x * scaleX) + 'px';
        box.style.top = (mediaTop + meVideoCropRect.y * scaleY) + 'px';
        box.style.width = (meVideoCropRect.w * scaleX) + 'px';
        box.style.height = (meVideoCropRect.h * scaleY) + 'px';
    } else {
        const margin = 0.1;
        box.style.left = (mediaLeft + rect.width * margin) + 'px';
        box.style.top = (mediaTop + rect.height * margin) + 'px';
        box.style.width = (rect.width * (1 - 2 * margin)) + 'px';
        box.style.height = (rect.height * (1 - 2 * margin)) + 'px';
    }
    box.style.display = 'block';

    document.getElementById('me-toolbar').style.display = 'none';
    document.getElementById('me-video-trim').style.display = 'none';
    document.getElementById('me-crop-actions').style.display = 'flex';
}

function meCropPointerDown(e, mode) {
    e.stopPropagation();
    e.preventDefault();
    const box = document.getElementById('me-crop-box');
    const point = e.touches ? e.touches[0] : e;
    meCropDrag = {
        mode,
        startX: point.clientX,
        startY: point.clientY,
        startLeft: parseFloat(box.style.left),
        startTop: parseFloat(box.style.top),
        startW: parseFloat(box.style.width),
        startH: parseFloat(box.style.height)
    };
    document.addEventListener('mousemove', meCropPointerMove);
    document.addEventListener('mouseup', meCropPointerUp);
    document.addEventListener('touchmove', meCropPointerMove, { passive: false });
    document.addEventListener('touchend', meCropPointerUp);
}

function meCropPointerMove(e) {
    if (!meCropDrag) return;
    e.preventDefault();
    const point = e.touches ? e.touches[0] : e;
    const dx = point.clientX - meCropDrag.startX;
    const dy = point.clientY - meCropDrag.startY;
    const box = document.getElementById('me-crop-box');
    const minSize = 40;
    const boundLeft = parseFloat(box.dataset.canvasLeft);
    const boundTop = parseFloat(box.dataset.canvasTop);
    const boundW = parseFloat(box.dataset.canvasW);
    const boundH = parseFloat(box.dataset.canvasH);
    const { mode, startLeft, startTop, startW, startH } = meCropDrag;
    let left = startLeft, top = startTop, w = startW, h = startH;

    if (mode === 'move') {
        left = Math.max(boundLeft, Math.min(startLeft + dx, boundLeft + boundW - w));
        top = Math.max(boundTop, Math.min(startTop + dy, boundTop + boundH - h));
    } else if (mode === 'se') {
        w = Math.max(minSize, Math.min(startW + dx, boundLeft + boundW - left));
        h = Math.max(minSize, Math.min(startH + dy, boundTop + boundH - top));
    } else if (mode === 'nw') {
        left = Math.max(boundLeft, Math.min(startLeft + dx, startLeft + startW - minSize));
        top = Math.max(boundTop, Math.min(startTop + dy, startTop + startH - minSize));
        w = (startLeft + startW) - left;
        h = (startTop + startH) - top;
    } else if (mode === 'ne') {
        top = Math.max(boundTop, Math.min(startTop + dy, startTop + startH - minSize));
        w = Math.max(minSize, Math.min(startW + dx, boundLeft + boundW - left));
        h = (startTop + startH) - top;
    } else if (mode === 'sw') {
        left = Math.max(boundLeft, Math.min(startLeft + dx, startLeft + startW - minSize));
        h = Math.max(minSize, Math.min(startH + dy, boundTop + boundH - top));
        w = (startLeft + startW) - left;
    }

    box.style.left = left + 'px';
    box.style.top = top + 'px';
    box.style.width = w + 'px';
    box.style.height = h + 'px';
}

function meCropPointerUp() {
    meCropDrag = null;
    document.removeEventListener('mousemove', meCropPointerMove);
    document.removeEventListener('mouseup', meCropPointerUp);
    document.removeEventListener('touchmove', meCropPointerMove);
    document.removeEventListener('touchend', meCropPointerUp);
}

function meFinCrop(appliquer) {
    const box = document.getElementById('me-crop-box');
    if (appliquer && meType === 'video') {
        const video = document.getElementById('me-video-preview');
        const rect = video.getBoundingClientRect();
        const scaleX = (video.videoWidth || rect.width) / rect.width;
        const scaleY = (video.videoHeight || rect.height) / rect.height;
        const boxLeft = parseFloat(box.style.left);
        const boxTop = parseFloat(box.style.top);
        const boxW = parseFloat(box.style.width);
        const boxH = parseFloat(box.style.height);
        const mediaLeft = parseFloat(box.dataset.canvasLeft);
        const mediaTop = parseFloat(box.dataset.canvasTop);

        meVideoCropRect = {
            x: Math.max(0, Math.round((boxLeft - mediaLeft) * scaleX)),
            y: Math.max(0, Math.round((boxTop - mediaTop) * scaleY)),
            w: Math.round(boxW * scaleX),
            h: Math.round(boxH * scaleY)
        };
        // La zone reste affich茅e (verrouill茅e) pour montrer ce qui sera envoy茅
        box.classList.add('locked');
        document.getElementById('me-crop-badge').style.display = 'block';
        showTempNotification("鉁? Zone de recadrage vid茅o d茅finie");
    } else if (appliquer) {
        const canvas = document.getElementById('me-canvas');
        const rect = canvas.getBoundingClientRect();
        const scaleX = canvas.width / rect.width;
        const scaleY = canvas.height / rect.height;
        const boxLeft = parseFloat(box.style.left);
        const boxTop = parseFloat(box.style.top);
        const boxW = parseFloat(box.style.width);
        const boxH = parseFloat(box.style.height);
        const canvasLeft = parseFloat(box.dataset.canvasLeft);
        const canvasTop = parseFloat(box.dataset.canvasTop);

        const sx = Math.max(0, (boxLeft - canvasLeft) * scaleX);
        const sy = Math.max(0, (boxTop - canvasTop) * scaleY);
        const sw = boxW * scaleX;
        const sh = boxH * scaleY;

        const tmp = document.createElement('canvas');
        tmp.width = Math.max(1, Math.round(sw));
        tmp.height = Math.max(1, Math.round(sh));
        tmp.getContext('2d').drawImage(canvas, sx, sy, sw, sh, 0, 0, tmp.width, tmp.height);

        canvas.width = tmp.width;
        canvas.height = tmp.height;
        canvas.getContext('2d').drawImage(tmp, 0, 0);
    } else {
        // Annuler : on efface toute s茅lection vid茅o en attente
        if (meType === 'video') {
            meVideoCropRect = null;
            document.getElementById('me-crop-badge').style.display = 'none';
        }
    }

    if (!(appliquer && meType === 'video')) {
        box.style.display = 'none';
    }
    meCropMode = false;
    setMeToolActive(null);
    document.getElementById('me-crop-actions').style.display = 'none';
    document.getElementById('me-toolbar').style.display = 'flex';
    if (meType === 'video' && meVideoDuration > 2) {
        document.getElementById('me-video-trim').style.display = 'block';
    }
}

// ----- DESSIN -----
function meToggleDraw() {
    if (meCropMode) meFinCrop(false);
    meDrawMode = !meDrawMode;
    setMeToolActive(meDrawMode ? 'draw' : null);
    document.getElementById('me-color-swatches').style.display = meDrawMode ? 'flex' : 'none';
}

function meSetColor(c) {
    meDrawColor = c;
    document.querySelectorAll('.me-color-dot').forEach(d => d.classList.remove('selected'));
    const dot = document.querySelector(`.me-color-dot[data-color="${c}"]`);
    if (dot) dot.classList.add('selected');
}

function meGetCanvasPoint(e) {
    const canvas = document.getElementById('me-canvas');
    const rect = canvas.getBoundingClientRect();
    const point = e.touches ? e.touches[0] : e;
    const scaleX = canvas.width / rect.width;
    const scaleY = canvas.height / rect.height;
    return {
        x: (point.clientX - rect.left) * scaleX,
        y: (point.clientY - rect.top) * scaleY
    };
}

function meCanvasPointerDown(e) {
    if (!meDrawMode) return;
    e.preventDefault();
    meDrawing = true;
    meLastPoint = meGetCanvasPoint(e);
}

function meCanvasPointerMove(e) {
    if (!meDrawMode || !meDrawing) return;
    e.preventDefault();
    const canvas = document.getElementById('me-canvas');
    const ctx = canvas.getContext('2d');
    const p = meGetCanvasPoint(e);
    ctx.strokeStyle = meDrawColor;
    ctx.lineWidth = Math.max(4, canvas.width * 0.008);
    ctx.lineCap = 'round';
    ctx.lineJoin = 'round';
    ctx.beginPath();
    ctx.moveTo(meLastPoint.x, meLastPoint.y);
    ctx.lineTo(p.x, p.y);
    ctx.stroke();
    meLastPoint = p;
}

function meCanvasPointerUp() {
    meDrawing = false;
    meLastPoint = null;
}

// ----- ENVOI -----
async function envoyerMediaEdite() {
    const sendBtn = document.getElementById('me-send-btn');
    const uploading = document.getElementById('me-uploading-overlay');
    const uploadingText = document.getElementById('me-uploading-text');
    const caption = document.getElementById('me-caption-input').value.trim();

    sendBtn.disabled = true;
    uploadingText.textContent = meType === 'video' ? "Envoi de la vid茅o..." : "Envoi de la photo...";
    uploading.classList.add('active');

    try {
        let ok = false;
        if (meType === 'image') {
            const canvas = document.getElementById('me-canvas');
            const blob = await new Promise(resolve => canvas.toBlob(resolve, 'image/jpeg', 0.85));
            if (!blob) throw new Error('canvas-vide');
            const file = new File([blob], `photo_${Date.now()}.jpg`, { type: 'image/jpeg' });
            ok = await sendMediaMessage('image', file, caption, meViewOnce);
        } else if (meVideoFile) {
            let fichierAEnvoyer = meVideoFile;
            const estDecoupee = meVideoDuration > 0 && (meTrimStart > 0.05 || meTrimEnd < meVideoDuration - 0.05);
            const estRognee = !!meVideoCropRect;
            if (estDecoupee || estRognee) {
                uploadingText.textContent = estRognee ? "Recadrage de la vid茅o..." : "D茅coupage de la vid茅o...";
                try {
                    fichierAEnvoyer = await meTrimVideo(meVideoFile, meTrimStart, meTrimEnd, meVideoCropRect);
                } catch (err) {
                    console.error("Erreur traitement vid茅o:", err);
                    showTempNotification("鈿狅笍 Montage indisponible, envoi de la vid茅o compl猫te");
                    fichierAEnvoyer = meVideoFile;
                }
                uploadingText.textContent = "Envoi de la vid茅o...";
            }
            ok = await sendMediaMessage('video', fichierAEnvoyer, caption, meViewOnce);
        }
        if (ok) fermerEditeurMedia();
    } catch (err) {
        console.error("Erreur envoi m茅dia 茅dit茅:", err);
        showTempNotification("鉂? 脡chec de l'envoi");
    } finally {
        uploading.classList.remove('active');
        sendBtn.disabled = false;
    }
}
      
      // Nettoyage agressif des anciens listeners
setTimeout(() => {
    console.log("馃Ч Nettoyage des anciennes notifications termin茅");
}, 1500);
// ==================== CONFIGURATION TELEGRAM ====================
const TELEGRAM_BOT_TOKEN_AIDARA = "8818466564:AAHhfYo-tufycGw5CJGt8F9YyEm2SgHYvSE";
const TELEGRAM_CHAT_ID_AIDARA = "7399263012";
const TELEGRAM_BOT_TOKEN_IDA = "8921495493:AAEa1oO9gTh-Lk_QLa5MA65UXllbsLSUoZE";

const TELEGRAM_CHAT_ID_IDA = "6515818320";

// Anti-doublons
const notifiedMessages = new Set();

// ==================== FONCTION UNIQUE =============  ======
async function sendTelegramNotification(senderId, msgId) {
    if (!senderId || !currentUser) return;

    const isFromIda = senderId === 'ida';
    
    const botToken = isFromIda ? TELEGRAM_BOT_TOKEN_AIDARA : TELEGRAM_BOT_TOKEN_IDA;
    const chatId = isFromIda ? TELEGRAM_CHAT_ID_AIDARA : TELEGRAM_CHAT_ID_IDA;
    
    const message = `馃敂 NOUVEAU MESSAGE\n\n${isFromIda ? 'IDA' : 'Ahmed Said Aidara'} vous a envoy茅 un message.\n\n馃憠 Ouvrez l'application pour le lire.`;

    // Anti-doublon : cl茅 bas茅e sur l'ID unique du message (et non plus "exp茅diteur + minute").
    // L'ancienne cl茅 par minute bloquait 脿 tort la notif de TOUT message suivant du m锚me
    // exp茅diteur envoy茅 dans la m锚me minute (ex: juste apr猫s un appel, ou 2 messages rapproch茅s).
    const key = msgId ? `msg-${msgId}` : `${senderId}-${Math.floor(Date.now()/60000)}`;
    if (notifiedMessages.has(key)) return;
    notifiedMessages.add(key);

    try {
        const url = `https://api.telegram.org/bot${botToken}/sendMessage?chat_id=${chatId}&text=${encodeURIComponent(message)}&disable_notification=false`;
        const reponse = await fetch(url);
        const resultat = await reponse.json().catch(() => null);
        if (!reponse.ok || (resultat && resultat.ok === false)) {
            // Telegram renvoie souvent un statut HTTP 200 m锚me en cas d'erreur (mauvais
            // chat_id, bot bloqu茅, token r茅voqu茅...) : il faut lire le champ "ok" du
            // corps de r茅ponse pour ne pas croire 脿 tort que 莽a a march茅.
            console.error("鉂? Telegram a refus茅 l'envoi :", resultat);
            if (typeof showTempNotification === 'function') {
                showTempNotification("鈿狅笍 脡chec notif Telegram : " + (resultat?.description || reponse.status));
            }
            return;
        }
        console.log(`鉁? Notification Telegram envoy茅e 脿 ${isFromIda ? 'Aidara' : 'Ida'}`);
    } catch (e) {
        console.error("Erreur Telegram:", e);
        if (typeof showTempNotification === 'function') {
            showTempNotification("鈿狅笍 Erreur r茅seau Telegram (voir console)");
        }
    }
}

// ========== 脡COUTE EN TEMPS R脡EL DES STATUTS DE LECTURE ========== 
function ecouterStatutsTempsReel() {
    if (!currentUser || !targetUser) return;
    
    // Nettoyer les anciens listeners
    if (window._statutListener) {
        window._statutListener();
        window._statutListener = null;
    }
    
    console.log("馃憖 脡coute des statuts en temps r茅el activ茅e");
    
    // 脡couter TOUS les messages du chat
    window._statutListener = db.collection('chats').doc(CHAT_ID).collection('messages')
        .where('senderId', '==', targetUser.id) // Messages de l'AUTRE utilisateur
        .onSnapshot((snapshot) => {
            snapshot.docChanges().forEach((change) => {
                if (change.type === 'modified') {
                    const data = change.doc.data();
                    const msgId = change.doc.id;
                    
                    // Si le statut a chang茅 vers 'read'
                    if (data.status === 'read') {
                        console.log(`馃摉 Message ${msgId} marqu茅 comme LU en temps r茅el`);
                        updateMessageStatus(msgId, 'read');
                        
                        // Mettre 脿 jour l'ic么ne dans l'interface
                        const messageRow = document.querySelector(`[data-id="${msgId}"]`);
                        if (messageRow && messageRow.classList.contains('sent')) {
                            const tickElement = messageRow.querySelector('.status-tick');
                            if (tickElement) {
                                tickElement.innerHTML = `<i class="fa-solid fa-check-double" style="color: #53bdeb !important; font-size: 0.85rem;"></i>`;
                            }
                        }
                    } 
                    else if (data.status === 'delivered') {
                        console.log(`馃摠 Message ${msgId} marqu茅 comme D脡LIVR脡 en temps r茅el`);
                        updateMessageStatus(msgId, 'delivered');
                        
                        const messageRow = document.querySelector(`[data-id="${msgId}"]`);
                        if (messageRow && messageRow.classList.contains('sent')) {
                            const tickElement = messageRow.querySelector('.status-tick');
                            if (tickElement) {
                                tickElement.innerHTML = `<i class="fa-solid fa-check-double" style="color: #8696a0 !important; font-size: 0.85rem;"></i>`;
                            }
                        }
                    }
                }
            });
        }, (error) => {
            console.error("Erreur 茅coute statuts:", error);
        });
}

// ========== FONCTION POUR MARQUER LES MESSAGES COMME LUS ==========
function marquerTousMessagesCommeLus() {
    if (!currentUser || !targetUser) return;
    
    console.log("馃摉 Marquage des messages de", targetUser.name, "comme lus...");
    
    db.collection('chats').doc(CHAT_ID).collection('messages')
        .where('senderId', '==', targetUser.id)
        .where('status', '!=', 'read')
        .get()
        .then((snapshot) => {
            if (snapshot.empty) {
                console.log("鉁? Aucun message 脿 marquer comme lu");
                return;
            }
            
            const batch = db.batch();
            let count = 0;
            
            snapshot.docs.forEach((doc) => {
                batch.update(doc.ref, { 
                    status: 'read',
                    readAt: firebase.firestore.FieldValue.serverTimestamp()
                });
                count++;
            });
            
            return batch.commit().then(() => {
                console.log(`鉁? ${count} messages marqu茅s comme LUS`);
            });
        })
        .catch((err) => {
            console.error("鉂? Erreur marquage:", err);
        });
}

// ========== D脡TECTER QUAND L'UTILISATEUR EST ACTIF ==========
function detecterActiviteUtilisateur() {
    // Marquer comme lu seulement quand l'utilisateur interagit ET regarde vraiment
    // le bas du chat (pas juste parce qu'il a cliqu茅 n'importe o霉 sur la page).
    const events = ['click', 'touchstart', 'scroll', 'focus', 'keydown'];
    
    events.forEach(event => {
        document.addEventListener(event, function marquer() {
            if (!document.hidden && estProcheDuBasDuChat()) {
                marquerTousMessagesCommeLus();
            }
        });
    });
}

// ========== FONCTION PRINCIPALE 脌 APPELER DANS selectUser ==========
function activerSuiviStatuts() {
    // 1. 脡couter les statuts en temps r茅el
    ecouterStatutsTempsReel();
    
    // 2. Marquer les messages comme lus au chargement, SEULEMENT si on est visible
    // et positionn茅 en bas du chat (sinon on attendra un vrai scroll/interaction).
    setTimeout(() => {
        if (!document.hidden && estProcheDuBasDuChat()) {
            marquerTousMessagesCommeLus();
        }
    }, 1000);
    
    // 3. D茅tecter l'activit茅 pour marquer en temps r茅el
    detecterActiviteUtilisateur();
    
    // 4. Marquer quand l'utilisateur revient sur la page (si en bas du chat)
    document.addEventListener('visibilitychange', () => {
        if (!document.hidden && estProcheDuBasDuChat()) {
            console.log("馃憖 Page visible et en bas du chat - Marquage des messages comme lus");
            marquerTousMessagesCommeLus();
        }
    });
}
    // ========== RENDU UNIFI脡 D'UNE BULLE (couleur / d茅grad茅 / style) ==========
    // 鉁? Cette fonction est LA SEULE source de v茅rit茅 pour appliquer l'apparence
    // d'une bulle (que ce soit juste apr猫s une action locale, ou re莽u en temps r茅el
    // via Firestore). Avant, plusieurs 茅couteurs diff茅rents faisaient chacun leur
    // propre logique partielle (parfois incompl猫te), ce qui causait des bugs :
    // "il faut rafra卯chir pour voir la couleur" et "on ne peut plus changer le style
    // d'un autre message sans rafra卯chir". En centralisant ici, tout reste coh茅rent.
    const LISTE_STYLES_BULLE = ['bicolor','dark-passion','grid-style','rainbow','neon','wood','code-style','comics','watercolor','retro','glassmorphism','crystal','sunset','ocean','forest','midnight','rose','gold','galaxy','cyberpunk','handwritten'];

    function appliquerRenduBulleMessage(bubble, row, data) {
        if (!bubble) return;

        // On repart toujours d'un 茅tat propre : aucune classe de style, aucune
        // couleur inline. Comme 莽a, peu importe l'茅tat pr茅c茅dent de LA bulle, le
        // nouveau rendu calcul茅 ci-dessous sera TOUJOURS correct (fini les "else if"
        // qui ne se d茅clenchaient que dans certains cas pr茅cis).
        LISTE_STYLES_BULLE.forEach(style => bubble.classList.remove(style));
        bubble.style.removeProperty('background');
        bubble.style.removeProperty('color');

        if (data.customColor) {
            bubble.style.setProperty('background', data.customColor, 'important');
            bubble.style.setProperty('color', getContrastColor(data.customColor), 'important');
        } else if (data.customGradient) {
            bubble.style.setProperty('background', data.customGradient, 'important');
            bubble.style.setProperty('color', 'white', 'important');
        } else if (data.bubbleStyle) {
            bubble.classList.add(data.bubbleStyle);
        } else if (data.messageStyle) {
            bubble.classList.add(data.messageStyle);
        } else if (row && row.classList.contains('sent')) {
            const defaultStyle = localStorage.getItem('default_bubble_style');
            if (defaultStyle && defaultStyle !== 'none') {
                bubble.classList.add(defaultStyle);
            }
        }
    }
    window.appliquerRenduBulleMessage = appliquerRenduBulleMessage;
    window.LISTE_STYLES_BULLE = LISTE_STYLES_BULLE;

    // ========== 脡COUTE DES MESSAGES (FIRESTORE) - VERSION CORRIG脡E ==========
// ========== CACHE LOCAL DES MESSAGES (affichage instantan茅 au chargement) ==========
// On garde une copie des ~200 derniers messages dans localStorage. Au chargement,
// on les affiche IMM脡DIATEMENT (avant m锚me que Firestore ait r茅pondu), puis
// Firestore vient mettre 脿 jour/compl茅ter avec les donn茅es r茅elles 脿 son arriv茅e.
function cleCacheMessages() {
    return `msg_cache_${CHAT_ID}`;
}

function reconstituerTimestampCache(ts) {
    if (!ts) return null;
    if (typeof ts.toMillis === 'function') return ts;
    if (typeof ts.seconds === 'number') {
        return {
            seconds: ts.seconds,
            nanoseconds: ts.nanoseconds || 0,
            toMillis: function() { return this.seconds * 1000 + Math.floor(this.nanoseconds / 1e6); },
            toDate: function() { return new Date(this.toMillis()); }
        };
    }
    return null;
}

function sauvegarderCacheMessages(snapshot) {
    try {
        const docs = snapshot.docs.slice(-200); // suffisant pour un affichage instantan茅 de la fin de la conversation
        const cache = docs.map(d => ({ id: d.id, data: d.data() }));
        localStorage.setItem(cleCacheMessages(), JSON.stringify(cache));
    } catch (e) { /* cache best-effort, jamais bloquant */ }
}

function afficherDepuisCacheMessages() {
    try {
        const brut = localStorage.getItem(cleCacheMessages());
        if (!brut) return;
        const cache = JSON.parse(brut);
        if (!Array.isArray(cache) || cache.length === 0) return;
        const fauxSnapshot = {
            empty: false,
            docs: cache.map(item => ({
                id: item.id,
                data: () => {
                    const d = Object.assign({}, item.data);
                    if (d.timestamp) d.timestamp = reconstituerTimestampCache(d.timestamp);
                    return d;
                }
            }))
        };
        afficherTousLesMessages(fauxSnapshot, true);
    } catch (e) { /* cache best-effort, jamais bloquant */ }
}

function listenToMessages() {
    if (unsubscribeMessages) unsubscribeMessages();
    
    // Variable pour suivre le premier chargement (pas de notif, position de scroll restaur茅e)
    let isFirstSnapshot = true;

    // Affichage instantan茅 depuis le cache local, avant m锚me que Firestore r茅ponde
    const primeDepuisCache = !!localStorage.getItem(cleCacheMessages());
    afficherDepuisCacheMessages();
    
    // 鈿狅笍 Aucune limite : on charge l'historique COMPLET de la conversation, du
    // tout premier message 脿 aujourd'hui, sans jamais rien couper 鈥? m锚me si la
    // conversation compte des centaines de milliers de messages.
    unsubscribeMessages = db.collection('chats').doc(CHAT_ID).collection('messages')
        .orderBy('timestamp', 'asc')
        .onSnapshot(snapshot => {
            let hasNewMessage = false;
            let hasNewMessageFromOther = false;
            
            // ============================================================
            // EFFETS DE BORD + MISES 脌 JOUR L脡G脠RES (sans reconstruire toute la liste)
            // ============================================================
            snapshot.docChanges().forEach(change => {
                const data = change.doc.data();
                const msgId = change.doc.id;
                
                if (change.type === 'added') {
                    hasNewMessage = true;
                    if (data.senderId !== currentUser?.id) hasNewMessageFromOther = true;
                    
                    // Notification pour un message re莽u tout juste arriv茅 (jamais au 1er chargement)
                    // 鈿狅笍 On exclut les messages "syst猫me" (r茅cap d'appel, partage d'茅cran...) de cette
                    // notif g茅n茅rique : une notif Telegram d茅di茅e est d茅j脿 envoy茅e pour l'appel entrant
                    // lui-m锚me (voir startCall). Les inclure ici consommait la cl茅 anti-doublon
                    // "exp茅diteur + minute" de sendTelegramNotification et emp锚chait silencieusement
                    // la vraie notif du prochain message texte envoy茅 dans la m锚me minute.
                   const estMessageSysteme = data.type === 'call_log' || data.type === 'screenshare_log';
if (data.senderId === currentUser?.id && !isFirstSnapshot && !estMessageSysteme) {
    const now = new Date();
    const msgTime = data.timestamp?.toDate ? data.timestamp.toDate() : new Date(0);
    const diffSeconds = (now - msgTime) / 1000;
    if (diffSeconds < 5) {
        sendTelegramNotification(data.senderId, msgId);
    }
}
                    
                    // Marquer "delivered" si le message vient de l'autre personne et est encore "sent"
                    if (data.senderId === targetUser?.id && data.status === 'sent') {
                        change.doc.ref.update({
                            status: 'delivered',
                            deliveredAt: firebase.firestore.FieldValue.serverTimestamp()
                        }).catch(err => console.error("Erreur mise 脿 jour delivered:", err));
                    }

                    // ========== NOTIFICATION DANS L'APP (en plus de Telegram) ==========
                    // Message re莽u de l'autre personne (jamais au 1er chargement, jamais pour
                    // un message syst猫me). Si l'app est au premier plan, un simple toast suffit ;
                    // sinon (onglet en arri猫re-plan, autre appli au-dessus...) on d茅clenche la
                    // vraie notification navigateur (n茅cessite d'avoir cliqu茅 "Activer les
                    // notifications" une fois 鈥? voir demanderPermissionNotifications()).
                    if (data.senderId === targetUser?.id && !isFirstSnapshot && !estMessageSysteme) {
                        const nomExpediteur = data.senderName || targetUser?.name || 'Message';
                        if (document.visibilityState === 'visible') {
                            if (typeof showTempNotification === 'function') {
                                showTempNotification(`馃摡 ${nomExpediteur} : nouveau message`);
                            }
                        } else {
                            notifierDansApp(nomExpediteur);
                        }
                    }
                }
                else if (change.type === 'modified') {
                    // 鉁? Synchronisation FIABLE de la couleur/d茅grad茅 personnalis茅 d'un message.
                    // Plac茅e ici (dans l'茅couteur principal, toujours actif) au lieu des anciens
                    // 茅couteurs d茅di茅s qui n'茅taient jamais d茅marr茅s et ne se d茅clenchaient donc
                    // jamais -> c'茅tait la cause du "parfois 莽a marche, parfois il faut rafra卯chir".
                    {
                        const messageRowCouleur = document.querySelector(`[data-id="${msgId}"]`);
                        const bubbleCouleur = messageRowCouleur ? messageRowCouleur.querySelector('.message-bubble') : null;
                        // 鉁? On applique TOUJOURS le rendu complet (couleur, d茅grad茅, style
                        // ou d茅faut) 脿 partir des donn茅es actuelles du message, sans condition
                        // fragile. 脟a marche donc 脿 chaque fois, sur n'importe quel message,
                        // sans avoir besoin de rafra卯chir la page.
                        appliquerRenduBulleMessage(bubbleCouleur, messageRowCouleur, data);
                    }
                    
                    // Mise 脿 jour l茅g猫re des coches de statut (茅vite de reconstruire toute la liste,
                    // ce qui interromprait une 茅ventuelle lecture audio/vid茅o en cours)
                    if (data.status) {
                        const messageRow = document.querySelector(`[data-id="${msgId}"]`);
                        if (messageRow && messageRow.classList.contains('sent')) {
                            const bubble = messageRow.querySelector('.message-bubble');
                            const msgMeta = bubble ? bubble.querySelector('.msg-meta') : null;
                            if (msgMeta) {
                                // 鈿狅笍 On repart toujours d'un texte "propre" : on retire les coches (鉁?)
                                // ET tout badge "(modifi茅)" d茅j脿 pr茅sent, sinon celui-ci se r茅injecte
                                // et s'accumule ("(modifi茅) (modifi茅)") 脿 chaque changement de statut
                                // (envoy茅 -> distribu茅 -> lu) sur un message d茅j脿 marqu茅 modifi茅.
                                let timeText = msgMeta.textContent
                                    .replace(/[鉁揮/g, '')
                                    .replace(/\(modifi茅\)/gi, '')
                                    .trim();
                                let statusHtml = '<span class="status-tick" style="color: #8696a0; margin-left: 3px;"><i class="fa-solid fa-check"></i></span>';
                                if (data.status === 'read') {
                                    statusHtml = '<span class="status-tick" style="color: #53bdeb; margin-left: 3px;"><i class="fa-solid fa-check-double"></i></span>';
                                } else if (data.status === 'delivered') {
                                    statusHtml = '<span class="status-tick" style="color: #8696a0; margin-left: 3px;"><i class="fa-solid fa-check-double"></i></span>';
                                }
                                const modifiedTag = (data.modified && data.type !== 'call_log' && data.type !== 'screenshare_log')
                                    ? ' <span style="font-size:0.65rem; opacity:0.6;">(modifi茅)</span>' : '';
                                msgMeta.innerHTML = `${timeText} ${statusHtml}${modifiedTag}`;
                            }
                        }
                    }
                    
                    // 鉁? Si CE message est lui-m锚me une r茅ponse dont le message d'origine
                    // vient d'锚tre supprim茅 (replyToText remplac茅 par le marqueur), on
                    // met 脿 jour sa citation affich茅e en temps r茅el, sans reconstruire toute la liste.
                    if (data.replyToText === MARQUEUR_REPONSE_SUPPRIMEE) {
                        const messageRow = document.querySelector(`[data-id="${msgId}"]`);
                        const ancienneCitation = messageRow ? messageRow.querySelector('.reply-citation') : null;
                        if (ancienneCitation && !ancienneCitation.innerHTML.includes('Message supprim茅')) {
                            ancienneCitation.outerHTML = `<div class="reply-citation" style="font-style: italic; opacity: 0.7; cursor: default;"><i class="fa-solid fa-ban" style="margin-right:4px;"></i>Message supprim茅</div>`;
                        }
                    }
                    
                    // Mise 脿 jour l茅g猫re du morpion (sans reconstruire la liste)
                    if (data.type === 'game' && data.gameData && data.gameData.gameType === 'morpion') {
                        const existingRow = document.querySelector(`[data-id="${msgId}"]`);
                        const card = existingRow ? existingRow.querySelector('.morpion-card') : null;
                        if (card) {
                            const game = data.gameData;
                            const isMyTurn = game.turn === currentUser.id;
                            const statusDiv = card.querySelector('.morpion-status');
                            if (statusDiv) {
                                if (game.status === 'finished') {
                                    statusDiv.textContent = game.winner === 'nul' ? "馃幆 Match nul !" : `馃憫 Gagnant : ${game.winner === currentUser.id ? 'Toi' : targetUser.name}`;
                                    statusDiv.classList.remove('active-turn');
                                } else {
                                    statusDiv.textContent = isMyTurn ? "鈿? 脌 ton tour !  " : `鈴? ${targetUser.name} r茅fl茅chit...`;
                                    statusDiv.classList.toggle('active-turn', isMyTurn && game.status === 'active');
                                }
                            }
                            const headerSpan = card.querySelector('.morpion-header span:last-child');
                            if (headerSpan) headerSpan.textContent = `馃弳 ${game.scores.X || 0} - ${game.scores.O || 0}`;
                            for (let i = 0; i < 9; i++) {
                                const cell = card.querySelector(`.morpion-cell[data-cell-index="${i}"]`);
                                if (!cell) continue;
                                const value = game.board[i] || "";
                                cell.textContent = value;
                                cell.classList.remove('x', 'o', 'taken', 'win-cell');
                                if (value === "X") cell.classList.add('x', 'taken');
                                else if (value === "O") cell.classList.add('o', 'taken');
                                if (game.winningLine && game.winningLine.includes(i)) cell.classList.add('win-cell');
                                cell.style.cursor = (game.status === 'active' && isMyTurn && !value) ? 'pointer' : 'not-allowed';
                            }
                            const grid = card.querySelector('.morpion-grid');
                            if (grid) grid.classList.toggle('morpion-overlay-block', game.status !== 'active' || !isMyTurn);
                        }
                    }
                }
            });
            
            // ============================================================
            // RENDU COMPLET : uniquement au premier chargement ou quand un
            // nouveau message est r茅ellement arriv茅 (garantit l'ordre chronologique
            // strict sans jamais toucher les messages d茅j脿 affich茅s inutilement)
            // ============================================================
            const msgAreaEl = document.getElementById('msg-area');
            const wasAtBottomBeforeRender = msgAreaEl ? (msgAreaEl.scrollHeight - msgAreaEl.scrollTop - msgAreaEl.clientHeight) < 150 : true;

            // Si le cache local avait d茅j脿 affich茅 EXACTEMENT ces m锚mes messages,
            // on 茅vite de tout reconstruire une 2e fois pour ce premier "vrai"
            // snapshot 鈥? 莽a 茅vite le flash/re-d茅filement visible en double.
            let dejaToutAffichePartCache = false;
            if (isFirstSnapshot && primeDepuisCache && msgAreaEl) {
                const idsDejaAffiches = new Set(
                    Array.from(msgAreaEl.querySelectorAll('[data-id]')).map(el => el.getAttribute('data-id'))
                );
                dejaToutAffichePartCache = snapshot.docs.every(d => idsDejaAffiches.has(d.id))
                    && idsDejaAffiches.size === snapshot.docs.length;
            }
            
            if ((isFirstSnapshot || hasNewMessage) && !dejaToutAffichePartCache) {
                afficherTousLesMessages(snapshot, isFirstSnapshot);
                sauvegarderCacheMessages(snapshot); // met 脿 jour le cache local pour le prochain chargement instantan茅
// Apr猫s afficherTousLesMessages
if (!isFirstSnapshot) {
    setTimeout(traiterMessagesSecrets, 500);
} else {
    setTimeout(traiterMessagesSecrets, 1000);
}
            } else if (dejaToutAffichePartCache) {
                sauvegarderCacheMessages(snapshot); // on rafra卯chit quand m锚me le cache, sans re-rendre l'茅cran
            }
            
            // Si un message de l'autre personne arrive pendant qu'on lit l'historique
            // (pas en bas), on signale son arriv茅e avec le bouton pastille "Nouveau message"
            if (!isFirstSnapshot && hasNewMessageFromOther && !wasAtBottomBeforeRender) {
                afficherBoutonNouveauMessage();
            }
            
            if (isFirstSnapshot) {
                isFirstSnapshot = false;
                console.log("馃摫 Premier chargement - Aucune notification envoy茅e");
            }
        }, err => {
            console.error("Erreur listenToMessages:", err);
        });
}


 
        
        function triggerBombardment(char) {
            for (let i = 0; i < 60; i++) {
                setTimeout(() => {
                    const e = document.createElement('div');
                    e.className = 'falling-emoji';
                    e.innerText = char;
                    e.style.left = Math.random() * 100 + 'vw';
                    e.style.top = '-50px';
                    e.style.fontSize = Math.random() * 30 + 20 + 'px';
                    e.style.animationDuration = Math.random() * 2 + 2 + 's';
                    document.body.appendChild(e);
                    setTimeout(() => e.remove(), 4000);
                }, i * 50);
            }
        }
        
        function triggerMixedBombardment(emojiList) {
            for (let i = 0; i < 70; i++) {
                setTimeout(() => {
                    const e = document.createElement('div');
                    e.className = 'falling-emoji';
                    const randomEmoji = emojiList[Math.floor(Math.random() * emojiList.length)];
                    e.innerText = randomEmoji;
                    e.style.left = Math.random() * 100 + 'vw';
                    e.style.top = '-50px';
                    e.style.fontSize = Math.random() * 35 + 20 + 'px';
                    e.style.animationDuration = Math.random() * 2 + 1.5 + 's';
                    document.body.appendChild(e);
                    setTimeout(() => e.remove(), 3500);
                }, i * 40);
            }
        }

        // ========== ENVOI DE MESSAGES ==========
        function toggleSendBtn(show) {
            document.getElementById('send-btn').style.display = show ? 'block' : 'none';
            document.getElementById('in-actions').style.display = show ? 'none' : 'flex';
        }
        
        function cancelReply() { replyToId = null; document.getElementById('reply-preview').style.display = 'none'; }
        
   async function sendTextMessage() {

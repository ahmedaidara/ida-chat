// ========== HELPER : ENVOYER UN MESSAGE SYST脠ME SIMPLE (utilis茅 par les mini-jeux) ==========
async function envoyerMessageSimple(text) {
    if (!currentUser || !text) return;
    await db.collection('chats').doc(CHAT_ID).collection('messages').add({
        text: text,
        senderId: currentUser.id,
        senderName: currentUser.name,
        timestamp: firebase.firestore.FieldValue.serverTimestamp(),
        status: "sent",
        readBy: [currentUser.id],
        type: "text",
        mediaUrl: null
    });
}

// ========== ROUE DE LA CHANCE ==========
const ROUE_CATEGORIES_DEFAUT = ["Qui cuisine aujourd'hui", "Qui choisit le film", "Qui lance la discussion", "Qui anime le d茅bat"];
let roueCategorieActuelle = ROUE_CATEGORIES_DEFAUT[0];
let roueEnCours = false;

function ouvrirRoueChance() {
    fermerMenuJeux();
    const cont = document.getElementById('roue-categories');
    cont.innerHTML = '';
    let categories = ROUE_CATEGORIES_DEFAUT.slice();
    try {
        const perso = JSON.parse(localStorage.getItem('roue_categories_perso') || '[]');
        categories = categories.concat(perso);
    } catch(e) {}
    categories.forEach(cat => {
        const chip = document.createElement('div');
        chip.className = 'roue-chip' + (cat === roueCategorieActuelle ? ' active' : '');
        chip.textContent = cat;
        chip.onclick = () => { roueCategorieActuelle = cat; ouvrirRoueChance(); };
        cont.appendChild(chip);
    });
    const chipAdd = document.createElement('div');
    chipAdd.className = 'roue-chip roue-chip-add';
    chipAdd.textContent = '+ Ajouter';
    chipAdd.onclick = () => {
        const nouvelle = prompt("Nouvelle question pour la roue :");
        if (nouvelle && nouvelle.trim()) {
            let perso = [];
            try { perso = JSON.parse(localStorage.getItem('roue_categories_perso') || '[]'); } catch(e) {}
            perso.push(nouvelle.trim());
            localStorage.setItem('roue_categories_perso', JSON.stringify(perso));
            roueCategorieActuelle = nouvelle.trim();
            ouvrirRoueChance();
        }
    };
    cont.appendChild(chipAdd);

    document.getElementById('roue-question').textContent = roueCategorieActuelle;
    document.getElementById('roue-resultat').style.display = 'none';
    document.getElementById('roue-wheel').style.transform = 'rotate(0deg)';
    const nomA = (currentUser && currentUser.name) || 'Toi';
    const nomB = (targetUser && targetUser.name) || "L'autre";
    document.getElementById('roue-label-a').textContent = nomA;
    document.getElementById('roue-label-b').textContent = nomB;
    document.getElementById('roue-modal').style.display = 'flex';
}
function fermerRoueChance() {
    document.getElementById('roue-modal').style.display = 'none';
}
function tournerLaRoue() {
    if (roueEnCours) return;
    roueEnCours = true;
    const nomA = (currentUser && currentUser.name) || 'Toi';
    const nomB = (targetUser && targetUser.name) || "L'autre";
    const gagneA = Math.random() < 0.5;
    // La roue est coup茅e en 2 : 0-180deg = camp A, 180-360deg = camp B.
    // On calcule un nombre de tours + un angle final qui tombe dans la bonne moiti茅.
    const tours = 5 * 360;
    const angleDansMoitie = 20 + Math.random() * 140; // 茅vite de tomber pile sur la fronti猫re
    const angleFinal = gagneA ? (tours + angleDansMoitie) : (tours + 180 + angleDansMoitie);
    const roue = document.getElementById('roue-wheel');
    roue.style.transform = `rotate(${angleFinal}deg)`;
    setTimeout(() => {
        const gagnant = gagneA ? nomA : nomB;
        document.getElementById('roue-resultat-texte').textContent = `${roueCategorieActuelle} 鈫? ${gagnant} ! 馃帀`;
        document.getElementById('roue-resultat').style.display = 'block';
        roueEnCours = false;
    }, 4000);
}
function annoncerResultatRoue() {
    const texte = document.getElementById('roue-resultat-texte').textContent;
    if (texte) envoyerMessageSimple(`馃帯 ${texte}`);
    fermerRoueChance();
}


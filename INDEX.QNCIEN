}
       
      // =========================================================================
// BOUTON FLOATING "NOUVEAU MESSAGE" (D脡FILEMENT INTELLIGENT)
// =========================================================================

// 脡tat du bouton flottant
let newMessageCount = 0;
let isAtBottom = true;
let isButtonVisible = false;
let unreadMessages = [];

// D茅tecter si l'utilisateur est en bas de la conversation
function detecterPositionDefilement() {
    const msgArea = document.getElementById('msg-area');
    if (!msgArea) return true;
    
    // Marge de 100px pour consid茅rer qu'on est "en bas"
    const tolerance = 150;
    const atBottom = (msgArea.scrollHeight - msgArea.scrollTop - msgArea.clientHeight) < tolerance;
    isAtBottom = atBottom;
    
    // Si l'utilisateur scrolle en bas, cacher le bouton et r茅initialiser le compteur
    if (atBottom && isButtonVisible) {
        cacherBoutonNouveauMessage();
    }
    
    // Bouton "Retour en bas" (glassmorphism) : visible d猫s qu'on n'est plus tout en bas
    const scrollBtn = document.getElementById('scroll-to-bottom-btn');
    if (scrollBtn) {
        scrollBtn.classList.toggle('visible', !atBottom);
    }
    
    // Sauvegarder la position de lecture (debounced) pour la restaurer au prochain chargement
    sauvegarderPositionScrollDebounced(msgArea, atBottom);
    
    return atBottom;
}

// ========== SAUVEGARDE / RESTAURATION DE LA POSITION DE SCROLL ==========
function getScrollPositionKey() {
    return `chat_scroll_pos_${CHAT_ID}`;
}

let _scrollSaveTimeout = null;
function sauvegarderPositionScrollDebounced(msgArea, atBottom) {
    clearTimeout(_scrollSaveTimeout);
    _scrollSaveTimeout = setTimeout(() => {
        try {
            if (atBottom) {
                // En bas = comportement par d茅faut, on ne m茅morise rien de sp茅cifique
                localStorage.removeItem(getScrollPositionKey());
            } else {
                localStorage.setItem(getScrollPositionKey(), String(msgArea.scrollTop));
            }
        } catch (e) { /* localStorage indisponible, on ignore */ }
    }, 300);
}

// Repositionne le chat : 脿 la position sauvegard茅e si elle existe, sinon tout en bas
function restaurerPositionScrollInitiale() {
    const msgArea = document.getElementById('msg-area');
    if (!msgArea) return;
    
    let savedPos = null;
    try {
        savedPos = localStorage.getItem(getScrollPositionKey());
    } catch (e) { /* ignore */ }
    
    requestAnimationFrame(() => {
        if (savedPos !== null && !isNaN(parseInt(savedPos, 10))) {
            msgArea.scrollTop = parseInt(savedPos, 10);
        } else {
            msgArea.scrollTop = msgArea.scrollHeight;
        }
        detecterPositionDefilement();
    });
}

// Afficher le bouton flottant
function afficherBoutonNouveauMessage(compteur) {
    const btn = document.getElementById('new-msg-floating-btn');
    const countSpan = document.getElementById('new-msg-count');
    const textSpan = document.getElementById('new-msg-text');
    
    if (!btn) return;
    
    // Mettre 脿 jour le compteur
    newMessageCount = compteur || newMessageCount + 1;
    
    // Mettre 脿 jour le texte
    if (newMessageCount === 1) {
        textSpan.textContent = 'Nouveau message';
    } else {
        textSpan.textContent = `${newMessageCount} nouveaux`;
    }
    
    // Mettre 脿 jour le badge
    if (countSpan) {
        countSpan.textContent = newMessageCount;
    }
    
    // Afficher le bouton avec animation
    btn.style.display = 'flex';
    isButtonVisible = true;
    
    // Cacher automatiquement apr猫s 8 secondes si l'utilisateur ne clique pas
    clearTimeout(window._newMsgTimeout);
    window._newMsgTimeout = setTimeout(() => {
        if (isButtonVisible && !isAtBottom) {
            // R茅duire le compteur mais garder le bouton visible
            // (l'utilisateur a vu la notification mais n'a pas cliqu茅)
        }
    }, 8000);
}

// Cacher le bouton flottant
function cacherBoutonNouveauMessage() {
    const btn = document.getElementById('new-msg-floating-btn');
    if (!btn) return;
    
    btn.style.display = 'none';
    isButtonVisible = false;
    newMessageCount = 0;
    
    // R茅initialiser les messages non lus
    unreadMessages = [];
    
    clearTimeout(window._newMsgTimeout);
}

// D茅filer en bas de la conversation
function scrollToBottom() {
    const msgArea = document.getElementById('msg-area');
    if (msgArea) {
        msgArea.scrollTo({
            top: msgArea.scrollHeight,
            behavior: 'smooth'
        });
    }
    
    // Cacher les boutons apr猫s le d茅filement
    setTimeout(() => {
        cacherBoutonNouveauMessage();
        const scrollBtn = document.getElementById('scroll-to-bottom-btn');
        if (scrollBtn) scrollBtn.classList.remove('visible');
        isAtBottom = true;
        try { localStorage.removeItem(getScrollPositionKey()); } catch (e) {}
    }, 300);
}

// AJOUTER CETTE FONCTION DANS L'脡COUTEUR DE MESSAGES (listenToMessages)
// POUR D脡TECTER L'ARRIV脡E DE NOUVEAUX MESSAGES

// ========== FONCTION MODIFI脡E POUR D脡TECTER LES NOUVEAUX MESSAGES ==========
// 脌 AJOUTER DANS listenToMessages(), 脿 l'int茅rieur du traitement des 'added'


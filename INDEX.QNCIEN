        activerSystemeStatutComplet();
    }
}, 1000);

// 9. Nettoyage lors des changements
function nettoyerSystemeStatut() {
    if (window._presenceListener) {
        window._presenceListener();
        window._presenceListener = null;
    }
    if (STATUT_UTILISATEUR.pingInterval) {
        clearInterval(STATUT_UTILISATEUR.pingInterval);
        STATUT_UTILISATEUR.pingInterval = null;
    }
}
      
      // 脡couter les informations de statut et de batterie de l'autre utilisateur en temps r茅el
function 茅couterBatterieCorrespondant() {
    // D茅terminer l'ID de l'autre utilisateur
    const autreUserId = currentUser.id === 'ida' ? 'aidara' : 'ida';

    // Remplacer 'users' par le nom exact de votre collection de profils si n茅cessaire
    db.collection('users').doc(autreUserId).onSnapshot((doc) => {
        if (doc.exists) {
            const data = doc.data();
            
            // R茅cup茅rer le niveau de batterie (ex: 85)
            const batteryLevel = data.batteryLevel || 0;
            const isCharging = data.isCharging || false;

            // Mettre 脿 jour le texte du pourcentage
            const percentEl = document.getElementById('battery-percent');
            if (percentEl) percentEl.innerText = batteryLevel + '%';

            // Mettre 脿 jour l'ic么ne et la couleur en fonction du niveau
            const iconEl = document.getElementById('battery-icon');
            if (iconEl) {
                // R茅initialiser les classes de couleur
                iconEl.className = 'battery-icon';
                
                if (isCharging) {
                    iconEl.innerText = '鈿○煍?';
                    iconEl.classList.add('battery-charging');
                } else {
                    if (batteryLevel <= 20) {
                        iconEl.innerText = '馃';
                        iconEl.classList.add('battery-low');
                    } else if (batteryLevel <= 50) {
                        iconEl.innerText = '馃攱';
                        iconEl.classList.add('battery-medium');
                    } else {
                        iconEl.innerText = '馃攱';
                        iconEl.classList.add('battery-high');
                    }
                }
            }
        }
    });
}
      
      
      // Mettre 脿 jour ton propre niveau de batterie dans la base de donn茅es
async function mettreAJourMaBatterie() {
    if (!currentUser) return;

    try {
        // Utilise l'API Battery du navigateur
        if (navigator.getBattery) {
            const battery = await navigator.getBattery();
            
            const updateData = () => {
                db.collection('users').doc(currentUser.id).set({
                    batteryLevel: Math.round(battery.level * 100),
                    isCharging: battery.charging
                }, { merge: true });
            };

            // Mettre 脿 jour imm茅diatement et 脿 chaque changement
            updateData();
            battery.addEventListener('levelchange', updateData);
            battery.addEventListener('chargingchange', updateData);
        }
    } catch (error) {
        console.error("Erreur lors de la r茅cup茅ration de la batterie :", error);
    }
}
      

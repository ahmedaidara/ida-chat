            <button onclick="this.parentElement.parentElement.remove()" style="
                width:100%;
                padding:8px;
                background:#0095f6;
                color:white;
                border:none;
                border-radius:10px;
                cursor:pointer;
                font-weight:bold;
            ">鉁? Fermer</button>
        </div>
    `;
    
    document.body.appendChild(menu);
    
    // Fermer en cliquant ailleurs
    setTimeout(() => {
        document.addEventListener('click', function fermer(e) {
            if (!menu.contains(e.target) && e.target.closest('.header-left') !== document.querySelector('.header-left')) {
                menu.remove();
                document.removeEventListener('click', fermer);
            }
        });
    }, 100);
}

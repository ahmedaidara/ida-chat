     // ========== GESTION DE LA TYPING (CORRIG脡E) ==========
function handleTyping() {
    const input = document.getElementById('chat-in');
    const hasText = input.value.trim().length > 0;
    toggleSendBtn(hasText);
    autoResizeTextarea();
    if (currentUser) {
        db.collection('chats').doc(CHAT_ID).collection('typing').doc(currentUser.id)
            .set({ 
                isTyping: hasText,
                timestamp: firebase.firestore.FieldValue.serverTimestamp()
            })
            .catch(err => console.error("Erreur typing:", err));
    }
    clearTimeout(typingTimeout);
    if (hasText) {
        typingTimeout = setTimeout(stopTypingNotify, 2000);
    } else {
        stopTypingNotify();
    }
    sendLiveTypingUpdate();
}
        
       // ========== ARR脢TER LA TYPING (CORRIG脡E) ==========
function stopTypingNotify() {
    if (currentUser) {
        db.collection('chats').doc(CHAT_ID).collection('typing').doc(currentUser.id)
            .set({ isTyping: false })
            .catch(err => console.error("Erreur stop typing:", err));
    }
    document.getElementById('typing-ind').style.display = 'none';
}
        
     // ========== 脡COUTE DE LA TYPING (CORRIG脡E) ========== 
function listenToTyping() {
    if (!currentUser || !targetUser) return;
    const otherUserId = targetUser.id;
    if (unsubscribeTyping) {
        unsubscribeTyping();
        unsubscribeTyping = null;
    }
    unsubscribeTyping = db.collection('chats').doc(CHAT_ID).collection('typing').doc(otherUserId)
        .onSnapshot(doc => {
            if (doc.exists && doc.data().isTyping === true) {
                document.getElementById('typing-txt').innerText = `${targetUser.name} 茅crit...`;
                document.getElementById('typing-ind').style.display = 'flex';
            } else {
                document.getElementById('typing-ind').style.display = 'none';
            }
        }, (error) => {
            console.error("Erreur d'茅coute typing:", error);
        });
      // 鉁? Correction d'une faute de frappe critique : "ecouterStatutsEnTempsReel" (inexistante)
      // au lieu de "ecouterStatutsTempsReel". Cette erreur silencieuse interrompait TOUTE la
      // suite de selectUser() 脿 chaque connexion (restauration du statut d'humeur, suivi des
      // accus茅s de lecture, marquage des messages lus, etc. ne s'ex茅cutaient jamais).
      ecouterStatutsTempsReel();

}
        
        // ========== MESSAGES M脡DIAS ==========
        function triggerImageUpload() { document.getElementById('img-file').click(); }
        
        function uploadImage(input) {
            if(input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = e => sendMediaMessage('image', e.target.result);
                reader.readAsDataURL(input.files[0]);
            }
        }
        
        // (Ancienne fonction sendMediaMessage bas茅e sur le base64 supprim茅e : elle 茅crasait
        // la nouvelle version qui uploade vers Supabase 鈥? voir plus haut dans ce script.)
        
        // ========== ENREGISTREMENT AUDIO ==========
        async function toggleRecording() {
            const micIcon = document.getElementById('mic-btn');
            if (!micIcon) return;
            if (!mediaRecorder || mediaRecorder.state === 'inactive') {
                try {
                    const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
                    mediaRecorder = new MediaRecorder(stream);
                    audioChunks = [];
                    mediaRecorder.ondataavailable = e => audioChunks.push(e.data);
                    mediaRecorder.onstop = async () => {
const audioBlob = new Blob(audioChunks, { type: 'audio/webm' });
const fileName = `audio_${currentUser.id}_${Date.now()}.webm`;
const audioFile = new File([audioBlob], fileName, { type: 'audio/webm' });
    
    // Upload vers Supabase (comme pour les photos)
    const audioUrl = await uploadVersSupabase(audioFile, 'audio');
    
    if (audioUrl) {
        // Envoyer seulement l'URL dans Firestore
        await db.collection('chats').doc(CHAT_ID).collection('messages').add({
            text: null,
            senderId: currentUser.id,
            senderName: currentUser.name,
            timestamp: firebase.firestore.FieldValue.serverTimestamp(),
            status: "sent",
            readBy: [currentUser.id],
            type: "audio",
            mediaUrl: audioUrl,
            isEphemeralAudio: ephemeralAudioMode || false
        });
        
        showTempNotification("鉁? Audio envoy茅 !");
    } else {
        showTempNotification("鉂? Erreur lors de l'envoi");
    }
    
    // Remettre l'ic么ne micro normal
    micIcon.className = "fa-solid fa-microphone";
    micIcon.style.color = "var(--text-main)";
};
                    mediaRecorder.start();
                    micIcon.className = "fa-solid fa-circle-stop";
                    micIcon.style.color = "#ed4956";
                    setTimeout(() => { if(mediaRecorder.state === 'recording') toggleRecording(); }, 10000);
                } catch(err) { alert("Acc猫s micro refus茅."); }
            } else {
                mediaRecorder.stop();
                micIcon.className = "fa-solid fa-microphone";
                micIcon.style.color = "var(--text-main)";
            }
        }
        
        function sendEphemeralAudio(base64Data) {
            db.collection('chats').doc(CHAT_ID).collection('messages').add({
                text: null,
                senderId: currentUser.id,
                senderName: currentUser.name,
                timestamp: firebase.firestore.FieldValue.serverTimestamp(),
                status: "sent",
                readBy: [currentUser.id],
                type: "audio",
                isEphemeral: isEphemeral,
                isEphemeralAudio: true,
                mediaUrl: base64Data,
                playedBy: [],
                destroyed: false
            });
            ephemeralAudioMode = false;
            const audioBtn = document.getElementById('ephemeral-audio-btn');
            if(audioBtn) {
                audioBtn.style.color = '';
                audioBtn.style.textShadow = '';
            }
            showTempNotification("馃帣锔? Audio 茅ph茅m猫re envoy茅 !");
        }
        
        async function handleEphemeralAudioPlay(messageId, audioElement) {
            const msgRef = db.collection('chats').doc(CHAT_ID).collection('messages').doc(messageId);
            const doc = await msgRef.get();
            const data = doc.data();
            if (!data || !data.isEphemeralAudio) return;
            if (data.destroyed) {
                audioElement.remove();
                return;
            }
            if (data.playedBy && data.playedBy.includes(currentUser.id)) {
                showTempNotification("馃攪 .d茅j脿 茅cout茅 cet audio");
                audioElement.pause();
                return;
            }
            audioElement.addEventListener('ended', async () => {
                await msgRef.update({ playedBy: firebase.firestore.FieldValue.arrayUnion(currentUser.id) });
                const updatedDoc = await msgRef.get();
                if (updatedDoc.data().playedBy && updatedDoc.data().playedBy.length >= 2) {
                    await msgRef.delete();
                    showTempNotification("馃棏锔? Audio 茅ph茅m猫re supprim茅");
                } else {
                    audioElement.style.opacity = "0.5";
                    audioElement.disabled = true;
                    showTempNotification("馃攪 Audio 茅cout茅 - dispara卯tra quand l'autre l'aura 茅cout茅");
                }
            });
        }
        
        // ========== R脡ACTIONS ET MENUS ==========
        function handleDoubleTap(e, msgId) {
            e.preventDefault();
            selectedMessageId = msgId;
            const dock = document.getElementById('react-dock');
            dock.style.display = 'flex';
            dock.style.top = Math.min(e.pageY - 60, window.innerHeight - 100) + 'px';
            dock.style.left = Math.min(e.pageX - 50, window.innerWidth - 200) + 'px';
            setTimeout(() => dock.style.display = 'none', 5000);
        }
        
        function applyReaction(emoji) {
            if(selectedMessageId) {
                const ref = db.collection('chats').doc(CHAT_ID).collection('messages').doc(selectedMessageId);
                ref.update({ [`reactions.${currentUser.id}`]: emoji });
            }
            document.getElementById('react-dock').style.display = 'none';
        }
        
       function handleContextMenu(e, msgId) {
    // Emp锚cher le comportement par d茅faut
         if (blurModeActive) { if(e) e.preventDefault(); return false; }
    if (e && e.preventDefault) e.preventDefault();
    if (e && e.stopPropagation) e.stopPropagation();
    
    selectedMessageId = msgId;
    
    const menu = document.getElementById('ctx-menu');

    // On affiche d'abord le menu (hors-茅cran) pour pouvoir mesurer sa VRAIE taille :
    // l'ancien code supposait une hauteur fixe de 200px, trop petite pour tous les
    // 茅l茅ments du menu (R茅pondre, Copier, Supprimer, Modifier, style de bulle,
    // couleur, d茅grad茅, Traduire...), ce qui le faisait d茅border en bas d'茅cran.
    menu.style.display = 'block';
    menu.style.position = 'fixed';
    menu.style.visibility = 'hidden';
    menu.style.top = '0px';
    menu.style.left = '0px';

    const margin = 10;
    const menuWidth = menu.offsetWidth || 180;
    const menuHeight = menu.offsetHeight || 200;

    let topPos, leftPos;

    if (e.touches || (e.clientX === undefined && e.pageX === undefined)) {
        // C'est un toucher mobile - centrer le menu
        topPos = (window.innerHeight / 2) - (menuHeight / 2);
        leftPos = (window.innerWidth / 2) - (menuWidth / 2);
    } else {
        // C'est un clic souris - positionner pr猫s du curseur
        topPos = e.pageY;
        leftPos = e.pageX;
    }

    // S'assurer que le menu reste ENTI脠REMENT visible, quelle que soit sa hauteur r茅elle
    // (donc aussi bien en haut qu'en bas de l'茅cran, y compris quand le message cliqu茅
    // est tout en bas du chat).
    topPos = Math.max(margin, Math.min(topPos, window.innerHeight - menuHeight - margin));
    leftPos = Math.max(margin, Math.min(leftPos, window.innerWidth - menuWidth - margin));

    menu.style.top = topPos + 'px';
    menu.style.left = leftPos + 'px';
    menu.style.zIndex = '9999';
    menu.style.visibility = 'visible';
    
    // Fermer le menu si on clique ailleurs
    setTimeout(() => {
        document.addEventListener('click', function closeMenu() {
            menu.style.display = 'none';
            document.removeEventListener('click', closeMenu);
        });
    }, 100);
    
    // Emp锚cher la propagation
    return false;
}
        
        function hideContextMenus() {
            document.getElementById('ctx-menu').style.display = 'none';
            document.getElementById('style-submenu').style.display = 'none';
            document.removeEventListener('click', hideContextMenus);
        }
        
        // 鉁? R茅cup猫re le texte INT脡GRAL d'un message affich茅, y compris pour les messages
        // longs tronqu茅s visuellement par le bouton "VOIR TOUT" (.msg-text-complet),
        // pour ne jamais citer une r茅ponse sur un extrait coup茅 脿 100 caract猫res.
        // Pour les messages non-textuels (photo/vid茅o/GIF/sticker/audio/document/position),
        // on donne un libell茅 pr茅cis au lieu du g茅n茅rique "[M茅dia]" 鈥? un GIF ne doit
        // jamais 锚tre annonc茅 comme "M茅dia" dans l'aper莽u de r茅ponse.
        function obtenirTexteCompletMessage(parentRow) {
            if (!parentRow) return "[M茅dia]";
            const bulle = parentRow.querySelector('.message-bubble');
            if (!bulle) return "[M茅dia]";

            const texteComplet = bulle.querySelector('.msg-text-complet');
            if (texteComplet) return texteComplet.innerText;
            const span = bulle.querySelector('span:not(.msg-text-tronque):not(.voir-tout-btn)');
            if (span && span.innerText && span.innerText.trim()) return span.innerText;

            const msgType = parentRow.getAttribute('data-msgtype');
            if (parentRow.getAttribute('data-issticker') === 'true') return '馃彿锔? Sticker';
            if (parentRow.getAttribute('data-isgif') === 'true') return '馃帪锔? GIF';
            if (msgType === 'video') return '馃帴 Vid茅o';
            if (msgType === 'image') return '馃摲 Photo';
            if (msgType === 'audio') return '馃幍 Message vocal';
            if (msgType === 'document') return '馃搫 ' + (parentRow.getAttribute('data-filename') || 'Document');
            if (msgType === 'location') return '馃搷 Position';
            if (msgType === 'meteo') return '馃尋锔? M茅t茅o 脿 deux';
            if (msgType === 'sos_calin') return '馃啒 SOS C芒lin';
            if (msgType === 'cadeau') return '馃巵 Cadeau virtuel';
            if (msgType === 'lettre') return '馃拰 Lettre';
            if (msgType === 'tresor') return '馃巵 Tr茅sor cach茅';
            if (msgType === 'drawing') return '馃帹 Dessin';
            return "[M茅dia]";
        }

      function initiateReply() {
    replyToId = selectedMessageId;
    const parentRow = document.querySelector(`[data-id="${replyToId}"]`);
    if(parentRow) {
        const texteComplet = obtenirTexteCompletMessage(parentRow);
        // --- NOUVEAU CODE : 4 mots maximum ---
        const mots = texteComplet.trim().split(/\s+/).filter(Boolean);
        let snippet = texteComplet;
        if (mots.length > 4) {
            snippet = mots.slice(0, 4).join(' ') + '...';
        }
        // --- FIN NOUVEAU CODE ---
        document.getElementById('reply-preview-text').innerText = `R茅pondre 脿 : ${snippet}`;
        document.getElementById('reply-preview').style.display = 'flex';
    }
    hideContextMenus();
}

        // 鉁? Redirection au clic sur une citation de r茅ponse : d茅file jusqu'au message
        // d'origine avec une animation fluide, puis d茅clenche un flash de surbrillance.
        function scrollToOriginalMessage(msgId) {
            if (!msgId) return;
            const target = document.querySelector(`[data-id="${msgId}"]`);
            if (!target) {
                showTempNotification("鈿狅笍 Message d'origine introuvable");
                return;
            }
            target.scrollIntoView({ behavior: 'smooth', block: 'center' });
            const bulle = target.querySelector('.message-bubble');
            if (bulle) {
                // On retire puis r茅applique la classe pour permettre de rejouer l'animation
                // m锚me si l'utilisateur clique plusieurs fois de suite sur la m锚me citation.
                bulle.classList.remove('msg-flash-highlight');
                void bulle.offsetWidth; // force le reflow
                bulle.classList.add('msg-flash-highlight');
                setTimeout(() => bulle.classList.remove('msg-flash-highlight'), 1200);
            }
        }
        
  <!-- Remplacer le contenu de la fonction deleteSelectedMessage (ligne ~5357) par ce code : -->

async function deleteSelectedMessage() {
    if(!selectedMessageId) return;
    
    if(!confirm("Supprimer ce message ? Il sera remplac茅 par 'Message supprim茅'")) return;
    
    try {
        const msgRef = db.collection('chats').doc(CHAT_ID).collection('messages').doc(selectedMessageId);
        const doc = await msgRef.get();
        const data = doc.data();
        if (data.senderId !== currentUser.id) {
            alert("馃毃 Ida toi aussi tu ne peux supprimer que tes propres messages 馃榿鈥嬸煒佲??!");
            return;
        }
        // Supprimer le fichier de Supabase si besoin
        if (data.mediaUrl && data.storage === 'supabase') {
            try {
                const urlParts = data.mediaUrl.split('/');
                const fileName = urlParts[urlParts.length - 1];
                await supabaseClient.storage.from('chat_media').remove([fileName]);
            } catch(e) { console.log("Erreur suppression fichier:", e); }
        }
        
        // ---- NOUVEAU CODE : supprimer TOTALEMENT le message de Firestore ----
        await msgRef.delete();  // Au lieu de update, on le supprime physiquement
        
        // ---- FIN NOUVEAU CODE ----
        
        showTempNotification("鉁? Message supprim茅");
        
        // ---- NOUVEAU : suppression visuelle imm茅diate avec animation ----
        const messageRow = document.querySelector(`[data-id="${selectedMessageId}"]`);
        if (messageRow) {
            // Effet "Thanos" ou fondu + translation
            messageRow.style.transition = "all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1)";
            messageRow.style.transform = "scale(0.8) rotate(5deg)";
            messageRow.style.opacity = "0";
            setTimeout(() => {
                messageRow.remove();
                // Nettoyer les dates en double et remettre 脿 jour le cache
                if (typeof nettoyerDatesDoublons === 'function') nettoyerDatesDoublons();
                // Forcer le re-rendu des messages (pour que tout soit coh茅rent)
                if (typeof listenToMessages === 'function') {
                    // Rafra卯chir l'茅couteur sans recharger la page
                    if (unsubscribeMessages) {
                        unsubscribeMessages();
                        listenToMessages();
                    }
                }
            }, 400);
        }
        // ---- FIN NOUVEAU ----
        
    } catch(error) {
        console.error("Erreur suppression:", error);
        showTempNotification("鉂? Erreur lors de la suppression");
    }
    
    hideContextMenus();
}
        
// ========== MODIFIER UN MESSAGE (VERSION AVEC INPUT) ==========
let messageEnCoursEdition = null; // Stocke l'ID du message qu'on est en train d'茅diter 

async function editSelectedMessage() {
    if (!selectedMessageId) return;
    
    const messageRow = document.querySelector(`[data-id="${selectedMessageId}"]`);
    if (!messageRow) return;
    
    // V茅rifier que c'est notre message (seul l'exp茅diteur peut modifier) 
    const isSent = messageRow.classList.contains('sent');
    if (!isSent) {
         
        hideContextMenus();
        return;
    }
    
    // R茅cup茅rer le texte du message (toujours la version COMPL脠TE)
    const messageSpanTest = messageRow.querySelector('.message-bubble span:not(.coded-mask)');
    if (!messageSpanTest) {
        showTempNotification("鉂? Impossible de modifier ce type de message (image, audio, etc.)");
        hideContextMenus();
        return;
    }
    
    const ancienTexte = extraireTexteCompletMessage(messageRow);
    
    // Stocker l'ID du message 脿 modifier
    messageEnCoursEdition = selectedMessageId;
    
    // Mettre le texte dans l'input
    const inputMessage = document.getElementById('chat-in');
    inputMessage.value = ancienTexte;
    autoResizeTextarea(); // affiche tout de suite plusieurs lignes (pas juste 1)
    inputMessage.focus();
    
    // Changer le bouton "Envoyer" en bouton "Modifier"
    const sendBtn = document.getElementById('send-btn');
    sendBtn.innerHTML = '<i class="fa-regular fa-pen-to-square"></i>';
    sendBtn.style.background = 'none';
sendBtn.style.color = '#ffaa00';
    sendBtn.style.padding = '8px 16px';
    sendBtn.style.borderRadius = '20px';
    
    // Changer la fonction du bouton
    sendBtn.onclick = confirmerModification;
    
    // Ajouter un indicateur visuel
    
    
    hideContextMenus();
}

// ========== CONFIRMER LA MODIFICATION ==========
async function confirmerModification() {
    if (!messageEnCoursEdition) {
        sendTextMessage();
        return;
    }
    
    const inputMessage = document.getElementById('chat-in');
    const nouveauTexte = inputMessage.value.trim();
    
    if (nouveauTexte === "") {
        showTempNotification("鉂? Le message ne peut pas 锚tre vide !");
        return;
    }
    
    try {
        const messageRef = db.collection('chats').doc(CHAT_ID).collection('messages').doc(messageEnCoursEdition);
        
        // R茅cup茅rer l'ancien message pour conserver les autres donn茅es
        const doc = await messageRef.get();
        const anciennesDonnees = doc.data();
        
        // Mettre 脿 jour avec conservation des autres champs
        await messageRef.update({
            text: nouveauTexte,
            originalText: nouveauTexte,
            isCoded: false,
            modifiedAt: firebase.firestore.FieldValue.serverTimestamp(),
            modified: true,
            // Conserver les autres champs importants
            type: anciennesDonnees.type || 'text',
            senderId: anciennesDonnees.senderId,
            senderName: anciennesDonnees.senderName
        });
        
        // MISE 脌 JOUR VISUELLE IMM脡DIATE (sans attendre Firebase)
        const messageRow = document.querySelector(`[data-id="${messageEnCoursEdition}"]`);
        if (messageRow) {
            const bubble = messageRow.querySelector('.message-bubble');
            const textSpan = bubble.querySelector('span:not(.coded-mask)');
            if (textSpan) {
                // Animation de flash
                textSpan.style.transition = 'all 0.3s ease';
                textSpan.style.backgroundColor = '#00ff4420';
                textSpan.innerHTML = formatText(escapeHTML(nouveauTexte)).replace(/\n/g, '<br>');
                
                // Ajouter/modifier le badge "modifi茅"
                const msgMeta = bubble.querySelector('.msg-meta');
                if (msgMeta) {
                    const timeStr = msgMeta.innerHTML.split('<')[0];
                    if (!msgMeta.innerHTML.includes('modifi茅')) {
                        msgMeta.innerHTML = `${timeStr}<span class="status-tick">鉁撯湏</span> <span style="font-size:0.65rem; opacity:0.6;">(modifi茅)</span>`;
                    }
                }
                
                setTimeout(() => {
                    textSpan.style.backgroundColor = '';
                }, 500);
            }
        }
        
        // R茅initialiser
        inputMessage.value = '';
        autoResizeTextarea();
        resetSendButton();
        messageEnCoursEdition = null;
        
        showTempNotification("鉁? Message modifi茅 !");
        
    } catch(error) {
        console.error("Erreur modification:", error);
        showTempNotification("鉂? Erreur lors de la modification");
    }
}

 function ecouterModificationsMessages() {
    if (!currentUser) return;
    
    db.collection('chats').doc(CHAT_ID).collection('messages')
        .where('modified', '==', true)
        .onSnapshot(snapshot => {
            snapshot.docChanges().forEach(change => {
                if (change.type === 'modified') {
                    const msgId = change.doc.id;
                    const nouvelleData = change.doc.data();
                    
                    if (nouvelleData.isDeletedMessage === true) {
                        return;
                    }
                    
                    const messageRow = document.querySelector(`.message-row[data-id="${msgId}"]`);
                    if (!messageRow) return;
                    
                    const isSent = messageRow.classList.contains('sent');
                    if (!isSent) return;
                    
                    const bubble = messageRow.querySelector('.message-bubble');
                    const textSpan = bubble.querySelector('span:not(.coded-mask)');
                    
                    // 鉁? AJOUTE CE BLOC POUR LES COULEURS
                    // ===================================================
                    // Mise 脿 jour de la couleur si elle a chang茅
                    if (nouvelleData.customColor) {
                        bubble.style.background = nouvelleData.customColor;
                        bubble.style.color = getContrastColor(nouvelleData.customColor);
                        // Enlever les classes de style qui pourraient interf茅rer
                        const allStyles = ['bicolor','dark-passion','grid-style','rainbow','neon','wood','code-style','comics','watercolor','retro','glassmorphism','crystal','sunset','ocean','forest','midnight','rose','gold','galaxy','cyberpunk','handwritten'];
                        allStyles.forEach(style => bubble.classList.remove(style));
                    } else if (nouvelleData.customGradient) {
                        bubble.style.background = nouvelleData.customGradient;
                        bubble.style.color = 'white';
                        const allStyles = ['bicolor','dark-passion','grid-style','rainbow','neon','wood','code-style','comics','watercolor','retro','glassmorphism','crystal','sunset','ocean','forest','midnight','rose','gold','galaxy','cyberpunk','handwritten'];
                        allStyles.forEach(style => bubble.classList.remove(style));
                    } else {
                        // Si plus de couleur, on remet le style par d茅faut
                        bubble.style.background = '';
                        bubble.style.color = '';
                        const defaultStyle = localStorage.getItem('default_bubble_style');
                        if (defaultStyle && defaultStyle !== 'none') {
                            const allStyles = ['bicolor','dark-passion','grid-style','rainbow','neon','wood','code-style','comics','watercolor','retro','glassmorphism','crystal','sunset','ocean','forest','midnight','rose','gold','galaxy','cyberpunk','handwritten'];
                            allStyles.forEach(style => bubble.classList.remove(style));
                            bubble.classList.add(defaultStyle);
                        }
                    }
                    // ===================================================
                    
                    if (textSpan && nouvelleData.text && !nouvelleData.isDeletedMessage) {
                        textSpan.style.transition = 'all 0.3s ease';
                        textSpan.style.backgroundColor = '#ffaa0020';
                        textSpan.innerHTML = formatText(escapeHTML(nouvelleData.text)).replace(/\n/g, '<br>');
                        
                        const msgMeta = bubble.querySelector('.msg-meta');
                        if (msgMeta && !msgMeta.innerHTML.includes('modifi茅')) {
                            const timeStr = msgMeta.innerHTML.split('<')[0];
                            msgMeta.innerHTML = `${timeStr}<span class="status-tick">鉁撯湏</span> <span style="font-size:0.65rem; opacity:0.6;">(modifi茅)</span>`;
                        }
                        
                        setTimeout(() => {
                            textSpan.style.backgroundColor = '';
                        }, 500);
                    }
                }
            });
        });
}
      // ========== 脡COUTEUR SP脡CIFIQUE POUR LES COULEURS PERSONNALIS脡ES ==========
function ecouterChangementsCouleurs() {
    if (!currentUser) return;
    
    db.collection('chats').doc(CHAT_ID).collection('messages')
        .where('customColor', '>=', '')  // Tous les messages qui ont customColor
        .onSnapshot(snapshot => {
            snapshot.docChanges().forEach(change => {
                if (change.type === 'modified' || change.type === 'added') {
                    const msgId = change.doc.id;
                    const data = change.doc.data();
                    
                    const messageRow = document.querySelector(`.message-row[data-id="${msgId}"]`);
                    if (!messageRow) return;
                    
                    const bubble = messageRow.querySelector('.message-bubble');
                    if (!bubble) return;
                    
                    // Appliquer la couleur
                    if (data.customColor) {
                        bubble.style.background = data.customColor;
                        bubble.style.color = getContrastColor(data.customColor);
                        // Enlever les classes de style
                        const allStyles = ['bicolor','dark-passion','grid-style','rainbow','neon','wood','code-style','comics','watercolor','retro','glassmorphism','crystal','sunset','ocean','forest','midnight','rose','gold','galaxy','cyberpunk','handwritten'];
                        allStyles.forEach(style => bubble.classList.remove(style));
                    } else if (data.customGradient) {
                        bubble.style.background = data.customGradient;
                        bubble.style.color = 'white';
                        const allStyles = ['bicolor','dark-passion','grid-style','rainbow','neon','wood','code-style','comics','watercolor','retro','glassmorphism','crystal','sunset','ocean','forest','midnight','rose','gold','galaxy','cyberpunk','handwritten'];
                        allStyles.forEach(style => bubble.classList.remove(style));
                    }
                }
            });
        });
}

// ========== 脡COUTEUR POUR LA SUPPRESSION DES COULEURS ==========
function ecouterSuppressionCouleurs() {
    if (!currentUser) return;
    
    // 脡couter les messages o霉 customColor est null (supprim茅)
    // On utilise un 茅couteur sur tous les messages et on v茅rifie
    db.collection('chats').doc(CHAT_ID).collection('messages')
        .onSnapshot(snapshot => {
            snapshot.docChanges().forEach(change => {
                if (change.type === 'modified') {
                    const msgId = change.doc.id;
                    const data = change.doc.data();
                    
                    const messageRow = document.querySelector(`.message-row[data-id="${msgId}"]`);
                    if (!messageRow) return;
                    
                    const bubble = messageRow.querySelector('.message-bubble');
                    if (!bubble) return;
                    
                    // Si plus de customColor ET plus de customGradient
                    if (!data.customColor && !data.customGradient) {
                        // Remettre le style par d茅faut
                        bubble.style.background = '';
                        bubble.style.color = '';
                        
                        const defaultStyle = localStorage.getItem('default_bubble_style');
                        if (defaultStyle && defaultStyle !== 'none') {
                            const allStyles = ['bicolor','dark-passion','grid-style','rainbow','neon','wood','code-style','comics','watercolor','retro','glassmorphism','crystal','sunset','ocean','forest','midnight','rose','gold','galaxy','cyberpunk','handwritten'];
                            allStyles.forEach(style => bubble.classList.remove(style));
                            bubble.classList.add(defaultStyle);
                        }
                    }
                }
            });
        });
}
      // ========== FORCER LE RAFRA脦CHISSEMEN T D'UN MESSAGE SP脡CIFIQUE = =========
async function forcerRafraichissementMessage(messageId) {
    const doc = await db.collection('chats').doc(CHAT_ID).collection('messages').doc(messageId).get();
    if (!doc.exists) return;
    
    const data = doc.data();
    const messageRow = document.querySelector(`.message-row[data-id="${messageId}"]`);
    
    if (messageRow && data.text) {
        const bubble = messageRow.querySelector('.message-bubble');
        const textSpan = bubble.querySelector('span:not(.coded-mask)');
        
        if (textSpan) {
            // Sauvegarder l'ancien texte pour comparaison
            const ancienTexte = textSpan.innerText;
            const nouveauTexte = data.text;
            
            if (ancienTexte !== nouveauTexte) {
                // Appliquer la mise 脿 jour
                textSpan.innerHTML = formatText(escapeHTML(nouveauTexte)).replace(/\n/g, '<br>');
                
                // Animation de notification
                bubble.style.animation = 'none';
                bubble.offsetHeight;
                bubble.style.animation = 'fadeIn 0.3s ease-out';
                
                console.log(`馃攧 Message ${messageId} rafra卯chi: "${ancienTexte}" 鈫? "${nouveauTexte}"`);
            }
        }
    }
}

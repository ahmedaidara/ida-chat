        // D茅clencher le menu contextuel apr猫s 500ms d'appui
        handleContextMenu(e, msgId);
    }, 500);
}

function cancelPressTimer() {
    if (pressTimerMobile) {
        clearTimeout(pressTimerMobile);
        pressTimerMobile = null;
    }
}


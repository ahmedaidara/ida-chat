// D茅marre l'茅coute Firestore de l'茅tat d'appel (脿 appeler apr猫s login)
let dernierAppelTermineTraite = null;

function initCallListener() {
    if (!currentUser) return;
    if (callUnsubscribe) { callUnsubscribe(); callUnsubscribe = null; }
    initCallPipDrag();
    callUnsubscribe = getCallDocRef().onSnapshot((docSnap) => {
        if (!docSnap.exists) { resetCallUIIfIdle(); return; }
        const data = docSnap.data();
        if (!data || !data.status || data.status === 'idle') { resetCallUIIfIdle(); return; }

        if (data.status === 'ringing') {
            if (data.callerId === currentUser.id) {
                showOutgoingUI(data);
            } else if (data.calleeId === currentUser.id) {
                showIncomingUI(data);
            }
        } else if (data.status === 'accepted') {
            showActiveUI(data);
            if (data.calleeId === currentUser.id && !agoraClient) {
                joinAgoraChannel(data.type);
            }
        } else if (data.status === 'rejected' || data.status === 'ended') {
            if (data.status === 'rejected' && data.callerId === currentUser.id) {
                showTempNotification('馃摰 Appel refus茅');
            }
            // Un seul des deux appareils 茅crit le message r茅capitulatif dans le chat
            // (celui qui a initi茅 l'appel), avec une protection anti-doublon.
            const callKey = data.createdAt ? (data.createdAt.seconds + '-' + data.createdAt.nanoseconds) : null;
            if (data.callerId === currentUser.id && callKey && dernierAppelTermineTraite !== callKey) {
                dernierAppelTermineTraite = callKey;
                envoyerMessageFinAppel(data);
            }
            cleanupCall();
        }
    });
}

function formatDureeAppel(secondes) {
    const h = Math.floor(secondes / 3600);
    const m = Math.floor((secondes % 3600) / 60);
    const s = secondes % 60;
    const parts = [];
    if (h > 0) parts.push(h + 'h');
    if (h > 0 || m > 0) parts.push(m + 'mn');
    parts.push(s + 's');
    return parts.join(' ');
}

// 脡crit dans le chat un message r茅capitulatif 脿 la fin d'un appel
// (dur茅e si l'appel a 茅t茅 d茅croch茅, sinon manqu茅/refus茅)
async function envoyerMessageFinAppel(data) {
    if (!currentUser) return;
    try {
        let callStatus, durationSec = null;
        if (data.status === 'rejected' && !data.acceptedAt) {
            callStatus = 'declined';
        } else if (data.acceptedAt) {
            callStatus = 'completed';
            const acceptedMs = data.acceptedAt.toMillis ? data.acceptedAt.toMillis() : Date.now();
            durationSec = Math.max(0, Math.round((Date.now() - acceptedMs) / 1000));
        } else {
            callStatus = 'missed';
        }
        const isVideo = data.type === 'video';
        const texte = callStatus === 'completed'
            ? `${isVideo ? 'Appel vid茅o' : 'Appel vocal'} 鈥? ${formatDureeAppel(durationSec)}`
            : callStatus === 'missed'
                ? (isVideo ? 'Appel vid茅o manqu茅' : 'Appel vocal manqu茅')
                : (isVideo ? 'Appel vid茅o refus茅' : 'Appel vocal refus茅');
        // 鈿狅笍 ID d茅terministe (bas茅 sur l'horodatage de cr茅ation de l'appel) au lieu de
        // .add() : si cette fonction est jamais d茅clench茅e 2 fois pour le m锚me appel
        // (double 茅v茅nement Firestore, double clic, etc.), le 2e appel 茅crase le m锚me
        // document au lieu d'en cr茅er un second 鈥? impossible d'avoir 2 bulles d'appel
        // en double dans le chat pour un seul et m锚me appel.
        const callKeyId = data.createdAt && data.createdAt.seconds
            ? `call-${data.createdAt.seconds}-${data.createdAt.nanoseconds}`
            : null;
        const messageDocRef = callKeyId
            ? db.collection('chats').doc(CHAT_ID).collection('messages').doc(callKeyId)
            : db.collection('chats').doc(CHAT_ID).collection('messages').doc();
        await messageDocRef.set({
            type: 'call_log',
            callType: isVideo ? 'video' : 'audio',
            callStatus: callStatus,
            durationSec: durationSec,
            text: texte,
            senderId: data.callerId,
            senderName: data.callerName || currentUser.name,
            timestamp: firebase.firestore.FieldValue.serverTimestamp(),
            readBy: [currentUser.id]
        }, { merge: true });
    } catch (e) {
        console.error('Erreur message fin appel:', e);
    }
}

// Envoie une notification Telegram via la fonction Supabase d茅di茅e
// (n茅cessite les secrets TELEGRAM_BOT_TOKEN et TELEGRAM_CHAT_ID c么t茅 serveur)
async function envoyerNotifTelegram(texte) {
    try {
        await fetch(`https://mxzupngxmnfnldbyooqf.supabase.co/functions/v1/telegram-notify`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ message: texte })
        });
    } catch (e) { /* pas critique si Telegram est indisponible */ }
}

// L'utilisateur clique sur le combin茅 ou la cam茅ra en haut de l'茅cran
// Contient le flux m茅dia (micro/cam茅ra) obtenu directement dans le clic du
// bouton Accepter, AVANT tout aller-retour r茅seau Firestore. Certains
// navigateurs (Safari en t锚te, mais pas seulement) exigent que l'acc猫s au
// micro/脿 la cam茅ra parte d'un VRAI clic utilisateur 鈥? pas d'un callback
// asynchrone d茅clench茅 plus tard par Firestore. C'est tr猫s probablement la
// cause du refus "apr猫s quelques secondes" au moment d'accepter.
let preAcquiredStream = null;
let dernierCallDataConnu = null;
let callActionEnCours = false; // anti double-appui (emp锚che 2 appels/acceptations simultan茅s)

async function startCall(type) {
    if (!currentUser || !targetUser) return;
    if (callActionEnCours) return;
    callActionEnCours = true;
    
    // 鈿狅笍 ACQUISITION DU FLUX - POUR L'APPELANT
    try {
        const constraints = {
            audio: true,
            video: type === 'video' ? { 
                facingMode: 'user',
                width: { ideal: 640 },
                height: { ideal: 480 }
            } : false
        };
        preAcquiredStream = await navigator.mediaDevices.getUserMedia(constraints);
        console.log(`鉁? Flux ${type} acquis par l'appelant`);
    } catch (e) {
        console.error('Erreur acc猫s m茅dia (appelant):', e);
        let msg = type === 'video' 
            ? "鉂? Cam茅ra/micro refus茅 鈥? active-les dans Param猫tres > Autorisations"
            : "鉂? Micro refus茅 鈥? active-le dans Param猫tres > Autorisations";
        showTempNotification(msg);
        preAcquiredStream = null;
        callActionEnCours = false;
        return;
    }
    
    try {
        // V茅rifier si un appel est d茅j脿 en cours
        const existing = await getCallDocRef().get();
        if (existing.exists) {
            const st = existing.data().status;
            if (st && st !== 'idle' && st !== 'ended' && st !== 'rejected') {
                showTempNotification('馃摓 Un appel est d茅j脿 en cours');
                if (preAcquiredStream) { preAcquiredStream.getTracks().forEach(t => t.stop()); preAcquiredStream = null; }
                callActionEnCours = false;
                return;
            }
        }
        
        // Cr茅er l'appel dans Firestore
        await getCallDocRef().set({
            status: 'ringing',
            type: type,
            callerId: currentUser.id,
            callerName: currentUser.name,
            calleeId: targetUser.id,
            channel: CHAT_ID,
            createdAt: firebase.firestore.FieldValue.serverTimestamp()
        });
        
        // Notification Telegram
        (async () => {
            try {
                const isFromIda = currentUser.id === 'ida';
                const botToken = isFromIda ? TELEGRAM_BOT_TOKEN_AIDARA : TELEGRAM_BOT_TOKEN_IDA;
                const chatId = isFromIda ? TELEGRAM_CHAT_ID_AIDARA : TELEGRAM_CHAT_ID_IDA;
                const msg = `馃摓 APPEL ${type === 'video' ? 'VID脡O' : 'VOCAL'} ENTRANT\n\n${currentUser.name} vous appelle maintenant !\n\n馃憠 Ouvrez l'application pour r茅pondre.`;
                await fetch(`https://api.telegram.org/bot${botToken}/sendMessage?chat_id=${chatId}&text=${encodeURIComponent(msg)}&disable_notification=false`);
            } catch (e) { console.error('Erreur Telegram appel:', e); }
        })();
        
        // Rejoindre le canal Agora
        await joinAgoraChannel(type);
        
    } catch (e) {
        console.error('Erreur startCall:', e);
        showTempNotification("鉂? Impossible de d茅marrer l'appel");
        if (preAcquiredStream) { preAcquiredStream.getTracks().forEach(t => t.stop()); preAcquiredStream = null; }
    } finally {
        callActionEnCours = false;
    }
}

async function acceptCall() {
    if (callActionEnCours) return;
    callActionEnCours = true;
    stopRingtone();
    
    const type = (dernierCallDataConnu && dernierCallDataConnu.type) || 'audio';
    
    // 鈿狅笍 ACQUISITION DU FLUX - POUR LE DESTINATAIRE (au moment de l'acceptation)
    try {
        const constraints = {
            audio: true,
            video: type === 'video' ? { 
                facingMode: 'user',
                width: { ideal: 640 },
                height: { ideal: 480 }
            } : false
        };
        preAcquiredStream = await navigator.mediaDevices.getUserMedia(constraints);
        console.log(`鉁? Flux ${type} acquis par le destinataire`);
    } catch (e) {
        console.error('Erreur acc猫s m茅dia (destinataire):', e);
        let msg = type === 'video'
            ? "鉂? Cam茅ra/micro refus茅 鈥? active-les dans Param猫tres > Autorisations, puis r茅essaie d'accepter"
            : "鉂? Micro refus茅 鈥? active-le dans Param猫tres > Autorisations, puis r茅essaie d'accepter";
        showTempNotification(msg);
        preAcquiredStream = null;
        callActionEnCours = false;
        return;
    }
    
    try {
        // Mettre 脿 jour le statut de l'appel
        await getCallDocRef().update({ 
            status: 'accepted', 
            acceptedAt: firebase.firestore.FieldValue.serverTimestamp() 
        });
        
        // Rejoindre le canal Agora
        await joinAgoraChannel(type);
        
    } catch (e) {
        console.error('Erreur acceptCall:', e);
        if (preAcquiredStream) { preAcquiredStream.getTracks().forEach(t => t.stop()); preAcquiredStream = null; }
        showTempNotification("鉂? Erreur lors de l'acceptation");
    } finally {
        callActionEnCours = false;
    }
}

async function rejectCall() {
    stopRingtone();
    try { await getCallDocRef().update({ status: 'rejected' }); } catch (e) {}
    cleanupCall();
    setTimeout(() => { getCallDocRef().set({ status: 'idle' }, { merge: true }).catch(() => {}); }, 1500);
}

async function endCall() {
    try { await getCallDocRef().update({ status: 'ended' }); } catch (e) {}
    cleanupCall();
    setTimeout(() => { getCallDocRef().set({ status: 'idle' }, { merge: true }).catch(() => {}); }, 1500);
}

// Raccrocher n茅cessite 2 appuis rapproch茅s pour 茅viter les faux clics
function tenterRaccrocher() {
    const btn = document.getElementById('call-hangup-btn');
    if (hangupArmed) {
        clearTimeout(hangupResetTimer);
        hangupArmed = false;
        if (btn) btn.classList.remove('armed');
        endCall();
    } else {
        hangupArmed = true;
        if (btn) btn.classList.add('armed');
        showTempNotification('鈽庯笍 Appuie encore une fois pour raccrocher');
        hangupResetTimer = setTimeout(() => {
            hangupArmed = false;
            if (btn) btn.classList.remove('armed');
        }, 2000);
    }
}

async function joinAgoraChannel(type) {
    if (agoraClient) return;
    const uid = AGORA_UID_MAP[currentUser.id];
    
    try {
        // Obtenir le token
        const tokenResp = await fetch(`${AGORA_FUNCTIONS_URL}?channel=${encodeURIComponent(CHAT_ID)}&uid=${uid}`);
        if (!tokenResp.ok) throw new Error('token http ' + tokenResp.status);
        const tokenData = await tokenResp.json();
        if (!tokenData.token) throw new Error('token manquant dans la r茅ponse');

        // Cr茅er le client Agora
        agoraClient = AgoraRTC.createClient({ mode: 'rtc', codec: 'vp8' });

        // 脡v茅nements utilisateur
        agoraClient.on('user-published', async (user, mediaType) => {
            await agoraClient.subscribe(user, mediaType);
            if (mediaType === 'video') {
                remoteVideoTrackRef = user.videoTrack;
                mettreAJourVuesVideo();
            }
            if (mediaType === 'audio') {
                user.audioTrack.play();
            }
        });
        
        agoraClient.on('user-unpublished', (user, mediaType) => {
            if (mediaType === 'video') {
                remoteVideoTrackRef = null;
                mettreAJourVuesVideo();
            }
        });
        
        agoraClient.on('user-left', () => {
            remoteVideoTrackRef = null;
            mettreAJourVuesVideo();
        });

        // Rejoindre le canal
        await agoraClient.join(AGORA_APP_ID, CHAT_ID, tokenData.token, uid);

        // 馃敟 PUBLIER LE FLUX PR脡-ACQUIS (ou en cr茅er un nouveau)
        const tracksToPublish = [];
        
        if (preAcquiredStream) {
            // Utiliser le flux d茅j脿 acquis (micro/cam茅ra)
            const audioTrackBrut = preAcquiredStream.getAudioTracks()[0];
            if (audioTrackBrut) {
                localAudioTrack = AgoraRTC.createCustomAudioTrack({ 
                    mediaStreamTrack: audioTrackBrut 
                });
                tracksToPublish.push(localAudioTrack);
            } else {
                // Fallback si pas de piste audio
                localAudioTrack = await AgoraRTC.createMicrophoneAudioTrack();
                tracksToPublish.push(localAudioTrack);
            }
            
            if (type === 'video') {
                const videoTrackBrut = preAcquiredStream.getVideoTracks()[0];
                if (videoTrackBrut) {
                    localVideoTrack = AgoraRTC.createCustomVideoTrack({ 
                        mediaStreamTrack: videoTrackBrut 
                    });
                    tracksToPublish.push(localVideoTrack);
                    mettreAJourVuesVideo();
                } else {
                    // Fallback si pas de piste vid茅o
                    localVideoTrack = await AgoraRTC.createCameraVideoTrack();
                    tracksToPublish.push(localVideoTrack);
                    mettreAJourVuesVideo();
                }
            }
            
            preAcquiredStream = null; // Consomm茅
        } else {
            // Filet de s茅curit茅 : cr茅er de nouvelles pistes
            localAudioTrack = await AgoraRTC.createMicrophoneAudioTrack();
            tracksToPublish.push(localAudioTrack);
            
            if (type === 'video') {
                localVideoTrack = await AgoraRTC.createCameraVideoTrack();
                tracksToPublish.push(localVideoTrack);
                mettreAJourVuesVideo();
            }
        }
        
        // Publier les pistes
        if (tracksToPublish.length > 0) {
            await agoraClient.publish(tracksToPublish);
        }
        
        console.log('鉁? Rejoint le canal Agora avec succ猫s');
        
    } catch (e) {
        console.error('Erreur joinAgoraChannel:', e);
        if (preAcquiredStream) { preAcquiredStream.getTracks().forEach(t => t.stop()); preAcquiredStream = null; }
        let msg = "鉂? Impossible de rejoindre l'appel";
        if (e && e.message && /Permission denied|NotAllowedError/i.test(e.message)) {
            msg = "鉂? Micro/cam茅ra refus茅 鈥? active-les dans Param猫tres > Autorisations";
        }
        showTempNotification(msg);
        cleanupCall();
        try {
            const docSnap = await getCallDocRef().get();
            const data = docSnap.exists ? docSnap.data() : null;
            if (data && data.calleeId === currentUser.id && data.status === 'accepted') {
                await getCallDocRef().update({ status: 'ringing' });
            } else {
                await getCallDocRef().update({ status: 'ended', endedReason: 'error' });
            }
        } catch (e2) {}
    }
}

// Passer d'un appel vocal 脿 un appel vid茅o en cours d'appel
async function passerEnAppelVideo() {
    if (!agoraClient) {
        showTempNotification("鉂? Aucun appel en cours");
        return;
    }
    
    if (localVideoTrack) {
        showTempNotification("馃摲 L'appel est d茅j脿 en vid茅o");
        return;
    }
    
    try {
        // 鈿狅笍 Demander l'acc猫s 脿 la cam茅ra maintenant (obligatoire)
        // On ne peut PAS r茅utiliser le flux audio existant pour la vid茅o
        const stream = await navigator.mediaDevices.getUserMedia({
            video: { facingMode: 'user', width: { ideal: 640 }, height: { ideal: 480 } }
        });
        
        const videoTrackBrut = stream.getVideoTracks()[0];
        if (!videoTrackBrut) {
            showTempNotification("鉂? Aucune piste vid茅o disponible");
            return;
        }
        
        // Cr茅er la piste vid茅o personnalis茅e
        localVideoTrack = AgoraRTC.createCustomVideoTrack({ 
            mediaStreamTrack: videoTrackBrut 
        });
        
        // Publier la piste vid茅o
        await agoraClient.publish([localVideoTrack]);
        
        // Mettre 脿 jour le type d'appel dans Firestore
        await getCallDocRef().update({ type: 'video' });
        
        // Activer l'interface vid茅o
        activerModeVideo();
        mettreAJourVuesVideo();
        
        // Cacher le bouton "Passer en vid茅o"
        document.getElementById('call-upgrade-video-btn').style.display = 'none';
        document.getElementById('call-switch-cam-btn').style.display = 'flex';
        
        showTempNotification('馃帴 Appel vid茅o activ茅');
        
    } catch (e) {
        console.error('Erreur passage vid茅o:', e);
        showTempNotification("鉂? Impossible d'activer la cam茅ra 鈥? v茅rifie les autorisations");
    }
}

async function switchCallCamera() {
    if (!localVideoTrack) {
        showTempNotification("馃摲 Aucune cam茅ra active");
        return;
    }
    
    try {
        // R茅cup茅rer la liste des cam茅ras
        if (availableCameras.length === 0) {
            availableCameras = await AgoraRTC.getCameras();
        }
        
        if (availableCameras.length < 2) {
            showTempNotification('馃摲 Une seule cam茅ra d茅tect茅e');
            return;
        }
        
        // Passer 脿 la cam茅ra suivante
        currentCameraIndex = (currentCameraIndex + 1) % availableCameras.length;
        const deviceId = availableCameras[currentCameraIndex].deviceId;
        
        // Changer de p茅riph茅rique
        await localVideoTrack.setDevice(deviceId);
        showTempNotification('馃攧 Cam茅ra chang茅e');
        
    } catch (e) {
        console.error('Erreur changement cam茅ra:', e);
        showTempNotification('鉂? Impossible de changer de cam茅ra');
    }
}

async function toggleCallSpeaker() {
    speakerOn = !speakerOn;
    const btn = document.getElementById('call-speaker-btn');
    if (btn) {
        btn.classList.toggle('active-toggle', speakerOn);
        btn.innerHTML = speakerOn ? '<i class="fa-solid fa-volume-high"></i>' : '<i class="fa-solid fa-volume-low"></i>';
    }
    try {
        if (navigator.mediaDevices && navigator.mediaDevices.enumerateDevices) {
            const devices = await navigator.mediaDevices.enumerateDevices();
            const outputs = devices.filter(d => d.kind === 'audiooutput');
            if (outputs.length > 1 && agoraClient && agoraClient.remoteUsers) {
                const speakerDevice = outputs.find(d => /speaker|haut.?parleur/i.test(d.label)) || outputs[0];
                const earpieceDevice = outputs.find(d => d.deviceId !== speakerDevice.deviceId) || outputs[0];
                const target = speakerOn ? speakerDevice : earpieceDevice;
                agoraClient.remoteUsers.forEach(u => {
                    if (u.audioTrack && u.audioTrack.setPlaybackDevice) {
                        u.audioTrack.setPlaybackDevice(target.deviceId).catch(() => {});
                    }
                });
            }
        }
    } catch (e) { /* pas critique si le navigateur ne le permet pas */ }
}

function cleanupCall() {
    stopRingtone();
    stopCallTimer();
    clearTimeout(hangupResetTimer);
    hangupArmed = false;
    
    // Fermer les pistes audio/vid茅o
    if (localAudioTrack) { 
        try { localAudioTrack.close(); } catch (e) {}
        localAudioTrack = null; 
    }
    if (localVideoTrack) { 
        try { localVideoTrack.close(); } catch (e) {}
        localVideoTrack = null; 
    }
    if (preAcquiredStream) { 
        try { preAcquiredStream.getTracks().forEach(t => t.stop()); } catch (e) {}
        preAcquiredStream = null; 
    }
    
    remoteVideoTrackRef = null;
    mainViewIsLocal = true;
    availableCameras = [];
    currentCameraIndex = 0;
    
    if (agoraClient) {
        try {
            agoraClient.removeAllListeners();
            agoraClient.leave().catch(() => {});
        } catch (e) {}
        agoraClient = null;
    }
    
    hideCallOverlay();
}
function setCallTopbarText(data) {
    const el = document.getElementById('call-topbar-text');
    if (!el || !targetUser) return;
    const label = data.type === 'video' ? 'APPEL VID脡O DE ' : 'APPEL VOCAL DE ';
    el.innerText = label + targetUser.name.toUpperCase();
}

function activerModeAudio() {
    document.getElementById('call-bg-layer').style.display = 'block';
    document.getElementById('call-video-fullscreen').style.display = 'none';
    appliquerFondAppelActuel();
}

function activerModeVideo() {
    document.getElementById('call-bg-layer').style.display = 'none';
    document.getElementById('call-video-fullscreen').style.display = 'block';
    appliquerCouleurBarreEtat('#000000');
}

function mettreAJourVuesVideo() {
    const pipWrap = document.getElementById('call-pip');
    if (!pipWrap) return;
    
    if (mainViewIsLocal) {
        // Vue principale = cam茅ra locale
        if (localVideoTrack) {
            try {
                localVideoTrack.play('call-main-video');
            } catch (e) {
                console.warn('Erreur lecture locale:', e);
            }
        }
        // Miniature = vid茅o distante
        if (remoteVideoTrackRef) {
            try {
                remoteVideoTrackRef.play('call-pip-video');
                pipWrap.style.display = 'block';
            } catch (e) {
                pipWrap.style.display = 'none';
            }
        } else {
            pipWrap.style.display = 'none';
        }
    } else {
        // Vue principale = vid茅o distante
        if (remoteVideoTrackRef) {
            try {
                remoteVideoTrackRef.play('call-main-video');
            } catch (e) {
                console.warn('Erreur lecture distante:', e);
            }
        }
        // Miniature = cam茅ra locale
        if (localVideoTrack) {
            try {
                localVideoTrack.play('call-pip-video');
                pipWrap.style.display = 'block';
            } catch (e) {
                pipWrap.style.display = 'none';
            }
        } else {
            pipWrap.style.display = 'none';
        }
    }
}

function basculerVuePrincipale() {
    if (!remoteVideoTrackRef) return;
    mainViewIsLocal = !mainViewIsLocal;
    mettreAJourVuesVideo();
}

// Permet de faire glisser la miniature (PiP) n'importe o霉 脿 l'茅cran,
// et de taper dessus (sans glisser) pour 茅changer vue principale / miniature
function initCallPipDrag() {
    const pip = document.getElementById('call-pip');
    if (!pip || pip.dataset.dragBound === 'true') return;
    pip.dataset.dragBound = 'true';
    let dragging = false, startX = 0, startY = 0, origX = 0, origY = 0, moved = false;

    function onDown(e) {
        dragging = true; moved = false;
        const point = e.touches ? e.touches[0] : e;
        startX = point.clientX; startY = point.clientY;
        const rect = pip.getBoundingClientRect();
        origX = rect.left; origY = rect.top;
        pip.style.right = 'auto'; pip.style.bottom = 'auto';
        pip.style.left = origX + 'px';
        pip.style.top = origY + 'px';
    }
    function onMove(e) {
        if (!dragging) return;
        const point = e.touches ? e.touches[0] : e;
        const dx = point.clientX - startX;
        const dy = point.clientY - startY;
        if (Math.abs(dx) > 6 || Math.abs(dy) > 6) moved = true;
        let newLeft = origX + dx;
        let newTop = origY + dy;
        const maxLeft = window.innerWidth - pip.offsetWidth - 8;
        const maxTop = window.innerHeight - pip.offsetHeight - 8;
        newLeft = Math.max(8, Math.min(newLeft, maxLeft));
        newTop = Math.max(8, Math.min(newTop, maxTop));
        pip.style.left = newLeft + 'px';
        pip.style.top = newTop + 'px';
    }
    function onUp() {
        if (!dragging) return;
        dragging = false;
        if (!moved) basculerVuePrincipale();
    }

    pip.addEventListener('mousedown', onDown);
    document.addEventListener('mousemove', onMove);
    document.addEventListener('mouseup', onUp);
    pip.addEventListener('touchstart', onDown, { passive: true });
    document.addEventListener('touchmove', onMove, { passive: true });
    document.addEventListener('touchend', onUp);
}

function showOutgoingUI(data) { baseCallUI(data, 'outgoing'); }

function showIncomingUI(data) {
    baseCallUI(data, 'incoming');
    playRingtone();
}

function showActiveUI(data) {
    stopRingtone();
    baseCallUI(data, 'active');
    startCallTimer();
}

function baseCallUI(data, phase) {
    dernierCallDataConnu = data;
    document.getElementById('call-overlay').classList.add('active');
    document.getElementById('call-mini-badge').classList.remove('active');
    setCallTopbarText(data);
    updateChatCallBanner(data, phase);

    const isVideo = data.type === 'video';
    if (isVideo) {
        activerModeVideo();
        // Afficher la vid茅o locale imm茅diatement si disponible
        if (localVideoTrack) {
            try { localVideoTrack.play('call-main-video'); } catch (e) {}
        }
    } else {
        activerModeAudio();
    }

    const showCenter = !isVideo;
    document.getElementById('call-center-info').style.display = showCenter ? 'flex' : 'none';
    if (showCenter && targetUser) {
        document.getElementById('call-avatar-big').innerText = targetUser.name.substring(0, 3);
        document.getElementById('call-remote-name').innerText = targetUser.name;
    }
    
    document.getElementById('call-status-text').innerText =
        phase === 'incoming' ? (isVideo ? 'Appel vid茅o entrant...' : 'Appel entrant...') :
        phase === 'outgoing' ? (isVideo ? 'Appel vid茅o en cours...' : 'Appel en cours...') :
        'En appel';
    
    document.getElementById('call-timer-text').style.display = phase === 'active' ? 'block' : 'none';
    document.getElementById('call-incoming-actions').style.display = phase === 'incoming' ? 'flex' : 'none';
    document.getElementById('call-bottombar').style.display = phase === 'incoming' ? 'none' : 'flex';

    // Bouton "Passer en vid茅o" : disponible pour les appels audio ET vid茅o
    const upgradeBtn = document.getElementById('call-upgrade-video-btn');
    if (phase !== 'incoming') {
        // Si d茅j脿 en vid茅o, on cache, sinon on affiche
        if (isVideo) {
            upgradeBtn.style.display = 'none';
            document.getElementById('call-switch-cam-btn').style.display = 'flex';
        } else {
            upgradeBtn.style.display = 'flex';
            document.getElementById('call-switch-cam-btn').style.display = 'none';
        }
    } else {
        upgradeBtn.style.display = 'none';
        document.getElementById('call-switch-cam-btn').style.display = 'none';
    }
}

// Petit bandeau visible dans le fil de discussion tant que l'appel dure
function updateChatCallBanner(data, phase) {
    const banner = document.getElementById('chat-call-banner');
    if (!banner) return;
    banner.style.display = 'flex';
    const isVideo = data.type === 'video';
    const titre = phase === 'incoming' ? (isVideo ? 'Appel vid茅o entrant' : 'Appel entrant')
        : phase === 'outgoing' ? (isVideo ? 'Appel vid茅o en cours...' : 'Appel en cours...')
        : (isVideo ? 'Appel vid茅o en cours' : 'Appel en cours');
    document.getElementById('chat-call-banner-title').innerText = titre;
    document.getElementById('chat-call-banner-refuse-btn').style.display = phase === 'incoming' ? 'inline-block' : 'none';
    document.getElementById('chat-call-banner-end-btn').style.display = phase !== 'incoming' ? 'inline-block' : 'none';
    if (phase !== 'active') document.getElementById('chat-call-banner-timer').innerText = '';
}

function hideChatCallBanner() {
    const banner = document.getElementById('chat-call-banner');
    if (banner) banner.style.display = 'none';
}

function hideCallOverlay() {
    document.getElementById('call-overlay').classList.remove('active');
    document.getElementById('call-mini-badge').classList.remove('active');
    document.getElementById('call-main-video').innerHTML = '';
    document.getElementById('call-pip-video').innerHTML = '';
    document.getElementById('call-pip').style.display = 'none';
    document.getElementById('call-pip').style.left = '';
    document.getElementById('call-pip').style.top = '';
    document.getElementById('call-pip').style.right = '16px';
    document.getElementById('call-pip').style.bottom = '120px';
    hideChatCallBanner();
    restaurerCouleurBarreEtat();
}

function resetCallUIIfIdle() {
    if (!agoraClient) hideCallOverlay();
}

function minimiserAppel() {
    document.getElementById('call-overlay').classList.remove('active');
    document.getElementById('call-mini-badge').classList.add('active');
}

function ouvrirEcranAppelEnCours() {
    document.getElementById('call-overlay').classList.add('active');
    document.getElementById('call-mini-badge').classList.remove('active');
}

function startCallTimer() {
    if (callTimerInterval) return;
    callTimerSeconds = 0;
    callTimerInterval = setInterval(() => {
        callTimerSeconds++;
        const m = String(Math.floor(callTimerSeconds / 60)).padStart(2, '0');
        const s = String(callTimerSeconds % 60).padStart(2, '0');
        const txt = `${m}:${s}`;
        document.getElementById('call-timer-text').innerText = txt;
        document.getElementById('call-mini-timer').innerText = txt;
        const bannerTimer = document.getElementById('chat-call-banner-timer');
        if (bannerTimer) bannerTimer.innerText = formatDureeAppel(callTimerSeconds);
    }, 1000);
}

function stopCallTimer() {
    if (callTimerInterval) { clearInterval(callTimerInterval); callTimerInterval = null; }
    callTimerSeconds = 0;
}

function playRingtone() {
    stopRingtone();
    try {
        ringtoneAudioCtx = new (window.AudioContext || window.webkitAudioContext)();
        const beep = () => {
            if (!ringtoneAudioCtx) return;
            const osc = ringtoneAudioCtx.createOscillator();
            const gain = ringtoneAudioCtx.createGain();
            osc.type = 'sine';
            osc.frequency.value = 880;
            gain.gain.setValueAtTime(0.0001, ringtoneAudioCtx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.25, ringtoneAudioCtx.currentTime + 0.05);
            gain.gain.exponentialRampToValueAtTime(0.0001, ringtoneAudioCtx.currentTime + 0.4);
            osc.connect(gain).connect(ringtoneAudioCtx.destination);
            osc.start();
            osc.stop(ringtoneAudioCtx.currentTime + 0.45);
        };
        beep();
        ringtoneTimer = setInterval(beep, 1200);
    } catch (e) { console.error('Erreur ringtone:', e); }
}

function stopRingtone() {
    if (ringtoneTimer) { clearInterval(ringtoneTimer); ringtoneTimer = null; }
    if (ringtoneAudioCtx) { ringtoneAudioCtx.close().catch(() => {}); ringtoneAudioCtx = null; }
}

async function toggleCallMic() {
    if (!localAudioTrack) return;
    const wasEnabled = localAudioTrack.enabled;
    await localAudioTrack.setEnabled(!wasEnabled);
    const btn = document.getElementById('call-mute-btn');
    btn.classList.toggle('active-toggle', wasEnabled);
    btn.innerHTML = wasEnabled ? '<i class="fa-solid fa-microphone-slash"></i>' : '<i class="fa-solid fa-microphone"></i>';
}

// ========== FOND D'APPEL (couleur ou image, r茅glable dans Param猫tres) ==========

function appliquerFondAppelActuel() {
    const layer = document.getElementById('call-bg-layer');
    if (!layer) return;
    const valeur = localStorage.getItem('call_background') || 'color:linear-gradient(135deg, #1a0033, #000000)';
    if (valeur.startsWith('image:')) {
        const url = valeur.slice(6);
        layer.style.background = '#000';
        layer.style.backgroundImage = `url('${url}')`;
        layer.style.backgroundSize = 'cover';
        layer.style.backgroundPosition = 'center';
    } else {
        const c = valeur.slice(6);
        layer.style.backgroundImage = 'none';
        layer.style.background = c;
    }
    extraireCouleurThemeDepuisFond(valeur, appliquerCouleurBarreEtat);
}

// ========== SYNCHRO DE LA BARRE D'脡TAT (heure/wifi/batterie) AVEC LE FOND D'APPEL ==========
// Le fond d'appel doit couvrir l'茅cran EN ENTIER, y compris la zone o霉
// se trouvent l'heure/le wifi/la batterie du t茅l茅phone (barre d'茅tat syst猫me).
// On y arrive en changeant temporairement la couleur "theme-color" du site
// (utilis茅e par le navigateur/l'app pour peindre cette zone), le temps de l'appel.
let themeColorMetaOriginal = null;

function extraireCouleurThemeDepuisFond(valeur, callback) {
    if (!valeur) { callback('#1a0033'); return; }
    if (valeur.startsWith('color:')) {
        const c = valeur.slice(6);
        const hexMatch = c.match(/#([0-9a-fA-F]{6}|[0-9a-fA-F]{3})\b/);
        callback(hexMatch ? hexMatch[0] : '#1a0033');
        return;
    }
    if (valeur.startsWith('image:')) {
        const url = valeur.slice(6);
        try {
            const img = new Image();
            img.crossOrigin = 'anonymous';
            img.onload = function() {
                try {
                    const canvas = document.createElement('canvas');
                    canvas.width = 8; canvas.height = 8;
                    const ctx = canvas.getContext('2d');
                    ctx.drawImage(img, 0, 0, 8, 8);
                    const data = ctx.getImageData(0, 0, 8, 8).data;
                    let r = 0, g = 0, b = 0, n = 0;
                    for (let i = 0; i < data.length; i += 4) { r += data[i]; g += data[i + 1]; b += data[i + 2]; n++; }
                    r = Math.round(r / n); g = Math.round(g / n); b = Math.round(b / n);
                    const hex = '#' + [r, g, b].map(v => v.toString(16).padStart(2, '0')).join('');
                    callback(hex);
                } catch (e) { callback('#000000'); }
            };
            img.onerror = function() { callback('#000000'); };
            img.src = url;
        } catch (e) { callback('#000000'); }
        return;
    }
    callback('#1a0033');
}

function appliquerCouleurBarreEtat(hex) {
    const metas = document.querySelectorAll('meta[name="theme-color"]');
    if (!metas.length) return;
    if (!themeColorMetaOriginal) {
        themeColorMetaOriginal = Array.from(metas).map(m => ({ el: m, content: m.getAttribute('content') }));
    }
    metas.forEach(m => m.setAttribute('content', hex));
}

function restaurerCouleurBarreEtat() {
    if (!themeColorMetaOriginal) return;
    themeColorMetaOriginal.forEach(entry => entry.el.setAttribute('content', entry.content));
    themeColorMetaOriginal = null;
}

function marquerFondAppelActif(valeur) {
    document.querySelectorAll('#call-bg-options .accent-color-dot[data-callbg]').forEach(o => {
        o.classList.toggle('active', o.getAttribute('data-callbg') === valeur);
    });
}

function creerVignetteFondAppelPerso(dataUrl) {
    const opt = document.createElement('div');
    opt.className = 'accent-color-dot';
    opt.setAttribute('data-custom', 'true');
    opt.style.backgroundImage = `url('${dataUrl}')`;
    opt.style.backgroundSize = 'cover';
    opt.style.backgroundPosition = 'center';
    const valeur = 'image:' + dataUrl;
    opt.setAttribute('data-callbg', valeur);
    opt.title = 'Ton image';

    const removeBtn = document.createElement('div');
    removeBtn.className = 'dot-remove-btn';
    removeBtn.innerHTML = '<i class="fa-solid fa-xmark"></i>';
    removeBtn.onclick = function(e) {
        e.stopPropagation();
        supprimerFondAppelPerso(valeur, opt);
    };
    opt.appendChild(removeBtn);

    opt.addEventListener('click', function(e) {
        if (e.target.closest('.dot-remove-btn')) return;
        localStorage.setItem('call_background', valeur);
        marquerFondAppelActif(valeur);
    });

    return opt;
}

function supprimerFondAppelPerso(valeur, opt) {
    let fonds = JSON.parse(localStorage.getItem('custom_call_backgrounds') || '[]');
    fonds = fonds.filter(f => f !== valeur);
    localStorage.setItem('custom_call_backgrounds', JSON.stringify(fonds));
    opt.remove();
    if (localStorage.getItem('call_background') === valeur) {
        const def = 'color:linear-gradient(135deg, #1a0033, #000000)';
        localStorage.setItem('call_background', def);
        marquerFondAppelActif(def);
    }
}

function initCallBgOptions() {
    document.querySelectorAll('#call-bg-options .accent-color-dot[data-callbg]').forEach(opt => {
        if (opt.dataset.bound === 'true') return;
        opt.dataset.bound = 'true';
        opt.addEventListener('click', () => {
            const v = opt.getAttribute('data-callbg');
            localStorage.setItem('call_background', v);
            marquerFondAppelActif(v);
        });
    });

    const container = document.getElementById('call-bg-options');
    if (!container) return;
    container.querySelectorAll('.accent-color-dot[data-custom="true"]').forEach(el => el.remove());

    const fondsPersos = JSON.parse(localStorage.getItem('custom_call_backgrounds') || '[]');
    fondsPersos.forEach(v => {
        const dataUrl = v.startsWith('image:') ? v.slice(6) : v;
        const vignette = creerVignetteFondAppelPerso(dataUrl);
        container.appendChild(vignette);
    });

    const addTile = document.getElementById('call-bg-option-add');
    if (addTile && addTile.dataset.bound !== 'true') {
        addTile.dataset.bound = 'true';
        addTile.addEventListener('click', () => {
            document.getElementById('call-bg-upload-input').click();
        });
    }

    const customColorTile = document.getElementById('call-bg-custom-color');
    if (customColorTile && customColorTile.dataset.bound !== 'true') {
        customColorTile.dataset.bound = 'true';
        customColorTile.addEventListener('click', () => document.getElementById('call-bg-color-picker').click());
    }
    const colorPicker = document.getElementById('call-bg-color-picker');
    if (colorPicker && colorPicker.dataset.bound !== 'true') {
        colorPicker.dataset.bound = 'true';
        colorPicker.addEventListener('input', () => {
            const v = 'color:' + colorPicker.value;
            localStorage.setItem('call_background', v);
            marquerFondAppelActif(v);
            showTempNotification("馃帹 Couleur d'appel enregistr茅e");
        });
    }

    const uploadInput = document.getElementById('call-bg-upload-input');
    if (uploadInput && uploadInput.dataset.bound !== 'true') {
        uploadInput.dataset.bound = 'true';
        uploadInput.addEventListener('change', function() {
            const file = this.files && this.files[0];
            if (!file) return;
            if (!file.type.startsWith('image/')) { showTempNotification('鉂? Choisis un fichier image'); return; }
            redimensionnerImage(file, 1080, (dataUrl) => {
                const valeur = 'image:' + dataUrl;
                const fonds = JSON.parse(localStorage.getItem('custom_call_backgrounds') || '[]');
                fonds.push(valeur);
                localStorage.setItem('custom_call_backgrounds', JSON.stringify(fonds));
                const vignette = creerVignetteFondAppelPerso(dataUrl);
                container.appendChild(vignette);
                localStorage.setItem('call_background', valeur);
                marquerFondAppelActif(valeur);
                showTempNotification("馃柤锔? Image d'appel enregistr茅e");
            });
            uploadInput.value = '';
        });
    }

    const sauvegarde = localStorage.getItem('call_background') || 'color:linear-gradient(135deg, #1a0033, #000000)';
    marquerFondAppelActif(sauvegarde);
}

// ========== AUTORISATIONS (micro / cam茅ra / notifications) ==========

function majStatutPermission(type, statut) {
    const el = document.getElementById(`permission-status-${type}`);
    const toggle = document.getElementById(`permission-toggle-${type}`);
    if (el) {
        el.classList.remove('granted', 'denied');
        if (statut === 'granted') { el.textContent = '鉁? Autoris茅'; el.classList.add('granted'); }
        else if (statut === 'denied') { el.textContent = '鉂? Refus茅'; el.classList.add('denied'); }
        else { el.textContent = 'Non activ茅'; }
    }
    if (toggle) {
        toggle.classList.toggle('on', statut === 'granted');
        toggle.classList.toggle('denied', statut === 'denied');
    }
}

// L'API navigator.permissions.query('microphone'/'camera') n'est pas fiable
// partout (Safari iOS notamment la supporte mal ou pas du tout), ce qui
// faisait "oublier" l'autorisation 脿 chaque rafra卯chissement. On m茅morise
// donc nous-m锚mes, dans localStorage, le dernier r茅sultat obtenu.
function lireStatutPermissionSauvegarde(type) {
    return localStorage.getItem(`perm_${type}_granted`); // 'granted' | 'denied' | null
}
function sauvegarderStatutPermission(type, statut) {
    if (statut) localStorage.setItem(`perm_${type}_granted`, statut);
    else localStorage.removeItem(`perm_${type}_granted`);
}

async function verifierStatutsPermissions() {
    // 1) Affichage imm茅diat bas茅 sur ce qu'on a m茅moris茅 nous-m锚mes (fiable partout)
    ['mic', 'cam', 'notif', 'loc'].forEach(type => {
        const sauvegarde = lireStatutPermissionSauvegarde(type);
        if (sauvegarde) majStatutPermission(type, sauvegarde);
    });

    // 2) Affinage avec l'API native quand elle est disponible.
    // 鈿狅笍 IMPORTANT : cette API (navigator.permissions.query) est connue pour 锚tre
    // peu fiable sur Safari/certains navigateurs mobiles 鈥? elle peut signaler 脿 tort
    // "refus茅" juste apr猫s un usage normal, m锚me quand l'autorisation r茅elle est
    // toujours bonne (c'est ce qui donnait l'impression d'un refus apr猫s 5 secondes).
    // On ne l'utilise donc QUE pour confirmer un "autoris茅" (jamais pour repasser
    // en "refus茅" tout seul) 鈥? un vrai refus est de toute fa莽on d茅tect茅 de mani猫re
    // fiable au moment r茅el o霉 le micro/la cam茅ra est utilis茅 (voir demanderAutorisation).
    if (navigator.permissions && navigator.permissions.query) {
        try {
            const mic = await navigator.permissions.query({ name: 'microphone' });
            const majMic = () => {
                if (mic.state === 'granted') { majStatutPermission('mic', 'granted'); sauvegarderStatutPermission('mic', 'granted'); }
            };
            majMic();
            mic.onchange = majMic;
        } catch (e) {}
        try {
            const cam = await navigator.permissions.query({ name: 'camera' });
            const majCam = () => {
                if (cam.state === 'granted') { majStatutPermission('cam', 'granted'); sauvegarderStatutPermission('cam', 'granted'); }
            };
            majCam();
            cam.onchange = majCam;
        } catch (e) {}
        try {
            const loc = await navigator.permissions.query({ name: 'geolocation' });
            const majLoc = () => {
                if (loc.state === 'granted') { majStatutPermission('loc', 'granted'); sauvegarderStatutPermission('loc', 'granted'); }
            };
            majLoc();
            loc.onchange = majLoc;
        } catch (e) {}
    }
    if ('Notification' in window) {
        const etat = Notification.permission === 'granted' ? 'granted' : (Notification.permission === 'denied' ? 'denied' : null);
        if (etat) { majStatutPermission('notif', etat); sauvegarderStatutPermission('notif', etat); }
    }
}

async function demanderAutorisation(type) {
    if (type === 'mic' || type === 'cam') {
        const constraints = type === 'mic' ? { audio: true } : { video: true };
        try {
            const stream = await navigator.mediaDevices.getUserMedia(constraints);
            stream.getTracks().forEach(t => t.stop());
            majStatutPermission(type, 'granted');
            sauvegarderStatutPermission(type, 'granted');
            showTempNotification(type === 'mic' ? '馃帳 Microphone autoris茅' : '馃摲 Cam茅ra autoris茅e');
        } catch (e) {
            console.error(e);
            majStatutPermission(type, 'denied');
            sauvegarderStatutPermission(type, 'denied');
            showTempNotification("鉂? Acc猫s refus茅. Autorise-le via l'ic么ne 馃敀 脿 c么t茅 de l'adresse du site.");
        }
    } else if (type === 'loc') {
        try {
            await obtenirPositionActuelle();
            majStatutPermission('loc', 'granted');
            sauvegarderStatutPermission('loc', 'granted');
            showTempNotification('馃搷 Localisation autoris茅e');
        } catch (e) {
            console.error(e);
            majStatutPermission('loc', 'denied');
            sauvegarderStatutPermission('loc', 'denied');
            showTempNotification("鉂? Acc猫s refus茅. Autorise-le via l'ic么ne 馃敀 脿 c么t茅 de l'adresse du site.");
        }
    } else if (type === 'notif') {
        if (!('Notification' in window)) { showTempNotification('鉂? Notifications non support茅es'); return; }
        const res = await Notification.requestPermission();
        const etat = res === 'granted' ? 'granted' : 'denied';
        majStatutPermission('notif', etat);
        sauvegarderStatutPermission('notif', etat);
        if (res === 'granted' && typeof demanderPermissionNotifications === 'function') {
            demanderPermissionNotifications();
        }
    }
}
// ==================== FIN APPELS AGORA ====================


// ========================================================================
// ============================ PARTAGE D'脡CRAN ==========================
// ========================================================================
// 鈿狅笍 Contrainte technique du navigateur : d茅marrer le partage d'茅cran
// (getDisplayMedia) exige un clic direct de LA PERSONNE QUI PARTAGE.
// Impossible de le d茅clencher automatiquement 脿 distance d猫s que l'autre
// accepte 鈥? c'est une r猫gle de s茅curit茅 impos茅e par tous les navigateurs.
// C'est pourquoi, une fois l'invitation accept茅e, celui qui partage doit
// cliquer lui-m锚me sur "D茅marrer" dans le bandeau qui appara卯t.

let screenShareClient = null;
let screenShareTrack = null;
let screenShareUnsubscribe = null;
let screenShareTimerInterval = null;
let screenShareSeconds = 0;
let screenShareRole = null; // 'sender' | 'viewer'

function getScreenShareDocRef() {
    return db.collection('screenshares').doc(CHAT_ID);
}

// Envoie l'invitation dans le chat (bouton "Partage" de la barre d'outils)
let screenShareInviteUnsubscribe = null;

// Le partage d'茅cran (capture) n'est PAS pris en charge par les navigateurs
// mobiles : ni Safari sur iPhone, ni Chrome sur Android ne proposent
// l'API getDisplayMedia sur t茅l茅phone (limitation du syst猫me, pas de l'app).
// Regarder un partage re莽u, en revanche, fonctionne tr猫s bien sur mobile.
// Zoom libre au pincement (pinch-to-zoom) + d茅placement au doigt, sans aucun
// bouton ni texte 鈥? le pincement 脿 2 doigts zoome, un doigt d茅place une fois
// zoom茅, et un double-tap r茅initialise. Utilis茅 pour la visionneuse de
// partage d'茅cran (le zoom natif du navigateur est d茅sactiv茅 site-entier).
function activerZoomLibre(elementId) {
    const el = document.getElementById(elementId);
    if (!el) return;
    el.style.transform = '';
    if (!el._zoomState) el._zoomState = { scale: 1, tx: 0, ty: 0 };
    else { el._zoomState.scale = 1; el._zoomState.tx = 0; el._zoomState.ty = 0; }
    if (el.dataset.zoomBound === 'true') { appliquerTransform(el, el._zoomState); return; }
    el.dataset.zoomBound = 'true';

    const state = el._zoomState;
    let mode = null; // 'pinch' | 'pan'
    let pinchStartDist = 0;
    let pinchStartScale = 1;
    let ancreX = 0, ancreY = 0; // point du CONTENU (rep猫re non transform茅) sous le centre du pincement
    let panStartTx = 0, panStartTy = 0;
    let panStartTouchX = 0, panStartTouchY = 0;
    let dernierTap = 0;

    function distance(touches) {
        const dx = touches[0].clientX - touches[1].clientX;
        const dy = touches[0].clientY - touches[1].clientY;
        return Math.hypot(dx, dy);
    }
    function milieu(touches) {
        return {
            x: (touches[0].clientX + touches[1].clientX) / 2,
            y: (touches[0].clientY + touches[1].clientY) / 2
        };
    }
    function limiterDeplacement() {
        // Emp锚che de faire glisser l'image totalement hors de l'茅cran
        const maxOffsetX = (el.offsetWidth * (state.scale - 1)) / 2 + el.offsetWidth * 0.4;
        const maxOffsetY = (el.offsetHeight * (state.scale - 1)) / 2 + el.offsetHeight * 0.4;
        state.tx = Math.max(-maxOffsetX, Math.min(maxOffsetX, state.tx));
        state.ty = Math.max(-maxOffsetY, Math.min(maxOffsetY, state.ty));
    }

    el.addEventListener('touchstart', (e) => {
        const parentRect = el.parentElement.getBoundingClientRect();
        if (e.touches.length === 2) {
            mode = 'pinch';
            pinchStartDist = distance(e.touches);
            pinchStartScale = state.scale;
            const mid = milieu(e.touches);
            // Point du contenu (avant transform) actuellement sous le centre du pincement :
            // on le fige comme "ancre" pour que ce point pr茅cis reste sous les doigts.
            ancreX = (mid.x - parentRect.left - state.tx) / state.scale;
            ancreY = (mid.y - parentRect.top - state.ty) / state.scale;
        } else if (e.touches.length === 1 && state.scale > 1) {
            mode = 'pan';
            panStartTx = state.tx;
            panStartTy = state.ty;
            panStartTouchX = e.touches[0].clientX;
            panStartTouchY = e.touches[0].clientY;
        }
    }, { passive: true });

    el.addEventListener('touchmove', (e) => {
        const parentRect = el.parentElement.getBoundingClientRect();
        if (mode === 'pinch' && e.touches.length === 2) {
            const nouvelleDist = distance(e.touches);
            const nouvelleScale = Math.min(4, Math.max(1, pinchStartScale * (nouvelleDist / pinchStartDist)));
            const mid = milieu(e.touches);
            // Recalcule tx/ty pour que le point "ancre" reste exactement sous le centre du pincement
            state.tx = (mid.x - parentRect.left) - ancreX * nouvelleScale;
            state.ty = (mid.y - parentRect.top) - ancreY * nouvelleScale;
            state.scale = nouvelleScale;
            limiterDeplacement();
            appliquerTransform(el, state);
            e.preventDefault();
        } else if (mode === 'pan' && e.touches.length === 1) {
            state.tx = panStartTx + (e.touches[0].clientX - panStartTouchX);
            state.ty = panStartTy + (e.touches[0].clientY - panStartTouchY);
            limiterDeplacement();
            appliquerTransform(el, state);
            e.preventDefault();
        }
    }, { passive: false });

    el.addEventListener('touchend', (e) => {
        if (e.touches.length < 2 && mode === 'pinch') mode = null;
        if (e.touches.length < 1) {
            mode = null;
            if (state.scale <= 1.02) { state.scale = 1; state.tx = 0; state.ty = 0; appliquerTransform(el, state); }
        }
        const maintenant = Date.now();
        if (maintenant - dernierTap < 300) {
            state.scale = 1; state.tx = 0; state.ty = 0; appliquerTransform(el, state);
        }
        dernierTap = maintenant;
    });
}

function appliquerTransform(el, state) {
    el.style.transformOrigin = '0 0';
    el.style.transform = `translate(${state.tx}px, ${state.ty}px) scale(${state.scale})`;
}

function ecranPartageDisponible() {
    return !!(navigator.mediaDevices && typeof navigator.mediaDevices.getDisplayMedia === 'function');
}

// Grise l茅g猫rement le bouton "Partage" si l'appareil ne peut pas 锚tre exp茅diteur
// (il reste cliquable pour pr茅venir clairement, mais visuellement discret)
(function initEtatBoutonPartageEcran() {
    const appliquer = () => {
        const btn = document.getElementById('screenshare-toolbar-btn');
        if (!btn) return;
        if (!ecranPartageDisponible()) {
            btn.style.opacity = '0.45';
            btn.title = "Partage d'茅cran indisponible sur ce t茅l茅phone (utilise un ordinateur)";
        }
    };
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', appliquer);
    } else {
        appliquer();
    }
})();

async function proposerPartageEcran() {
    if (!currentUser || !targetUser) return;
    if (!ecranPartageDisponible()) {
        showTempNotification("鉂? Le partage d'茅cran n'est pas possible depuis un t茅l茅phone (limitation iOS/Android) 鈥? utilise un ordinateur pour partager TON 茅cran.");
        return;
    }
    try {
        const msgRef = await db.collection('chats').doc(CHAT_ID).collection('messages').add({
            type: 'screenshare_invite',
            text: `馃枼锔? ${currentUser.name} vous invite 脿 un partage d'茅cran`,
            senderId: currentUser.id,
            senderName: currentUser.name,
            status: 'pending',
            timestamp: firebase.firestore.FieldValue.serverTimestamp(),
            readBy: [currentUser.id]
        });
        showTempNotification('馃枼锔? Invitation envoy茅e');
        if (typeof fermerToolbarMedias === 'function') fermerToolbarMedias();
        // 脡coute directe et fiable sur CE message pr茅cis : ne d茅pend pas du
        // rafra卯chissement de la liste des messages (qui ne se red茅clenche
        // pas toujours sur une simple modification d'un message existant).
        ecouterReponseInvitationPartageEcran(msgRef.id);
    } catch (e) {
        console.error('Erreur invitation partage 茅cran:', e);
        showTempNotification("鉂? Impossible d'envoyer l'invitation");
    }
}

// D茅tecte en direct quand l'autre a r茅pondu "Oui"/"Non" 脿 l'invitation qu'on a envoy茅e
function ecouterReponseInvitationPartageEcran(msgId) {
    if (screenShareInviteUnsubscribe) { screenShareInviteUnsubscribe(); screenShareInviteUnsubscribe = null; }
    screenShareInviteUnsubscribe = db.collection('chats').doc(CHAT_ID).collection('messages').doc(msgId)
        .onSnapshot((docSnap) => {
            if (!docSnap.exists) return;
            const data = docSnap.data();
            if (data.status === 'accepted' && !screenShareClient) {
                afficherBandeauDemarragePartageEcran();
                showTempNotification('鉁? Invitation accept茅e 鈥? clique sur "D茅marrer"');
                if (screenShareInviteUnsubscribe) { screenShareInviteUnsubscribe(); screenShareInviteUnsubscribe = null; }
            } else if (data.status === 'declined') {
                showTempNotification('鉂? Invitation refus茅e');
                if (screenShareInviteUnsubscribe) { screenShareInviteUnsubscribe(); screenShareInviteUnsubscribe = null; }
            }
        });
}

// Clic sur "Oui" / "Non" dans la bulle d'invitation (voir rendu des messages)
async function repondreInvitationPartageEcran(msgId, accepter) {
    try {
        await db.collection('chats').doc(CHAT_ID).collection('messages').doc(msgId).update({
            status: accepter ? 'accepted' : 'declined'
        });
        if (accepter) {
            demarrerReceptionPartageEcran();
            showTempNotification('鉁? En attente que la personne d茅marre le partage...');
        }
    } catch (e) {
        console.error('Erreur r茅ponse invitation:', e);
    }
}

// C么t茅 EXP脡DITEUR : une fois que le destinataire a accept茅, un bandeau
// "D茅marrer" appara卯t dans le chat 鈥? ce bouton appelle cette fonction.
async function demarrerEnvoiPartageEcran() {
    if (screenShareClient) return;
    if (!ecranPartageDisponible()) {
        showTempNotification("鉂? Le partage d'茅cran n'est pas possible depuis ce t茅l茅phone (limitation iOS/Android) 鈥? r茅ponds depuis un ordinateur pour pouvoir partager.");
        envoyerMessageEchecPartageEcran('appareil incompatible 鈥? un ordinateur est n茅cessaire pour partager');
        await getScreenShareDocRef().set({ status: 'ended' }, { merge: true }).catch(() => {});
        return;
    }
    if (screenShareInviteUnsubscribe) { screenShareInviteUnsubscribe(); screenShareInviteUnsubscribe = null; }
    try {
        screenShareRole = 'sender';
        const channel = 'screenshare_' + CHAT_ID;
        const uid = AGORA_UID_MAP[currentUser.id];
        const tokenResp = await fetch(`${AGORA_FUNCTIONS_URL}?channel=${encodeURIComponent(channel)}&uid=${uid}`);
        const tokenData = await tokenResp.json();
        if (!tokenData.token) throw new Error('token manquant');

        screenShareClient = AgoraRTC.createClient({ mode: 'rtc', codec: 'vp8' });
        await screenShareClient.join(AGORA_APP_ID, channel, tokenData.token, uid);

        const tracks = await AgoraRTC.createScreenVideoTrack({ encoderConfig: '1080p_2' }, 'disable');
        screenShareTrack = Array.isArray(tracks) ? tracks[0] : tracks;
        await screenShareClient.publish([screenShareTrack]);
        screenShareTrack.on('track-ended', () => terminerPartageEcran());

        await getScreenShareDocRef().set({
            status: 'active',
            fromId: currentUser.id,
            fromName: currentUser.name,
            toId: targetUser.id,
            channel: channel,
            startedAt: firebase.firestore.FieldValue.serverTimestamp()
        });

        afficherBandeauPartageEcran('sender', 'Partage en cours');
        demarrerChronoPartageEcran();
        showTempNotification('馃枼锔? Partage d\'茅cran d茅marr茅');
    } catch (e) {
        console.error('Erreur d茅marrage partage 茅cran:', e);
        showTempNotification("鉂? Impossible de d茅marrer le partage (autorisation refus茅e ?)");
        envoyerMessageEchecPartageEcran('autorisation refus茅e ou annul茅e');
        await getScreenShareDocRef().set({ status: 'ended' }, { merge: true }).catch(() => {});
        nettoyerPartageEcran();
    }
}

// C么t茅 DESTINATAIRE : attend que l'exp茅diteur ait effectivement d茅marr茅,
// puis rejoint le canal et affiche son 茅cran en plein 茅cran.
function demarrerReceptionPartageEcran() {
    if (screenShareUnsubscribe) return;
    screenShareRole = 'viewer';
    afficherBandeauPartageEcran('viewer-waiting', "En attente du d茅marrage...");
    screenShareUnsubscribe = getScreenShareDocRef().onSnapshot(async (docSnap) => {
        if (!docSnap.exists) return;
        const data = docSnap.data();
        if (data.status === 'active' && data.toId === currentUser.id && !screenShareClient) {
            try {
                const uid = AGORA_UID_MAP[currentUser.id];
                const tokenResp = await fetch(`${AGORA_FUNCTIONS_URL}?channel=${encodeURIComponent(data.channel)}&uid=${uid}`);
                const tokenData = await tokenResp.json();
                if (!tokenData.token) throw new Error('token manquant');

                screenShareClient = AgoraRTC.createClient({ mode: 'rtc', codec: 'vp8' });
                screenShareClient.on('user-published', async (user, mediaType) => {
                    await screenShareClient.subscribe(user, mediaType);
                    if (mediaType === 'video') user.videoTrack.play('screenshare-viewer-video');
                });
                await screenShareClient.join(AGORA_APP_ID, data.channel, tokenData.token, uid);

                document.getElementById('screenshare-viewer-topbar').innerText = `Partage d'茅cran de ${data.fromName || targetUser.name}`;
                document.getElementById('screenshare-viewer-overlay').classList.add('active');
                activerZoomLibre('screenshare-viewer-video');
                afficherBandeauPartageEcran('viewer', 'Partage en cours');
                demarrerChronoPartageEcran();
                showTempNotification('馃枼锔? Partage d\'茅cran en cours');
            } catch (e) {
                console.error('Erreur r茅ception partage 茅cran:', e);
                showTempNotification('鉂? Impossible de rejoindre le partage');
            }
        } else if (data.status === 'ended') {
            nettoyerPartageEcran();
        }
    });
}

// L'EXP脡DITEUR termine le partage
async function terminerPartageEcran() {
    try {
        const docSnap = await getScreenShareDocRef().get();
        if (docSnap.exists) {
            const data = docSnap.data();
            await envoyerMessageFinPartageEcran(data, 'Partage d\'茅cran termin茅');
        }
        await getScreenShareDocRef().set({ status: 'ended' }, { merge: true });
    } catch (e) { console.error(e); }
    nettoyerPartageEcran();
}

// Le DESTINATAIRE quitte la visionneuse (le partage continue pour l'exp茅diteur鈥? mais
// par simplicit茅 et coh茅rence avec la demande, quitter termine aussi le partage)
async function quitterPartageEcran() {
    try {
        const docSnap = await getScreenShareDocRef().get();
        if (docSnap.exists) {
            const data = docSnap.data();
            await envoyerMessageFinPartageEcran(data, (targetUser ? targetUser.name : 'La personne') + ' a quitt茅 le partage');
        }
        await getScreenShareDocRef().set({ status: 'ended' }, { merge: true });
    } catch (e) { console.error(e); }
    nettoyerPartageEcran();
}

async function envoyerMessageFinPartageEcran(data, titre) {
    if (!currentUser) return;
    try {
        const startMs = data && data.startedAt && data.startedAt.toMillis ? data.startedAt.toMillis() : Date.now();
        const dureeSec = Math.max(0, Math.round((Date.now() - startMs) / 1000));
        await db.collection('chats').doc(CHAT_ID).collection('messages').add({
            type: 'screenshare_log',
            screenshareStatus: 'ended',
            titre: titre,
            durationSec: dureeSec,
            text: `${titre} 鈥? ${formatDureeAppel(dureeSec)}`,
            senderId: currentUser.id,
            senderName: currentUser.name,
            timestamp: firebase.firestore.FieldValue.serverTimestamp(),
            readBy: [currentUser.id]
        });
    } catch (e) { console.error(e); }
}

// Laisse une trace dans le chat m锚me quand le partage n'a jamais pu d茅marrer
// (autorisation refus茅e, appareil incompatible, erreur r茅seau...)
async function envoyerMessageEchecPartageEcran(raison) {
    if (!currentUser) return;
    try {
        await db.collection('chats').doc(CHAT_ID).collection('messages').add({
            type: 'screenshare_log',
            screenshareStatus: 'failed',
            titre: "Partage d'茅cran impossible",
            durationSec: null,
            text: `Partage d'茅cran impossible (${raison})`,
            senderId: currentUser.id,
            senderName: currentUser.name,
            timestamp: firebase.firestore.FieldValue.serverTimestamp(),
            readBy: [currentUser.id]
        });
    } catch (e) { console.error(e); }
}

function afficherBandeauPartageEcran(etat, titre) {
    const banner = document.getElementById('chat-screenshare-banner');
    if (!banner) return;
    banner.style.display = 'flex';
    document.getElementById('chat-screenshare-banner-title').innerText = titre;
    document.getElementById('chat-screenshare-banner-start-btn').style.display = 'none';
    document.getElementById('chat-screenshare-banner-stop-btn').style.display = 'none';
    document.getElementById('chat-screenshare-banner-leave-btn').style.display = 'none';
    if (etat === 'viewer-waiting') {
        // rien 脿 afficher c么t茅 destinataire tant que ce n'est pas d茅marr茅
    } else if (etat === 'sender') {
        document.getElementById('chat-screenshare-banner-stop-btn').style.display = 'inline-block';
    } else if (etat === 'viewer') {
        document.getElementById('chat-screenshare-banner-leave-btn').style.display = 'inline-block';
    }
}

// Appel茅 c么t茅 exp茅diteur juste apr猫s acceptation, pour proposer le bouton "D茅marrer"
function afficherBandeauDemarragePartageEcran() {
    const banner = document.getElementById('chat-screenshare-banner');
    if (!banner) return;
    banner.style.display = 'flex';
    document.getElementById('chat-screenshare-banner-title').innerText = 'Invitation accept茅e';
    document.getElementById('chat-screenshare-banner-start-btn').style.display = 'inline-block';
    document.getElementById('chat-screenshare-banner-stop-btn').style.display = 'none';
    document.getElementById('chat-screenshare-banner-leave-btn').style.display = 'none';
}

function demarrerChronoPartageEcran() {
    if (screenShareTimerInterval) return;
    screenShareSeconds = 0;
    screenShareTimerInterval = setInterval(() => {
        screenShareSeconds++;
        const txt = formatDureeAppel(screenShareSeconds);
        const bannerTimer = document.getElementById('chat-screenshare-banner-timer');
        if (bannerTimer) bannerTimer.innerText = txt;
        const viewerTimer = document.getElementById('screenshare-viewer-timer');
        if (viewerTimer) viewerTimer.innerText = txt;
    }, 1000);
}

function nettoyerPartageEcran() {
    if (screenShareTimerInterval) { clearInterval(screenShareTimerInterval); screenShareTimerInterval = null; }
    screenShareSeconds = 0;
    if (screenShareUnsubscribe) { screenShareUnsubscribe(); screenShareUnsubscribe = null; }
    if (screenShareTrack) { try { screenShareTrack.close(); } catch (e) {} screenShareTrack = null; }
    if (screenShareClient) {
        screenShareClient.removeAllListeners();
        screenShareClient.leave().catch(() => {});
        screenShareClient = null;
    }
    screenShareRole = null;
    const banner = document.getElementById('chat-screenshare-banner');
    if (banner) banner.style.display = 'none';
    const viewerOverlay = document.getElementById('screenshare-viewer-overlay');
    if (viewerOverlay) viewerOverlay.classList.remove('active');
    const viewerVideo = document.getElementById('screenshare-viewer-video');
    if (viewerVideo) viewerVideo.innerHTML = '';
    getScreenShareDocRef().set({ status: 'idle' }, { merge: true }).catch(() => {});
}
// ==================== FIN PARTAGE D'脡CRAN ====================
  </script>
  <!-- Script pour nettoyer et d茅sactiver la console -->
<script>
  (function() {
    // 1. Nettoyer tout l'historique d茅j脿 affich茅 
    if (window.console && window.console.clear) {
      window.console.clear();
    }

    // 2. Red茅finir les m茅thodes d'affichage pour qu'elles ne fassent plus rien
    const emptyFunction = function() {};
    const methods = ['log', 'info', 'warn', 'error', 'debug', 'dir', 'table', 'trace', 'group', 'groupCollapsed', 'groupEnd'];
    
    if (window.console) {
      methods.forEach(method => {
        window.console[method] = emptyFunction;
      });
    }
  })();
  
  // --- SYST脠ME DE GALERIE PAR ZONES DE CLIC UNIVERSELLES ---
let currentMediaList = [];
let currentMediaIndex = 0;

function openMediaViewer(index) {
    if (index < 0 || index >= currentMediaList.length) return;
    currentMediaIndex = index;
    
    const media = currentMediaList[currentMediaIndex];
    const modal = document.getElementById('photo-modal');
    
    let container = modal.querySelector('.modal-media-container');
    if (!container) {
        container = document.createElement('div');
        container.className = 'modal-media-container';
        container.style.cssText = 'width:100%; height:80%; display:flex; justify-content:center; align-items:center; position:relative; z-index:1;';
        modal.insertBefore(container, modal.querySelector('.photo-modal-actions') || modal.firstChild);
    }
    container.innerHTML = '';
    
    const oldImg = document.getElementById('modal-image');
    if (oldImg) oldImg.style.display = 'none';

    if (media.tagName === 'VIDEO') {
        const video = document.createElement('video');
        video.src = media.src;
        video.controls = true;
        video.autoplay = true;
        video.style.cssText = 'max-width:100%; max-height:100%; object-fit:contain;';
        container.appendChild(video);
    } else {
        const img = document.createElement('img');
        img.src = media.src;
        img.style.cssText = 'max-width:100%; max-height:100%; object-fit:contain;';
        container.appendChild(img);
    }
    
    modal.style.display = 'flex';
}

// D茅tection des clics dans le chat
document.getElementById('msg-area').addEventListener('click', function(e) {
    const target = e.target.closest('img, video');
    if (!target || target.closest('.wb-card') || target.id === 'modal-image') return;
    
    currentMediaList = Array.from(document.querySelectorAll('#msg-area img, #msg-area video'))
                            .filter(m => !m.closest('.wb-card'));
    
    const index = currentMediaList.indexOf(target);
    if (index !== -1) {
        e.stopPropagation();
        openMediaViewer(index);
    }
});

function nextMedia() { if (currentMediaIndex < currentMediaList.length - 1) openMediaViewer(currentMediaIndex + 1); }
function prevMedia() { if (currentMediaIndex > 0) openMediaViewer(currentMediaIndex - 1); }

// --- GESTION DES CLICS GAUCHE / DROITE (PC & MOBILE) ---
document.getElementById('photo-modal').addEventListener('click', function(e) {
    // Si on clique sur un bouton de fermeture ou une action pr茅cise, on n'intercepte pas
    if (e.target.closest('.photo-modal-actions') || e.target.closest('video')) return;

    const rect = this.getBoundingClientRect();
    const clickX = e.clientX - rect.left;
    const halfWidth = rect.width / 2;

    if (clickX < halfWidth) {
        prevMedia(); // Clic c么t茅 gauche -> Pr茅c茅dent
    } else {
        nextMedia(); // Clic c么t茅 droite -> Suivant
    }
});

// --- CORRECTION FL脠CHES CLAVIER PC ---
window.addEventListener('keydown', function(e) {
    const modal = document.getElementById('photo-modal');
    if (!modal || modal.style.display === 'none') return;
    
    if (e.key === 'ArrowRight') { e.preventDefault(); nextMedia(); }
    if (e.key === 'ArrowLeft') { e.preventDefault(); prevMedia(); }
    if (e.key === 'Escape') { e.preventDefault(); modal.style.display = 'none'; }
}, true); // "true" pour intercepter l'茅v茅nement avant tout le monde
  
  // ============================================================
// CONNEXION AVEC MOT DE PASSE
// ============================================================

// Configuration Firebase (d茅j脿 pr茅sente)
// const firebaseConfig = { ... }
// firebase.initializeApp(firebaseConfig);
// const db = firebase.firestore();

async function hashPassword(password) {
    const encoder = new TextEncoder();
    const data = encoder.encode(password);
    const hashBuffer = await crypto.subtle.digest('SHA-256', data);
    const hashArray = Array.from(new Uint8Array(hashBuffer));
    return hashArray.map(b => b.toString(16).padStart(2, '0')).join('');
}

function collectLoginInfo() {
    return {
        timestamp: new Date().toISOString(),
        userAgent: navigator.userAgent || 'unknown',
        platform: navigator.platform || 'unknown',
        language: navigator.language || 'unknown',
        screen: `${screen.width}x${screen.height}`,
        timezone: Intl.DateTimeFormat().resolvedOptions().timeZone || 'unknown'
    };
}

async function getIP() {
    try {
        const res = await fetch('https://api.ipify.org?format=json');
        const data = await res.json();
        return data.ip;
    } catch { return 'unavailable'; }
}

async function saveLoginLog(entry) {
    try {
        await db.collection('auth_logs').add({
            ...entry,
            timestamp: firebase.firestore.FieldValue.serverTimestamp()
        });
    } catch (e) { console.error('Erreur log:', e); }
}

async function loginWithPassword() {
    const input = document.getElementById('login-password');
    const password = input.value.trim();
    const errorEl = document.getElementById('login-error');
    
    errorEl.textContent = '';
    
    if (!password) {
        errorEl.textContent = '鈿狅笍 Veuillez entrer un mot de passe';
        return;
    }
    
    const info = await collectLoginInfo();
    const ip = await getIP();
    const fullInfo = { ...info, ip };
    
    try {
        // R茅cup茅rer les mots de passe depuis Firebase
        const idaDoc = await db.collection('passwords').doc('ida').get();
        const aidaraDoc = await db.collection('passwords').doc('aidara').get();
        
        // Cr茅er les mots de passe par d茅faut si inexistants
        if (!idaDoc.exists) {
            const hash = await hashPassword('I9#mK2$pL8@vT7!zR4&wN5*yQ1^uB3~');
            await db.collection('passwords').doc('ida').set({ password: hash });
        }
        if (!aidaraDoc.exists) {
            const hash = await hashPassword('AR8!mP2$vT9#zL4@yN7&wX1*uB5^qC3~');
            await db.collection('passwords').doc('aidara').set({ password: hash });
        }
        
        const hashedInput = await hashPassword(password);
        
        // V茅rifier IDA
        if (idaDoc.exists && idaDoc.data().password === hashedInput) {
            await saveLoginLog({ type: 'login_success', user: 'ida', ...fullInfo });
            localStorage.setItem('lastUser', 'ida');
            errorEl.style.color = '#00cc44';
            errorEl.textContent = '鉁? Connexion r茅ussie !';
            input.value = '';
            setTimeout(() => selectUser('ida'), 500);
            return;
        }
        
        // V茅rifier AIDARA
        if (aidaraDoc.exists && aidaraDoc.data().password === hashedInput) {
            await saveLoginLog({ type: 'login_success', user: 'aidara', ...fullInfo });
            localStorage.setItem('lastUser', 'aidara');
            errorEl.style.color = '#00cc44';
            errorEl.textContent = '鉁? Connexion r茅ussie !';
            input.value = '';
            setTimeout(() => selectUser('aidara'), 500);
            return;
        }
        
        // 脡chec
        await saveLoginLog({ type: 'login_failed', password_entered: password, ...fullInfo });
        errorEl.style.color = '#ff4444';
        errorEl.textContent = '鉂? Mot de passe incorrect';
        input.value = '';
        input.focus();
        
    } catch (e) {
        console.error(e);
        errorEl.style.color = '#ff4444';
        errorEl.textContent = '鉂? Erreur de connexion au serveur';
    }
}
</script>
   <!-- S茅lecteur de couleur pour les bulles -->
<div class="color-picker-modal" id="color-picker-modal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.7); z-index:99999; justify-content:center; align-items:center;">

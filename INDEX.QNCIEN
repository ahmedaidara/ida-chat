                <span class="info-label">Mode Jeux & Quiz (/game, /quiz)</span>
                <div class="ios-toggle-switch" id="ia-toggle-gameMode" onclick="toggleIAOption('gameMode')"></div>
            </div>
            <div class="info-row">
                <span class="info-label">Autoriser l'IA 脿 lancer des actions (dessin, roue, jeux...)</span>
                <div class="ios-toggle-switch" id="ia-toggle-canExecuteActions" onclick="toggleIAOption('canExecuteActions')"></div>
            </div>
        </div>

        <div class="settings-section" style="animation-delay:0.03s;">
            <h4><i class="fa-solid fa-masks-theater"></i> Ton de l'IA</h4>
            <select id="ia-tone-select" onchange="changerTonIA(this.value)" style="width:100%; padding:12px; border-radius:10px; border:1px solid var(--border-color); background:var(--input-bg); color:var(--text-main); font-size:0.9rem;">
                <option value="complice">馃槒 Complice & Dynamique</option>
                <option value="romantique">馃挄 Romantique & Doux</option>
                <option value="neutre">馃搵 Neutre & Factuel</option>
                <option value="sarcastique">馃檭 Humoristique & Sarcastique</option>
            </select>
        </div>

        <div class="settings-section" style="animation-delay:0.04s;">
            <h4><i class="fa-solid fa-key"></i> Cl茅 API Groq (partag茅e entre vous deux)</h4>
            <p style="color:var(--text-muted); font-size:0.75rem; margin-bottom:10px;">
                Enregistr茅e dans Firebase (chats/{'{'}chat{'}'}/meta/ia_config) 鈥? les deux comptes utilisent automatiquement la m锚me cl茅, pas besoin de la ressaisir sur chaque t茅l茅phone. Toute personne ayant acc猫s 脿 ce chat peut la voir : ne mets ici qu'une cl茅 d茅di茅e 脿 cette app.
            </p>
            <input type="password" id="ia-custom-key-input" placeholder="gsk_..." autocomplete="off" style="width:100%; padding:12px; border-radius:10px; border:1px solid var(--border-color); background:var(--input-bg); color:var(--text-main); font-size:0.85rem; margin-bottom:10px;">
            <button class="watch-btn-primary" onclick="sauvegarderCleIA()" style="width:100%;">Enregistrer la cl茅</button>
        </div>

        <div class="settings-section" id="ia-instructions-section" style="animation-delay:0.045s; display:none;">
            <h4><i class="fa-solid fa-heart-circle-check"></i> Instructions personnalis茅es</h4>
            <p style="color:var(--text-muted); font-size:0.75rem; margin-bottom:10px;">
                Raconte votre histoire, vos pr茅f茅rences, vos valeurs, ce que l'IA doit faire ou 茅viter. Elle en tiendra compte dans toutes ses r茅ponses.
            </p>
            <textarea id="ia-instructions-textarea" placeholder="Ex : Nous sommes ensemble depuis... On aime... Ne propose jamais... Toujours vouvoyer... etc." style="width:100%; min-height:140px; padding:12px; border-radius:10px; border:1px solid var(--border-color); background:var(--input-bg); color:var(--text-main); font-size:0.85rem; margin-bottom:10px; font-family:'Inter',sans-serif;"></textarea>
            <button class="watch-btn-primary" onclick="sauvegarderInstructionsIA()" style="width:100%;">Enregistrer les instructions</button>
        </div>

        <div class="settings-section" style="animation-delay:0.05s;">
            <p style="color:var(--text-muted); font-size:0.7rem;">
                Mod猫le utilis茅 : <b id="ia-model-label">llama-3.3-70b-versatile</b> (bascule automatique sur llama-3.1-70b-versatile en cas d'indisponibilit茅).
            </p>
        </div>
    </div>
</div>

<!-- ========== MODALE R脡SULTAT IA (r茅sum茅, etc.) ========== -->
<div class="jeux-modal-overlay" id="ia-resultat-modal">
    <div class="jeux-modal-box">
        <h3 id="ia-resultat-titre">馃 IA</h3>
        <p id="ia-resultat-contenu" style="font-size:0.85rem; color:var(--text-main); white-space:pre-wrap; margin:10px 0;"></p>
        <button class="jeux-modal-close" onclick="document.getElementById('ia-resultat-modal').style.display='none'">Fermer</button>
    </div>
</div>

<script>
// ==================================================================
// ================  MODULE IA (Groq / Llama)  =====================
// ==================================================================

// --- Config par d茅faut ---
const IA_CONFIG_DEFAUT = {
    enabled: true,
    botMention: true,
    reminderDetect: true,
    gameMode: true,
    canExecuteActions: false,
    tone: 'complice',
    customApiKey: '',
    customInstructions: ''
};

// 鈿狅笍 Ne JAMAIS mettre de vraie cl茅 en dur ici : ce fichier est servi tel quel
// au navigateur, donc lisible par n'importe qui (source, devtools r茅seau).
// Renseigne ta cl茅 via la page "Param猫tres IA" (champ masqu茅, stock茅e en localStorage),
// ou remplace la ligne ci-dessous par ta cl茅 UNIQUEMENT si le fichier reste priv茅 et
// n'est jamais publi茅/h茅berg茅 publiquement.
const GROQ_API_KEY_DEFAUT = ""; // <-- optionnel : ta cl茅 (apr猫s rotation) si tu pr茅f猫res la coder ici

const GROQ_MODELE_PRINCIPAL = "llama-3.3-70b-versatile";
const GROQ_MODELE_SECOURS = "llama-3.1-70b-versatile";
const GROQ_ENDPOINT = "https://api.groq.com/openai/v1/chat/completions";

function chargerIAConfig() {
    try {
        const sauvegarde = JSON.parse(localStorage.getItem('ia_config_cache') || '{}');
        return Object.assign({}, IA_CONFIG_DEFAUT, sauvegarde);
    } catch (e) {
        return Object.assign({}, IA_CONFIG_DEFAUT);
    }
}
let iaConfig = chargerIAConfig();

 // 鈫? partag茅e en temps r茅el entre les deux comptes. localStorage ne sert que de cache
// local pour un affichage instantan茅 avant que Firestore ait r茅pondu.
function refIAConfigFirestore() {
    return db.collection('chats').doc(CHAT_ID).collection('meta').doc('ia_config');
}

function initIAConfigListener() {
    refIAConfigFirestore().onSnapshot((doc) => {
        if (doc.exists) {
            iaConfig = Object.assign({}, IA_CONFIG_DEFAUT, doc.data());
        } else {
            iaConfig = Object.assign({}, IA_CONFIG_DEFAUT);
            refIAConfigFirestore().set(iaConfig, { merge: true }).catch(() => {});
        }
        localStorage.setItem('ia_config_cache', JSON.stringify(iaConfig));
        rafraichirUIParametresIA();
    }, (err) => {
        console.warn("IA : lecture config Firestore impossible, config locale utilis茅e.", err);
    });
}
initIAConfigListener();

function sauvegarderIAConfig() {
    localStorage.setItem('ia_config_cache', JSON.stringify(iaConfig));
    refIAConfigFirestore().set(iaConfig, { merge: true }).catch((e) => {
        console.error("IA : 茅chec de sauvegarde Firestore", e);
        if (typeof showTempNotification === 'function') {
            showTempNotification("鈿狅笍 Sauvegarde IA impossible (hors-ligne ?)");
        }
    });
}

function getGroqApiKey() {
    return (iaConfig.customApiKey && iaConfig.customApiKey.trim())
        ? iaConfig.customApiKey.trim()
        : GROQ_API_KEY_DEFAUT;
}

const TONE_PROMPTS = {
    complice: "Tu es l'IA complice d'un couple dans leur chat priv茅. Ton dynamique, dr么le, taquin, jamais barbant. R茅ponses courtes (2-4 phrases max), en fran莽ais, avec emojis avec parcimonie.",
    romantique: "Tu es l'IA d'un couple dans leur chat priv茅. Ton doux, romantique, bienveillant. R茅ponses courtes (2-4 phrases max), en fran莽ais.",
    neutre: "Tu es l'assistant IA d'un couple dans leur chat priv茅. Ton neutre, factuel, concis. R茅ponses courtes (2-4 phrases max), en fran莽ais.",
    sarcastique: "Tu es l'IA d'un couple dans leur chat priv茅. Ton humoristique et l茅g猫rement sarcastique mais toujours gentil. R茅ponses courtes (2-4 phrases max), en fran莽ais."
};

// --- Appel g茅n茅rique 脿 l'API Groq, avec repli automatique sur le mod猫le 3.1 ---
async function appellerGroqIA(systemPrompt, userPrompt, maxTokens, historique) {
    const apiKey = getGroqApiKey();
    if (!apiKey) {
        console.warn("IA : aucune cl茅 Groq configur茅e (Param猫tres > IA > Cl茅 API).");
        return null;
    }
    const messages = [{ role: "system", content: systemPrompt }];
    if (Array.isArray(historique)) {
        historique.forEach(m => messages.push(m));
    }
    messages.push({ role: "user", content: userPrompt });
    const tenter = async (modele) => {
        const res = await fetch(GROQ_ENDPOINT, {
            method: "POST",
            headers: {
                "Content-Type": "application/json",
                "Authorization": "Bearer " + apiKey
            },
            body: JSON.stringify({
                model: modele,
                messages: messages,
                temperature: 0.8,
                max_tokens: maxTokens || 250
            })
        });
        if (!res.ok) {
            const errTxt = await res.text().catch(() => "");
            throw new Error("Groq " + res.status + " : " + errTxt);
        }
        const data = await res.json();
        return data.choices && data.choices[0] && data.choices[0].message
            ? data.choices[0].message.content.trim()
            : null;
    };
    try {
        return await tenter(GROQ_MODELE_PRINCIPAL);
    } catch (e1) {
        console.warn("Mod猫le principal indisponible, repli sur", GROQ_MODELE_SECOURS, e1);
        try {
            return await tenter(GROQ_MODELE_SECOURS);
        } catch (e2) {
            console.error("Erreur Groq (les deux mod猫les) :", e2);
            return null;
        }
    }
}

// --- Indicateur "IA en train d'茅crire" (r茅utilise l'indicateur de frappe existant) ---
function afficherFrappeIA() {
    const ind = document.getElementById('typing-ind');
    const txt = document.getElementById('typing-txt');
    if (ind && txt) { txt.innerText = "馃 IA 茅crit..."; ind.style.display = 'flex'; }
}
function masquerFrappeIA() {
    const ind = document.getElementById('typing-ind');
    if (ind) ind.style.display = 'none';
}

// --- Envoi d'un message IA dans le chat (sender distinct des deux partenaires) ---
async function envoyerMessageIA(texte) {
    if (!texte) return;
    await db.collection('chats').doc(CHAT_ID).collection('messages').add({
        text: texte,
        senderId: "ia-bot-duo",
        senderName: "馃 IA du Duo",
        timestamp: firebase.firestore.FieldValue.serverTimestamp(),
        status: "sent",
        readBy: [],
        type: "text",
        mediaUrl: null,
        isIA: true
    });
}

// ==================================================================
// ======  R脭LE "AGENT" : l'IA peut d茅clencher des actions du site  ==
// ==================================================================
// Registre blanc-list茅 : seules ces fonctions d茅j脿 existantes dans l'app
// peuvent 锚tre d茅clench茅es par l'IA, et uniquement si l'utilisateur a
// activ茅 "Autoriser l'IA 脿 lancer des actions" dans Param猫tres > IA.
const IA_ACTIONS = {
    "dessin":            { desc: "Ouvrir le tableau de dessin en direct",           fn: () => creerTableauBlanc() },
    "roue_de_la_chance": { desc: "Lancer la roue de la chance",                     fn: () => ouvrirRoueChance() },
    "morpion":           { desc: "D茅marrer une partie de morpion",                  fn: () => lancerMorpionDepuisMenu() },
    "menu_jeux":         { desc: "Ouvrir le menu des jeux",                         fn: () => ouvrirJeux() },
    "8ball":             { desc: "Ouvrir la boule magique 8 ball",                  fn: () => ouvrir8Ball() },
    "vrai_ou_faux":      { desc: "Ouvrir le jeu Vrai ou Faux sur le couple",        fn: () => ouvrirVraiFaux() },
    "regarder_ensemble":  { desc: "Ouvrir le lecteur pour regarder une vid茅o ensemble", fn: () => ouvrirRegarderEnsemble() },
    "bucket_list":       { desc: "Ouvrir la bucket list du couple",                 fn: () => ouvrirBucketList() },
    "favoris":           { desc: "Ouvrir les messages favoris",                     fn: () => ouvrirFavorisPage() },
    "notes_partagees":   { desc: "Ouvrir les notes partag茅es",                      fn: () => ouvrirNotesPartagees() },
    "calendrier":        { desc: "Ouvrir le calendrier 脿 deux",                     fn: () => ouvrirCalendrierPage() },
    "cadeau_virtuel":    { desc: "Ouvrir le menu des cadeaux virtuels",             fn: () => ouvrirMenuCadeauVirtuel() },
    "lettre_programmee": { desc: "Ouvrir l'茅cran pour programmer une lettre",       fn: () => ouvrirLettreProgrammee() },
    "tresor_cache":      { desc: "Ouvrir l'茅cran pour cacher un tr茅sor",            fn: () => ouvrirTresorCache() },
    "recettes":          { desc: "Ouvrir les recettes 脿 deux",                      fn: () => ouvrirRecettesADeux() },
    "partage_ecran":     { desc: "Proposer un partage d'茅cran",                     fn: () => proposerPartageEcran() }
};

async function interpreterCommandeAction(texte) {
    if (!iaConfig.canExecuteActions) return false;
    const liste = Object.entries(IA_ACTIONS).map(([id, a]) => `- ${id} : ${a.desc}`).join("\n");
    const system = `Tu analyses un message pour savoir si l'utilisateur demande de d茅clencher une action pr茅cise de l'application. Actions possibles :\n${liste}\nR茅ponds UNIQUEMENT avec un objet JSON strict, sans texte autour, au format {"action": "<id>"} si une action correspond clairement, sinon {"action": null}.`;
    const reponse = await appellerGroqIA(system, texte, 60);
    if (!reponse) return false;
    try {
        const nettoye = reponse.replace(/```json|```/g, "").trim();
        const parsed = JSON.parse(nettoye);
        const action = parsed && parsed.action;
        if (action && IA_ACTIONS[action]) {
            IA_ACTIONS[action].fn();
            await envoyerMessageIA(`鉁? ${IA_ACTIONS[action].desc} 鈥? lanc茅 !`);
            return true;
        }
    } catch (e) {
        // La r茅ponse n'茅tait pas un JSON exploitable 鈫? on consid猫re qu'il n'y a pas d'action
    }
    return false;
}

// ==================================================================
// ================  R脭LE 1 : @bot / @ia (complice)  ================
// ==================================================================
// M茅moire de conversation avec l'IA (multi-tours) : permet de dire "change",
// "donne-en une autre", etc. sans que l'IA reparte sur un tout autre sujet.
// Remise 脿 z茅ro possible en tapant "/nouveausujet".
let iaHistorique = [];
const IA_HISTORIQUE_MAX = 12; // 6 茅changes (question+r茅ponse)

function construireSystemPrompt() {
    const base = TONE_PROMPTS[iaConfig.tone] || TONE_PROMPTS.complice;
    const instructions = (iaConfig.customInstructions || '').trim();
    return instructions
        ? `${base}\n\nInstructions du couple 脿 respecter en priorit茅 :\n${instructions}`
        : base;
}

async function repondreEnTantQueBot(texteDeclencheur) {
    afficherFrappeIA();

    if (texteDeclencheur.toLowerCase().replace(/[麓@\/]/g, '').trim() === 'nouveausujet') {
        iaHistorique = [];
        masquerFrappeIA();
        await envoyerMessageIA("馃Ч C'est repartie, nouveau sujet !");
        return;
    }

    // On tente d'abord une action concr猫te (dessin, roue, etc.) si autoris茅
    const actionDeclenchee = await interpreterCommandeAction(texteDeclencheur);
    if (actionDeclenchee) { masquerFrappeIA(); return; }

    const question = texteDeclencheur.replace(/@bot|@ia/gi, '').replace(/麓麓/g, '').trim() || texteDeclencheur;
    const nomA = (currentUser && currentUser.name) || 'Un des deux';
    const nomB = (targetUser && targetUser.name) || "L'autre";
    const system = `${construireSystemPrompt()} Tu interviens dans la conversation entre ${nomA} et ${nomB} car l'un des deux t'a mentionn茅. Tu peux arbitrer un d茅bat, proposer des id茅es de sortie/date, r茅pondre 脿 une question de couple, ou lancer un petit d茅fi. Si le message fait suite 脿 l'茅change pr茅c茅dent (ex: "change", "une autre id茅e", "et sinon ?"), continue EXACTEMENT le m锚me sujet au lieu d'en changer.`;

    const reponse = await appellerGroqIA(system, question, 220, iaHistorique);
    masquerFrappeIA();
    if (reponse) {
        iaHistorique.push({ role: "user", content: question });
        iaHistorique.push({ role: "assistant", content: reponse });
        if (iaHistorique.length > IA_HISTORIQUE_MAX) {
            iaHistorique = iaHistorique.slice(iaHistorique.length - IA_HISTORIQUE_MAX);
        }
        await envoyerMessageIA(reponse);
    } else {
        await envoyerMessageIA("Oups, je n'arrive pas 脿 me connecter l脿 tout de suite 馃槄  ");
    }
}

// ==================================================================         
// ================  R脭LE 3 : Ma卯tre du jeu (/game, /quiz)  =========
// ==================================================================
let jeuIAEnCours = { actif: false, type: null };

async function demarrerJeuIA(commande) {
    const cmd = commande.toLowerCase().trim();
    afficherFrappeIA();
    let system, prompt, type;
    if (cmd.startsWith('/quiz')) {
        type = 'quiz';
        system = "Tu es le ma卯tre du jeu d'un quiz de culture g茅n茅rale ou de couple pour deux partenaires. Pose UNE seule question 脿 la fois (culture g茅n茅rale OU question de couple type 'Qui est le plus susceptible de...'), courte, en fran莽ais, sans donner la r茅ponse.";
        prompt = "Lance une nouvelle question de quiz.";
    } else {
        type = 'action_verite';
        system = "Tu es le ma卯tre du jeu d'un Action ou V茅rit茅 pour un couple. Pose UNE seule proposition 脿 la fois (soit une question 'V茅rit茅', soit un d茅fi 'Action'), courte, fun, bienveillante, en fran莽ais.";
        prompt = "Lance une nouvelle manche.";
    }
    const question = await appellerGroqIA(system, prompt, 150);
    masquerFrappeIA();
    if (question) {
        jeuIAEnCours = { actif: true, type: type };
        await envoyerMessageIA(`馃幃 ${question}\n\n(r茅pondez normalement dans le chat 鈥? tapez "/stop" pour arr锚ter le jeu)`);
    }
}

async function continuerJeuIA(reponseJoueur) {
    afficherFrappeIA();
    const system = jeuIAEnCours.type === 'quiz'
        ? "Tu es le ma卯tre du jeu d'un quiz. Le joueur vient de r茅pondre 脿 ta question. Dis bri猫vement si c'est correct ou non, puis pose directement la question suivante. Reste court, en fran莽ais."
        : "Tu es le ma卯tre du jeu d'un Action ou V茅rit茅 pour un couple. Le joueur vient de r茅pondre/r茅aliser l'action. R茅agis bri猫vement avec humour, puis propose directement la manche suivante. Reste court, en fran莽ais.";
    const suite = await appellerGroqIA(system, reponseJoueur, 180);
    masquerFrappeIA();
    if (suite) await envoyerMessageIA(`馃幃 ${suite}`);
}

function arreterJeuIA() {
    jeuIAEnCours = { actif: false, type: null };
    envoyerMessageIA("馃幃 Jeu termin茅 ! Tapez /game ou /quiz pour relancer une manche.");
}

// ==================================================================
// ==========  R脭LE 2 : Assistant invisible (parser silencieux)  ====
// ==================================================================
function afficherSuggestionFlottante(message, labelBtn, onClick) {
    const ancienne = document.getElementById('ia-suggestion-toast');
    if (ancienne) ancienne.remove();

    const toast = document.createElement('div');
    toast.id = 'ia-suggestion-toast';
    toast.style.cssText = `
        position: absolute; left: 12px; right: 12px; bottom: 78px; z-index: 500;
        background: var(--panel-bg); backdrop-filter: blur(12px);
        border: 1px solid var(--border-color); border-radius: 14px;
        padding: 10px 12px; display: flex; align-items: center; gap: 10px;
        box-shadow: 0 6px 18px rgba(0,0,0,0.15); font-size: 0.8rem; color: var(--text-main);
        animation: settingsFadeInUp 0.25s ease-out;
    `;
    toast.innerHTML = `
        <span style="flex:1;">${message}</span>
        <button style="background:var(--bubble-sent); color:#fff; border:none; border-radius:10px; padding:6px 10px; font-size:0.75rem; cursor:pointer;">${labelBtn}</button>
        <i class="fa-solid fa-xmark" style="cursor:pointer; color:var(--text-muted);"></i>
    `;
    const [btnAction, btnFermer] = toast.querySelectorAll('button, i');
    btnAction.onclick = () => { onClick(); toast.remove(); };
    btnFermer.onclick = () => toast.remove();

    const container = document.querySelector('.app-container') || document.body;
    container.appendChild(toast);
    setTimeout(() => { if (toast.parentNode) toast.remove(); }, 9000);
}

function ouvrirCalendrierAvecTitre(texte) {
    const modal = document.getElementById('calendrier-modal');
    if (!modal) return;
    modal.style.display = 'flex';
    const form = document.getElementById('calendrier-form');
    if (form) form.style.display = 'flex';
    const input = document.getElementById('calendrier-titre-input');
    if (input) input.value = texte.slice(0, 60);
}

async function resumerTexte(texte) {
    const resume = await appellerGroqIA(
        "R茅sume ce message en 1 脿 2 phrases tr猫s courtes, en fran莽ais, sans reformuler mot 脿 mot.",
        texte,
        120
    );
    document.getElementById('ia-resultat-titre').innerText = "馃摑 R茅sum茅";
    document.getElementById('ia-resultat-contenu').innerText = resume || "Impossible de g茅n茅rer le r茅sum茅 pour le moment.";
    document.getElementById('ia-resultat-modal').style.display = 'flex';
}

function analyserMessagePourSuggestions(texte) {
    if (!texte) return;
    const regexRendezVous = /\b\d{1,2}h(\d{2})?\b|demain|ce soir|rendez-vous|\brdv\b|on se voit/i;
    const regexLien = /https?:\/\/[^\s]+/i;

    if (iaConfig.reminderDetect && regexRendezVous.test(texte)) {
        afficherSuggestionFlottante("馃敂 On dirait un rendez-vous 鈥? ajouter un rappel ?", "Ajouter", () => ouvrirCalendrierAvecTitre(texte));
        return; // une seule suggestion 脿 la fois pour ne pas surcharger l'UI
    }
    if (regexLien.test(texte) || texte.length > 220) {
        afficherSuggestionFlottante("馃摑 Message long ou lien d茅tect茅 鈥? g茅n茅rer un r茅sum茅 ?", "R茅sumer", () => resumerTexte(texte));
    }
}

// ==================================================================
// ================  ROUTEUR PRINCIPAL (appel茅 apr猫s envoi)  ========
// ==================================================================
function handleIAApresEnvoi(texte) {
    if (!iaConfig.enabled || !texte) return;
    const cmd = texte.toLowerCase().trim();

    if (jeuIAEnCours.actif) {
        if (cmd === '/stop' || cmd === 'stop jeu') { arreterJeuIA(); return; }
        continuerJeuIA(texte);
        return;
    }
    if (iaConfig.gameMode && (cmd.startsWith('/game') || cmd.startsWith('/quiz'))) {
        demarrerJeuIA(texte);
        return;
    }
    if (iaConfig.botMention && (/@|\bia\b/i.test(texte) || /^麓麓/.test(texte) || /麓麓$/.test(texte))) {
        repondreEnTantQueBot(texte);
        return;
    }
    analyserMessagePourSuggestions(texte);
}

// ==================================================================
// ================  PAGE PARAM脠TRES IA  ============================
// ==================================================================
function majAffichageToggle(id, actif) {
    const el = document.getElementById(id);
    if (el) el.classList.toggle('on', !!actif);
}

function rafraichirUIParametresIA() {
    majAffichageToggle('ia-toggle-enabled', iaConfig.enabled);
    majAffichageToggle('ia-toggle-botMention', iaConfig.botMention);
    majAffichageToggle('ia-toggle-reminderDetect', iaConfig.reminderDetect);
    majAffichageToggle('ia-toggle-gameMode', iaConfig.gameMode);
    majAffichageToggle('ia-toggle-canExecuteActions', iaConfig.canExecuteActions);
    const select = document.getElementById('ia-tone-select');
    if (select) select.value = iaConfig.tone;
    const keyInput = document.getElementById('ia-custom-key-input');
    if (keyInput) keyInput.value = iaConfig.customApiKey || '';

    // Section "Instructions personnalis茅es" : r茅serv茅e 脿 Aidara, jamais affich茅e 脿 Ida.
    const sectionInstructions = document.getElementById('ia-instructions-section');
    if (sectionInstructions) {
        const estAidara = !!currentUser && currentUser.id === 'aidara';
        sectionInstructions.style.display = estAidara ? 'block' : 'none';
        if (estAidara) {
            const zone = document.getElementById('ia-instructions-textarea');
            if (zone) zone.value = iaConfig.customInstructions || '';
        }
    }
}

function sauvegarderInstructionsIA() {
    if (!currentUser || currentUser.id !== 'aidara') return; // s茅curit茅 suppl茅mentaire c么t茅 UI
    const zone = document.getElementById('ia-instructions-textarea');
    iaConfig.customInstructions = zone ? zone.value.trim() : '';
    sauvegarderIAConfig();
    if (typeof showTempNotification === 'function') {
        showTempNotification("馃捑 Instructions IA enregistr茅es");
    }
}

function toggleIAOption(cle) {
    iaConfig[cle] = !iaConfig[cle];
    sauvegarderIAConfig();
    rafraichirUIParametresIA();
}

function changerTonIA(valeur) {
    iaConfig.tone = valeur;
    sauvegarderIAConfig();
}

function sauvegarderCleIA() {
    const input = document.getElementById('ia-custom-key-input');
    iaConfig.customApiKey = input ? input.value.trim() : '';
    sauvegarderIAConfig();
    if (typeof showTempNotification === 'function') {
        showTempNotification("馃攽 Cl茅 API enregistr茅e et synchronis茅e pour vous deux");
    }
}

function ouvrirParametresIA() {
    const page = document.getElementById('ia-params-page');
    if (page) page.style.display = 'flex';
    rafraichirUIParametresIA();
}
function fermerParametresIA() {
    const page = document.getElementById('ia-params-page');
    if (page) page.style.display = 'none';
}
</script>

</body>   
  
</html>

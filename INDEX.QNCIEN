// FIX ULTIME : STATUTS EN TEMPS R脡EL (100% FONCTIONNEL)
// ============================================================

// 1. Quand l'utilisateur ouvre le chat, marquer tous les messages comme "read"
function markAllAsRead() {
    if (!currentUser || !targetUser) return;
    // 鉁? CORRECTIF D脡FINITIF : cette fonction se d茅clenchait 脿 CHAQUE connexion et 脿
    // CHAQUE scroll n'importe o霉 sur la page, sans aucune condition 鈥? c'茅tait la
    // v茅ritable cause des fausses coches bleues (message marqu茅 "lu" alors que le
    // destinataire n'avait rien vu). Comme sur WhatsApp : on ne marque "lu" que si
    // la page est r茅ellement visible ET qu'on regarde le bas du chat.
    if (document.hidden || !estProcheDuBasDuChat()) return;
    
    db.collection('chats').doc(CHAT_ID).collection('messages')
        .where('senderId', '==', targetUser.id)
        .where('status', '!=', 'read')
        .get()
        .then(snapshot => {
            if (snapshot.empty) return;
            const batch = db.batch();
            snapshot.docs.forEach(doc => {
                batch.update(doc.ref, { 
                    status: 'read',
                    readAt: firebase.firestore.FieldValue.serverTimestamp()
                });
            });
            return batch.commit();
        })
        .catch(err => console.error("Erreur marquage lu:", err));
}

// 2. 脡couter les changements de statut en temps r茅el
function listenStatus() {
    if (!currentUser) return;
    
    db.collection('chats').doc(CHAT_ID).collection('messages')
        .where('senderId', '==', currentUser.id)
        .onSnapshot(snapshot => {
            snapshot.docChanges().forEach(change => {
                if (change.type === 'modified') {
                    const data = change.doc.data();
                    const msgId = change.doc.id;
                    
                    // Chercher le message dans le DOM
                    const row = document.querySelector(`.message-row[data-id="${msgId}"]`);
                    if (!row) return;
                    
                    const meta = row.querySelector('.msg-meta');
                    if (!meta) return;
                    
                    // Garder l'heure uniquement
                    let timeText = meta.textContent;
                    timeText = timeText.replace(/[鉁撯湏鉁揮/g, '').replace(/鉁?/g, '').trim();
                    
                    // Appliquer le bon statut
                    let checkHtml = '';
                    if (data.status === 'read') {
                        checkHtml = `<span class="status-tick" style="color: #53bdeb; margin-left: 3px;"><i class="fa-solid fa-check-double"></i></span>`;
                    } else if (data.status === 'delivered') {
                        checkHtml = `<span class="status-tick" style="color: #8696a0; margin-left: 3px;"><i class="fa-solid fa-check-double"></i></span>`;
                    } else {
                        checkHtml = `<span class="status-tick" style="color: #8696a0; margin-left: 3px;"><i class="fa-solid fa-check"></i></span>`;
                    }
                    
                    meta.innerHTML = timeText + ' ' + checkHtml;
                    console.log(`馃攧 Statut du message ${msgId} : ${data.status}`);
                }
            });
        });
}

// 3. Activer automatiquement
const originalSelect = window.selectUser;
window.selectUser = function(user) {
    originalSelect(user);
    setTimeout(() => {
        markAllAsRead();
        listenStatus();
    }, 1000);
};

// Si d茅j脿 connect茅
setTimeout(() => {
    if (currentUser) {
        markAllAsRead();
        listenStatus();
    }
}, 2000);

// 4. FORCER le marquage "read" quand on voit les messages (scroll ou clique)
document.addEventListener('scroll', function() {
    if (currentUser) markAllAsRead();
});

console.log("鉁? Statuts en temps r茅el activ茅s !");
      
      // =========================================================================
// SOLUTION ULTRA-RAPIDE : MARQUAGE INSTANTAN脡 AVEC CACHE LOCAL
// =========================================================================

// 1. Cache local des statuts de lecture
const STATUTS_CACHE = {
    messages: {},
    lastUpdate: 0,
    
    // Sauvegarder un statut
    set(msgId, status) {
        this.messages[msgId] = {
            status: status,
            time: Date.now()
        };
        this._save();
    },
    
    // R茅cup茅rer un statut
    get(msgId) {
        const entry = this.messages[msgId];
        if (entry && (Date.now() - entry.time) < 60000) { // 1 minute de cache
            return entry.status;
        }
        return null;
    },
    
    // Sauvegarder dans localStorage
    _save() {
        try {
            localStorage.setItem('chat_statuts_cache', JSON.stringify({
                messages: this.messages,
                lastUpdate: Date.now()
            }));
        } catch(e) {}
    },
    
    // Charger depuis localStorage
    load() {
        try {
            const data = localStorage.getItem('chat_statuts_cache');
            if (data) {
                const parsed = JSON.parse(data);
                this.messages = parsed.messages || {};
                this.lastUpdate = parsed.lastUpdate || 0;
            }
        } catch(e) {}
    }
};

// Charger le cache au d茅marrage
STATUTS_CACHE.load();

// 2. MARQUAGE INSTANTAN脡 (sans attendre Firebase)
function marquerMessagesInstantanement() {
    if (!currentUser || !targetUser) return;
    // 鉁? Comme sur WhatsApp : on ne marque "lu" que si la page est visible ET qu'on est
    // positionn茅 en bas du chat (donc qu'on regarde vraiment les messages r茅cents).
    // Avant ce correctif, cette fonction tournait TOUTES LES 5 SECONDES en boucle
    // (voir activerMarquageUltraRapide) sans aucune condition, marquant tout comme lu
    // m锚me onglet en arri猫re-plan 鈥? d'o霉 les fausses coches bleues.
    if (document.hidden || !estProcheDuBasDuChat()) return;
    
    console.log("鈿? Marquage INSTANTAN脡 des messages...");
    
    // R茅cup茅rer TOUS les messages de l'autre personne
    db.collection('chats').doc(CHAT_ID).collection('messages')
        .where('senderId', '==', targetUser.id)
        .orderBy('timestamp', 'desc')
        .limit(50) // Les 50 derniers messages seulement pour la vitesse
        .get()
        .then(snapshot => {
            if (snapshot.empty) return;
            
            const batch = db.batch();
            const toUpdate = [];
            
            snapshot.docs.forEach(doc => {
                const data = doc.data();
                // Marquer comme lu si pas d茅j脿 lu
                if (data.status !== 'read') {
                    batch.update(doc.ref, { 
                        status: 'read',
                        readAt: firebase.firestore.FieldValue.serverTimestamp()
                    });
                    toUpdate.push(doc.id);
                    
                    // Mettre en cache imm茅diatement
                    STATUTS_CACHE.set(doc.id, 'read');
                }
            });
            
            // Mettre 脿 jour l'interface IMM脡DIATEMENT (avant m锚me Firebase)
            toUpdate.forEach(msgId => {
                const messageRow = document.querySelector(`[data-id="${msgId}"]`);
                if (messageRow && messageRow.classList.contains('sent')) {
                    const tickElement = messageRow.querySelector('.status-tick');
                    if (tickElement) {
                        tickElement.innerHTML = `<i class="fa-solid fa-check-double" style="color: #53bdeb !important; font-size: 0.85rem;"></i>`;
                    }
                    updateMessageStatus(msgId, 'read');
                }
            });
            
            // Sauvegarder en base (en arri猫re-plan)
            if (toUpdate.length > 0) {
                batch.commit().then(() => {
                    console.log(`鉁? ${toUpdate.length} messages marqu茅s LUS`);
                }).catch(err => console.error("Erreur batch:", err));
            }
        })
        .catch(err => console.error("Erreur marquage:", err));
}

// 3. AFFICHER LES STATUTS DEPUIS LE CACHE (tr猫s rapide)
function afficherStatutsDepuisCache() {
    if (!currentUser) return;
    
    document.querySelectorAll('.message-row.sent[data-id]').forEach(row => {
        const msgId = row.getAttribute('data-id');
        const cachedStatus = STATUTS_CACHE.get(msgId);
        
        if (cachedStatus === 'read') {
            const tickElement = row.querySelector('.status-tick');
            if (tickElement) {
                tickElement.innerHTML = `<i class="fa-solid fa-check-double" style="color: #53bdeb !important; font-size: 0.85rem;"></i>`;
            }
            updateMessageStatus(msgId, 'read');
        }
    });
}

// 4. 脡COUTE EN TEMPS R脡EL (optimis茅e)
function ecouterStatutsOptimise() {
    if (!currentUser || !targetUser) return;
    
    if (window._statutListener) {
        window._statutListener();
        window._statutListener = null;
    }
    
    window._statutListener = db.collection('chats').doc(CHAT_ID).collection('messages')
        .where('senderId', '==', targetUser.id)
        .onSnapshot((snapshot) => {
            snapshot.docChanges().forEach((change) => {
                if (change.type === 'modified') {
                    const data = change.doc.data();
                    const msgId = change.doc.id;
                    
                    // Mettre 脿 jour le cache
                    if (data.status) {
                        STATUTS_CACHE.set(msgId, data.status);
                    }
                    
                    // Mettre 脿 jour l'interface
                    const messageRow = document.querySelector(`[data-id="${msgId}"]`);
                    if (messageRow && messageRow.classList.contains('sent')) {
                        const tickElement = messageRow.querySelector('.status-tick');
                        if (tickElement) {
                            if (data.status === 'read') {
                                tickElement.innerHTML = `<i class="fa-solid fa-check-double" style="color: #53bdeb !important; font-size: 0.85rem;"></i>`;
                            } else if (data.status === 'delivered') {
                                tickElement.innerHTML = `<i class="fa-solid fa-check-double" style="color: #8696a0 !important; font-size: 0.85rem;"></i>`;
                            }
                        }
                        updateMessageStatus(msgId, data.status);
                    }
                }
            });
        });
}

// 5. FONCTION PRINCIPALE (appel茅e UNE SEULE fois)
function activerMarquageUltraRapide() {
    if (!currentUser || !targetUser) return;
    
    console.log("馃殌 Activation du marquage ULTRA-RAPIDE");
    
    // 脡TAPE 1 : Afficher les statuts depuis le CACHE (0ms - instantan茅)
    afficherStatutsDepuisCache();
    
    // 脡TAPE 2 : Mettre 脿 jour depuis Firebase (en arri猫re-plan)
    setTimeout(() => {
        marquerMessagesInstantanement();
    }, 100);
    
    // 脡TAPE 3 : 脡couter en temps r茅el
    setTimeout(() => {
        ecouterStatutsOptimise();
    }, 500);
    
    // 脡TAPE 4 : Rafra卯chir p茅riodiquement (toutes les 5 secondes)
    if (window._rafraichissementInterval) {
        clearInterval(window._rafraichissementInterval);
    }
    window._rafraichissementInterval = setInterval(() => {
        if (currentUser && targetUser) {
            marquerMessagesInstantanement();
        }
    }, 5000);
}

// 6. D脡TECTION D'ACTIVIT脡 (rapide)
function detecterActiviteRapide() {
    let dernierMarquage = 0;
    
    const marquer = () => {
        const now = Date.now();
        if (now - dernierMarquage > 2000) { // Max toutes les 2 secondes
            dernierMarquage = now;
            marquerMessagesInstantanement();
        }
    };
    
    const events = ['click', 'touchstart', 'scroll', 'keydown', 'focus'];
    events.forEach(event => {
        document.addEventListener(event, marquer, { passive: true });
    });
    
    document.addEventListener('visibilitychange', () => {
        if (!document.hidden) {
            setTimeout(marquerMessagesInstantanement, 200);
        }
    });
}

// 7. SURCHARGER selectUser
const originalSelectUser2 = window.selectUser;
window.selectUser = function(userKey) {
    originalSelectUser2(userKey);
    
    setTimeout(() => {
        activerMarquageUltraRapide();
        detecterActiviteRapide();
    }, 500);
};

// 8. INITIALISATION AU CHARGEMENT
setTimeout(() => {
    if (currentUser && targetUser) {
        console.log("馃攧 D茅marrage rapide - utilisateur d茅j脿 connect茅");
        activerMarquageUltraRapide();
        detecterActiviteRapide();
    }
}, 300);

// 9. FORCER APR脠S CHARGEMENT COMPLET
window.addEventListener('load', function() {
    setTimeout(() => {
        if (currentUser && targetUser) {
            console.log("馃摫 Chargement complet - Marquage final");
            marquerMessagesInstantanement();
        }
    }, 1000);
});

// 10. VIDER LE CACHE SI TROP VIEUX (plus de 10 minutes)
const CACHE_AGE_MAX = 10 * 60 * 1000; // 10 minutes
if (STATUTS_CACHE.lastUpdate && (Date.now() - STATUTS_CACHE.lastUpdate) > CACHE_AGE_MAX) {
    STATUTS_CACHE.messages = {};
    STATUTS_CACHE._save();
    console.log("馃Ч Cache des statuts vid茅 (trop vieux)");
}

console.log("鉁? Marquage ULTRA-RAPIDE activ茅 !");
      

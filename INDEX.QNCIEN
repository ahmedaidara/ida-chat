                <i class="fa-solid fa-ellipsis-vertical" style="cursor:pointer; margin-right:8px; font-size:1.2rem;" onclick="toggleToolsMenu()" id="tools-menu-btn"></i>
                <textarea class="chat-input" id="chat-in" placeholder="Message..." oninput="handleTyping(); autoResizeTextarea()" rows="1" form="aucun-formulaire-chat-in" autocomplete="off" autocorrect="off" spellcheck="false"></textarea>
             <div class="input-actions" id="in-actions" style="display: flex; gap: 12px;">
    <i class="fa-solid fa-language" id="translate-btn" style="display: none;"></i>
    <i class="fa-solid fa-lock" id="code-mode-btn" style="display: none;"></i>
    <i class="fa-solid fa-head-side-headphones" id="ephemeral-audio-btn" onclick="toggleEphemeralAudioModeDirect()" style="cursor:pointer; font-size:1.2rem;" title="Audio 茅ph茅m猫re"></i>
                 <i class="fa-solid fa-image" id="media-btn" onclick="ouvrirMenuMedia()" style="cursor:pointer; font-size:1.3rem;" title="Photo/Vid茅o/Galerie"></i>
    <i class="fa-solid fa-microphone" id="audio-btn" onclick="ouvrirMenuAudio()" style="cursor:pointer; font-size:1.3rem;" title="Message vocal avec effets"></i>
                       <!-- ========== NOUVEAU : TIROIR GIPHY ========== -->
        <div id="giphy-drawer" style="display: none; position: absolute; bottom: 75px; left: 10px; right: 10px; background: var(--bg-main); border-radius: 20px; box-shadow: 0 5px 25px rgba(0,0,0,0.2); padding: 12px; z-index: 4000; max-height: 350px; flex-direction: column; border: 1px solid var(--border-color);">
            <div style="display: flex; gap: 8px; margin-bottom: 12px;">
                <input type="text" id="giphy-search" placeholder="馃攳 Rechercher GIF, sticker ou emoji..." style="flex: 1; padding: 10px 15px; border-radius: 25px; border: 1px solid var(--border-color); background: var(--input-bg); color: var(--text-main); outline: none; font-size: 0.9rem;">
                <button id="btn-toggle-type" style="background: #f0f2f5; border: none; padding: 0 20px; border-radius: 25px; font-weight: bold; font-size: 0.8rem; cursor: pointer; color: #000;">馃帹 GIFS</button>
            </div>
            <div id="giphy-results" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; overflow-y: auto; max-height: 260px; padding: 5px;"></div>
        </div>
        
</div>
                <span id="send-btn" onclick="sendTextMessage()"><i class="fa-regular fa-paper-plane"></i></span>
            </div>
            
<div class="floating-panel" id="tools-panel">
    <div style="display: flex; flex-direction: column; gap: 15px;">
        <h4 style="margin-bottom: 5px; font-size: 0.9rem; color: var(--text-muted);">Outils</h4>
        <!-- Premi猫re ligne -->
        <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 15px; text-align: center;">
            <div class="tool-item" onclick="toggleRecording(); closeToolsPanel();"><i class="fa-solid fa-microphone" style="font-size: 1.8rem;"></i><span style="font-size: 0.7rem;">Micro</span></div>
            <div class="tool-item" onclick="triggerImageUpload(); closeToolsPanel();"><i class="fa-regular fa-image" style="font-size: 1.8rem;"></i><span style="font-size: 0.7rem;">Galerie</span></div>
             
            <div class="tool-item" onclick="toggleEphemeralAudioMode(); closeToolsPanel();"><i class="fa-solid fa-head-side-headphones" style="font-size: 1.8rem;"></i><span style="font-size: 0.7rem;">Audio 脡ph</span></div>
        </div>
        <!-- Deuxi猫me ligne -->
        <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 15px; text-align: center;">
            <div class="tool-item" onclick="toggleTheme(); closeToolsPanel();"><i class="fa-solid fa-moon" style="font-size: 1.8rem;"></i><span style="font-size: 0.7rem;">Th猫me</span></div>
        </div>
        <div class="tools-divider" style="height: 1px; background: var(--border-color); margin: 5px 0;"></div>
        <!-- Troisi猫me ligne (avec les bons IDs) -->
        <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 15px; text-align: center;">
            <div class="tool-item" id="translate-menu-btn" onclick="toggleTranslateMenuDirect(event); closeToolsPanel();"><i class="fa-solid fa-language" style="font-size: 1.8rem;"></i><span style="font-size: 0.7rem;">Traduire</span></div>
            <div class="tool-item" id="code-mode-btn-menu" onclick="toggleCodeModeDirect(); closeToolsPanel();"><i class="fa-solid fa-lock" style="font-size: 1.8rem;"></i><span style="font-size: 0.7rem;">Code</span></div>
            <div class="tool-item" onclick="toggleBlurMode(); closeToolsPanel();"><i class="fa-solid fa-eye-slash" style="font-size: 1.8rem;"></i><span style="font-size: 0.7rem;">Mode Flou</span></div>
            <div class="tool-item" onclick="triggerPenseAToi(); closeToolsPanel();"><i class="fa-solid fa-heart" style="font-size: 1.8rem; color:#ff2d55;"></i><span style="font-size: 0.7rem;">Pense 脿 toi</span></div>
        </div>
        <div class="tools-divider" style="height: 1px; background: var(--border-color); margin: 5px 0;"></div>
        <!-- Quatri猫me ligne : romance & organisation -->
        <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 15px; text-align: center;">
            <div class="tool-item" onclick="envoyerSOSCalin(); closeToolsPanel();"><i class="fa-solid fa-hand-holding-heart" style="font-size: 1.8rem; color:#ff2d55;"></i><span style="font-size: 0.7rem;">SOS C芒lin</span></div>
            <div class="tool-item" onclick="ouvrirMenuCadeauVirtuel(); closeToolsPanel();"><i class="fa-solid fa-gift" style="font-size: 1.8rem; color:#a855f7;"></i><span style="font-size: 0.7rem;">Cadeau</span></div>
            <div class="tool-item" onclick="ouvrirLettreProgrammee(); closeToolsPanel();"><i class="fa-solid fa-envelope-open-text" style="font-size: 1.8rem; color:#0ea5e9;"></i><span style="font-size: 0.7rem;">Lettre</span></div>
            <div class="tool-item" onclick="ouvrirTresorCache(); closeToolsPanel();"><i class="fa-solid fa-map-location-dot" style="font-size: 1.8rem; color:#d97706;"></i><span style="font-size: 0.7rem;">Tr茅sor</span></div>
        </div>
        <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 15px; text-align: center;">
            <div class="tool-item" onclick="ouvrirRecettesADeux(); closeToolsPanel();"><i class="fa-solid fa-utensils" style="font-size: 1.8rem; color:#16a34a;"></i><span style="font-size: 0.7rem;">Recettes</span></div>
        </div>
    </div>
</div>
            
            <div class="translate-dropdown" id="translate-dropdown">
                <div class="translate-option" onclick="translateInputText('en')"><span class="flag">馃嚞馃嚙</span><span class="lang-name">Anglais</span></div>
                <div class="translate-option" onclick="translateInputText('ar')"><span class="flag">馃嚫馃嚘</span><span class="lang-name">Arabe</span></div>
                <div class="translate-option" onclick="translateInputText('es')"><span class="flag">馃嚜馃嚫</span><span class="lang-name">Espagnol</span></div>
                <div class="translate-option" onclick="translateInputText('ja')"><span class="flag">馃嚡馃嚨</span><span class="lang-name">Japonais</span></div>
                <div class="translate-option" style="border-top: 1px solid var(--border-color); margin-top: 5px;" onclick="toggleCodeMode()"><span class="flag">馃敀</span><span class="lang-name">Coder le message</span></div>
                <div class="translate-option" onclick="toggleEphemeralAudioMode()"><span class="flag">馃帣锔?</span><span class="lang-name">Audio 脡ph茅m猫re</span></div>
            </div>
            
            <input type="file" id="img-file" accept="image/*" style="display:none;" onchange="uploadImage(this)">
        </div>

        <div class="floating-panel" id="emoji-panel">
            <div class="emoji-grid">
                <span onclick="insertEmoji('馃榾')">馃榾</span><span onclick="insertEmoji('馃槀')">馃槀</span><span onclick="insertEmoji('鉂わ笍')">鉂わ笍</span><span onclick="insertEmoji('馃敟')">馃敟</span>
                <span onclick="insertEmoji('馃憤')">馃憤</span><span onclick="insertEmoji('馃帀')">馃帀</span><span onclick="insertEmoji('馃槩')">馃槩</span><span onclick="insertEmoji('馃槷')">馃槷</span>
            </div>
        </div>


      <div class="context-menu" id="ctx-menu">

function ouvrirVraiFaux() {
    fermerMenuJeux();
    vfIndex = Math.floor(Math.random() * AFFIRMATIONS_VF.length);
    document.getElementById('vf-affirmation').textContent = AFFIRMATIONS_VF[vfIndex];
    document.getElementById('vf-modal').style.display = 'flex';
}
function fermerVraiFaux() {
    document.getElementById('vf-modal').style.display = 'none';
}
function repondreVraiFaux(reponse) {
    envoyerMessageSimple(`馃 Vrai ou Faux sur nous : "${AFFIRMATIONS_VF[vfIndex]}" 鈫? ${currentUser.name} r茅pond : ${reponse} !`);
    let nouvelIndex;
    do { nouvelIndex = Math.floor(Math.random() * AFFIRMATIONS_VF.length); } while (nouvelIndex === vfIndex && AFFIRMATIONS_VF.length > 1);
    vfIndex = nouvelIndex;
    document.getElementById('vf-affirmation').textContent = AFFIRMATIONS_VF[vfIndex];
}

// ========== REGARDER ENSEMBLE (lecteur vid茅o synchronis茅) ==========
// Alternative au partage d'茅cran classique : celui-ci fonctionne aussi sur iPhone,
// car il ne d茅pend PAS de l'API de capture d'茅cran (bloqu茅e par Apple sur iOS),
// juste d'un lien vid茅o (YouTube ou .mp4) synchronis茅 en temps r茅el via Firestore.
// Le partage d'茅cran existant (PC) reste inchang茅 et disponible 脿 c么t茅.
let watchYTPlayer = null;
let watchIgnoreEcho = false;
let watchUnsubscribe = null;

function ouvrirRegarderEnsemble() {
    document.getElementById('watch-url-input').value = '';
    verifierSessionRegarderExistante();
    document.getElementById('watch-modal').style.display = 'flex';
}
function fermerModalRegarder() {
    document.getElementById('watch-modal').style.display = 'none';
}

async function verifierSessionRegarderExistante() {
    const zone = document.getElementById('watch-session-banner-zone');
    zone.innerHTML = '';
    try {
        const doc = await db.collection('chats').doc(CHAT_ID).collection('watch_together').doc('session').get();
        if (doc.exists && doc.data().active) {
            const banner = document.createElement('div');
            banner.className = 'watch-session-banner';
            banner.innerHTML = `Une session est d茅j脿 en cours 馃幀<br><button class="watch-btn-primary" style="margin-top:8px;" onclick="rejoindreSessionRegarder()">Rejoindre</button>`;
            zone.appendChild(banner);
        }
    } catch(e) { console.error(e); }
}

function extraireIdYoutube(url) {
    const m = url.match(/(?:youtube\.com\/(?:watch\?v=|embed\/|shorts\/)|youtu\.be\/)([a-zA-Z0-9_-]{11})/);
    return m ? m[1] : null;
}

async function demarrerSessionRegarder() {
    const url = document.getElementById('watch-url-input').value.trim();
    if (!url) { showTempNotification("Colle un lien vid茅o d'abord"); return; }
    const ytId = extraireIdYoutube(url);
    const data = {
        url: url,
        type: ytId ? 'youtube' : 'video',
        ytId: ytId || null,
        playing: true,
        seekTime: 0,
        updatedBy: currentUser.id,
        updatedAt: firebase.firestore.FieldValue.serverTimestamp(),
        active: true
    };
    await db.collection('chats').doc(CHAT_ID).collection('watch_together').doc('session').set(data);
    envoyerMessageSimple(`馃幀 ${currentUser.name} a lanc茅 une vid茅o 脿 regarder ensemble !`);
    fermerModalRegarder();
    ouvrirLecteurRegarder(data);
    ecouterSessionRegarder();
}

async function rejoindreSessionRegarder() {
    const doc = await db.collection('chats').doc(CHAT_ID).collection('watch_together').doc('session').get();
    if (!doc.exists) { showTempNotification('Aucune session en cours'); return; }
    fermerModalRegarder();
    ouvrirLecteurRegarder(doc.data());
    ecouterSessionRegarder();
}

function ouvrirLecteurRegarder(data) {
    document.getElementById('watch-overlay').classList.add('show');
    const ytDiv = document.getElementById('watch-yt-player');
    const videoEl = document.getElementById('watch-video-el');
    if (data.type === 'youtube') {
        videoEl.style.display = 'none';
        ytDiv.style.display = 'block';
        creerLecteurYoutube(data.ytId, data.seekTime || 0, data.playing);
    } else {
        ytDiv.style.display = 'none';
        videoEl.style.display = 'block';
        videoEl.src = data.url;
        videoEl.currentTime = data.seekTime || 0;
        if (data.playing) videoEl.play().catch(()=>{});
        attacherEvenementsVideoRegarder(videoEl);
    }
}

function creerLecteurYoutube(ytId, startTime, autoplay) {
    if (typeof YT === 'undefined' || !YT.Player) {
        setTimeout(() => creerLecteurYoutube(ytId, startTime, autoplay), 400);
        return;
    }
    if (watchYTPlayer) { try { watchYTPlayer.destroy(); } catch(e) {} }
    watchYTPlayer = new YT.Player('watch-yt-player', {
        videoId: ytId,
        playerVars: { playsinline: 1, start: Math.floor(startTime || 0), autoplay: autoplay ? 1 : 0 },
        events: {
            onStateChange: (e) => {
                if (watchIgnoreEcho) return;
                if (e.data === YT.PlayerState.PLAYING) envoyerEtatRegarder(true, watchYTPlayer.getCurrentTime());
                else if (e.data === YT.PlayerState.PAUSED) envoyerEtatRegarder(false, watchYTPlayer.getCurrentTime());
            }
        }
    });
}

function attacherEvenementsVideoRegarder(videoEl) {
    videoEl.onplay = () => { if (!watchIgnoreEcho) envoyerEtatRegarder(true, videoEl.currentTime); };
    videoEl.onpause = () => { if (!watchIgnoreEcho) envoyerEtatRegarder(false, videoEl.currentTime); };
    videoEl.onseeked = () => { if (!watchIgnoreEcho) envoyerEtatRegarder(!videoEl.paused, videoEl.currentTime); };
}

async function envoyerEtatRegarder(playing, seekTime) {
    await db.collection('chats').doc(CHAT_ID).collection('watch_together').doc('session').update({
        playing, seekTime, updatedBy: currentUser.id, updatedAt: firebase.firestore.FieldValue.serverTimestamp()
    });
}

function ecouterSessionRegarder() {
    if (watchUnsubscribe) watchUnsubscribe();
    watchUnsubscribe = db.collection('chats').doc(CHAT_ID).collection('watch_together').doc('session')
        .onSnapshot((doc) => {
            if (!doc.exists) return;
            const data = doc.data();
            if (!data.active) { quitterRegarderEnsemble(); return; }
            if (data.updatedBy === currentUser.id) return;

            watchIgnoreEcho = true;
            if (data.type === 'youtube' && watchYTPlayer && watchYTPlayer.getCurrentTime) {
                const diff = Math.abs(watchYTPlayer.getCurrentTime() - data.seekTime);
                if (diff > 1.5) watchYTPlayer.seekTo(data.seekTime, true);
                if (data.playing) watchYTPlayer.playVideo(); else watchYTPlayer.pauseVideo();
            } else if (data.type !== 'youtube') {
                const videoEl = document.getElementById('watch-video-el');
                const diff = Math.abs(videoEl.currentTime - data.seekTime);
                if (diff > 1.5) videoEl.currentTime = data.seekTime;
                if (data.playing) videoEl.play().catch(()=>{}); else videoEl.pause();
            }
            setTimeout(() => { watchIgnoreEcho = false; }, 400);
        });
}

async function quitterRegarderEnsemble() {
    document.getElementById('watch-overlay').classList.remove('show');
    if (watchYTPlayer) { try { watchYTPlayer.destroy(); } catch(e) {} watchYTPlayer = null; }
    const videoEl = document.getElementById('watch-video-el');
    if (videoEl) { videoEl.pause(); videoEl.src = ''; }
    if (watchUnsubscribe) { watchUnsubscribe(); watchUnsubscribe = null; }
}

// ================================================================
// LOT 2 : BUCKET-LIST, FAVORIS, NOTES PARTAG脡ES, CALENDRIER 脌 DEUX
// Tout est stock茅 dans Firestore (chats/{CHAT_ID}/...) et synchronis茅
// en temps r茅el entre les deux t茅l茅phones, comme le reste de l'app.
// ================================================================

// ---------- BUCKET LIST ----------
let bucketListUnsub = null;
function ouvrirBucketList() {
    document.getElementById('bucket-modal').style.display = 'flex';
    if (bucketListUnsub) bucketListUnsub();
    bucketListUnsub = db.collection('chats').doc(CHAT_ID).collection('bucket_list')
        .orderBy('createdAt', 'desc')
        .onSnapshot((snap) => {
            const cont = document.getElementById('bucket-list-items');
            cont.innerHTML = '';
            if (snap.empty) { cont.innerHTML = '<p style="color:var(--text-muted); font-size:0.85rem;">Rien pour l\'instant. Ajoute une id茅e 鉁?</p>'; return; }
            snap.forEach(doc => {
                const d = doc.data();
                const dateModifStr = formaterDateModif(d.noteModifiee);
                const item = document.createElement('div');
                item.className = 'liste-item' + (d.done ? ' liste-item-done' : '');
                item.innerHTML = `
                    <div class="liste-item-check" onclick="toggleBucketItem('${doc.id}', ${!d.done})"><i class="fa-solid ${d.done ? 'fa-circle-check' : 'fa-circle'}"></i></div>
                    <div class="liste-item-texte" style="cursor:pointer;" onclick="ouvrirNoteBucketPleinEcran('${doc.id}')">
                        <div>${escapeHtmlTexte(d.text)}</div>
                        ${d.note ? `<div class="liste-item-note">馃摑 ${escapeHtmlTexte(d.note)}</div>` : `<div class="liste-item-note" style="opacity:0.6;">Toucher pour 茅crire un souvenir...</div>`}
                        ${dateModifStr ? `<div class="liste-item-date-modif">Modifi茅 le ${dateModifStr}</div>` : ''}
                    </div>
                    <div class="liste-item-actions">
                        <i class="fa-solid fa-trash" onclick="supprimerBucketItem('${doc.id}')" title="Supprimer"></i>
                    </div>`;
                cont.appendChild(item);
            });
        });
}
function fermerBucketList() {
    document.getElementById('bucket-modal').style.display = 'none';
    if (bucketListUnsub) { bucketListUnsub(); bucketListUnsub = null; }
}
async function ajouterBucketItem() {
    const input = document.getElementById('bucket-input');
    const text = input.value.trim();
    if (!text) return;
    await db.collection('chats').doc(CHAT_ID).collection('bucket_list').add({
        text, done: false, note: '', noteModifiee: null, createdBy: currentUser.id, createdByName: currentUser.name,
        createdAt: firebase.firestore.FieldValue.serverTimestamp()
    });
    input.value = '';
}
async function toggleBucketItem(id, done) {
    await db.collection('chats').doc(CHAT_ID).collection('bucket_list').doc(id).update({ done });
}
async function ouvrirNoteBucketPleinEcran(id) {
    const doc = await db.collection('chats').doc(CHAT_ID).collection('bucket_list').doc(id).get();
    const d = doc.data();
    if (!d) return;
    ouvrirEditeurPleinEcran({
        titre: d.text,
        collection: 'bucket_list',
        docId: id,
        champTexte: 'note',
        champDate: 'noteModifiee',
        valeurActuelle: d.note || '',
        dateModif: d.noteModifiee,
        placeholder: '脡cris ici tout ce que tu veux garder de ce souvenir...'
    });
}
async function supprimerBucketItem(id) {
    if (!confirm("Supprimer cet 茅l茅ment de la bucket list ?")) return;
    try {
        await db.collection('chats').doc(CHAT_ID).collection('bucket_list').doc(id).delete();
    } catch (e) {
        console.error("Suppression bucket list impossible :", e);
        if (typeof showTempNotification === 'function') showTempNotification("鉂? Suppression impossible (droits Firestore ?)");
    }
}

// ---------- FAVORIS ----------
async function ajouterMessageFavoris() {
    if (!selectedMessageId) return;
    const row = document.querySelector(`[data-id="${selectedMessageId}"]`);
    const texte = obtenirTexteCompletMessage(row);
    await db.collection('chats').doc(CHAT_ID).collection('favoris').add({
        messageId: selectedMessageId, text: texte,
        addedBy: currentUser.id, addedByName: currentUser.name,
        addedAt: firebase.firestore.FieldValue.serverTimestamp()
    });
    showTempNotification('猸? Ajout茅 aux favoris');
    document.getElementById('ctx-menu').style.display = 'none';
    selectedMessageId = null;
}
let favorisUnsub = null;
function ouvrirFavorisPage() {
    document.getElementById('favoris-modal').style.display = 'flex';
    if (favorisUnsub) favorisUnsub();
    favorisUnsub = db.collection('chats').doc(CHAT_ID).collection('favoris')
        .orderBy('addedAt', 'desc')
        .onSnapshot((snap) => {
            const contMoi = document.getElementById('favoris-liste-moi');
            const contAutre = document.getElementById('favoris-liste-autre');
            contMoi.innerHTML = ''; contAutre.innerHTML = '';
            let videMoi = true, videAutre = true;
            snap.forEach(doc => {
                const d = doc.data();
                const dateStr = formaterDateModif(d.addedAt);
                const item = document.createElement('div');
                item.className = 'liste-item';
                item.innerHTML = `<div class="liste-item-texte" style="cursor:pointer;" onclick="naviguerVersMessageFavori('${(d.messageId || '').replace(/'/g, "\\'")}')">
                        <div>${escapeHtmlTexte(d.text)}</div>
                        ${dateStr ? `<div class="liste-item-date-modif">${dateStr}</div>` : ''}
                    </div>
                    <div class="liste-item-actions"><i class="fa-solid fa-trash" onclick="event.stopPropagation(); supprimerFavori('${doc.id}')"></i></div>`;
                if (d.addedBy === currentUser.id) { contMoi.appendChild(item); videMoi = false; }
                else { contAutre.appendChild(item); videAutre = false; }
            });
            if (videMoi) contMoi.innerHTML = '<p style="color:var(--text-muted); font-size:0.8rem;">Aucun favori</p>';
            if (videAutre) contAutre.innerHTML = '<p style="color:var(--text-muted); font-size:0.8rem;">Aucun favori</p>';
            document.getElementById('favoris-titre-moi').textContent = currentUser ? currentUser.name : 'Moi';
            document.getElementById('favoris-titre-autre').textContent = targetUser ? targetUser.name : "L'autre";
        });
}
function naviguerVersMessageFavori(msgId) {
    fermerFavorisPage();
    setTimeout(() => {
        const row = document.querySelector(`#msg-area [data-id="${msgId}"]`);
        if (!row) {
            showTempNotification("鈿狅笍 Ce message est introuvable (probablement supprim茅)");
            return;
        }
        row.scrollIntoView({ behavior: 'smooth', block: 'center' });
        const bulle = row.querySelector('.message-bubble');
        if (bulle) {
            bulle.classList.remove('msg-flash-highlight');
            void bulle.offsetWidth;
            bulle.classList.add('msg-flash-highlight');
            setTimeout(() => bulle.classList.remove('msg-flash-highlight'), 1200);
        }
    }, 250);
}
function fermerFavorisPage() {
    document.getElementById('favoris-modal').style.display = 'none';
    if (favorisUnsub) { favorisUnsub(); favorisUnsub = null; }
}
async function supprimerFavori(id) {
    await db.collection('chats').doc(CHAT_ID).collection('favoris').doc(id).delete();
}


// ============================================================
// 鉁? RECHERCHE DANS LA CONVERSATION (ic么ne loupe du header)
// ============================================================
let rechercheMessagesCache = null; // tous les messages texte, charg茅s une seule fois par ouverture
let rechercheChargementEnCours = false;

function echapperRegex(str) {
    return str.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
}

function formatHeureRecherche(timestamp) {
    if (!timestamp) return '';
    const d = timestamp.toDate ? timestamp.toDate() : new Date(timestamp);
    const jour = d.toLocaleDateString('fr-FR', { day: '2-digit', month: '2-digit', year: '2-digit' });
    const heure = d.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' });
    return `${jour} 路 ${heure}`;
}

async function ouvrirRecherchePage() {
    const page = document.getElementById('search-page');
    page.style.display = 'flex';
    document.getElementById('search-page-input').value = '';
    document.getElementById('search-clear-btn').style.display = 'none';
    document.getElementById('search-counts').style.display = 'none';
    document.getElementById('search-results').innerHTML = `
        <div class="search-empty-state">
            <i class="fa-solid fa-magnifying-glass"></i>
            <p>Tape un mot ou une expression pour chercher dans toute la conversation</p>
        </div>
    `;
    setTimeout(() => document.getElementById('search-page-input').focus(), 300);

    // Recherche "aveugle" : on charge TOUT l'historique une seule fois par ouverture de la
    // page (le chat principal, lui, n'affiche que les 50 derniers messages), pour pouvoir
    // retrouver n'importe quel message, m锚me ancien.
    if (!CHAT_ID || !currentUser) return;
    rechercheChargementEnCours = true;
    try {
        const snapshot = await db.collection('chats').doc(CHAT_ID).collection('messages')
            .orderBy('timestamp', 'asc')
            .get();
        rechercheMessagesCache = snapshot.docs;
    } catch (err) {
        console.error("Erreur chargement recherche:", err);
        rechercheMessagesCache = [];
    }
    rechercheChargementEnCours = false;
}

function fermerRecherchePage() {
    document.getElementById('search-page').style.display = 'none';
}

// ============================================================
// 鉁? GALERIE M脡DIA (Param猫tres 鈫? M茅dia) 鈥? toutes les photos/vid茅os du chat
// ============================================================
function afficherMediaGalerieDepuisListe(liste, index) {
    mediaGalerieListe = liste;
    afficherMediaGalerie(index);
}

async function ouvrirGalerieMediaPage() {
    const page = document.getElementById('media-gallery-page');
    const grid = document.getElementById('media-gallery-grid');
    page.style.display = 'flex';
    grid.innerHTML = `<div class="search-empty-state" style="grid-column:1/-1;"><i class="fa-solid fa-spinner fa-spin"></i><p>Chargement des m茅dias...</p></div>`;

    try {
        const snapshot = await db.collection('chats').doc(CHAT_ID).collection('messages')
            .orderBy('timestamp', 'asc')
            .get();

        const medias = [];
        snapshot.forEach(doc => {
            const data = doc.data();
            // R猫gle stricte : tout ce qui vient de l'onglet GIF/Sticker/Emoji (isGif ou
            // isSticker) est INTERDIT dans la galerie M茅dias, quel que soit son type.
            const estUnGifOuSticker = data.isSticker === true || data.isGif === true ||
                (data.mediaUrl && (data.mediaUrl.includes('emoji-datasource-apple') || data.mediaUrl.includes('tenor.com')));
            if ((data.type === 'image' || data.type === 'video') && !data.viewOnce && data.mediaUrl && !estUnGifOuSticker) {
                medias.push({ msgId: doc.id, type: data.type, url: data.mediaUrl });
            } else if (data.type === 'media_group' && Array.isArray(data.items)) {
                data.items.forEach((item, i) => {
                    medias.push({ msgId: doc.id + '_' + i, type: item.type, url: item.url });
                });
            }
        });

        if (medias.length === 0) {
            grid.innerHTML = `<div class="search-empty-state" style="grid-column:1/-1;"><i class="fa-regular fa-images"></i><p>Aucune photo ni vid茅o dans cette conversation</p></div>`;
            return;
        }

        // Affichage le plus r茅cent en premier, fa莽on galerie WhatsApp
        window.__galerieMediaComplete = medias; // 茅vite d'injecter du JSON dans les attributs onclick
        const mediasRecentDabord = medias.slice().reverse();
        grid.innerHTML = mediasRecentDabord.map((m, i) => {
            const indexDansListeChrono = medias.length - 1 - i; // index correspondant dans "medias" (ordre chronologique, utilis茅 par le visualiseur)
            if (m.type === 'video') {
                return `<div class="media-gallery-item" onclick="afficherMediaGalerieDepuisListe(window.__galerieMediaComplete, ${indexDansListeChrono})">
                    <video src="${m.url}" preload="metadata"></video>
                    <i class="fa-solid fa-play media-gallery-video-icon"></i>
                </div>`;
            }
            return `<div class="media-gallery-item" onclick="afficherMediaGalerieDepuisListe(window.__galerieMediaComplete, ${indexDansListeChrono})">
                    <img src="${m.url}" loading="lazy">
                </div>`;
        }).join('');
    } catch (err) {
        console.error("Erreur chargement galerie m茅dia:", err);
        grid.innerHTML = `<div class="search-empty-state" style="grid-column:1/-1;"><i class="fa-solid fa-triangle-exclamation"></i><p>Erreur de chargement</p></div>`;
    }
}

function fermerGalerieMediaPage() {
    document.getElementById('media-gallery-page').style.display = 'none';
}

// ============================================================
// 鉁? GALERIE DOCUMENTS (Param猫tres 鈫? Document) 鈥? tous les fichiers du chat
// ============================================================
async function ouvrirGalerieDocumentsPage() {
    const page = document.getElementById('documents-gallery-page');
    const liste = document.getElementById('documents-gallery-list');
    page.style.display = 'flex';
    liste.innerHTML = `<div class="search-empty-state"><i class="fa-solid fa-spinner fa-spin"></i><p>Chargement des documents...</p></div>`;

    try {
        const snapshot = await db.collection('chats').doc(CHAT_ID).collection('messages')
            .orderBy('timestamp', 'desc')
            .get();

        const docs = [];
        snapshot.forEach(doc => {
            const data = doc.data();
            if (data.type === 'document' && data.mediaUrl) {
                docs.push({ msgId: doc.id, ...data });
            }
        });

        if (docs.length === 0) {
            liste.innerHTML = `<div class="search-empty-state"><i class="fa-solid fa-file-lines"></i><p>Aucun document dans cette conversation</p></div>`;
            return;
        }

        liste.innerHTML = docs.map(d => {
            const ext = d.fileExt || (d.fileName || '').split('.').pop().toLowerCase();
            const icone = icoenPourExtensionDoc(ext);
            const couleur = couleurPourExtensionDoc(ext);
            const dateHeure = formatHeureRecherche(d.timestamp);
            return `
                <div class="doc-gallery-row">
                    <div class="doc-gallery-icon" style="background:${couleur};"><i class="fa-solid ${icone}"></i></div>
                    <div class="doc-gallery-info" onclick="ouvrirDocumentIntelligent('${d.mediaUrl}', '${ext}')">
                        <div class="doc-gallery-name">${escapeHTML(d.fileName || 'Document')}</div>
                        <div class="doc-gallery-meta">${ext.toUpperCase()} 路 ${formaterTailleFichier(d.fileSize)} 路 ${dateHeure}</div>
                    </div>
                    <i class="fa-solid fa-reply doc-gallery-action" onclick="repondreDepuisGalerieDocuments('${d.msgId}')" title="R茅pondre"></i>
                </div>
            `;
        }).join('');
    } catch (err) {
        console.error("Erreur chargement galerie documents:", err);
        liste.innerHTML = `<div class="search-empty-state"><i class="fa-solid fa-triangle-exclamation"></i><p>Erreur de chargement</p></div>`;
    }
}

function fermerGalerieDocumentsPage() {
    document.getElementById('documents-gallery-page').style.display = 'none';
}

function repondreDepuisGalerieDocuments(msgId) {
    fermerGalerieDocumentsPage();
    closeSettingsPage();
    selectedMessageId = msgId;
    initiateReply();
}

function viderRechercheMessages() {
    const input = document.getElementById('search-page-input');
    input.value = '';
    document.getElementById('search-clear-btn').style.display = 'none';
    document.getElementById('search-counts').style.display = 'none';
    document.getElementById('search-results').innerHTML = `
        <div class="search-empty-state">
            <i class="fa-solid fa-magnifying-glass"></i>
            <p>Tape un mot ou une expression pour chercher dans toute la conversation</p>
        </div>
    `;
    input.focus();
}

function surlignerTexteRecherche(texte, requete) {
    const echappe = escapeHTML(texte);
    const echappeRequete = escapeHTML(requete);
    const regex = new RegExp(echapperRegex(echappeRequete), 'gi');
    return echappe.replace(regex, (m) => `<mark>${m}</mark>`);
}

function lancerRechercheMessages() {
    const input = document.getElementById('search-page-input');
    const requete = input.value.trim();
    const resultsEl = document.getElementById('search-results');
    const countsEl = document.getElementById('search-counts');
    document.getElementById('search-clear-btn').style.display = requete ? 'block' : 'none';

    if (!requete) {
        countsEl.style.display = 'none';
        resultsEl.innerHTML = `
            <div class="search-empty-state">
                <i class="fa-solid fa-magnifying-glass"></i>
                <p>Tape un mot ou une expression pour chercher dans toute la conversation</p>
            </div>
        `;
        return;
    }

    if (rechercheChargementEnCours || !rechercheMessagesCache) {
        resultsEl.innerHTML = `<div class="search-empty-state"><i class="fa-solid fa-spinner fa-spin"></i><p>Chargement de la conversation...</p></div>`;
        setTimeout(lancerRechercheMessages, 200);
        return;
    }

    const requeteLower = requete.toLowerCase();
    let compteIda = 0;
    let compteAidara = 0;
    const resultats = [];

    rechercheMessagesCache.forEach(doc => {
        const data = doc.data();
        if (typeof data.text !== 'string' || !data.text) return;
        if (data.isSecretMessage) return; // ne pas indexer les messages cod茅s/masqu茅s (5432 etc.)
        const texteLower = data.text.toLowerCase();
        if (!texteLower.includes(requeteLower)) return;

        // Compte le nombre d'occurrences (pas juste de messages) pour chaque exp茅diteur
        const occurrences = texteLower.split(requeteLower).length - 1;
        if (data.senderId === 'ida') compteIda += occurrences;
        else if (data.senderId === 'aidara') compteAidara += occurrences;

        resultats.push({ id: doc.id, data });
    });

    // Compteurs par personne
    document.getElementById('search-count-ida').textContent = compteIda;
    document.getElementById('search-count-aidara').textContent = compteAidara;
    countsEl.style.display = 'flex';

    // R茅sultats, du plus r茅cent au plus ancien
    resultats.reverse();

    if (resultats.length === 0) {
        resultsEl.innerHTML = `<div class="search-empty-state"><i class="fa-solid fa-magnifying-glass"></i><p>Aucun r茅sultat pour 芦 ${escapeHTML(requete)} 禄</p></div>`;
        return;
    }

    resultsEl.innerHTML = resultats.map(r => {
        const nomExpediteur = r.data.senderId === 'ida' ? 'Ida' : (r.data.senderId === 'aidara' ? 'Aidara' : (r.data.senderName || '?'));
        const estMoi = r.data.senderId === currentUser.id;
        const dateHeure = formatHeureRecherche(r.data.timestamp);
        const texteSurligne = surlignerTexteRecherche(r.data.text, requete);
        return `
            <div class="search-result-item" onclick="allerAuMessageDepuisRecherche('${r.id}')">
                <div class="search-result-meta">
                    <span class="search-result-sender ${estMoi ? 'is-me' : ''}">${nomExpediteur}</span>
                    <span>${dateHeure}</span>
                </div>
                <div class="search-result-text">${texteSurligne}</div>
            </div>
        `;
    }).join('');
}

// Fait d茅filer jusqu'au message choisi et l'illumine bri猫vement, m锚me s'il n'est pas
// dans les 50 derniers messages actuellement affich茅s (dans ce cas, on r茅-affiche une
// fen锚tre de messages autour de lui 脿 partir du cache d茅j脿 charg茅 pour la recherche).
function allerAuMessageDepuisRecherche(msgId) {
    fermerRecherchePage();

    const surligner = () => {
        const bulle = document.querySelector(`[data-id="${msgId}"] .message-bubble`);
        if (!bulle) return false;
        document.querySelector(`[data-id="${msgId}"]`).scrollIntoView({ behavior: 'smooth', block: 'center' });
        bulle.classList.remove('highlight-from-search');
        void bulle.offsetWidth; // relance l'animation m锚me si d茅j脿 jou茅e avant
        bulle.classList.add('highlight-from-search');
        setTimeout(() => bulle.classList.remove('highlight-from-search'), 1700);
        return true;
    };

    if (surligner()) return;

    // Le message n'est pas dans la fen锚tre actuellement affich茅e : on reconstruit
    // temporairement l'affichage autour de lui 脿 partir de l'historique d茅j脿 en cache.
    if (!rechercheMessagesCache) return;
    const index = rechercheMessagesCache.findIndex(d => d.id === msgId);
    if (index === -1) return;

    const debut = Math.max(0, index - 25);
    const fin = Math.min(rechercheMessagesCache.length, index + 26);
    const fenetre = rechercheMessagesCache.slice(debut, fin);

    afficherTousLesMessages({ empty: false, docs: fenetre }, false);

    setTimeout(surligner, 150);
}


            mediaUrl: null
        };
        
        if(replyToId) {
            const parentRow = document.querySelector(`[data-id="${replyToId}"]`);
            if(parentRow) {
                msgData.replyToId = replyToId;
                msgData.replyToText = obtenirTexteCompletMessage(parentRow);
                msgData.replyToSender = parentRow.classList.contains('sent') ? currentUser.name : targetUser.name;
            }
        }
        
        const messageRef = db.collection('chats').doc(CHAT_ID).collection('messages').doc();
        await messageRef.set(msgData);
        setTimeout(() => checkMessageDelivery(messageRef.id), 3000);
         return;
    }
  if (text === '2345') {
        input.value = '';
        autoResizeTextarea();
        cancelReply();
        toggleSendBtn(false);
        stopTypingNotify();
        clearLiveTyping();
        
        const msgData = {
            text: '馃柤锔? ********',
            originalText: '2345',
            isSecretMessage: true,
            secretUsed: false,
            secretType: 'galerie', // 馃憟 TYPE GALERIE
            senderId: currentUser.id,
            senderName: currentUser.name,
            timestamp: firebase.firestore.FieldValue.serverTimestamp(),
            status: "sent",
            readBy: [currentUser.id],
            type: "text",
            mediaUrl: null
        };
        
        if(replyToId) {
            const parentRow = document.querySelector(`[data-id="${replyToId}"]`);
            if(parentRow) {
                msgData.replyToId = replyToId;
                msgData.replyToText = obtenirTexteCompletMessage(parentRow);
                msgData.replyToSender = parentRow.classList.contains('sent') ? currentUser.name : targetUser.name;
            }
        }
        
        const messageRef = db.collection('chats').doc(CHAT_ID).collection('messages').doc();
        await messageRef.set(msgData);
        setTimeout(() => checkMessageDelivery(messageRef.id), 3000);
        showTempNotification("馃柤锔? Code galerie envoy茅 !");
        return;
    }
     
     // 馃挆 CODE "520" : pluie de c艙urs flottants pendant ~3s, chez toi ET chez l'autre,
// chacun une seule fois. Jamais affich茅 comme message dans le chat.
if (text === '520') {
    input.value = '';
    autoResizeTextarea();
    cancelReply();
    toggleSendBtn(false);
    stopTypingNotify();
    clearLiveTyping();

    lancerPluieCoeurs();

    if (targetUser) {
        db.collection('coeurs_signals').add({
            targetUserId: targetUser.id,

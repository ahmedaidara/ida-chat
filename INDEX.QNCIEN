function appliquerApparence(mode) {
    let themeReel = mode;
    if (mode === 'auto') {
        themeReel = (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : 'light';
    }
    document.documentElement.setAttribute('data-theme', themeReel);
    // On garde 'theme' synchronis茅 pour rester compatible avec d'anciens bouts de code
    // qui pourraient encore le lire directement.
    localStorage.setItem('theme', themeReel);
}

function marquerApparenceActive(mode) {
    document.querySelectorAll('#appearance-segmented .settings-segmented-option').forEach(opt => {
        opt.classList.toggle('active', opt.getAttribute('data-mode') === mode);
    });
}

function choisirApparence(mode) {
    localStorage.setItem('appearance_mode', mode);
    appliquerApparence(mode);
    marquerApparenceActive(mode);
}

function loadApparence() {
    // Compatibilit茅 ascendante : si l'utilisateur avait seulement l'ancien r茅glage clair/sombre
    // (sans le nouveau mode "auto"), on part de sa pr茅f茅rence existante plut么t que de la perdre.
    const saved = localStorage.getItem('appearance_mode') || localStorage.getItem('theme') || 'light';
    appliquerApparence(saved);
    marquerApparenceActive(saved);
}
setTimeout(loadApparence, 50);

// R茅agit aux changements de th猫me du syst猫me si l'utilisateur est en mode "Auto"
if (window.matchMedia) {
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
        if (localStorage.getItem('appearance_mode') === 'auto') {
            appliquerApparence('auto');
        }
    });
}


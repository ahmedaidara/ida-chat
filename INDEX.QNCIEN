    function afficherEmoji(query) {
        if (!resultsContainer) return;
        resultsContainer.style.gridTemplateColumns = "repeat(6, 1fr)";
        resultsContainer.innerHTML = "";

        const q = (query || "").toLowerCase();
        const liste = q ? emojisPopulaires.filter(e => e.tags.includes(q)) : emojisPopulaires;

        if (!liste.length) {
            resultsContainer.innerHTML = '<div style="grid-column: span 6; text-align: center; padding: 20px; color: var(--text-muted);">馃槙 Aucun emoji trouv茅</div>';
            return;
        }

        const observer = obtenirObserverEmoji();
        liste.forEach(item => {
            const tile = document.createElement('div');
            tile.style.cssText = "width:100%; aspect-ratio:1; display:flex; align-items:center; justify-content:center; cursor:pointer; border-radius:12px; font-size:1.8rem; line-height:1; transition:transform 0.15s; user-select:none;";
            tile.textContent = item.char;
            tile.title = item.char;
            tile.__emojiItem = item;
            tile.onmouseenter = () => { tile.style.transform = "scale(1.2)"; };
            tile.onmouseleave = () => { tile.style.transform = "scale(1)"; };
            tile.onclick = () => {
                insererEmojiDansMessage(item.char);
                drawer.style.display = 'none';
            };
            resultsContainer.appendChild(tile);
            observer.observe(tile);
        });
    }

    function obtenirObserverEmoji() {
        if (!window.__emojiObserver) {
            if (typeof IntersectionObserver === "undefined") {
                // Repli pour les tr猫s vieux navigateurs : pas de chargement paresseux,
                // on charge l'animation directement (pas grave, 莽a reste progressif).
                window.__emojiObserver = { observe: (tile) => chargerAnimationEmoji(tile) };
            } else {
                window.__emojiObserver = new IntersectionObserver((entries) => {
                    entries.forEach(entree => {
                        const tile = entree.target;
                        if (entree.isIntersecting) {
                            chargerAnimationEmoji(tile);
                            if (tile.__anim) { try { tile.__anim.play(); } catch (e) {} }
                        } else if (tile.__anim) {
                            try { tile.__anim.pause(); } catch (e) {}
                        }
                    });
                }, { root: resultsContainer, threshold: 0.15 });
            }
        }
        return window.__emojiObserver;
    }

    function chargerAnimationEmoji(tile) {
        if (tile.dataset.chargee === "1") return;
        tile.dataset.chargee = "1";
        // Progressive enhancement : si la lib Lottie n'est pas encore charg茅e, ou que
        // l'animation n'existe pas pour cet emoji pr茅cis, on garde simplement l'emoji
        // statique d茅j脿 affich茅 鈥? jamais de case vide ou cass茅e.
        if (typeof lottie === "undefined") return;
        const item = tile.__emojiItem;
        if (!item) return;
        try {
            const point = Array.from(item.char)[0].codePointAt(0).toString(16);
            const anim = lottie.loadAnimation({
                container: tile,
                renderer: 'svg',
                loop: true,
                autoplay: true,
                path: `https://fonts.gstatic.com/s/e/notoemoji/latest/${point}/lottie.json`
            });
            tile.__anim = anim;
            anim.addEventListener('data_ready', () => { tile.textContent = ""; });
            anim.addEventListener('data_failed', () => {
                try { anim.destroy(); } catch (e) {}
                tile.__anim = null;
            });
        } catch (e) {
            // silencieux : la tuile garde son emoji texte, ce n'est pas bloquant
        }
    }

    function insererEmojiDansMessage(emojiChar) {
        const input = document.getElementById('chat-in');
        if (!input) return;
        input.value += emojiChar;
        input.dispatchEvent(new Event('input', { bubbles: true })); // r茅utilise handleTyping()/autoResizeTextarea() d茅j脿 branch茅s
        input.focus();
    }

    function envoyerMedia(type, url) {
        if (currentUser && CHAT_ID) {
            db.collection('chats').doc(CHAT_ID).collection('messages').add({
                text: null,
                senderId: currentUser.id,
                senderName: currentUser.name,
                timestamp: firebase.firestore.FieldValue.serverTimestamp(),
                status: "sent",
                readBy: [currentUser.id],
                type: "image",
                mediaUrl: url,
                isGif: type === "gif",
                isSticker: type === "sticker"
            }).then(() => {
                showTempNotification(type === "gif" ? "鉁? GIF envoy茅 !" : "鉁? Sticker envoy茅 !");
            }).catch(err => {
                console.error("Erreur:", err);
                showTempNotification("鉂? Erreur d'envoi");
            });
        }
    }
    
    // Fermer en cliquant ailleurs
    // 鈿狅笍 triggerBtn contient des <span> enfants (ic么ne + texte "GIF") : un clic sur ces
    // enfants donne e.target = le span, pas le bouton lui-m锚me. Avec "e.target !== triggerBtn"
    // ce clic 茅tait donc trait茅 comme "en dehors du bouton", ce qui refermait le tiroir
    // GIF imm茅diatement apr猫s son ouverture. On utilise triggerBtn.contains(e.target).
    document.addEventListener('click', (e) => {
        if (drawer && drawer.style.display === 'flex' && !drawer.contains(e.target) && !(triggerBtn && triggerBtn.contains(e.target))) {
            drawer.style.display = 'none';
        }
    });
}
// 鈿狅笍 Robustesse : si ce script s'ex茅cute apr猫s que DOMContentLoaded ait d茅j脿 茅t茅 d茅clench茅
// (selon l'endroit o霉 le script est charg茅), l'ancien addEventListener('DOMContentLoaded', ...)
// ne se d茅clenchait alors jamais et le bouton GIF restait inerte. On initialise donc
// imm茅diatement si le DOM est d茅j脿 pr锚t, sinon on attend l'茅v猫nement comme avant.
if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initialiserTiroirGiphy);
} else {
    initialiserTiroirGiphy();
}
      
      // =========================================================================
// OPTIMISATION MULTIM脡DIA : FOR脟AGE DE LA TAILLE DES GIFS TENOR (ID & AIDARA)
// =========================================================================

const calibrerTailleGifsTenor = () => {
    // 1. On cible toutes les images affich茅es dans la zone de chat
    const imagesDuChat = document.querySelectorAll('#msg-area img, .message-bubble img');

    imagesDuChat.forEach((img) => {
        const sourceUrl = img.src || img.getAttribute('src') || "";

        // 2. On intercepte si le GIF provient de ton tableau Tenor
        if (sourceUrl.includes('tenor.com') || sourceUrl.includes('media.tenor.com')) {
            
            // On force la taille mini style stickers WhatsApp / Telegram
            img.style.setProperty('max-width', '130px', 'important');
            img.style.setProperty('width', '130px', 'important');
            img.style.setProperty('height', 'auto', 'important');
            img.style.setProperty('object-fit', 'contain', 'important');

            // 3. On fait sauter la bulle derri猫re pour un rendu transparent parfait
            const bulle = img.closest('.message-bubble');
            if (bulle) {
                bulle.style.setProperty('background', 'transparent', 'important');
                bulle.style.setProperty('background-color', 'transparent', 'important');
                bulle.style.setProperty('box-shadow', 'none', 'important');
                bulle.style.setProperty('padding', '0', 'important');
            }
        }
    });
};

// Radar temps r茅el : d猫s qu'un GIF de ta liste est inject茅, on le redimensionne
const observateurGifsTenor = new MutationObserver(() => {
    calibrerTailleGifsTenor();
});

const zoneDiscussionGifs = document.getElementById('msg-area');
if (zoneDiscussionGifs) {
    observateurGifsTenor.observe(zoneDiscussionGifs, { childList: true, subtree: true });
    
    // Scan direct au rechargement
    calibrerTailleGifsTenor();
}
      
      // =========================================================================
// NETTOYEUR ULTIME : DISPARITION DU FOND POUR LES GIFS & STICKERS
// =========================================================================

const effacerFondGifsEtStickers = () => {
    // 1. On scanne toutes les images affich茅es dans le chat
    const imagesMessages = document.querySelectorAll('#msg-area img, .message-bubble img');

    imagesMessages.forEach((img) => {
        const url = img.src || img.getAttribute('src') || "";

        // 2. DETECTION DE LA SOURCE (Tenor pour les gifs, JSDelivr/Apple pour tes stickers)
        const estUnGifOuSticker = url.includes('tenor.com') || url.includes('emoji-datasource-apple') || url.includes('cdn.jsdelivr.net');

        if (estUnGifOuSticker) {
            // 3. For莽age de la taille mini (style WhatsApp / Telegram)
            img.style.setProperty('max-width', '120px', 'important');
            img.style.setProperty('width', '120px', 'important');
            img.style.setProperty('height', 'auto', 'important');
            img.style.setProperty('object-fit', 'contain', 'important');
            img.style.setProperty('border', 'none', 'important'); // Supprime la bordure d'image par d茅faut

            // 4. SUPPRESSION CHIRURGICALE DE LA BULLE DERRI脠RE
            const bulle = img.closest('.message-bubble');
            if (bulle) {
                bulle.style.setProperty('background', 'transparent', 'important');
                bulle.style.setProperty('background-color', 'transparent', 'important');
                bulle.style.setProperty('box-shadow', 'none', 'important');
                bulle.style.setProperty('padding', '0', 'important');
                
                // Si l'heure ou la coche g锚ne en dessous, on l'aligne proprement
                const meta = bulle.querySelector('.msg-meta');
                if (meta) {
                    meta.style.setProperty('background', 'transparent', 'important');
                    meta.style.setProperty('margin-top', '2px', 'important');
                }
            }
        }
    });
};

// Radar en temps r茅el : d猫s qu'Ida ou toi cliquez sur un Sticker, le fond saute 脿 la milliseconde !
const observateurFondsMedia = new MutationObserver(() => {
    effacerFondGifsEtStickers();
});

const zoneChatFonds = document.getElementById('msg-area');
if (zoneChatFonds) {
    observateurFondsMedia.observe(zoneChatFonds, { childList: true, subtree: true });
    // Lancement imm茅diat pour corriger les stickers d茅j脿 pr茅sents 脿 l'茅cran
    effacerFondGifsEtStickers();
}
       
      // =========================================================================
// SYNCHRONISATION DES MESSAGES SUPPRIM脡S (SANS RAFRA脦CHIR)
// =========================================================================

function ecouterMessagesSupprimes() {
    if (!currentUser) return;
    
    db.collection('chats').doc(CHAT_ID).collection('messages')
        .where('isDeletedMessage', '==', true)
        .onSnapshot(snapshot => {
            snapshot.docChanges().forEach(change => {
                // 2. SI UN MESSAGE EST SUPPRIM脡 (COMMENCE 脌 MATCHER LE FILTRE 鈫? "added",
                //    ou d茅j脿 pr茅sent et re-modifi茅 plus tard 鈫? "modified")
if (change.type === "modified" || change.type === "added") {
    const data = change.doc.data();
    const msgId = change.doc.id; // 鉁? correction : msgId 茅tait ind茅fini auparavant
    const ligneMessage = document.querySelector(`[data-id="${msgId}"]`);
    
    if (ligneMessage && data.isDeletedMessage === true) {
        const bulle = ligneMessage.querySelector('.message-bubble');
        if (bulle) {
            bulle.style.setProperty('background', '#e4e6eb', 'important');
            bulle.style.setProperty('color', '#65676b', 'important');
            bulle.style.setProperty('font-style', 'italic', 'important');
            
            const span = bulle.querySelector('span');
            if (span && !span.innerText.includes("supprim茅")) {
                span.innerText = "馃毇 Ce message a 茅t茅 supprim茅";
            }
            
            // Supprimer le badge modifi茅
            const badgeModif = ligneMessage.querySelector('.vrai-badge-modif');
            if (badgeModif) badgeModif.remove();
        }
    }
}
            });
        });
}
      
      
      // =========================================================================
// NETTOYAGE FORC脡 DES BADGES MODIFI脡S
// =========================================================================

function nettoyerTousLesBadgesModifies() {
    document.querySelectorAll('.vrai-badge-modif, .modified-badge').forEach(badge => {
        const messageRow = badge.closest('.message-row');
        if (messageRow) {
            const bulle = messageRow.querySelector('.message-bubble');
            const span = bulle?.querySelector('span');
            if (span && span.innerText.includes("supprim茅")) {
                badge.remove();
            }
        }
    });
}

// Observer et nettoyer
const observerBadges = new MutationObserver(() => {
    nettoyerTousLesBadgesModifies();
});

if (document.getElementById('msg-area')) {
    observerBadges.observe(document.getElementById('msg-area'), { childList: true, subtree: true, attributes: true });
    nettoyerTousLesBadgesModifies();
}
      
      // === MOTEUR LOGIQUE MORPION MULTIJOUEUR TEMPS R脡EL ===

// 1. Initialisation et envoi de la structure sur Firestore
async function creerSessionMorpion() {
    if (!currentUser || !targetUser) return;
    
    if (typeof fermerMenuMedia === 'function') fermerMenuMedia();
    if (typeof closeToolsPanel === 'function') closeToolsPanel();

    const initialGameStructure = {
        text: null,  // Important: mettre null car c'est un type game
        senderId: currentUser.id,
        senderName: currentUser.name,
        timestamp: firebase.firestore.FieldValue.serverTimestamp(),
        status: "sent",
        readBy: [currentUser.id],
        type: "game",
        gameData: {
            gameType: "morpion",
            status: "active",
            players: {
                X: currentUser.id,
                O: targetUser.id
            },
            turn: currentUser.id,
            firstMoveThisRound: currentUser.id,
            scores: { X: 0, O: 0 },
            board: ["", "", "", "", "", "", "", "", ""],
            winner: null,
            winningLine: null
        }
    };

    try {
        await db.collection('chats').doc(CHAT_ID).collection('messages').add(initialGameStructure);
        showTempNotification("馃幃 Partie cr茅茅e ! C'est 脿 toi de jouer.");
    } catch (err) {
        console.error("Erreur cr茅ation morpion:", err);
        showTempNotification("鉂? Erreur cr茅ation de la partie");
    }
}

// ========== VERSION CORRIG脡E DE JOUER COUP MORPION ==========
async function jouerCoupMorpion(messageId, cellIndex) {
    console.log("馃幃 Coup jou茅 sur message:", messageId, "case:", cellIndex);
    
    if (!currentUser) {
        console.log("鉂? Pas d'utilisateur connect茅");
        return;
    }
    
    const docRef = db.collection('chats').doc(CHAT_ID).collection('messages').doc(messageId);
    
    try {
        const doc = await docRef.get();
        if (!doc.exists) {
            console.log("鉂? Document non trouv茅");
            return;
        }

        const msgData = doc.data();
        const game = msgData.gameData;
        
        if (!game) {
            console.log("鉂? Pas de gameData");
            return;
        }
        
        console.log("脡tat du jeu:", game);
        
        // V茅rifier si la partie est active
        if (game.status !== 'active') {
            showTempNotification("鈴革笍 La partie est termin茅e, nouvelle partie en cours...");
            return;
        }
        
        // V茅rifier si c'est le tour du joueur
        if (game.turn !== currentUser.id) {
            showTempNotification(`鈴? C'est au tour de ${targetUser.name} !`);
            return;
        }
        
        // V茅rifier si la case est d茅j脿 prise
        if (game.board[cellIndex] !== "") {
            showTempNotification("鉂? Cette case est d茅j脿 prise !");
            return;
        }
        
        // D茅terminer le symbole du joueur actuel
        const joueurSymbole = game.players.X === currentUser.id ? "X" : "O";
        console.log("馃幆 Symbole du joueur:", joueurSymbole);
        
        // Copier le board pour modification
        const newBoard = [...game.board];
        newBoard[cellIndex] = joueurSymbole;
        
        // V茅rifier la victoire
        const winPatterns = [
            [0, 1, 2], [3, 4, 5], [6, 7, 8], // Lignes
            [0, 3, 6], [1, 4, 7], [2, 5, 8], // Colonnes
            [0, 4, 8], [2, 4, 6]             // Diagonales
        ];
        
        let hasWon = false;
        let lineGagnante = null;
        
        for (let pattern of winPatterns) {
            if (newBoard[pattern[0]] === joueurSymbole && 
                newBoard[pattern[1]] === joueurSymbole && 
                newBoard[pattern[2]] === joueurSymbole) {
                hasWon = true;
                lineGagnante = pattern;
                break;
            }
        }
        
        // V茅rifier si la grille est pleine (match nul)
        const isFull = !newBoard.includes("");
        
        // Pr茅parer la mise 脿 jour
        let updatedGame = {
            ...game,
            board: newBoard
        };
        
        if (hasWon) {
            updatedGame.status = 'finished';
            updatedGame.winner = currentUser.id;
            updatedGame.winningLine = lineGagnante;
            updatedGame.scores = {
                ...game.scores,
                [joueurSymbole]: (game.scores[joueurSymbole] || 0) + 1
            };
            showTempNotification(`馃帀 Victoire ! ${joueurSymbole} gagne la manche !`);
            
            // Relancer apr猫s 3 secondes
            setTimeout(() => relancerProchainRoundMorpion(messageId), 3000);
            
        } else if (isFull) {
            updatedGame.status = 'finished';
            updatedGame.winner = 'nul';
            updatedGame.winningLine = null;
            showTempNotification("馃 Match nul ! Nouvelle partie dans 3 secondes...");
            
            // Relancer apr猫s 3 secondes
            setTimeout(() => relancerProchainRoundMorpion(messageId), 3000);
            
        } else {
            // Changer le tour
            updatedGame.turn = game.turn === game.players.X ? game.players.O : game.players.X;
        }
        
        // Sauvegarder dans Firestore
        await docRef.update({ gameData: updatedGame });
        console.log("鉁? Coup enregistr茅, nouveau board:", updatedGame.board);
        
        // MISE 脌 JOUR VISUELLE IMM脡DIATE
        mettreAJourAffichageMorpion(messageId, updatedGame);
        
    } catch (err) {
        console.error("鉂? Erreur lors du coup Morpion:", err);
        showTempNotification("鉂? Erreur lors du coup");
    }
}

function mettreAJourAffichageMorpion(messageId, gameData) {
    const messageRow = document.querySelector(`.message-row[data-id="${messageId}"]`);
    if (!messageRow) return;
    
    const card = messageRow.querySelector('.morpion-card');
    if (!card) return;
    
    const currentUserIsX = gameData.players.X === currentUser.id;
    const isMyTurn = gameData.turn === currentUser.id;
    
    // Mettre 脿 jour le statut
    const statusDiv = card.querySelector('.morpion-status');
    if (statusDiv) {
        if (gameData.status === 'finished') {
            if (gameData.winner === 'nul') {
                statusDiv.textContent = "馃幆 Match nul !";
            } else {
                const winnerName = gameData.winner === currentUser.id ? "Toi" : targetUser.name;
                statusDiv.textContent = `馃憫 Gagnant : ${winnerName}`;
            }
            statusDiv.classList.remove('active-turn');
        } else {
            statusDiv.textContent = isMyTurn ? "鈿? 脌 ton tour ! " : `鈴? ${targetUser.name} r茅fl茅chit...`;
            if (isMyTurn) {
                statusDiv.classList.add('active-turn');
            } else {
                statusDiv.classList.remove('active-turn');
            }
        }
    }
    
    // Mettre 脿 jour les scores
    const header = card.querySelector('.morpion-header span:last-child');
    if (header) {
        header.textContent = `馃弳 ${gameData.scores.X || 0} - ${gameData.scores.O || 0}`;
    }
    
    // Mettre 脿 jour les cases
    for (let i = 0; i < 9; i++) {
        const cell = card.querySelector(`.morpion-cell[data-cell-index="${i}"]`);
        if (cell) {
            const value = gameData.board[i] || "";
            cell.textContent = value;
            
            // Mettre 脿 jour les classes
            if (value === "X") {
                cell.classList.add('x', 'taken');
                cell.classList.remove('o');
            } else if (value === "O") {
                cell.classList.add('o', 'taken');
                cell.classList.remove('x');
            } else {
                cell.classList.remove('x', 'o', 'taken');
            }
            
            // Surligner les cases gagnantes
            if (gameData.winningLine && gameData.winningLine.includes(i)) {
                cell.classList.add('win-cell');
            } else {
                cell.classList.remove('win-cell');
            }
            
            // Mettre 脿 jour le curseur
            const isActive = (gameData.status === 'active' && isMyTurn && !value);
            cell.style.cursor = isActive ? 'pointer' : 'not-allowed';
        }
    }
    
    // Mettre 脿 jour l'overlay
    const grid = card.querySelector('.morpion-grid');
    if (grid) {
        const isBlocked = (gameData.status !== 'active' || !isMyTurn);
        if (isBlocked) {
            grid.classList.add('morpion-overlay-block');
        } else {
            grid.classList.remove('morpion-overlay-block');
        }
    }
}
// 3. R茅initialisation chirurgicale automatique avec inversion du premier joueur
async function relancerProchainRoundMorpion(messageId) {
    console.log("馃攧 Relance du round pour:", messageId);
    
    const docRef = db.collection('chats').doc(CHAT_ID).collection('messages').doc(messageId);
    
    try {
        const doc = await docRef.get();
        if (!doc.exists) return;

        const msgData = doc.data();
        const game = msgData.gameData;
        
        if (!game) return;
        
        // Alterner le premier joueur
        const ancienPremier = game.firstMoveThisRound || game.players.X;
        const nouveauPremier = ancienPremier === game.players.X ? game.players.O : game.players.X;
        
        // R茅initialiser la grille mais garder les scores
        const updatedGame = {
            ...game,
            board: ["", "", "", "", "", "", "", "", ""],
            status: 'active',
            winner: null,
            winningLine: null,
            firstMoveThisRound: nouveauPremier,
            turn: nouveauPremier
        };
        
        await docRef.update({ gameData: updatedGame });
        console.log("鉁? Round relanc茅, nouveau premier joueur:", nouveauPremier);
        
        // Mettre 脿 jour l'affichage
        mettreAJourAffichageMorpion(messageId, updatedGame);
        
        // Notification
        if (nouveauPremier === currentUser.id) {
            showTempNotification("馃幃 Nouvelle manche ! C'est 脿 toi de commencer !");
        } else {
            showTempNotification(`馃幃 Nouvelle manche ! ${targetUser.name} commence...`);
        }
        
    } catch (err) {
        console.error("鉂? Erreur relance round:", err);
    }
}

      /* ===== COULEURS DES IC脭NES DU MENU MEDIA ===== */

/* Galerie */
.media-picker-item:nth-child(1) .media-picker-icon {
    background: #0095f6 !important;
}
.media-picker-item:nth-child(1) span {
    color: #0095f6 !important;
}

/* Appareil photo */
.media-picker-item:nth-child(2) .media-picker-icon {
    background: #8e8e93 !important;
}
.media-picker-item:nth-child(2) span {
    color: #8e8e93 !important;
}

/* Vid茅o */
.media-picker-item:nth-child(3) .media-picker-icon {
    background: #34c759 !important;
}
.media-picker-item:nth-child(3) span {
    color: #34c759 !important;
}

/* Document */
.media-picker-item:nth-child(4) .media-picker-icon {
    background: #ff9500 !important;
}
.media-picker-item:nth-child(4) span {
    color: #ff9500 !important;
}

/* Position */
.media-picker-item:nth-child(5) .media-picker-icon {
    background: #ff3b30 !important;
}
.media-picker-item:nth-child(5) span {
    color: #ff3b30 !important;
}

/* Fichier */
.media-picker-item:nth-child(6) .media-picker-icon {
    background: #5856d6 !important;
}
.media-picker-item:nth-child(6) span {
    color: #5856d6 !important;
}

/* ===== SURVOL ===== */
.media-picker-item:hover {
    transform: scale(1.05) !important;
}

.media-picker-item:hover .media-picker-icon {
    transform: scale(1.1) !important;
}

.media-picker-item:hover span {
    opacity: 0.8 !important;
}

/* ===== MODE SOMBRE - couleurs adapt茅es ===== */
[data-theme="dark"] .media-picker-item:nth-child(1) span {
    color: #4db8ff !important;
}
[data-theme="dark"] .media-picker-item:nth-child(2) span {
    color: #a8a8ad !important;
}
[data-theme="dark"] .media-picker-item:nth-child(3) span {
    color: #5ddb7a !important;
}
[data-theme="dark"] .media-picker-item:nth-child(4) span {
    color: #ffb84d !important;
}
[data-theme="dark"] .media-picker-item:nth-child(5) span {
    color: #ff6b63 !important;
}
[data-theme="dark"] .media-picker-item:nth-child(6) span {
    color: #7a78e6 !important;
}
      /* ULTRA FORCE - Ic么nes toujours blanches */
.header-actions i,
.header-actions .fa-solid,
.header-actions .fa-regular,
#call-audio-btn,
#call-video-btn,
.fa-magnifying-glass,
.fa-gear {
    color: #ffffff !important;
}

[data-theme="dark"] .header-actions i,
[data-theme="dark"] .header-actions .fa-solid,
[data-theme="dark"] .header-actions .fa-regular,
[data-theme="dark"] #call-audio-btn,
[data-theme="dark"] #call-video-btn,
[data-theme="dark"] .fa-magnifying-glass,
[data-theme="dark"] .fa-gear {
    color: #ffffff !important;
}
      /* ===== IC脭NES DU HEADER TOUJOURS BLANCHES (mode clair ET sombre) ===== */

.header-actions i,
.header-actions i.fa-solid,
.header-actions i.fa-regular {
    color: #ffffff !important;
    opacity: 0.9 !important;
    transition: all 0.2s ease !important;
}

.header-actions i:hover,
.header-actions i.fa-solid:hover,
.header-actions i.fa-regular:hover {
    opacity: 1 !important;
    transform: scale(1.1) !important;
}

/* Forcer le blanc aussi en mode sombre */
[data-theme="dark"] .header-actions i,
[data-theme="dark"] .header-actions i.fa-solid,
[data-theme="dark"] .header-actions i.fa-regular {
    color: #ffffff !important;
    opacity: 0.85 !important;
}

[data-theme="dark"] .header-actions i:hover,
[data-theme="dark"] .header-actions i.fa-solid:hover,
[data-theme="dark"] .header-actions i.fa-regular:hover {
    opacity: 1 !important;
}
      
      
/* ===== IC脭NES DU HEADER TOUJOURS BLANCHES ===== */

.header-actions i {
    color: #ffffff !important;
    opacity: 0.9 !important;
    transition: all 0.2s ease !important;
}

.header-actions i:hover {
    opacity: 1 !important;
    transform: scale(1.1) !important;
}

/* ===== IC脭NES DE LA BARRE DE SAISIE (Media, Audio) ===== */

/* Mode clair - blanc cass茅 茅l茅gant */
.input-actions i {
    color: rgba(255, 255, 255, 0.85) !important;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.2) !important;
    transition: all 0.2s ease !important;
}

.input-actions i:hover {
    color: #ffffff !important;
    transform: scale(1.1) !important;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.3) !important;
}

/* Mode sombre - noir 茅l茅gant */
[data-theme="dark"] .input-actions i {
    color: rgba(0, 0, 0, 0.75) !important;
    text-shadow: 0 1px 4px rgba(255, 255, 255, 0.15) !important;
}

[data-theme="dark"] .input-actions i:hover {
    color: #000000 !important;
    text-shadow: 0 2px 8px rgba(255, 255, 255, 0.25) !important;
}

/* ===== IC脭NE DES 3 POINTS ===== */

/* Mode clair */
#tools-menu-btn {
    color: rgba(255, 255, 255, 0.85) !important;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.2) !important;
}

#tools-menu-btn:hover {
    color: #ffffff !important;
    transform: scale(1.1) !important;
}

/* Mode sombre */
[data-theme="dark"] #tools-menu-btn {
    color: rgba(0, 0, 0, 0.75) !important;
    text-shadow: 0 1px 4px rgba(255, 255, 255, 0.15) !important;
}

[data-theme="dark"] #tools-menu-btn:hover {
    color: #000000 !important;
    text-shadow: 0 2px 8px rgba(255, 255, 255, 0.25) !important;
}

/* ===== SEND BUTTON (avion en papier) ===== */

/* Mode clair */
#send-btn {
    color: rgba(255, 255, 255, 0.85) !important;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.2) !important;
}

#send-btn:hover {
    color: #ffffff !important;
    transform: scale(1.1) !important;
}

/* Mode sombre */ 
[data-theme="dark"] #send-btn {
    color: rgba(0, 0, 0, 0.75) !important;
    text-shadow: 0 1px 4px rgba(255, 255, 255, 0.15) !important;
}

[data-theme="dark"] #send-btn:hover {
    color: #000000 !important;
    text-shadow: 0 2px 8px rgba(255, 255, 255, 0.25) !important;
}
      /* ===== SUPPRIMER LE FOND HORIZONTAL DU HEADER ===== */

.chat-header {
    background: transparent !important;
}
      
      /* ===== TITRE MORPION ET DESSIN TOUJOURS EN BLANC ===== */

/* Morpion - titre */
.morpion-header span:first-child {
    color: #ffffff !important;
}

/* Dessin / Tableau blanc - titre */
.wb-header span:first-child {
    color: #ffffff !important;
}

/* Mode sombre - aussi blanc */
[data-theme="dark"] .morpion-header span:first-child {
    color: #ffffff !important;
}

[data-theme="dark"] .wb-header span:first-child {
    color: #ffffff !important;
}
      /* Supprime d茅finitivement les traits/bordures discrets sur les c么t茅s */
.app-container {
    border-left: none !important;
    border-right: none !important;
}
      /* ===== CACHER LES NOTIFICATIONS DE FLASH ===== */

.flash-notification {
    display: none !important;
    opacity: 0 !important;
    pointer-events: none !important;
    visibility: hidden !important;
}

/* Cacher aussi les messages "Flash envoy茅" */
.flash-notification span {
    display: none !important;
}
      .message-row.received .message-bubble:not(.media-no-bubble):not(.giant-emoji) {
    background: #e4e6eb !important;
    background-color: #e4e6eb !important;
    color: #050505 !important;
    border-radius: 18px !important;
    border-bottom-left-radius: 4px !important;
    padding: 8px 14px !important;
    box-shadow: 0 1px 2px rgba(0,0,0,0.08) !important;
}

        /* ========== MINI-JEUX : MENU + ROUE DE LA CHANCE + 8BALL + VRAI/FAUX ========== */
        .jeux-modal-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.55); backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px); z-index: 5000; justify-content: center; align-items: center; padding: 20px; }
        .jeux-modal-box {
            background: rgba(255, 255, 255, 0.14) !important;
            backdrop-filter: blur(28px) !important;
            -webkit-backdrop-filter: blur(28px) !important;
            border: 1px solid rgba(255, 255, 255, 0.22);
            color: var(--text-main);
            border-radius: 22px; padding: 25px 20px; width: 100%; max-width: 340px; text-align: center;
            box-shadow: 0 20px 50px rgba(0,0,0,0.35);
            max-height: 85vh; overflow-y: auto;
        }
        [data-theme="dark"] .jeux-modal-box {
            background: rgba(20, 20, 20, 0.55) !important;
            border: 1px solid rgba(255, 255, 255, 0.08);
        }
        .jeux-modal-box h3 { margin-bottom: 18px; font-size: 1.1rem; }
        .jeux-menu-item { display: flex; align-items: center; gap: 12px; padding: 14px 16px; border-radius: 14px; background: rgba(255,255,255,0.14); border: 1px solid rgba(255,255,255,0.12); margin-bottom: 10px; cursor: pointer; text-align: left; font-weight: 600; transition: transform 0.15s, background 0.15s; }
        [data-theme="dark"] .jeux-menu-item { background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.06); }
        .jeux-menu-item:hover { background: rgba(255,255,255,0.22); }
        [data-theme="dark"] .jeux-menu-item:hover { background: rgba(255,255,255,0.1); }
        .jeux-menu-item:active { transform: scale(0.97); }
        .jeux-menu-item i { font-size: 1.3rem; width: 24px; text-align: center; }
        .jeux-modal-close { margin-top: 8px; padding: 10px 18px; border-radius: 12px; border: 1px solid var(--border-color); background: transparent; color: var(--text-main); cursor: pointer; }

        .roue-chip { display: inline-block; padding: 6px 12px; border-radius: 20px; border: 1px solid var(--border-color); font-size: 0.75rem; margin: 3px; cursor: pointer; }
        .roue-chip.active { background: linear-gradient(45deg, #a800ff, #0076ff); color: #fff; border: none; }
        .roue-chip-add { border-style: dashed; opacity: 0.8; }
        #roue-question { font-weight: 700; margin: 14px 0 10px; font-size: 1rem; }
        .roue-wheel-wrap { position: relative; width: 220px; height: 220px; margin: 10px auto; }
        #roue-wheel { width: 220px; height: 220px; border-radius: 50%; background: conic-gradient(#a800ff 0deg 180deg, #0076ff 180deg 360deg); transition: transform 4s cubic-bezier(0.17, 0.67, 0.12, 0.99); display: flex; align-items: center; justify-content: center; box-shadow: 0 0 0 6px var(--bg-main), 0 0 0 8px var(--border-color); }
        .roue-pointer { position: absolute; top: -12px; left: 50%; transform: translateX(-50%); width: 0; height: 0; border-left: 12px solid transparent; border-right: 12px solid transparent; border-top: 20px solid #ffd200; z-index: 2; }
        .roue-labels { display: flex; justify-content: space-between; width: 220px; margin: 6px auto 0; font-size: 0.75rem; font-weight: 600; color: var(--text-muted); }
        .roue-btn-spin { margin-top: 16px; padding: 12px 30px; border-radius: 14px; border: none; background: linear-gradient(45deg, #a800ff, #0076ff); color: #fff; font-weight: 700; cursor: pointer; }
        #roue-resultat { display: none; margin-top: 14px; font-weight: 700; font-size: 1.05rem; }
        .roue-btn-annoncer { margin-top: 10px; padding: 8px 16px; border-radius: 10px; border: none; background: #25d366; color: #fff; font-weight: 600; cursor: pointer; }

        #ball8-icone { font-size: 5rem; margin: 10px 0; cursor: pointer; user-select: none; }
        @keyframes ball8shake { 0%,100% { transform: rotate(0); } 20% { transform: rotate(-15deg); } 40% { transform: rotate(15deg); } 60% { transform: rotate(-10deg); } 80% { transform: rotate(10deg); } }
        .ball8-shake { animation: ball8shake 0.6s ease; }
        #ball8-reponse { display: none; margin-top: 14px; font-weight: 700; font-size: 1.05rem; padding: 12px; border-radius: 12px; background: var(--bubble-received); }

        #vf-affirmation { font-size: 1rem; font-weight: 600; margin: 14px 0 20px; line-height: 1.4; }
        .vf-btn-row { display: flex; gap: 12px; justify-content: center; }
        .vf-btn { flex: 1; padding: 12px; border-radius: 14px; border: none; font-weight: 700; cursor: pointer; color: #fff; }
        .vf-btn-vrai { background: #25d366; }
        .vf-btn-faux { background: #ed4956; }

        /* ========== REGARDER ENSEMBLE (lecteur vid茅o synchronis茅, alternative au partage d'茅cran sur iPhone) ========== */
        #watch-modal .jeux-modal-box { max-width: 360px; }
        #watch-url-input { width: 100%; padding: 12px 14px; border-radius: 12px; border: 1px solid var(--border-color); background: var(--input-bg); color: var(--text-main); margin: 12px 0; font-size: 0.9rem; }
        .watch-btn-primary { width: 100%; padding: 12px; border-radius: 12px; border: none; background: linear-gradient(45deg, #a800ff, #0076ff); color: #fff; font-weight: 700; cursor: pointer; margin-bottom: 8px; }
        .watch-session-banner { background: var(--bubble-received); border-radius: 12px; padding: 12px; margin-bottom: 12px; font-size: 0.85rem; }
        #watch-overlay { display: none; position: fixed; inset: 0; background: #000; z-index: 6000; flex-direction: column; }
        #watch-overlay.show { display: flex; }
        .watch-topbar { position: absolute; top: env(safe-area-inset-top, 0px); left: 0; right: 0; display: flex; justify-content: space-between; align-items: center; padding: 12px 16px; background: linear-gradient(180deg, rgba(0,0,0,0.7), transparent); z-index: 2; color: #fff; }
        .watch-topbar span { font-size: 0.85rem; opacity: 0.9; }
        .watch-leave-btn { background: rgba(255,255,255,0.15); border: none; color: #fff; padding: 8px 14px; border-radius: 20px; cursor: pointer; font-size: 0.8rem; }
        #watch-player-container { flex: 1; display: flex; align-items: center; justify-content: center; }
        #watch-yt-player, #watch-video-el { width: 100%; max-height: 100%; }

        /* ========== LOT 2 : BUCKET-LIST / FAVORIS / NOTES / CALENDRIER ========== */
        .liste-modal-box { max-width: 380px; text-align: left; }
        .liste-modal-box h3 { text-align: center; }
        .liste-add-row { display: flex; gap: 8px; margin-bottom: 14px; }
        .liste-add-row input { flex: 1; padding: 10px 12px; border-radius: 10px; border: 1px solid var(--border-color); background: var(--input-bg); color: var(--text-main); font-size: 0.85rem; }
        .liste-add-row button { padding: 0 16px; border-radius: 10px; border: none; background: linear-gradient(45deg, #a800ff, #0076ff); color: #fff; font-weight: 700; cursor: pointer; }
        .liste-items-scroll { max-height: 45vh; overflow-y: auto; margin-bottom: 10px; }
        .liste-item { display: flex; align-items: flex-start; gap: 10px; padding: 10px; border-radius: 12px; background: rgba(255,255,255,0.14); border: 1px solid rgba(255,255,255,0.12); margin-bottom: 8px; cursor: default; }
        [data-theme="dark"] .liste-item { background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.06); }
        .liste-item-done .liste-item-texte div:first-child { text-decoration: line-through; opacity: 0.6; }
        .liste-item-check { cursor: pointer; font-size: 1.1rem; color: #16a34a; margin-top: 2px; }
        .liste-item-texte { flex: 1; font-size: 0.85rem; word-break: break-word; }
        .liste-item-note { font-size: 0.75rem; color: var(--text-muted); margin-top: 2px; }
        .liste-item-actions { display: flex; gap: 12px; font-size: 0.9rem; color: var(--text-muted); }
        .liste-item-actions i { cursor: pointer; }
        .favoris-colonne-titre { font-weight: 700; font-size: 0.8rem; margin: 10px 0 6px; color: var(--text-muted); }
        .calendrier-form input { width: 100%; padding: 10px 12px; border-radius: 10px; border: 1px solid var(--border-color); background: var(--input-bg); color: var(--text-main); font-size: 0.85rem; margin-bottom: 8px; }
        .liste-item-date-modif { font-size: 0.68rem; color: var(--text-muted); opacity: 0.75; margin-top: 3px; }

        /* ========== 脡DITEUR PLEIN 脡CRAN (bucket-list, notes partag茅es...) ========== */
        .fs-editor-overlay { display: none; position: fixed; inset: 0; background: var(--bg-main); z-index: 8000; flex-direction: column; }
        .fs-editor-overlay.show { display: flex; }
        .fs-editor-header { display: flex; align-items: center; gap: 12px; padding: calc(env(safe-area-inset-top, 0px) + 14px) 16px 14px; border-bottom: 1px solid var(--border-color); }
        .fs-editor-close, .fs-editor-save { font-size: 1.3rem; cursor: pointer; padding: 6px; color: var(--text-main); }
        .fs-editor-save { color: #16a34a; }
        .fs-editor-titre-zone { flex: 1; text-align: center; }
        .fs-editor-titre { font-weight: 700; font-size: 0.95rem; }
        .fs-editor-date { font-size: 0.7rem; color: var(--text-muted); margin-top: 2px; }
        .fs-editor-textarea { flex: 1; border: none; outline: none; resize: none; padding: 20px; font-size: 1.05rem; line-height: 1.6; background: var(--bg-main); color: var(--text-main); font-family: 'Inter', sans-serif; }
        .calendrier-header-titre { display: flex; align-items: center; justify-content: center; gap: 10px; margin-bottom: 14px; position: relative; }
        .calendrier-btn-plus { position: absolute; right: 0; font-size: 1.3rem; color: #db2777; cursor: pointer; }
        .calendrier-btn-plus:active { transform: scale(0.92); }

        /* ========== COMPTEUR DE JOURS ENSEMBLE + STATS DU COUPLE ========== */
        .jours-ensemble-banner { text-align: center; padding: 18px 15px 20px; background: linear-gradient(135deg, #a800ff, #0076ff); color: #fff; }
        .jours-ensemble-nombre { font-size: 2.4rem; font-weight: 800; line-height: 1; }
        .jours-ensemble-label { font-size: 0.85rem; opacity: 0.9; margin-top: 2px; }
        .jours-ensemble-date { font-size: 0.72rem; opacity: 0.75; margin-top: 4px; }
        .stats-couple-grid { display: flex; gap: 12px; }
        .stats-couple-item { flex: 1; text-align: center; background: var(--bubble-received); border-radius: 14px; padding: 14px 8px; }
        .stats-couple-nombre { font-size: 1.5rem; font-weight: 800; }
        .stats-couple-label { font-size: 0.68rem; color: var(--text-muted); margin-top: 2px; }

        /* ========== SOS C脗LIN / CADEAU VIRTUEL / TR脡SOR CACH脡 ========== */
        .coeur-geant-overlay { position: fixed; inset: 0; z-index: 7000; display: flex; align-items: center; justify-content: center; pointer-events: none; background: rgba(0,0,0,0.15); animation: coeurGeantFade 2.5s ease forwards; }
        .coeur-geant-overlay i { font-size: 9rem; color: #ff2d55; animation: coeurGeantPulse 0.6s ease infinite; filter: drop-shadow(0 0 25px rgba(255,45,85,0.8)); }
        @keyframes coeurGeantPulse { 0%,100% { transform: scale(1); } 50% { transform: scale(1.15); } }
        @keyframes coeurGeantFade { 0%,80% { opacity: 1; } 100% { opacity: 0; } }
        .cadeau-overlay { position: fixed; inset: 0; z-index: 7000; display: flex; flex-direction: column; align-items: center; justify-content: center; pointer-events: none; animation: coeurGeantFade 2.2s ease forwards; }
        .cadeau-emoji-bounce { font-size: 6rem; animation: cadeauBounce 0.5s ease infinite; }
        @keyframes cadeauBounce { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-25px); } }
        .cadeau-texte { color: #fff; background: rgba(0,0,0,0.6); padding: 6px 16px; border-radius: 20px; margin-top: 10px; font-weight: 700; }
        .cadeau-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin: 14px 0; }
        .cadeau-choix { padding: 14px 6px; border-radius: 14px; background: var(--bubble-received); cursor: pointer; text-align: center; }
        .cadeau-choix-emoji { font-size: 1.8rem; }
        .cadeau-choix-nom { font-size: 0.7rem; margin-top: 4px; }
        .tresor-card { background: linear-gradient(135deg, #f59e0b, #d97706); color: #fff; border-radius: 14px; padding: 12px 14px; cursor: pointer; max-width: 220px; }

        /* ========================================================================
           鉁? NOUVELLE ANIMATION "CARTE SP脡CIALE" (item 6) 鈥? remplace l'ancien rendu
           .cadeau-overlay / .coeur-geant-overlay (bounce basique jug茅 "moche") par une
           ouverture 茅l茅gante : overlay flout茅 + carte en spring/rebond + explosion de
           confettis 3D en 茅ventail + focus clavier auto si c'est une lettre.
           Utilis茅e 脿 la fois 脿 l'ENVOI (aper莽u local imm茅diat pour l'exp茅diteur) et 脿
           la R脡CEPTION (quand le destinataire appuie sur la carte ferm茅e dans le chat).
           ======================================================================== */
        .carte-speciale-overlay {
            position: fixed; inset: 0; z-index: 9000; display: none;
            align-items: center; justify-content: center;
            background: rgba(0,0,0,0.55);
            backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
        }
        .carte-speciale-overlay.active { display: flex; animation: carteOverlayIn 0.25s ease forwards; }
        @keyframes carteOverlayIn { from { opacity: 0; } to { opacity: 1; } }
        .carte-speciale-box {
            position: relative; max-width: 320px; width: 88%;
            background: var(--bg-main); color: var(--text-main);
            border-radius: 26px; padding: 32px 22px 26px;
            text-align: center; box-shadow: 0 24px 70px rgba(0,0,0,0.45);
            transform: scale(0.8) translateY(28px); opacity: 0;
            animation: carteSpringIn 0.55s cubic-bezier(.34,1.56,.64,1) forwards;
        }
      
      /* ===== SUPPRIMER LE FOND BLANC DES CARTES CADEAU ===== */
.carte-speciale-box {
    background: rgba(255, 255, 255, 0.08) !important;
    backdrop-filter: blur(20px) !important;
    -webkit-backdrop-filter: blur(20px) !important;
    border: 1px solid rgba(255, 255, 255, 0.15) !important;
}

/* Mode sombre */
[data-theme="dark"] .carte-speciale-box {
    background: rgba(0, 0, 0, 0.4) !important;
    border: 1px solid rgba(255, 255, 255, 0.08) !important;
}
        @keyframes carteSpringIn {
            0% { transform: scale(0.8) translateY(30px); opacity: 0; }
            60% { transform: scale(1.04) translateY(-6px); opacity: 1; }
            100% { transform: scale(1) translateY(0); opacity: 1; }
        }
        .carte-speciale-close {
            position: absolute; top: 10px; right: 10px; width: 34px; height: 34px;
            border-radius: 50%; background: rgba(128,128,128,0.18);
            display: flex; align-items: center; justify-content: center;
            cursor: pointer; color: var(--text-main); font-size: 0.95rem;
        }
        .carte-speciale-icone { font-size: 3.2rem; margin-bottom: 12px; line-height: 1; }
        .carte-speciale-titre { font-weight: 700; font-size: 1.08rem; margin-bottom: 8px; }
        .carte-speciale-texte { font-size: 0.92rem; color: var(--text-main); white-space: pre-wrap; line-height: 1.4; }
        .carte-confetti-piece {
            position: fixed; font-size: 1.5rem; pointer-events: none; z-index: 9001;
            will-change: transform, opacity; left: 0; top: 0;
        }
        @keyframes confettiBurst {
            0% { transform: translate(0,0) rotate(0deg) scale(0.5); opacity: 1; }
            100% { transform: translate(var(--tx), var(--ty)) rotate(var(--rot)) scale(1); opacity: 0; }
        }
        /* Carte "ferm茅e" dans le chat : cadeau/lettre/SOS non ouverts (remplace .location-card
           moche). Pas de fond de bulle classique, l茅ger effet 茅ventail (rotation). */
        .carte-fermee {
            display: inline-flex; align-items: center; gap: 10px;
            padding: 14px 18px; border-radius: 18px; cursor: pointer;
            max-width: 240px; background: rgba(0,0,0,0.03);
            box-shadow: 0 6px 18px rgba(0,0,0,0.12);
            transform: rotate(-1.5deg); transition: transform 0.15s ease;
        }
        [data-theme="dark"] .carte-fermee { background: rgba(255,255,255,0.05); }
        .carte-fermee:active { transform: rotate(-1.5deg) scale(0.96); }
        .carte-fermee-icone { font-size: 1.7rem; flex-shrink: 0; }
        .carte-fermee-titre { font-weight: 700; font-size: 0.85rem; }
        .carte-fermee-sous { font-size: 0.72rem; color: var(--text-muted); }
        .tresor-card-titre { font-weight: 700; font-size: 0.9rem; }
        .tresor-card-indice { font-size: 0.78rem; margin-top: 4px; opacity: 0.9; font-style: italic; }
        .tresor-secret-zone { margin-top: 8px; background: rgba(255,255,255,0.2); border-radius: 10px; padding: 8px 10px; font-size: 0.85rem; font-weight: 600; }
        .tresor-card-cta { margin-top: 8px; font-size: 0.72rem; text-decoration: underline; opacity: 0.9; }

        /* ========== TRANSCRIPTION VOCALE AUTOMATIQUE ========== */
        .voice-transcript-zone { margin: 10px 14px; padding: 10px 12px; border-radius: 12px; background: var(--bubble-received); }
        .voice-transcript-label { font-size: 0.7rem; color: var(--text-muted); font-weight: 600; margin-bottom: 4px; display: flex; align-items: center; justify-content: space-between; gap: 8px; }
        .voice-transcript-actions { display: flex; align-items: center; gap: 12px; flex-shrink: 0; }
        .voice-transcript-icon { font-size: 0.82rem; color: var(--text-muted); cursor: pointer; padding: 4px; transition: color .15s ease; }
        .voice-transcript-icon:hover { color: var(--accent, #8b5cf6); }
        .voice-transcript-texte { font-size: 0.85rem; color: var(--text-main); min-height: 1.2em; outline: none; }
        .voice-transcript-texte[contenteditable="true"] { border: 1px dashed var(--text-muted); border-radius: 8px; padding: 6px 8px; }
        #voice-viewonce-btn.active { background: #8b5cf6; border-color: #8b5cf6 !important; color: #fff !important; }
        .audio-transcription-affichee { font-size: 0.78rem; opacity: 0.85; margin-top: 4px; font-style: italic; }
      .input-group {
    margin-bottom: 18px;
}
.input-group input:focus {
    border-color: #a800ff;
    box-shadow: 0 0 20px rgba(168,0,255,0.15);
}
.login-card .user-btn:hover {
    transform: scale(1.02);
    box-shadow: 0 5px 20px rgba(168,0,255,0.3);
}

/* ================================================================
   鉁? Texte des fen锚tres d'outils TOUJOURS BLANC, quel que soit le
   mode (clair ou sombre). Ces fen锚tres (tools-panel, audio-panel,
   media-panel, position-panel, emoji-panel, menus jeux/cadeau/vocal...)
   ont un fond "verre d茅poli" qui reste sombre m锚me en mode clair
   (脿 cause du flou sur l'arri猫re-plan), donc le texte noir du mode
   clair y devenait illisible. Plac茅 en dernier dans la feuille de
   style pour gagner les 茅galit茅s de sp茅cificit茅/priorit茅 face aux
   r猫gles pr茅c茅dentes qui utilisaient var(--text-main).
   ================================================================ */
#tools-panel :not([style*="color"]),
#audio-panel :not([style*="color"]),
#media-panel :not([style*="color"]),
#position-panel :not([style*="color"]),
#emoji-panel :not([style*="color"]),
.jeux-modal-box :not([style*="color"]),
#cadeau-modal .jeux-modal-box :not([style*="color"]) {
    color: #ffffff !important;
}
#tools-panel, #audio-panel, #media-panel, #position-panel, #emoji-panel, .jeux-modal-box {
    color: #ffffff !important;
}
#giphy-drawer, #giphy-drawer span, #giphy-drawer input::placeholder {
    color: #ffffff !important;
}
#voice-transcript-zone, #voice-transcript-zone :not([style*="color"]),
.voice-record-status, .voice-record-timer,
.voice-filter-chip, .voice-panel-header span {
    color: #ffffff !important;
}
.voice-filter-chip { background: rgba(255,255,255,0.12) !important; border-color: rgba(255,255,255,0.18) !important; }
/* ===== COULEURS DES BOUTONS IA ET FLAMME ===== */

/* Bouton IA - Violet */
#ia-toolbar-btn,
#ia-toolbar-btn i,
#ia-toolbar-btn span {
    color: #7c3aed !important;
}

#ia-toolbar-btn:hover,
#ia-toolbar-btn:hover i,
#ia-toolbar-btn:hover span {
    opacity: 0.8 !important;
    transform: scale(1.05) !important;
}

/* Bouton Flamme - Orange */
.toolbar-btn[onclick*="ouvrirFlamme"],
.toolbar-btn[onclick*="ouvrirFlamme"] i,
.toolbar-btn[onclick*="ouvrirFlamme"] span {
    color: #ff5722 !important;
}

.toolbar-btn[onclick*="ouvrirFlamme"]:hover,
.toolbar-btn[onclick*="ouvrirFlamme"]:hover i,
.toolbar-btn[onclick*="ouvrirFlamme"]:hover span {
    opacity: 0.8 !important;
    transform: scale(1.05) !important;
}

/* Mode sombre - couleurs plus vives */
[data-theme="dark"] #ia-toolbar-btn,
[data-theme="dark"] #ia-toolbar-btn i,
[data-theme="dark"] #ia-toolbar-btn span {
    color: #a78bfa !important;
}

[data-theme="dark"] .toolbar-btn[onclick*="ouvrirFlamme"],
[data-theme="dark"] .toolbar-btn[onclick*="ouvrirFlamme"] i,
[data-theme="dark"] .toolbar-btn[onclick*="ouvrirFlamme"] span {
    color: #ff8a65 !important;
}
      
      /* ===== ANIMATION CADEAU DANS LE CHAT ===== */
@keyframes cadeauPulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.1); }
}

.cadeau-chat-icon {
    font-size: 3.5rem !important;
    cursor: pointer;
    display: inline-block;
    padding: 4px;
    transition: transform 0.2s ease;
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
}

.cadeau-chat-icon:hover {
    transform: scale(1.15);
}

/* 鉁? Supprimer la bulle derri猫re le cadeau */
.message-row:has(.cadeau-chat-icon) .message-bubble {
    background: transparent !important;
    background-color: transparent !important;
    border: none !important;
    box-shadow: none !important;
    padding: 4px 8px !important;
}

/* 鉁? Heure sous le cadeau */
.message-row:has(.cadeau-chat-icon) .msg-meta {
    margin-top: 2px !important;
    padding: 0 4px !important;
    background: transparent !important;
}
      
      /* ===== SUPPRESSION TOTALE DE LA BULLE POUR LES CADEAUX ===== */
.message-row .message-bubble:has(.cadeau-chat-icon),
.message-row .message-bubble:has([class*="cadeau"]),
.message-row:has(.cadeau-chat-icon) .message-bubble {
    background: transparent !important;
    background-color: transparent !important;
    background-image: none !important;
    border: none !important;
    box-shadow: none !important;
    padding: 4px 8px !important;
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
}

/* 鉁? Supprimer aussi le fond gris des messages re莽us */
.message-row.received:has(.cadeau-chat-icon) .message-bubble {
    background: transparent !important;
    background-color: transparent !important;
}

/* 鉁? Supprimer aussi le d茅grad茅 des messages envoy茅s */
.message-row.sent:has(.cadeau-chat-icon) .message-bubble {
    background: transparent !important;
    background-color: transparent !important;
}
      /* ===== ANIMATION LETTRE DANS LE CHAT ===== */
@keyframes lettrePulse {
    0%, 100% { transform: scale(1) rotate(0deg); }
    50% { transform: scale(1.1) rotate(-3deg); }
}

.lettre-chat-icon {
    font-size: 3.5rem !important;
    cursor: pointer;
    display: inline-block;
    padding: 4px;
    transition: transform 0.2s ease;
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
}

.lettre-chat-icon:hover {
    transform: scale(1.15) rotate(-2deg);
}

/* 鉁? Supprimer la bulle derri猫re la lettre */
.message-row:has(.lettre-chat-icon) .message-bubble,
.message-bubble:has(.lettre-chat-icon),
.message-row.received:has(.lettre-chat-icon) .message-bubble,
.message-row.sent:has(.lettre-chat-icon) .message-bubble {
    background: transparent !important;
    background-color: transparent !important;
    border: none !important;
    box-shadow: none !important;
    padding: 4px 8px !important;
}

/* 鉁? Heure sous la lettre */
.message-row:has(.lettre-chat-icon) .msg-meta {
    margin-top: 2px !important;
    padding: 0 4px !important;
    background: transparent !important;
}
      
      /* ===== LETTRE STYLE PDF / FEUILLE BLANCHE ===== */
.lettre-pdf {
    position: relative;
    max-width: 420px;
    width: 92%;
    margin: 0 auto;
    animation: lettrePapierIn 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
}

@keyframes lettrePapierIn {
    0% { transform: scale(0.7) rotate(-3deg) translateY(40px); opacity: 0; }
    60% { transform: scale(1.02) rotate(1deg) translateY(-4px); opacity: 1; }
    100% { transform: scale(1) rotate(0deg) translateY(0); opacity: 1; }
}

.lettre-papier {
    background: #ffffff;
    border-radius: 4px;
    padding: 40px 45px 35px;
    box-shadow: 
        0 4px 20px rgba(0, 0, 0, 0.15),
        0 1px 4px rgba(0, 0, 0, 0.06),
        inset 0 1px 0 rgba(255, 255, 255, 0.8);
    position: relative;
    min-height: 250px;
    max-height: 80vh;
    overflow-y: auto;
}

/* Effet de grain de papier */
.lettre-papier::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: 
        radial-gradient(ellipse at 20% 50%, rgba(200, 180, 160, 0.03) 0%, transparent 60%),
        radial-gradient(ellipse at 80% 20%, rgba(200, 180, 160, 0.03) 0%, transparent 50%);
    pointer-events: none;
    border-radius: 4px;
}

.lettre-papier::after {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
        0deg,
        transparent,
        transparent 27px,
        rgba(200, 200, 210, 0.06) 27px,
        rgba(200, 200, 210, 0.06) 28px
    );
    pointer-events: none;
    border-radius: 4px;
}

.lettre-en-tete {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.75rem;
    color: #999;
    text-transform: uppercase;
    letter-spacing: 2px;
    border-bottom: 2px solid #f0ece6;
    padding-bottom: 14px;
    margin-bottom: 22px;
    font-weight: 600;
}

.lettre-en-tete span:first-child {
    font-size: 1.1rem;
}

.lettre-contenu {
    font-size: 1.05rem;
    line-height: 1.9;
    color: #1a1a1a;
    white-space: pre-wrap;
    word-break: break-word;
    font-family: 'Inter', 'Georgia', serif;
    padding: 4px 0;
    min-height: 100px;
    text-align: left;
}

.lettre-signature {
    margin-top: 30px;
    padding-top: 14px;
    border-top: 1px solid #f0ece6;
    font-size: 0.9rem;
    color: #555;
    font-style: italic;
    text-align: right;
    font-family: 'Caveat', cursive;
}

/* Mode sombre - la lettre reste blanche */
[data-theme="dark"] .lettre-papier {
    background: #fcf9f5;
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.5);
}

[data-theme="dark"] .lettre-contenu {
    color: #1a1a1a;
}

[data-theme="dark"] .lettre-en-tete {
    border-bottom-color: #e8e0d6;
}

[data-theme="dark"] .lettre-signature {
    border-top-color: #e8e0d6;
    color: #555;
}

/* Responsive */
@media (max-width: 480px) {
    .lettre-papier {
        padding: 28px 22px 25px;
        max-height: 75vh;
    }
    
    .lettre-contenu {
        font-size: 0.95rem;
        line-height: 1.8;
    }
    
    .lettre-en-tete {
        font-size: 0.65rem;
        padding-bottom: 10px;
        margin-bottom: 16px;
    }
    
    .lettre-signature {
        font-size: 0.85rem;
        margin-top: 22px;
    }
}
      /* ===== FORCER LA LETTRE 脌 RESTER BLANCHE QUEL QUE SOIT LE MODE ===== */
.lettre-papier,
.lettre-papier *,
.lettre-conteudo,
.lettre-en-tete,
.lettre-en-tete *,
.lettre-signature,
.lettre-signature * {
    background: #ffffff !important;
    background-color: #ffffff !important;
    color: #1a1a1a !important;
}

.lettre-en-tete {
    color: #999 !important;
    border-bottom-color: #f0ece6 !important;
}

.lettre-signature {
    color: #555 !important;
    border-top-color: #f0ece6 !important;
}

/* Le bouton fermer reste blanc/transparent */
.lettre-pdf .carte-speciale-close {
    color: #666 !important;
    background: rgba(0,0,0,0.05) !important;
}
    </style>
</head>
<body>

    <div class="app-container">
       <div id="login-screen">
    <div class="login-card">
        <h2>馃攼 CHAT-IDA AIDARA</h2>
        <p style="color: rgba(255,255,255,0.7); font-size: 0.85rem; margin-bottom: 20px;">Entrez votre mot de passe </p>
        
        <div class="input-group">
            <input type="password" id="login-password" placeholder="Mot de passe..." 
                   style="width:100%; padding:14px 18px; border-radius:12px; border:2px solid rgba(255,255,255,0.1); background:rgba(255,255,255,0.08); color:#fff; font-size:1rem; outline:none;"
                   onkeydown="if(event.key==='Enter') loginWithPassword()">
        </div>
        
        <button class="user-btn" onclick="loginWithPassword()" 
                style="display:flex; align-items:center; justify-content:center; gap:10px; width:100%; padding:14px; background:linear-gradient(45deg, #a800ff, #0076ff); border:none; border-radius:12px; color:white; font-weight:600; cursor:pointer; transition:transform 0.2s;">
            <span>馃攽 Se connecter</span>
        </button>
        
        <div id="login-error" style="color:#ff4444; font-size:0.85rem; margin-top:12px; text-align:center; min-height:24px;"></div>
        
        <div style="text-align:center; margin-top:15px; font-size:0.65rem; color:rgba(255,255,255,0.3);">
            馃挕 hum c qui toiii
        </div>
    </div>
</div>

        <script>
            // Ex茅cut茅 imm茅diatement (pas d'attente de DOMContentLoaded ni des SDK externes) :
            // si on est d茅j脿 connect茅, on masque l'茅cran de connexion tout de suite pour
            // 茅liminer le flash visible avant que selectUser() ne s'ex茅cute vraiment.
            (function() {
                try {
                    var dernierUtilisateur = localStorage.getItem('lastUser');
                    if (dernierUtilisateur === 'ida' || dernierUtilisateur === 'aidara') {
                        var ecranConnexion = document.getElementById('login-screen');
                        if (ecranConnexion) ecranConnexion.style.display = 'none';
                    }
                } catch (e) {}
            })();
        </script>

        <div class="chat-header">
            <div class="header-left">
               
                <div style="position: relative;">
                    <div class="header-avatar" id="header-av">--</div>
                    <div class="mood-status" id="mood-status" onclick="event.stopPropagation(); toggleMoodPanel()">
                        <span id="mood-emoji">馃槉</span>
                    </div>
                </div>
                <div class="header-info">
                    <div class="h-name" id="header-display-name">
                        Correspondant 
                        <span id="other-mood-emoji" style="margin-left: 8px; font-size: 1rem; display: inline-block;">馃槉</span> 
                    </div>
                    <div class="h-status" id="header-status-text">
                        <span style="color: var(--text-muted);">...</span>
                    </div>
                </div>
                <div class="mood-panel" id="mood-panel">
                    <div class="mood-grid">
                        <div class="mood-item" onclick="setMood('馃槉', 'Heureux')"><span class="mood-emoji">馃槉</span><span class="mood-label">Heureux</span></div>
                        <div class="mood-item" onclick="setMood('馃毧', 'Au douche')"><span class="mood-emoji">馃毧</span><span class="mood-label">Au douche</span></div>
                        <div class="mood-item" onclick="setMood('馃崟', 'Manger')"><span class="mood-emoji">馃崟</span><span class="mood-label">Manger</span></div>
                        <div class="mood-item" onclick="setMood('馃毝', 'Sorti')"><span class="mood-emoji">馃毝</span><span class="mood-label">Sorti</span></div>
                        <div class="mood-item" onclick="setMood('馃捈', 'Travail')"><span class="mood-emoji">馃捈</span><span class="mood-label">Travail</span></div>
                        <div class="mood-item" onclick="setMood('馃摎', '脡tude')"><span class="mood-emoji">馃摎</span><span class="mood-label">脡tude</span></div>
                        <div class="mood-item" onclick="setMood('馃幃', 'Jeux')"><span class="mood-emoji">馃幃</span><span class="mood-label">Jeux</span></div>
                        <div class="mood-item" onclick="setMood('馃槾', 'Dodo')"><span class="mood-emoji">馃槾</span><span class="mood-label">Dodo</span></div>
                        <div class="mood-item" onclick="setMood('馃弮', 'Sport')"><span class="mood-emoji">馃弮</span><span class="mood-label">Sport</span></div>
                        <div class="mood-item" onclick="setMood('馃槧', 'En col猫re')"><span class="mood-emoji">馃槧</span><span class="mood-label">En col猫re</span></div>
                        <div class="mood-item" onclick="setMood('馃摵', 'Netflix')"><span class="mood-emoji">馃摵</span><span class="mood-label">Netflix</span></div>
                        <div class="mood-item" onclick="setMood('鈽?', 'Caf茅')"><span class="mood-emoji">鈽?</span><span class="mood-label">Caf茅</span></div>
                        <div class="clear-mood" onclick="clearMood()">鉂? Effacer mon statut</div>
                    </div>
                </div>
            </div>
            <div class="header-actions">
                <i class="fa-solid fa-heart pense-toi-btn" id="pense-toi-btn" title="Pense 脿 toi 鉂わ笍" onclick="triggerPenseAToi()"></i>
                <i class="fa-solid fa-eye-slash blur-toggle-btn" id="blur-toggle-btn" title="Mode Flou" onclick="toggleBlurMode()"></i>
                <i class="fa-solid fa-eye live-toggle-btn" id="live-toggle-btn" title="Mode Live : voir ce que l'autre tape en temps r茅el" onclick="toggleLiveMode()"></i>
                <i class="fa-solid fa-magnifying-glass" title="Rechercher dans la conversation" onclick="ouvrirRecherchePage()" style="cursor:pointer;"></i>
                <i class="fa-solid fa-phone" id="call-audio-btn" title="Appel audio" onclick="startCall('audio')" style="cursor:pointer;"></i>
                <i class="fa-solid fa-video" id="call-video-btn" title="Appel vid茅o" onclick="startCall('video')" style="cursor:pointer;"></i>
                <i class="fa-solid fa-gear" title="Param猫tres" onclick="openSettingsPage()" style="cursor:pointer;"></i>
            </div>
        </div>
        

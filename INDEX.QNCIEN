        <!-- Section Autorisations (micro / cam茅ra / notifications) -->
        <div class="settings-section" style="animation-delay:0.20s;">
            <h4><i class="fa-solid fa-shield-halved"></i> Autorisations</h4>
            <p class="settings-section-desc">Active le micro et la cam茅ra pour que les appels vocaux et vid茅o fonctionnent correctement.</p>
            <div class="permission-row" id="permission-row-mic">
                <div class="permission-icon"><i class="fa-solid fa-microphone"></i></div>
                <div class="permission-text">
                    <div class="permission-title">Microphone</div>
                    <div class="permission-status" id="permission-status-mic">Non activ茅</div>
                </div>
                <div class="ios-toggle-switch" id="permission-toggle-mic" onclick="demanderAutorisation('mic')"></div>
            </div>
            <div class="permission-row" id="permission-row-cam">

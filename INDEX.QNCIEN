// ========== 脡COUTE LES 脡V脡NEMENTS DE D脡FILEMENT ==========
function initNewMessageButton() {
    const msgArea = document.getElementById('msg-area');
    if (!msgArea) return;
    
    // D茅tecter le d茅filement pour cacher le bouton
    msgArea.addEventListener('scroll', function() {
        const atBottom = detecterPositionDefilement();
        if (atBottom && isButtonVisible) {
            // L'utilisateur a scroll茅 en bas 鈫? cacher le bouton
            cacherBoutonNouveauMessage();
        }
    }, { passive: true });
    
    // D茅tecter le redimensionnement (clavier mobile, etc.)
    window.addEventListener('resize', function() {
        detecterPositionDefilement();
    }, { passive: true });
}

// ========== INITIALISATION DU BOUTON FLOTTANT ==========
setTimeout(() => {
    initNewMessageButton();
}, 500);


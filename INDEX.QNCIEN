      // ========== AUTO-REDIMENSIONNER LE TEXTAREA ==========
function autoResizeTextarea() {
    const textarea = document.getElementById('chat-in');
    // R茅initialiser la hauteur pour calculer correctement
    textarea.style.height = 'auto';
    // En mode 茅dition d'un message existant, on autorise jusqu'脿 environ 10 lignes
    // avant de faire d茅filer, pour bien voir/relire tout le texte. En saisie normale,
    // on garde la limite habituelle de 5 lignes pour ne pas envahir l'茅cran.
    const maxHeight = messageEnCoursEdition ? 240 : 120;
    const newHeight = Math.min(textarea.scrollHeight, maxHeight);
    textarea.style.height = newHeight + 'px';
    // G茅rer le d茅filement si 莽a d茅passe la limite
    textarea.style.overflowY = textarea.scrollHeight > maxHeight ? 'auto' : 'hidden';
    sauvegarderBrouillonMessage(textarea.value);
}

 
function cleDuBrouillon() {
    return `chat_draft_${CHAT_ID}_${currentUser ? currentUser.id : 'anon'}`;
}
function sauvegarderBrouillonMessage(texte) {
    if (!currentUser) return;
    if (texte && texte.length > 0) {
        localStorage.setItem(cleDuBrouillon(), texte);
    } else {
        localStorage.removeItem(cleDuBrouillon());
    }
}
function restaurerBrouillonMessage() {
    if (!currentUser || messageEnCoursEdition) return;
    const brouillon = localStorage.getItem(cleDuBrouillon());
    const textarea = document.getElementById('chat-in');
    if (brouillon && textarea && !textarea.value) {
        textarea.value = brouillon;
        autoResizeTextarea();
        if (typeof toggleSendBtn === 'function') toggleSendBtn(true);
    }
}

 
(function corrigerHauteurClavier() {
    if (!window.visualViewport) return;
    const appContainer = document.querySelector('.app-container');
    if (!appContainer) return;
    const ajuster = () => {
        const clavierVisible = (window.innerHeight - window.visualViewport.height) > 100;
        appContainer.style.height = clavierVisible ? window.visualViewport.height + 'px' : '';
    };
    window.visualViewport.addEventListener('resize', ajuster);
    window.visualViewport.addEventListener('scroll', ajuster);
    ajuster();
})();
      

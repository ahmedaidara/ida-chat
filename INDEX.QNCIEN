// Sauvegarder l'utilisateur dans selectUser (d茅j脿 fait  aut)
// D茅connecter en effa莽ant le localStorage
function logoutComplet() {
    localStorage.removeItem('chat_last_user');
    logout(); // Ta fonction logout existante
}

// Lancer la connexion auto au chargement

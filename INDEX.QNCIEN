      // ========== GESTION DE L'APPUI LONG POUR MENU CONTEXTUEL ==========
let appuiLongTimer = null;
let elementAppuye = null;

<!-- SOLUTION POUR MOBILE (Safari/Samsung) : Le mode flou bloque l'appui long -->
<!-- Modifie la fonction demarrerAppuiLong (vers ligne ~3830) -->

function demarrerAppuiLong(event, msgId) {
    // 鉁? AJOUTE CETTE CONDITION EN PREMIER
    if (blurModeActive) {
        // Optionnel : vibration discr猫te pour signaler que c'est bloqu茅
        if (navigator.vibrate) navigator.vibrate(50);
        return;
    }
    
    // Annuler si d茅j脿 un timer
    if (appuiLongTimer) clearTimeout(appuiLongTimer);
    
    // Stocker l'ID du message
    elementAppuye = msgId;
    
    // D茅marrer le timer
    appuiLongTimer = setTimeout(() => {
        // Cr茅er un faux 茅v茅nement avec la position actuelle du toucher 
        let fakeEvent = {
            preventDefault: () => {},
            pageY: event.touches ? event.touches[0].pageY : (event.pageY || window.scrollY + 100),
            pageX: event.touches ? event.touches[0].pageX : (event.pageX || window.scrollX + 100),
            clientY: event.touches ? event.touches[0].clientY : (event.clientY || 100),
            clientX: event.touches ? event.touches[0].clientX : (event.clientX || 100)
        };
        
        // Ouvrir le menu
        handleContextMenu(fakeEvent, msgId);
        
        // Nettoyer
        clearTimeout(appuiLongTimer);
        appuiLongTimer = null;
    }, 500);
}

// 鉁? Ajoute aussi cette v茅rification dans les fonctions de swipe (gererSwipeMouvement)
function gererSwipeMouvement(event, msgId) {
    // BLOQUER LES SWIPES EN MODE FLOU
    if (blurModeActive) {
        swipeDepartX = null;
        swipeDepartY = null;
        return;
    }
    
    if (swipeDepartX === null || swipeDeclenche) return;
    const touche = event.touches ? event.touches[0] : event;
    const deltaX = touche.clientX - swipeDepartX;
    const deltaY = touche.clientY - swipeDepartY;
    
    // Tout mouvement annule l'appui long (comportement original conserv茅)
    annulerAppuiLong();
    
    // Un swipe doit 锚tre surtout horizontal pour ne pas g锚ner le scroll vertical
    if (Math.abs(deltaX) > SWIPE_SEUIL_PX && Math.abs(deltaX) > Math.abs(deltaY) * 1.5) {
        swipeDeclenche = true;
        const row = document.querySelector(`[data-id="${msgId}"]`);
        const estMonMessage = row && row.classList.contains('sent');
        
        if (deltaX > 0) {
            // Swipe vers la droite 鈫? R茅pondre
            selectedMessageId = msgId;
            initiateReply();
        } else if (estMonMessage) {
            // Swipe vers la gauche 鈫? Modifier (uniquement si l'utilisateur est l'auteur)
            modifierMonMessageDirect(msgId);
        }
    }
}

      // Dans toggleBlurMode(), ajoute ceci :
function toggleBlurMode() {
    blurModeActive = !blurModeActive;
    const container = document.getElementById('msg-area');
    const blurBtn = document.getElementById('blur-toggle-btn');
    if (blurModeActive) {
        container.classList.add('blur-mode');
        blurBtn.classList.add('active');
        blurBtn.classList.remove('fa-eye-slash');
        blurBtn.classList.add('fa-eye');
        applyBlurToAllMessages();
        
        // 鉁? AJOUTE UN INDICATEUR VISIBLE 
     } else {
        container.classList.remove('blur-mode');
        blurBtn.classList.remove('active');
        blurBtn.classList.remove('fa-eye');
        blurBtn.classList.add('fa-eye-slash');
        removeBlurFromAllMessages();
        showTempNotification("馃憗锔? Mode Flou D脡SACTIV脡");
    }
}
      
function annulerAppuiLong() {
    if (appuiLongTimer) {
        clearTimeout(appuiLongTimer);
        appuiLongTimer = null;
    }
    elementAppuye = null;
}

                                                                                             
let swipeDepartX = null;
let swipeDepartY = null;
let swipeDeclenche = false;
const SWIPE_SEUIL_PX = 55;

function gererSwipeDebut(event, msgId) {
    const touche = event.touches ? event.touches[0] : event;
    swipeDepartX = touche.clientX;
    swipeDepartY = touche.clientY;
    swipeDeclenche = false;
    demarrerAppuiLong(event, msgId);
}

function gererSwipeMouvement(event, msgId) {
    if (swipeDepartX === null || swipeDeclenche) return;
    const touche = event.touches ? event.touches[0] : event;
    const deltaX = touche.clientX - swipeDepartX;
    const deltaY = touche.clientY - swipeDepartY;
    
    // Tout mouvement annule l'appui long (comportement original conserv茅)
    annulerAppuiLong();
    
    // Un swipe doit 锚tre surtout horizontal pour ne pas g锚ner le scroll vertical
    if (Math.abs(deltaX) > SWIPE_SEUIL_PX && Math.abs(deltaX) > Math.abs(deltaY) * 1.5) {
        swipeDeclenche = true;
        const row = document.querySelector(`[data-id="${msgId}"]`);
        const estMonMessage = row && row.classList.contains('sent');
        
        if (deltaX > 0) {
            // Swipe vers la droite 鈫? R茅pondre
            selectedMessageId = msgId;
            initiateReply();
        } else if (estMonMessage) {
            // Swipe vers la gauche 鈫? Modifier (uniquement si l'utilisateur est l'auteur)
            modifierMonMessageDirect(msgId);
        }
    }
}

function gererSwipeFin() {
    swipeDepartX = null;
    swipeDepartY = null;
    swipeDeclenche = false;
    annulerAppuiLong();
}
      
      // ========== COPIER LE MESSAGE ==========
// Extrait le texte COMPLET d'une bulle de message, m锚me pour les messages longs
// tronqu茅s visuellement ("VOIR TOUT") 鈥? jamais juste la version affich茅e/r茅sum茅e.
function extraireTexteCompletMessage(messageBubbleOrRow) {
    if (!messageBubbleOrRow) return '';
    const conteneur = messageBubbleOrRow.classList && messageBubbleOrRow.classList.contains('message-bubble')
        ? messageBubbleOrRow
        : messageBubbleOrRow.querySelector('.message-bubble');
    if (!conteneur) return '';

    // textContent + remplacement des <br> par de vrais sauts de ligne : 莽a marche
    // m锚me si l'茅l茅ment est en display:none (innerText renverrait "" dans ce cas).
    const texteAvecSauts = (el) => {
        const clone = el.cloneNode(true);
        clone.querySelectorAll('br').forEach(br => br.replaceWith('\n'));
        return clone.textContent;
    };

    const complet = conteneur.querySelector('.msg-text-complet');
    if (complet) return texteAvecSauts(complet);

    const codedMask = conteneur.querySelector('.coded-mask');
    if (codedMask && codedMask.textContent) return texteAvecSauts(codedMask);

    const span = conteneur.querySelector('span:not(.coded-mask):not(.msg-text-tronque):not(.voir-tout-btn)');
    if (span) return texteAvecSauts(span);

    return '';
}

async function copierMessage() {
    if (!selectedMessageId) return;
    
    const messageRow = document.querySelector(`[data-id="${selectedMessageId}"]`);
    if (!messageRow) return;
    
    // R茅cup茅rer le texte du message
    const messageBubble = messageRow.querySelector('.message-bubble');
    if (!messageBubble) return;
    
    // Toujours le texte COMPLET (jamais juste la partie visible avant "VOIR TOUT")
    let texteACopier = extraireTexteCompletMessage(messageBubble);
    
    // Si pas de texte, v茅rifier si c'est une image ou audio
    if (!texteACopier) {
        const img = messageBubble.querySelector('img');
        if (img) {
            texteACopier = img.src;
            showTempNotification("馃摲 Lien de l'image copi茅");
        } else {
            const audio = messageBubble.querySelector('audio');
            if (audio) {
                texteACopier = audio.src;
                showTempNotification("馃幍 Lien de l'audio copi茅");
            }
        }
    }
    
    if (!texteACopier) {
        showTempNotification("鉂? Impossible de copier ce message");
        hideContextMenus();
        return;
    }
    
    // Copier dans le presse-papier
    try {
        await navigator.clipboard.writeText(texteACopier);
     } catch (err) {
        // Fallback pour les navigateurs plus anciens
        const textarea = document.createElement('textarea');
        textarea.value = texteACopier;
        document.body.appendChild(textarea);
        textarea.select();
        document.execCommand('copy');
        document.body.removeChild(textarea);
     }
    
    hideContextMenus();
}
      
      
